# Supabase for the app (S4). Copy to .env.local and fill in; never commit a filled-in copy.
# With either value empty the app runs signed-out only ("Accounts aren't set up in this build").
# Local stack: `npm run db:start`, then `npx supabase status` prints the API URL (port 54321) and the anon key.
# On the phone use the box's Tailscale address instead of 127.0.0.1 (docs/plans/2026-10-22-live-checklist.md).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Links (S9): the page a Copy link / Invite link points at (web/share/, D92). Empty → http://localhost:8080/share/,
# which opens only on the box; for phone tests use the box's Tailscale address (docs/plans/2026-10-22-live-checklist.md).
EXPO_PUBLIC_SHARE_BASE_URL=
