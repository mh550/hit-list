+/** The nearest host (native) ancestor: the tile's wrapper View. */
+function hostParent(node: ReactTestInstance): ReactTestInstance {
+  let p = node.parent;
+  while (p && typeof p.type !== 'string') p = p.parent;
+  if (!p) throw new Error('no host parent');
+  return p;
