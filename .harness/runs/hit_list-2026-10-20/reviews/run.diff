+    ...KNOWN.flatMap(([key, label, format]) => row(key, label, format)),
+    ...Object.keys(legacy)
+      .filter((key) => !listed.has(key))
+      .flatMap((key) => row(key, humanise(key))),
+    ...RAW.flatMap(([key, label]) => row(key, label)),
+  ];
+}
