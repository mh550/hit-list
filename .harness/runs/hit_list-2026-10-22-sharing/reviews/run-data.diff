diff --git a/supabase/functions/account-delete/index.ts b/supabase/functions/account-delete/index.ts
new file mode 100644
index 0000000..ec682b2
--- /dev/null
+++ b/supabase/functions/account-delete/index.ts
@@ -0,0 +1,116 @@
+// account-delete (S4-05, D51): deletes the calling rider's account. The user comes only from the caller's JWT
+// (Authorization: Bearer <jwt>, resolved by auth.getUser); the request body is never read, so no request can name
+// another user. Order: the rider's Storage objects first (<uid>/… and sends/<id>/… of every send from or to them, and
+// any photo they staged for a send that never got its row, S7), then the auth user, whose deletion cascades through
+// profiles to every row they own (S3 schema, `on delete cascade`). Storage goes first so a retry after a later failure still finds the files; the reverse would orphan
+// them, as nothing would point at them any more. A direct DELETE on storage.objects is blocked, so files go through
+// the Storage API. A photo uploaded between the listing and the user delete is left behind (S8 may sweep orphans).
+// Responses: 200 { ok: true }, 401 { error: 'unauthorized' }, 405 { error: 'method not allowed' },
+// 500 { error: 'delete failed' } (the detail only in the function's log). Plan: docs/plans/2026-10-22-s4-accounts.md.
+import { createClient, type SupabaseClient } from 'npm:@supabase/supabase-js@2.118.0';
+
+import { corsHeaders } from '../_shared/cors.ts';
+
+const BUCKET = 'photos';
+/** The Storage API's page size for list and its limit for one remove. */
+const PAGE = 1000;
+/** Folders listed in parallel: a rider with thousands of spots has a folder each, and one at a time is too slow. */
+const LISTS_AT_ONCE = 20;
+
+function json(status: number, body: Record<string, unknown>): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { ...corsHeaders, 'Content-Type': 'application/json' },
+  });
+}
+
+/** Every entry directly under `prefix`, all pages. A folder has `id` null; a file has an id. */
+async function listAll(admin: SupabaseClient, prefix: string): Promise<{ name: string; id: string | null }[]> {
+  const entries: { name: string; id: string | null }[] = [];
+  for (let offset = 0; ; offset += PAGE) {
+    const { data, error } = await admin.storage.from(BUCKET).list(prefix, { limit: PAGE, offset });
+    if (error) throw error;
+    entries.push(...data);
+    if (data.length < PAGE) return entries;
+  }
+}
+
+/** The paths of every file under the prefixes, down any depth of folders; LISTS_AT_ONCE folders are read at a time. */
+async function filesUnder(admin: SupabaseClient, prefixes: string[]): Promise<string[]> {
+  const paths: string[] = [];
+  for (let i = 0; i < prefixes.length; i += LISTS_AT_ONCE) {
+    const batch = prefixes.slice(i, i + LISTS_AT_ONCE);
+    const listed = await Promise.all(batch.map((prefix) => listAll(admin, prefix)));
+    const folders: string[] = [];
+    listed.forEach((entries, j) => {
+      for (const entry of entries) {
+        const path = `${batch[j]}/${entry.name}`;
+        if (entry.id === null) folders.push(path);
+        else paths.push(path);
+      }
+    });
+    if (folders.length) paths.push(...(await filesUnder(admin, folders)));
+  }
+  return paths;
+}
+
+async function deleteUserData(admin: SupabaseClient, uid: string): Promise<void> {
+  // Sends to the rider go too: their rows cascade away with the account, and then nobody (not even the sender) may
+  // read or remove the files. PostgREST caps a response at max_rows (1000), so the sends are read in pages.
+  const prefixes = [uid];
+  for (let offset = 0; ; offset += PAGE) {
+    const { data: sends, error } = await admin
+      .from('sends')
+      .select('id')
+      .or(`sender.eq.${uid},recipient.eq.${uid}`)
+      .order('id')
+      .range(offset, offset + PAGE - 1);
+    if (error) throw error;
+    prefixes.push(...sends.map((send: { id: string }) => `sends/${send.id}`));
+    if (sends.length < PAGE) break;
+  }
+  const paths = await filesUnder(admin, prefixes);
+  // photos staged for a send that never got its row (S7, D77: the app stopped between the copy and create_send)
+  const { data: staged, error: stagedError } = await admin.rpc('staged_send_objects', { p_uid: uid });
+  if (stagedError) throw stagedError;
+  paths.push(...((staged ?? []) as string[]));
+
+  for (let i = 0; i < paths.length; i += PAGE) {
+    const { error } = await admin.storage.from(BUCKET).remove(paths.slice(i, i + PAGE));
+    if (error) throw error;
+  }
+
+  const { error: deleteError } = await admin.auth.admin.deleteUser(uid);
+  if (deleteError) throw deleteError;
+}
+
+Deno.serve(async (req: Request) => {
+  if (req.method === 'OPTIONS') return new Response('ok', { headers: corsHeaders });
+  if (req.method !== 'POST') return json(405, { error: 'method not allowed' });
+
+  const url = Deno.env.get('SUPABASE_URL');
+  const anonKey = Deno.env.get('SUPABASE_ANON_KEY');
+  const serviceRoleKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY');
+  if (!url || !anonKey || !serviceRoleKey) {
+    console.error('account-delete: missing SUPABASE_URL, SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY');
+    return json(500, { error: 'delete failed' });
+  }
+
+  const jwt = req.headers.get('Authorization')?.match(/^Bearer\s+(\S+)$/i)?.[1];
+  if (!jwt) return json(401, { error: 'unauthorized' });
+
+  const noSession = { auth: { persistSession: false, autoRefreshToken: false } };
+  const anon = createClient(url, anonKey, noSession);
+  const { data: userData, error: userError } = await anon.auth.getUser(jwt);
+  const uid = userData?.user?.id;
+  if (userError || !uid) return json(401, { error: 'unauthorized' });
+
+  const admin = createClient(url, serviceRoleKey, noSession);
+  try {
+    await deleteUserData(admin, uid);
+  } catch (error) {
+    console.error('account-delete failed', uid, error);
+    return json(500, { error: 'delete failed' });
+  }
+  return json(200, { ok: true });
+});
diff --git a/supabase/functions/share-preview/index.ts b/supabase/functions/share-preview/index.ts
new file mode 100644
index 0000000..8d02d1d
--- /dev/null
+++ b/supabase/functions/share-preview/index.ts
@@ -0,0 +1,183 @@
+// share-preview (S9-02, D44/D45, spec §3.6; plan docs/plans/2026-10-22-s9-links.md "share-preview"): what a link
+// shows to anyone holding it, with no account. Deployed with verify_jwt = false (config.toml), so a browser calls it
+// with no Authorization header: `POST` with the token as a text/plain body (D96: a simple CORS request, no preflight,
+// and never in the URL, so no gateway or platform request log keeps it; `GET ?t=` answers 405).
+// - A live send link: 200 { kind: 'send', spots, sender, expires_at }. The spots are the send's frozen payload (D40),
+//   by an allow-list of fields (never the payload's spot id), each with photo_urls signed for 600 s. Only objects
+//   listed under sends/<send_id>/ that a payload photo names get a URL; a path as the sender wrote it is never signed
+//   (the service role would sign anyone's photo). The sender is the preview_link row's (the profile), never the
+//   payload's.
+// - A live invite link: 200 { kind: 'invite', list_name, inviter, expires_at }, no spots.
+// - Anything else (unknown, malformed, expired, revoked, withdrawn, used, unshared or deleted list): 404 with exactly
+//   {"error":"gone"} and the same headers, never saying which. A database error is 500 { error: 'unavailable' }.
+// JSON only, never HTML (Edge Functions can't serve it, D45); the page in web/share/ renders it. The token is hashed
+// here (SHA-256, lowercase hex, as the app and redeem_invite do) and never logged.
+import { createClient, type SupabaseClient } from 'npm:@supabase/supabase-js@2.118.0';
+
+const BUCKET = 'photos';
+/** A signed photo URL lives 10 minutes. */
+const SIGNED_URL_SECONDS = 600;
+/** The Storage API's page size for list. */
+const PAGE = 1000;
+/** 16 random bytes as base64url (the app's newToken). */
+const TOKEN_RE = /^[A-Za-z0-9_-]{22}$/;
+/** More than a token and its whitespace is never read. */
+const MAX_BODY = 256;
+const MEDIA_FILE_RE = /^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jpg$/;
+
+const HEADERS = {
+  'Access-Control-Allow-Origin': '*',
+  'Access-Control-Allow-Methods': 'POST, OPTIONS',
+  'Content-Type': 'application/json',
+  'Cache-Control': 'no-store',
+  'Referrer-Policy': 'no-referrer',
+};
+/** Built once, so every dead case answers the same bytes. */
+const GONE = JSON.stringify({ error: 'gone' });
+
+const json = (status: number, body: string) => new Response(body, { status, headers: HEADERS });
+const gone = () => json(404, GONE);
+
+type PreviewRow = {
+  kind: 'send' | 'invite';
+  send_id: string | null;
+  payload: unknown;
+  list_name: string | null;
+  sender_username: string | null;
+  sender_display_name: string | null;
+  expires_at: string | null;
+};
+
+type SpotOut = {
+  name: string | null;
+  generated_name: string | null;
+  lat: number | null;
+  lng: number | null;
+  feature_types: string[];
+  stopped: boolean;
+  natural_speed: number | null;
+  notes: string | null;
+  photo_urls: string[];
+};
+
+const isObject = (value: unknown): value is Record<string, unknown> =>
+  typeof value === 'object' && value !== null && !Array.isArray(value);
+const text = (value: unknown) => (typeof value === 'string' ? value : null);
+const finite = (value: unknown) => (typeof value === 'number' && Number.isFinite(value) ? value : null);
+
+async function sha256Hex(token: string): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(token));
+  return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+/** The media ids of the photo files directly under sends/<sendId>/, all pages. */
+async function stagedMediaIds(admin: SupabaseClient, sendId: string): Promise<Set<string>> {
+  const ids = new Set<string>();
+  for (let offset = 0; ; offset += PAGE) {
+    const { data, error } = await admin.storage.from(BUCKET).list(`sends/${sendId}`, { limit: PAGE, offset });
+    if (error) throw error;
+    for (const entry of data) {
+      const match = entry.id === null ? null : MEDIA_FILE_RE.exec(entry.name);
+      if (match) ids.add(match[1]);
+    }
+    if (data.length < PAGE) return ids;
+  }
+}
+
+/**
+ * storage-js builds a signed URL on the client's SUPABASE_URL, which in the local edge runtime is the internal
+ * gateway (not reachable from a browser). PUBLIC_SUPABASE_URL (config.toml [edge_runtime.secrets] locally; the cloud's
+ * SUPABASE_URL is public already) replaces everything before the path, port and any path prefix included (a value
+ * with no port, e.g. https://box.tailnet.ts.net, must not keep the gateway's :8000); the path and the signature (which
+ * signs the object path, not the host) stay as they are.
+ */
+function publicUrl(signedUrl: string, publicOrigin: string | null): string {
+  if (!publicOrigin) return signedUrl;
+  const url = new URL(signedUrl);
+  return publicOrigin.replace(/\/+$/, '') + url.pathname + url.search;
+}
+
+async function sendSpots(admin: SupabaseClient, row: PreviewRow, publicOrigin: string | null): Promise<SpotOut[]> {
+  const rawSpots = isObject(row.payload) && Array.isArray(row.payload.spots) ? row.payload.spots : [];
+  const staged = row.send_id ? await stagedMediaIds(admin, row.send_id) : new Set<string>();
+
+  const photoPaths: string[][] = [];
+  const spots: SpotOut[] = rawSpots.filter(isObject).map((spot) => {
+    const paths: string[] = [];
+    for (const photo of Array.isArray(spot.photos) ? spot.photos : []) {
+      const mediaId = isObject(photo) ? text(photo.media_id) : null;
+      if (mediaId && staged.has(mediaId)) {
+        paths.push(`sends/${row.send_id}/${mediaId}.jpg`);
+        staged.delete(mediaId); // one URL per object, even if the payload names it twice
+      }
+    }
+    photoPaths.push(paths);
+    return {
+      name: text(spot.name),
+      generated_name: text(spot.generated_name),
+      lat: finite(spot.lat),
+      lng: finite(spot.lng),
+      feature_types: Array.isArray(spot.feature_types)
+        ? spot.feature_types.filter((t): t is string => typeof t === 'string')
+        : [],
+      stopped: spot.stopped === true,
+      natural_speed: finite(spot.natural_speed),
+      notes: text(spot.notes),
+      photo_urls: [],
+    };
+  });
+
+  const all = photoPaths.flat();
+  if (all.length) {
+    const { data, error } = await admin.storage.from(BUCKET).createSignedUrls(all, SIGNED_URL_SECONDS);
+    if (error) throw error;
+    const urlByPath = new Map<string, string>();
+    for (const entry of data) {
+      if (!entry.error && entry.path && entry.signedUrl) {
+        urlByPath.set(entry.path, publicUrl(entry.signedUrl, publicOrigin));
+      }
+    }
+    spots.forEach((spot, i) => {
+      spot.photo_urls = photoPaths[i].flatMap((path) => urlByPath.get(path) ?? []);
+    });
+  }
+  return spots;
+}
+
+Deno.serve(async (req: Request) => {
+  if (req.method === 'OPTIONS') return new Response(null, { status: 204, headers: HEADERS });
+  if (req.method !== 'POST') return json(405, JSON.stringify({ error: 'method not allowed' }));
+
+  const body = await req.text().catch(() => '');
+  const token = body.length > MAX_BODY ? '' : body.trim();
+  if (!TOKEN_RE.test(token)) return gone();
+
+  const url = Deno.env.get('SUPABASE_URL');
+  const serviceRoleKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY');
+  if (!url || !serviceRoleKey) {
+    console.error('share-preview: missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY');
+    return json(500, JSON.stringify({ error: 'unavailable' }));
+  }
+  const publicOrigin = Deno.env.get('PUBLIC_SUPABASE_URL') || null;
+  const admin = createClient(url, serviceRoleKey, { auth: { persistSession: false, autoRefreshToken: false } });
+
+  try {
+    const { data, error } = await admin.rpc('preview_link', { p_sha: await sha256Hex(token) });
+    if (error) throw error;
+    const row = (data as PreviewRow[] | null)?.[0];
+    if (!row) return gone();
+    const sender = { username: row.sender_username, display_name: row.sender_display_name };
+    if (row.kind === 'invite') {
+      return json(
+        200,
+        JSON.stringify({ kind: 'invite', list_name: row.list_name, inviter: sender, expires_at: row.expires_at }),
+      );
+    }
+    const spots = await sendSpots(admin, row, publicOrigin);
+    return json(200, JSON.stringify({ kind: 'send', spots, sender, expires_at: row.expires_at }));
+  } catch (error) {
+    // never the token
+    console.error('share-preview failed', error);
+    return json(500, JSON.stringify({ error: 'unavailable' }));
+  }
+});
diff --git a/supabase/migrations/20261023015403_schema.sql b/supabase/migrations/20261023015403_schema.sql
new file mode 100644
index 0000000..d9060d8
--- /dev/null
+++ b/supabase/migrations/20261023015403_schema.sql
@@ -0,0 +1,265 @@
+-- S3-02: the §3.2 server data model (docs/plans/2026-10-22-s3-backend.md, "Schema").
+-- RLS is enabled on every table and no policy exists yet, so anon and authenticated read and write nothing; the
+-- policies arrive with their pgTAP tests in the later S3 migrations. Append new migrations; never edit this one.
+
+create extension if not exists postgis with schema extensions;
+create extension if not exists citext with schema extensions;
+
+-- One counter for every synced table: a pull cursor is one number (spec §3.4).
+create sequence public.sync_rev;
+
+-- Tables --------------------------------------------------------------------------------------------------------------
+
+create table public.profiles (
+  id uuid primary key references auth.users (id) on delete cascade,
+  username extensions.citext unique,
+  display_name text,
+  created_at timestamptz not null default now(),
+  rev bigint,
+  -- D39: 3–20 letters (any case on input), digits, '_' or '.'; citext makes the unique index case-insensitive.
+  constraint profiles_username_format check (username::text ~ '^[A-Za-z0-9_.]{3,20}$')
+);
+
+create table public.spots (
+  id uuid primary key,
+  owner_id uuid not null references public.profiles (id) on delete cascade,
+  name text,
+  generated_name text,
+  lat double precision not null,
+  lng double precision not null,
+  geog extensions.geography(Point, 4326) generated always as
+    (extensions.st_setsrid(extensions.st_makepoint(lng, lat), 4326)::extensions.geography) stored,
+  feature_types text[] not null default '{}',
+  stopped boolean not null default false,
+  natural_speed smallint check (natural_speed between 0 and 4),
+  notes text,
+  primary_photo_id uuid,
+  copied_from_send uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null,
+  deleted_at timestamptz,
+  rev bigint
+);
+create index spots_owner_idx on public.spots (owner_id);
+create index spots_geog_idx on public.spots using gist (geog);
+
+create table public.media (
+  id uuid primary key,
+  spot_id uuid not null references public.spots (id) on delete cascade,
+  owner_id uuid not null references public.profiles (id) on delete cascade,
+  storage_path text,
+  captured_at timestamptz,
+  lat double precision,
+  lng double precision,
+  uploaded_by uuid references public.profiles (id) on delete set null,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null,
+  deleted_at timestamptz,
+  rev bigint
+);
+create index media_spot_idx on public.media (spot_id);
+create index media_owner_idx on public.media (owner_id);
+
+create table public.hit_lists (
+  id uuid primary key,
+  owner_id uuid not null references public.profiles (id) on delete cascade,
+  name text not null,
+  kind text not null check (kind in ('manual', 'area')),
+  area_center_lat double precision,
+  area_center_lng double precision,
+  area_center extensions.geography(Point, 4326) generated always as
+    (extensions.st_setsrid(extensions.st_makepoint(area_center_lng, area_center_lat), 4326)::extensions.geography)
+    stored,
+  area_radius_m integer check (area_radius_m > 0),
+  area_filters jsonb,
+  area_place text,
+  shared boolean not null default false,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null,
+  deleted_at timestamptz,
+  rev bigint,
+  constraint hit_lists_area_shape check (
+    (kind = 'area' and area_center_lat is not null and area_center_lng is not null and area_radius_m is not null)
+    or (kind = 'manual' and area_center_lat is null and area_center_lng is null and area_radius_m is null
+        and area_filters is null and area_place is null)
+  )
+);
+create index hit_lists_owner_idx on public.hit_lists (owner_id);
+
+-- Manual lists only; area lists compute their spots (S2).
+create table public.hit_list_spots (
+  list_id uuid not null references public.hit_lists (id) on delete cascade,
+  spot_id uuid not null references public.spots (id) on delete cascade,
+  added_by uuid not null references public.profiles (id) on delete cascade,
+  added_at timestamptz not null default now(),
+  rev bigint,
+  primary key (list_id, spot_id)
+);
+create index hit_list_spots_spot_idx on public.hit_list_spots (spot_id);
+
+-- The owner is implicit (hit_lists.owner_id). status is D57 *default*: 'invited' until Join; only 'member' reads.
+create table public.hit_list_members (
+  list_id uuid not null references public.hit_lists (id) on delete cascade,
+  user_id uuid not null references public.profiles (id) on delete cascade,
+  role text not null default 'add' check (role in ('add', 'view')),
+  status text not null default 'invited' check (status in ('invited', 'member')),
+  invited_by uuid references public.profiles (id) on delete set null,
+  invited_at timestamptz not null default now(),
+  joined_at timestamptz,
+  rev bigint,
+  primary key (list_id, user_id)
+);
+create index hit_list_members_user_idx on public.hit_list_members (user_id, list_id);
+
+-- One row per pair, ordered.
+create table public.friendships (
+  id uuid primary key default gen_random_uuid(),
+  user_a uuid not null references public.profiles (id) on delete cascade,
+  user_b uuid not null references public.profiles (id) on delete cascade,
+  status text not null check (status in ('pending', 'accepted')),
+  requested_by uuid not null,
+  created_at timestamptz not null default now(),
+  constraint friendships_ordered check (user_a < user_b),
+  constraint friendships_pair_unique unique (user_a, user_b),
+  constraint friendships_requester check (requested_by in (user_a, user_b))
+);
+create index friendships_user_b_idx on public.friendships (user_b);
+
+create table public.blocks (
+  blocker uuid not null references public.profiles (id) on delete cascade,
+  blocked uuid not null references public.profiles (id) on delete cascade,
+  created_at timestamptz not null default now(),
+  primary key (blocker, blocked),
+  constraint blocks_not_self check (blocker <> blocked)
+);
+create index blocks_blocked_idx on public.blocks (blocked);
+
+-- A frozen copy of spots (D40). recipient NULL = a link-only send (S9).
+create table public.sends (
+  id uuid primary key,
+  sender uuid not null references public.profiles (id) on delete cascade,
+  recipient uuid references public.profiles (id) on delete cascade,
+  link_id uuid,
+  payload jsonb not null,
+  created_at timestamptz not null default now(),
+  withdrawn_at timestamptz,
+  saved_at timestamptz,
+  dismissed_at timestamptz
+);
+create index sends_sender_idx on public.sends (sender);
+create index sends_recipient_idx on public.sends (recipient);
+
+-- Only a token's SHA-256 is stored (D45); no direct access ever (no policies, S3-07).
+create table public.links (
+  id uuid primary key default gen_random_uuid(),
+  kind text not null check (kind in ('send', 'invite')),
+  token_sha256 text not null unique check (token_sha256 ~ '^[0-9a-f]{64}$'),
+  send_id uuid references public.sends (id) on delete cascade,
+  list_id uuid references public.hit_lists (id) on delete cascade,
+  role text check (role in ('add', 'view')),
+  created_by uuid not null references public.profiles (id) on delete cascade,
+  created_at timestamptz not null default now(),
+  expires_at timestamptz,
+  revoked_at timestamptz,
+  used_by uuid references public.profiles (id) on delete set null,
+  used_at timestamptz,
+  constraint links_target check (
+    (kind = 'send' and send_id is not null and list_id is null and role is null)
+    or (kind = 'invite' and list_id is not null and send_id is null and role is not null and expires_at is not null)
+  )
+);
+
+-- RLS on everywhere, no policies: deny all to anon and authenticated (the service role bypasses RLS).
+alter table public.profiles enable row level security;
+alter table public.spots enable row level security;
+alter table public.media enable row level security;
+alter table public.hit_lists enable row level security;
+alter table public.hit_list_spots enable row level security;
+alter table public.hit_list_members enable row level security;
+alter table public.friendships enable row level security;
+alter table public.blocks enable row level security;
+alter table public.sends enable row level security;
+alter table public.links enable row level security;
+
+-- Triggers ------------------------------------------------------------------------------------------------------------
+-- Same-event triggers fire in name order: t10 (stale guard) skips the row before t20 (rev) can bump it.
+
+-- rev: every write to a synced table takes the next number. security definer so no client role needs a grant on the
+-- sequence (a grant would also let it setval the cursor backwards).
+create function public.bump_rev()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  new.rev := nextval('public.sync_rev');
+  return new;
+end;
+$$;
+
+create trigger t20_rev before insert or update on public.profiles
+  for each row execute function public.bump_rev();
+create trigger t20_rev before insert or update on public.spots
+  for each row execute function public.bump_rev();
+create trigger t20_rev before insert or update on public.media
+  for each row execute function public.bump_rev();
+create trigger t20_rev before insert or update on public.hit_lists
+  for each row execute function public.bump_rev();
+create trigger t20_rev before insert or update on public.hit_list_spots
+  for each row execute function public.bump_rev();
+create trigger t20_rev before insert or update on public.hit_list_members
+  for each row execute function public.bump_rev();
+
+-- D48: an update older than the stored row is skipped (equal is applied), so a late push never overwrites newer data.
+create function public.skip_stale_update()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if new.updated_at < old.updated_at then
+    return null;
+  end if;
+  return new;
+end;
+$$;
+
+create trigger t10_stale_guard before update on public.spots
+  for each row execute function public.skip_stale_update();
+create trigger t10_stale_guard before update on public.media
+  for each row execute function public.skip_stale_update();
+create trigger t10_stale_guard before update on public.hit_lists
+  for each row execute function public.skip_stale_update();
+
+-- A profile for every new auth user; username stays NULL until onboarding (S4). security definer: the auth admin
+-- role inserts users.
+create function public.handle_new_user()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  insert into public.profiles (id) values (new.id);
+  return new;
+end;
+$$;
+
+create trigger on_auth_user_created after insert on auth.users
+  for each row execute function public.handle_new_user();
+
+-- Privileges ----------------------------------------------------------------------------------------------------------
+
+revoke all on sequence public.sync_rev from public, anon, authenticated, service_role;
+
+-- RLS does not cover TRUNCATE; the default covers tables later migrations add.
+revoke truncate on all tables in schema public from anon, authenticated;
+alter default privileges in schema public revoke truncate on tables from anon, authenticated;
+
+-- No client role executes a function in public unless its migration grants it (to authenticated, or service_role
+-- alone for preview_link). PUBLIC's EXECUTE is a global default (an in-schema revoke can't remove it), so it is
+-- revoked for every function postgres creates; extension functions belong to supabase_admin and keep theirs.
+alter default privileges revoke execute on functions from public;
+alter default privileges in schema public revoke execute on functions from anon, authenticated;
+revoke execute on all functions in schema public from public, anon, authenticated;
diff --git a/supabase/migrations/20261023020530_spots_rls.sql b/supabase/migrations/20261023020530_spots_rls.sql
new file mode 100644
index 0000000..85c67cd
--- /dev/null
+++ b/supabase/migrations/20261023020530_spots_rls.sql
@@ -0,0 +1,186 @@
+-- S3-03: who reads a spot and its photos, and who writes them (docs/plans/2026-10-22-s3-backend.md, "Functions" and
+-- "Row policies"). Readers: the owner; the owner and 'member's of a shared, live, manual list holding the spot; the
+-- 'member's of a shared, live, area list of the same owner whose circle and filters take the spot. Writes: the owner.
+-- Append new migrations; never edit this one.
+
+-- The area list's filters as the app applies them (selectAreaSpots → selectFilteredSpots): What's here is any-of,
+-- Skate stopped is exact when set, Natural speed is an inclusive range that keeps unrated spots. A key that is missing
+-- or of the wrong JSON type is no filter. Called only from can_read_spot (no client grant).
+create function public.spot_matches_filters(p_spot public.spots, p_filters jsonb)
+returns boolean
+language sql
+immutable
+set search_path = ''
+as $$
+  select case
+    when p_filters is null or jsonb_typeof(p_filters) <> 'object' then true
+    else
+      (case
+         -- nested, not `and`: SQL doesn't promise evaluation order and jsonb_array_length raises on a scalar
+         when jsonb_typeof(p_filters -> 'types') = 'array' then
+           case
+             when jsonb_array_length(p_filters -> 'types') > 0
+               then p_spot.feature_types && array(select jsonb_array_elements_text(p_filters -> 'types'))
+             else true
+           end
+         else true
+       end)
+      and (case
+             when jsonb_typeof(p_filters -> 'stopped') = 'boolean'
+               then p_spot.stopped = (p_filters ->> 'stopped')::boolean
+             else true
+           end)
+      and (case
+             when p_spot.natural_speed is null then true
+             else
+               (case
+                  when jsonb_typeof(p_filters -> 'natural_speed_min') = 'number'
+                    then p_spot.natural_speed >= (p_filters ->> 'natural_speed_min')::numeric
+                  else true
+                end)
+               and (case
+                      when jsonb_typeof(p_filters -> 'natural_speed_max') = 'number'
+                        then p_spot.natural_speed <= (p_filters ->> 'natural_speed_max')::numeric
+                      else true
+                    end)
+           end)
+  end;
+$$;
+
+-- Whether p_uid may read the spot. security definer so the policies can look at lists and members without their own
+-- policies applying (no RLS recursion). Any caller with a JWT may only ask about themselves (only the service role,
+-- or a direct connection with no JWT, may pass another uid). Evaluated per query, so a removed member loses read on
+-- the next one. The owner reads their spot deleted or not; nobody else reads a deleted one.
+-- Manual list: the row must have been added by the spot's owner, who must still be the list's owner or a 'member'
+-- (so a bad hit_list_spots row, or one left behind by a member who left, grants nothing).
+-- Area list: same owner as the spot; never an unlocated (0, 0) spot (D53); the circle on the sphere, like the app's
+-- haversine (use_spheroid false: PostGIS's sphere is R 6370986 m, the app's 6371 km; the spheroid differs by ~0.3%).
+create function public.can_read_spot(p_spot_id uuid, p_uid uuid default auth.uid())
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select case
+    when p_uid is null then false
+    when p_uid is distinct from auth.uid() and auth.jwt() is not null and coalesce(auth.role(), '') <> 'service_role'
+      then false
+    else exists (
+      select 1
+      from public.spots s
+      where s.id = p_spot_id
+        and (
+          s.owner_id = p_uid
+          or (
+            s.deleted_at is null
+            and (
+              exists (
+                select 1
+                from public.hit_list_spots hs
+                join public.hit_lists l on l.id = hs.list_id
+                where hs.spot_id = s.id
+                  and hs.added_by = s.owner_id
+                  and l.kind = 'manual'
+                  and l.shared
+                  and l.deleted_at is null
+                  and (
+                    l.owner_id = s.owner_id
+                    or exists (
+                      select 1 from public.hit_list_members m
+                      where m.list_id = l.id and m.user_id = s.owner_id and m.status = 'member'
+                    )
+                  )
+                  and (
+                    l.owner_id = p_uid
+                    or exists (
+                      select 1 from public.hit_list_members m
+                      where m.list_id = l.id and m.user_id = p_uid and m.status = 'member'
+                    )
+                  )
+              )
+              or (
+                not (s.lat = 0 and s.lng = 0)
+                and exists (
+                  select 1
+                  from public.hit_list_members m
+                  join public.hit_lists l on l.id = m.list_id
+                  where m.user_id = p_uid
+                    and m.status = 'member'
+                    and l.owner_id = s.owner_id
+                    and l.kind = 'area'
+                    and l.shared
+                    and l.deleted_at is null
+                    and extensions.st_dwithin(s.geog, l.area_center, l.area_radius_m, false)
+                    and public.spot_matches_filters(s, l.area_filters)
+                )
+              )
+            )
+          )
+        )
+    )
+  end;
+$$;
+
+grant execute on function public.can_read_spot(uuid, uuid) to authenticated;
+
+-- spots: no DELETE policy (a delete is a soft delete, an UPDATE; account deletion runs as the service role).
+create policy spots_select on public.spots for select to authenticated
+  using (owner_id = (select auth.uid()) or public.can_read_spot(id));
+create policy spots_insert on public.spots for insert to authenticated
+  with check (owner_id = (select auth.uid()));
+create policy spots_update on public.spots for update to authenticated
+  using (owner_id = (select auth.uid()))
+  with check (owner_id = (select auth.uid()));
+
+-- media: readable with its spot, a deleted photo by its owner only; written by the owner, on their own spot. The
+-- owner test comes first so the owner's own rows skip can_read_spot.
+create policy media_select on public.media for select to authenticated
+  using (owner_id = (select auth.uid()) or (deleted_at is null and public.can_read_spot(spot_id)));
+create policy media_insert on public.media for insert to authenticated
+  with check (
+    owner_id = (select auth.uid())
+    and exists (select 1 from public.spots s where s.id = spot_id and s.owner_id = (select auth.uid()))
+  );
+create policy media_update on public.media for update to authenticated
+  using (owner_id = (select auth.uid()))
+  with check (
+    owner_id = (select auth.uid())
+    and exists (select 1 from public.spots s where s.id = spot_id and s.owner_id = (select auth.uid()))
+  );
+
+-- A row's identity never changes: a spot keeps its id, owner and created_at; a photo its id, spot, owner and
+-- created_at (no moving a photo, no re-keying a spot under the sync engine). An upsert that sets them to the same
+-- values passes. Runs before the stale guard (t10) and rev (t20).
+create function public.keep_spot_identity()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if new.id is distinct from old.id or new.owner_id is distinct from old.owner_id
+     or new.created_at is distinct from old.created_at then
+    raise exception 'spot id, owner_id and created_at are fixed' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create function public.keep_media_identity()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if new.id is distinct from old.id or new.spot_id is distinct from old.spot_id
+     or new.owner_id is distinct from old.owner_id or new.created_at is distinct from old.created_at then
+    raise exception 'media id, spot_id, owner_id and created_at are fixed' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create trigger t05_keep_identity before update on public.spots
+  for each row execute function public.keep_spot_identity();
+create trigger t05_keep_identity before update on public.media
+  for each row execute function public.keep_media_identity();
diff --git a/supabase/migrations/20261023021848_lists_rls.sql b/supabase/migrations/20261023021848_lists_rls.sql
new file mode 100644
index 0000000..d31627c
--- /dev/null
+++ b/supabase/migrations/20261023021848_lists_rls.sql
@@ -0,0 +1,373 @@
+-- S3-04: who reads and writes a hit list, its spots and its members (docs/plans/2026-10-22-s3-backend.md, "Functions"
+-- and "Row policies"; D42 roles, D43 a member's spots leave with them, D50 blocks, D57 invitations). The owner does
+-- everything; a 'member' with role 'add' adds and removes their own spots; a 'view' member reads; an 'invited' user
+-- sees the list's name and owner and their own row until Join. Append new migrations; never edit this one.
+
+-- Helpers for the policies. security definer so a policy on one of the three tables can look at the others without
+-- their policies applying (no RLS recursion). They answer for auth.uid() only, so nobody can probe another user.
+
+create function public.is_list_owner(p_list uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (select 1 from public.hit_lists l where l.id = p_list and l.owner_id = auth.uid());
+$$;
+
+-- A joined member ('invited' is not a member, D57), of the given role when one is given.
+create function public.is_list_member(p_list uuid, p_role text default null)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.hit_list_members m
+    where m.list_id = p_list and m.user_id = auth.uid() and m.status = 'member'
+      and (p_role is null or m.role = p_role)
+  );
+$$;
+
+create function public.is_list_invitee(p_list uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.hit_list_members m
+    where m.list_id = p_list and m.user_id = auth.uid() and m.status = 'invited'
+  );
+$$;
+
+-- Whether the caller may put a spot row in the list: a live manual list (area lists compute their spots, S2) that
+-- they own, or that is shared and they joined with role 'add' (D42). Spot ownership is checked by the policy.
+create function public.can_add_to_list(p_list uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.hit_lists l
+    where l.id = p_list
+      and l.kind = 'manual'
+      and l.deleted_at is null
+      and (
+        l.owner_id = auth.uid()
+        or (
+          l.shared
+          and exists (
+            select 1 from public.hit_list_members m
+            where m.list_id = l.id and m.user_id = auth.uid() and m.status = 'member' and m.role = 'add'
+          )
+        )
+      )
+  );
+$$;
+
+-- Whether the caller may invite p_user: the caller owns the live, shared list; p_user is someone else, an accepted
+-- friend (§1: friends are who you share with), and neither has blocked the other (D50). Links are S3-07's path.
+create function public.can_invite_to_list(p_list uuid, p_user uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select p_user is distinct from auth.uid()
+    and exists (
+      select 1 from public.hit_lists l
+      where l.id = p_list and l.owner_id = auth.uid() and l.shared and l.deleted_at is null
+    )
+    and exists (
+      select 1 from public.friendships f
+      where f.user_a = least(auth.uid(), p_user) and f.user_b = greatest(auth.uid(), p_user)
+        and f.status = 'accepted'
+    )
+    and not exists (
+      select 1 from public.blocks b
+      where (b.blocker = p_user and b.blocked = auth.uid()) or (b.blocker = auth.uid() and b.blocked = p_user)
+    );
+$$;
+
+-- Whether the caller reads the list's spot rows: the owner always; a 'member' while the list is shared and live (a
+-- deleted list's rows say nothing a member needs).
+create function public.can_read_list_spots(p_list uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.hit_lists l
+    where l.id = p_list
+      and (
+        l.owner_id = auth.uid()
+        or (
+          l.shared
+          and l.deleted_at is null
+          and exists (
+            select 1 from public.hit_list_members m
+            where m.list_id = l.id and m.user_id = auth.uid() and m.status = 'member'
+          )
+        )
+      )
+  );
+$$;
+
+grant execute on function public.is_list_owner(uuid), public.is_list_member(uuid, text),
+  public.is_list_invitee(uuid), public.can_add_to_list(uuid), public.can_invite_to_list(uuid, uuid),
+  public.can_read_list_spots(uuid)
+  to authenticated;
+
+-- hit_lists: no DELETE policy (a delete is a soft delete, an UPDATE). Only the owner writes; members and invitees
+-- read the row (an invitee sees the name and owner, and the row's other columns such as an area's circle; the spot
+-- rows need 'member', so no count leaks).
+create policy hit_lists_select on public.hit_lists for select to authenticated
+  using (owner_id = (select auth.uid()) or public.is_list_member(id) or public.is_list_invitee(id));
+create policy hit_lists_insert on public.hit_lists for insert to authenticated
+  with check (owner_id = (select auth.uid()));
+create policy hit_lists_update on public.hit_lists for update to authenticated
+  using (owner_id = (select auth.uid()))
+  with check (owner_id = (select auth.uid()));
+
+-- A list's identity never changes: can_read_spot's area branch trusts owner_id, and kind decides whether spot rows
+-- or a circle grant read (S3-03 review). Runs before the stale guard (t10) and rev (t20).
+create function public.keep_list_identity()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if new.id is distinct from old.id or new.owner_id is distinct from old.owner_id
+     or new.kind is distinct from old.kind or new.created_at is distinct from old.created_at then
+    raise exception 'hit list id, owner_id, kind and created_at are fixed' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create trigger t05_keep_identity before update on public.hit_lists
+  for each row execute function public.keep_list_identity();
+
+-- Turning sharing off, by stop_sharing or by a plain UPDATE (a sync push), drops every member and invitee (their
+-- spots go with them, D43) and every spot row the owner didn't add, so turning it on again restores nobody.
+create function public.drop_list_sharing()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  delete from public.hit_list_members m where m.list_id = new.id;
+  delete from public.hit_list_spots s where s.list_id = new.id and s.added_by <> new.owner_id;
+  return null;
+end;
+$$;
+
+create trigger t30_unshare after update of shared on public.hit_lists
+  for each row when (old.shared and not new.shared) execute function public.drop_list_sharing();
+
+-- hit_list_spots: read by the owner and members; added only by its writer, for a spot the writer owns, everyone the
+-- owner included (otherwise anyone could expose another rider's spot through their own shared list, §3.3); removed
+-- by whoever added it or by the list owner (D42). No UPDATE.
+create policy hit_list_spots_select on public.hit_list_spots for select to authenticated
+  using (public.can_read_list_spots(list_id));
+create policy hit_list_spots_insert on public.hit_list_spots for insert to authenticated
+  with check (
+    added_by = (select auth.uid())
+    and exists (select 1 from public.spots s where s.id = spot_id and s.owner_id = (select auth.uid()))
+    and public.can_add_to_list(list_id)
+  );
+create policy hit_list_spots_delete on public.hit_list_spots for delete to authenticated
+  using (added_by = (select auth.uid()) or public.is_list_owner(list_id));
+
+-- A member's add locks their membership row (FOR SHARE) until the add commits, so a concurrent Leave, Remove or Stop
+-- sharing waits for it and its D43 delete then sees the new row (no row outlives its adder's membership). The
+-- policy has already checked the role; this re-checks it under the lock.
+create function public.lock_adder_membership()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if current_user not in ('authenticated', 'anon') or public.is_list_owner(new.list_id) then
+    return new;
+  end if;
+  perform 1 from public.hit_list_members m
+  where m.list_id = new.list_id and m.user_id = new.added_by and m.status = 'member' and m.role = 'add'
+  for share;
+  if not found then
+    raise exception 'not a member who can add to this list' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create trigger t10_lock_membership before insert on public.hit_list_spots
+  for each row execute function public.lock_adder_membership();
+
+-- hit_list_members: the owner sees every row, a member sees the member strip, an invitee only their own row. The
+-- owner invites (an 'invited' row, D57); the owner changes roles; the row's user joins; the owner or the row's user
+-- deletes it (Remove, Decline, Leave).
+create policy hit_list_members_select on public.hit_list_members for select to authenticated
+  using (public.is_list_owner(list_id) or user_id = (select auth.uid()) or public.is_list_member(list_id));
+create policy hit_list_members_insert on public.hit_list_members for insert to authenticated
+  with check (
+    status = 'invited'
+    and joined_at is null
+    and invited_by = (select auth.uid())
+    and public.can_invite_to_list(list_id, user_id)
+  );
+create policy hit_list_members_update on public.hit_list_members for update to authenticated
+  using (public.is_list_owner(list_id) or user_id = (select auth.uid()))
+  with check (public.is_list_owner(list_id) or user_id = (select auth.uid()));
+create policy hit_list_members_delete on public.hit_list_members for delete to authenticated
+  using (public.is_list_owner(list_id) or user_id = (select auth.uid()));
+
+-- What a client may change in a membership: the owner the role; the row's user only 'invited' → 'member' (Join,
+-- which stamps joined_at). Nobody re-points a row. The security-definer functions (current_user is their owner) and
+-- the service role are not limited here.
+create function public.guard_member_update()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if current_user not in ('authenticated', 'anon') then
+    return new;
+  end if;
+  if new.list_id is distinct from old.list_id or new.user_id is distinct from old.user_id
+     or new.invited_by is distinct from old.invited_by or new.invited_at is distinct from old.invited_at then
+    raise exception 'a membership''s list, user and invitation are fixed' using errcode = '42501';
+  end if;
+  if public.is_list_owner(old.list_id) then
+    if new.status is distinct from old.status or new.joined_at is distinct from old.joined_at then
+      raise exception 'the owner changes only a member''s role' using errcode = '42501';
+    end if;
+  elsif old.user_id = auth.uid() then
+    if new.role is distinct from old.role then
+      raise exception 'only the owner changes a role' using errcode = '42501';
+    end if;
+    if new.status is distinct from old.status then
+      if old.status = 'invited' and new.status = 'member' then
+        if not exists (select 1 from public.hit_lists l
+                       where l.id = old.list_id and l.shared and l.deleted_at is null) then
+          raise exception 'this list is not shared any more' using errcode = '42501';
+        end if;
+        new.joined_at := now();
+      else
+        raise exception 'a member can only join' using errcode = '42501';
+      end if;
+    elsif new.joined_at is distinct from old.joined_at then
+      raise exception 'joined_at is set by Join' using errcode = '42501';
+    end if;
+  else
+    raise exception 'not the list owner' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create trigger t10_member_guard before update on public.hit_list_members
+  for each row execute function public.guard_member_update();
+
+-- D43 in one place: whenever a membership row goes (Leave, Remove, Decline, Stop sharing, a direct DELETE, a deleted
+-- account), the spots that member added leave the list with them. The spots themselves stay theirs. On Join it
+-- also clears any row left from an earlier membership, so rejoining never brings old spots back.
+create function public.remove_member_spots()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  delete from public.hit_list_spots where list_id = old.list_id and added_by = old.user_id;
+  return null;
+end;
+$$;
+
+create trigger t30_member_spots_leave after delete on public.hit_list_members
+  for each row execute function public.remove_member_spots();
+create trigger t30_member_spots_join after update of status on public.hit_list_members
+  for each row when (old.status = 'invited' and new.status = 'member') execute function public.remove_member_spots();
+
+-- Functions --------------------------------------------------------------------------------------------------------
+
+-- A member or invitee leaves (or declines); their spots leave with them (the trigger). The owner can't leave: they
+-- stop sharing or delete the list.
+create function public.leave_list(p_list uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if exists (select 1 from public.hit_lists l where l.id = p_list and l.owner_id = v_uid) then
+    raise exception 'the owner cannot leave their own list' using errcode = '42501';
+  end if;
+  delete from public.hit_list_members m where m.list_id = p_list and m.user_id = v_uid;
+  if not found then
+    raise exception 'not a member of this list' using errcode = '42501';
+  end if;
+end;
+$$;
+
+-- The owner removes a member or withdraws an invitation; the member's spots leave with them (the trigger).
+create function public.remove_member(p_list uuid, p_user uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if not exists (select 1 from public.hit_lists l where l.id = p_list and l.owner_id = v_uid) then
+    raise exception 'not the list owner' using errcode = '42501';
+  end if;
+  delete from public.hit_list_members m where m.list_id = p_list and m.user_id = p_user;
+  if not found then
+    raise exception 'not a member of this list' using errcode = '42501';
+  end if;
+end;
+$$;
+
+-- The owner stops sharing: the list is private again; t30_unshare drops every member and invitee and every spot row
+-- not added by the owner (D43; members lose read on their next query). updated_at never moves backwards (D48 guard).
+create function public.stop_sharing(p_list uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if not exists (select 1 from public.hit_lists l where l.id = p_list and l.owner_id = v_uid) then
+    raise exception 'not the list owner' using errcode = '42501';
+  end if;
+  update public.hit_lists set shared = false, updated_at = greatest(updated_at, now()) where id = p_list;
+end;
+$$;
+
+grant execute on function public.leave_list(uuid), public.remove_member(uuid, uuid), public.stop_sharing(uuid)
+  to authenticated;
diff --git a/supabase/migrations/20261023025214_friends_rls.sql b/supabase/migrations/20261023025214_friends_rls.sql
new file mode 100644
index 0000000..87f432f
--- /dev/null
+++ b/supabase/migrations/20261023025214_friends_rls.sql
@@ -0,0 +1,294 @@
+-- S3-05: who reads a profile, and friend requests and blocks (docs/plans/2026-10-22-s3-backend.md, "Functions" and
+-- "Row policies"; D39 exact usernames, D50 blocking). A profile is read by its user, their friends, either side of a
+-- pending request (the Inbox shows who asked) and co-members of a shared list; anyone else gets only find_profile.
+-- Requests and blocks are written only through the functions below. Append new migrations; never edit this one.
+
+-- Whether the caller reads p_id's profile: themselves; an accepted friend; someone who asked them (the Inbox shows who
+-- asked; the asker doesn't read the target's row, which would follow it through a rename: find_profile is their way);
+-- or a live shared list both are in: both joined members, or the owner and a member or invitee.
+-- security definer so the profiles policy can look at the list tables without their policies applying.
+create function public.can_read_profile(p_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select coalesce(
+    p_id = auth.uid()
+    or exists (
+      select 1 from public.friendships f
+      where f.user_a = least(auth.uid(), p_id) and f.user_b = greatest(auth.uid(), p_id)
+        and (f.status = 'accepted' or f.requested_by = p_id)
+    )
+    or exists (
+      select 1
+      from public.hit_list_members a
+      join public.hit_list_members b on b.list_id = a.list_id
+      join public.hit_lists l on l.id = a.list_id
+      where a.user_id = auth.uid() and b.user_id = p_id and a.status = 'member' and b.status = 'member'
+        and l.shared and l.deleted_at is null
+    )
+    or exists (
+      select 1
+      from public.hit_lists l
+      join public.hit_list_members m on m.list_id = l.id
+      where l.shared and l.deleted_at is null
+        and ((l.owner_id = auth.uid() and m.user_id = p_id) or (l.owner_id = p_id and m.user_id = auth.uid()))
+    ),
+    false
+  );
+$$;
+
+-- One transaction at a time per pair of users, so a request, a block and a new list membership between the same two
+-- never interleave (two crossed requests would both insert; a request or an invitation could slip in behind a
+-- block). Each caller re-reads blocks after taking it: a plpgsql statement in a volatile function sees what committed
+-- before it started.
+create function public.lock_user_pair(p_a uuid, p_b uuid)
+returns void
+language sql
+security definer
+set search_path = ''
+as $$
+  select pg_advisory_xact_lock(hashtextextended(least(p_a, p_b)::text || greatest(p_a, p_b)::text, 5));
+$$;
+
+-- Exact, case-insensitive username lookup (D39: no search, no enumerating riders). No row for an unknown name, a
+-- NULL name (not onboarded yet) or a target who blocked the caller; the three are indistinguishable. citext's '='
+-- lives in the extensions schema, which is off this function's search_path, so it is named explicitly (a bare '='
+-- would compare as text, case-sensitively).
+create function public.find_profile(p_username text)
+returns table (id uuid, username extensions.citext, display_name text)
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  return query
+    select p.id, p.username, p.display_name
+    from public.profiles p
+    where p.username operator(extensions.=) p_username::extensions.citext
+      and not exists (select 1 from public.blocks b where b.blocker = p.id and b.blocked = v_uid);
+end;
+$$;
+
+-- A friend request by exact username. The pair is stored once, ordered (user_a < user_b). Asking again returns the
+-- same row; asking someone who already asked you accepts their request. 'user not found' for an unknown name or a
+-- target who blocked the caller (same error, D50); a caller must unblock before asking.
+create function public.send_friend_request(p_username text)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_other uuid;
+  v_row public.friendships;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  select p.id into v_other from public.profiles p
+  where p.username operator(extensions.=) p_username::extensions.citext;
+  if v_other = v_uid then
+    raise exception 'you cannot add yourself' using errcode = '22023';
+  end if;
+  if v_other is not null then
+    perform public.lock_user_pair(v_uid, v_other);
+  end if;
+  if v_other is null
+     or exists (select 1 from public.blocks b where b.blocker = v_other and b.blocked = v_uid) then
+    raise exception 'user not found' using errcode = 'P0002';
+  end if;
+  if exists (select 1 from public.blocks b where b.blocker = v_uid and b.blocked = v_other) then
+    raise exception 'unblock this user first' using errcode = '42501';
+  end if;
+
+  select * into v_row from public.friendships f
+  where f.user_a = least(v_uid, v_other) and f.user_b = greatest(v_uid, v_other);
+  if not found then
+    insert into public.friendships (user_a, user_b, status, requested_by)
+    values (least(v_uid, v_other), greatest(v_uid, v_other), 'pending', v_uid)
+    returning * into v_row;
+  elsif v_row.status = 'pending' and v_row.requested_by <> v_uid then
+    update public.friendships set status = 'accepted' where id = v_row.id;
+  end if;
+  return v_row.id;
+end;
+$$;
+
+-- The person asked accepts (the row becomes a friendship) or declines (the row goes). Nobody else answers, and a
+-- friendship is not answered twice.
+create function public.respond_friend_request(p_id uuid, p_action text)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_row public.friendships;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if p_action is null or p_action not in ('accept', 'decline') then
+    raise exception 'action must be accept or decline' using errcode = '22023';
+  end if;
+  select * into v_row from public.friendships f where f.id = p_id for update;
+  if not found or v_uid not in (v_row.user_a, v_row.user_b) or v_row.requested_by = v_uid
+     or v_row.status <> 'pending' then
+    raise exception 'no friend request to answer' using errcode = '42501';
+  end if;
+  if p_action = 'accept' then
+    update public.friendships set status = 'accepted' where id = p_id;
+  else
+    delete from public.friendships where id = p_id;
+  end if;
+end;
+$$;
+
+-- D50: the block row, and the friendship (or either side's pending request) go; t30_withdraw_invitations (below) takes
+-- any pending invitation to a list between the two with it. They aren't told. Shared lists both are in stay as they are; their pending sends are hidden by
+-- the sends policy (S3-06), and find_profile, send_friend_request and invitations check blocks from now on.
+create function public.block_user(p_user uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if p_user = v_uid then
+    raise exception 'you cannot block yourself' using errcode = '22023';
+  end if;
+  if p_user is null or not exists (select 1 from public.profiles p where p.id = p_user) then
+    raise exception 'user not found' using errcode = 'P0002';
+  end if;
+  perform public.lock_user_pair(v_uid, p_user);
+  insert into public.blocks (blocker, blocked) values (v_uid, p_user) on conflict do nothing;
+  delete from public.friendships f where f.user_a = least(v_uid, p_user) and f.user_b = greatest(v_uid, p_user);
+end;
+$$;
+
+-- Lifting a block restores nothing (no friendship comes back); asking again is a new request.
+create function public.unblock_user(p_user uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  delete from public.blocks b where b.blocker = v_uid and b.blocked = p_user;
+end;
+$$;
+
+grant execute on function public.can_read_profile(uuid), public.find_profile(text),
+  public.send_friend_request(text), public.respond_friend_request(uuid, text), public.block_user(uuid),
+  public.unblock_user(uuid)
+  to authenticated;
+
+-- profiles: the signup trigger inserts the row and the account's deletion removes it (S4, service role); the user
+-- edits their username and display name. A profile's id and created_at never change.
+create policy profiles_select on public.profiles for select to authenticated
+  using (id = (select auth.uid()) or public.can_read_profile(id));
+create policy profiles_update on public.profiles for update to authenticated
+  using (id = (select auth.uid()))
+  with check (id = (select auth.uid()));
+
+create function public.keep_profile_identity()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if new.id is distinct from old.id or new.created_at is distinct from old.created_at then
+    raise exception 'profile id and created_at are fixed' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create trigger t05_keep_identity before update on public.profiles
+  for each row execute function public.keep_profile_identity();
+
+-- friendships: either side reads the row and removes it (Remove friend, or withdrawing a request); requests and
+-- answers go through send_friend_request and respond_friend_request.
+create policy friendships_select on public.friendships for select to authenticated
+  using ((select auth.uid()) in (user_a, user_b));
+create policy friendships_delete on public.friendships for delete to authenticated
+  using ((select auth.uid()) in (user_a, user_b));
+
+-- blocks: only the blocker sees or lifts a block (the blocked user can't tell); block_user inserts.
+create policy blocks_select on public.blocks for select to authenticated
+  using (blocker = (select auth.uid()));
+create policy blocks_delete on public.blocks for delete to authenticated
+  using (blocker = (select auth.uid()));
+
+-- D58 *default*: a display name is at most 50 characters (it is shown to friends, co-members and find_profile).
+alter table public.profiles add constraint profiles_display_name_length check (char_length(display_name) <= 50);
+
+-- D50: no new membership between a blocked pair, whichever path adds it (an owner's invite, S3-07's redeem_invite, the
+-- service role). The invite policy checked blocks in its own snapshot; this takes the pair lock block_user takes and
+-- reads blocks again, so an invitation racing a block either commits first (and block_user deletes it) or fails.
+create function public.guard_invite_block()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_owner uuid;
+begin
+  select l.owner_id into v_owner from public.hit_lists l where l.id = new.list_id;
+  if v_owner is null or v_owner = new.user_id then
+    return new;
+  end if;
+  perform public.lock_user_pair(v_owner, new.user_id);
+  if exists (select 1 from public.blocks b
+             where (b.blocker = v_owner and b.blocked = new.user_id)
+                or (b.blocker = new.user_id and b.blocked = v_owner)) then
+    raise exception 'blocked users cannot be added to each other''s lists' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create trigger t05_block_guard before insert on public.hit_list_members
+  for each row execute function public.guard_invite_block();
+
+-- An invitation needs a friendship (can_invite_to_list), so when the friendship goes (Remove friend, a block) the
+-- pending invitations between the two go with it. Joined members stay (D50: shared lists stay as they are).
+create function public.withdraw_pair_invitations()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  delete from public.hit_list_members m
+  using public.hit_lists l
+  where m.list_id = l.id and m.status = 'invited'
+    and ((l.owner_id = old.user_a and m.user_id = old.user_b) or (l.owner_id = old.user_b and m.user_id = old.user_a));
+  return null;
+end;
+$$;
+
+create trigger t30_withdraw_invitations after delete on public.friendships
+  for each row execute function public.withdraw_pair_invitations();
diff --git a/supabase/migrations/20261023031134_sends_storage.sql b/supabase/migrations/20261023031134_sends_storage.sql
new file mode 100644
index 0000000..648669e
--- /dev/null
+++ b/supabase/migrations/20261023031134_sends_storage.sql
@@ -0,0 +1,265 @@
+-- S3-06: sends and the private photos bucket (docs/plans/2026-10-22-s3-backend.md, "Functions", "Row policies" and
+-- "Storage"; D40 a send is a frozen copy, D50 blocking). A send is read by its sender and, while it is not withdrawn
+-- and they haven't blocked the sender, its recipient; it is written only through the four functions below. A photo
+-- object is read by whoever reads its spot or its send, and written only under the writer's own spot or send.
+-- Append new migrations; never edit this one.
+
+-- Sends ---------------------------------------------------------------------------------------------------------------
+
+-- Whether the caller reads send p_send: its sender (withdrawn or not), or its recipient while the send is not
+-- withdrawn and the recipient hasn't blocked the sender (D50 hides a blocked user's sends). The one rule for the sends
+-- policy, send photos in storage, and Save / Dismiss.
+create function public.can_read_send(p_send uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select coalesce((
+    select s.sender = auth.uid()
+      or (s.recipient = auth.uid() and s.withdrawn_at is null
+          and not exists (select 1 from public.blocks b where b.blocker = s.recipient and b.blocked = s.sender))
+    from public.sends s
+    where s.id = p_send
+  ), false);
+$$;
+
+-- A send of a frozen payload (D40, a JSON object of at most 1 MB) with the client's id. A recipient must be an accepted friend (§1: friends are who
+-- you Send to) with no block either way; not a friend and blocked raise the same error (D50: they aren't told).
+-- p_recipient NULL = a link-only send (S9). The pair lock (block_user takes it too) orders a send racing a block: it
+-- commits first and the block hides it, or it waits and sees the block. Reusing an existing id raises (23505).
+create function public.create_send(p_id uuid, p_recipient uuid, p_payload jsonb)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if p_id is null or p_payload is null or jsonb_typeof(p_payload) <> 'object'
+     or octet_length(p_payload::text) > 1048576 then
+    raise exception 'a send needs an id and a payload object of at most 1 MB' using errcode = '22023';
+  end if;
+  if p_recipient = v_uid then
+    raise exception 'you cannot send to yourself' using errcode = '22023';
+  end if;
+  if p_recipient is not null then
+    perform public.lock_user_pair(v_uid, p_recipient);
+    if not exists (select 1 from public.friendships f
+                   where f.user_a = least(v_uid, p_recipient) and f.user_b = greatest(v_uid, p_recipient)
+                     and f.status = 'accepted')
+       or exists (select 1 from public.blocks b
+                  where (b.blocker = v_uid and b.blocked = p_recipient)
+                     or (b.blocker = p_recipient and b.blocked = v_uid)) then
+      raise exception 'you can only send to friends' using errcode = '42501';
+    end if;
+  end if;
+  insert into public.sends (id, sender, recipient, payload) values (p_id, v_uid, p_recipient, p_payload);
+  return p_id;
+end;
+$$;
+
+-- The sender takes a send back until the recipient saves it (D40: a saved send is the recipient's copy). Withdrawing
+-- twice keeps the first time. Anyone but the sender, or an unknown id, gets the same 'no such send'.
+create function public.withdraw_send(p_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_row public.sends;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  select * into v_row from public.sends s where s.id = p_id for update;
+  if not found or v_row.sender <> v_uid then
+    raise exception 'no such send' using errcode = '42501';
+  end if;
+  if v_row.saved_at is not null then
+    raise exception 'this send was saved: it is their copy now' using errcode = '55000';
+  end if;
+  if v_row.withdrawn_at is null then
+    update public.sends set withdrawn_at = now() where id = p_id;
+  end if;
+end;
+$$;
+
+-- The recipient's Save and Dismiss: only a send they can read (not withdrawn, sender not blocked). The row lock orders
+-- Save against withdraw_send, so a send is never both saved and withdrawn.
+create function public.mark_send_saved(p_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_row public.sends;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  select * into v_row from public.sends s where s.id = p_id for update;
+  if not found or v_row.recipient is distinct from v_uid or not public.can_read_send(p_id) then
+    raise exception 'no such send' using errcode = '42501';
+  end if;
+  update public.sends set saved_at = coalesce(saved_at, now()) where id = p_id;
+end;
+$$;
+
+create function public.dismiss_send(p_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_row public.sends;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  select * into v_row from public.sends s where s.id = p_id for update;
+  if not found or v_row.recipient is distinct from v_uid or not public.can_read_send(p_id) then
+    raise exception 'no such send' using errcode = '42501';
+  end if;
+  update public.sends set dismissed_at = coalesce(dismissed_at, now()) where id = p_id;
+end;
+$$;
+
+grant execute on function public.can_read_send(uuid), public.create_send(uuid, uuid, jsonb),
+  public.withdraw_send(uuid), public.mark_send_saved(uuid), public.dismiss_send(uuid)
+  to authenticated;
+
+-- sends: read per can_read_send (the sender/recipient test first, so the indexes on sender and recipient serve a
+-- pull); no INSERT, UPDATE or DELETE policy, so the recipient can't change a payload and nobody rewrites a send.
+create policy sends_select on public.sends for select to authenticated
+  using ((sender = (select auth.uid()) or recipient = (select auth.uid())) and public.can_read_send(id));
+
+-- Storage -------------------------------------------------------------------------------------------------------------
+
+-- One private bucket (D45: a link preview gets short-lived signed URLs, never public ones). JPEG only, as D46
+-- re-encodes every upload (long edge ≤ 2048 px); 10 MB is far above such a file. A bucket made earlier (say, in a
+-- dashboard) is set to the same, never left public.
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values ('photos', 'photos', false, 10485760, array['image/jpeg'])
+on conflict (id) do update
+  set public = false, file_size_limit = excluded.file_size_limit, allowed_mime_types = excluded.allowed_mime_types;
+
+-- NULL instead of an error for text that is not a uuid.
+create function public.try_uuid(p_text text)
+returns uuid
+language plpgsql
+immutable
+set search_path = ''
+as $$
+begin
+  return p_text::uuid;
+exception when invalid_text_representation then
+  return null;
+end;
+$$;
+
+-- A photo path is exactly '<owner uuid>/<spot uuid>/<media uuid>.jpg' or 'sends/<send uuid>/<media uuid>.jpg', in
+-- lowercase as uuid::text and the app's ids (expo-crypto lowercases) print them; anything else is refused.
+create function public.photo_path_ok(p_name text)
+returns boolean
+language sql
+immutable
+set search_path = ''
+as $$
+  select coalesce(
+    p_name ~ '^(sends|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.jpg$',
+    false
+  );
+$$;
+
+-- Whether the caller reads a photo object. A send's photo: whoever reads the send. A spot's photo: the owner reads
+-- everything under their own prefix (a photo uploads before its media row, S5); anyone else needs the prefix to be
+-- the spot's owner, a live media row for that photo on that spot (a removed photo is gone for members, as in
+-- media_select), and can_read_spot, evaluated on every query, so a removed member's next read is empty.
+create function public.can_read_photo(p_name text)
+returns boolean
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_spot uuid;
+begin
+  if v_uid is null or not public.photo_path_ok(p_name) then
+    return false;
+  end if;
+  v_spot := public.try_uuid(split_part(p_name, '/', 2));
+  if split_part(p_name, '/', 1) = 'sends' then
+    return public.can_read_send(v_spot);
+  end if;
+  if public.try_uuid(split_part(p_name, '/', 1)) = v_uid then
+    return true;
+  end if;
+  return exists (
+      select 1
+      from public.spots s
+      join public.media m on m.spot_id = s.id
+      where s.id = v_spot
+        and s.owner_id = public.try_uuid(split_part(p_name, '/', 1))
+        and m.id = public.try_uuid(left(split_part(p_name, '/', 3), -4))
+        and m.deleted_at is null
+    )
+    and public.can_read_spot(v_spot);
+end;
+$$;
+
+-- Whether the caller may p_op ('insert' | 'update' | 'delete') a photo object: anything under their own prefix for a
+-- spot they own. A send's photos are the sender's and write-once (D40: the recipient keeps what they were sent): a new
+-- one only while the send is neither withdrawn nor saved, never an overwrite or a move, and a delete until it is
+-- saved (a withdrawn send's photos can go).
+create function public.can_write_photo(p_name text, p_op text)
+returns boolean
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_target uuid;
+begin
+  if v_uid is null or not public.photo_path_ok(p_name) then
+    return false;
+  end if;
+  v_target := public.try_uuid(split_part(p_name, '/', 2));
+  if split_part(p_name, '/', 1) = 'sends' then
+    return exists (select 1 from public.sends s
+                   where s.id = v_target and s.sender = v_uid and s.saved_at is null
+                     and (p_op = 'delete' or (p_op = 'insert' and s.withdrawn_at is null)));
+  end if;
+  return public.try_uuid(split_part(p_name, '/', 1)) = v_uid
+    and exists (select 1 from public.spots s where s.id = v_target and s.owner_id = v_uid);
+end;
+$$;
+
+grant execute on function public.can_read_photo(text), public.can_write_photo(text, text) to authenticated;
+
+-- storage.objects, bucket 'photos' only (no other bucket has a policy, so nothing else is readable or writable). The
+-- Storage API runs these as the signed-in user; an upsert needs SELECT and UPDATE, a move UPDATE on both names.
+create policy photos_select on storage.objects for select to authenticated
+  using (bucket_id = 'photos' and public.can_read_photo(name));
+create policy photos_insert on storage.objects for insert to authenticated
+  with check (bucket_id = 'photos' and public.can_write_photo(name, 'insert'));
+create policy photos_update on storage.objects for update to authenticated
+  using (bucket_id = 'photos' and public.can_write_photo(name, 'update'))
+  with check (bucket_id = 'photos' and public.can_write_photo(name, 'update'));
+create policy photos_delete on storage.objects for delete to authenticated
+  using (bucket_id = 'photos' and public.can_write_photo(name, 'delete'));
diff --git a/supabase/migrations/20261023041500_links.sql b/supabase/migrations/20261023041500_links.sql
new file mode 100644
index 0000000..9205cdc
--- /dev/null
+++ b/supabase/migrations/20261023041500_links.sql
@@ -0,0 +1,244 @@
+-- S3-07: links (docs/plans/2026-10-22-s3-backend.md, "Functions"; D44 send and invite links, D45 a token is a secret
+-- and only its SHA-256 is stored). The links table keeps RLS on with no policies: nobody reads or writes it directly.
+-- The creator makes, lists and revokes links; the service role (the share-preview Edge Function, S9) previews one;
+-- a signed-in user redeems an invite link once. Expired, revoked, used and withdrawn links all look unknown.
+-- Append new migrations; never edit this one.
+
+-- A link to a send (by its sender, while it is not withdrawn; NULL expiry = never) or an invite link to a shared list
+-- (by its owner, with a role; it expires within 7 days, a later expiry is cut to 7 days, D44). p_token_sha256 is the
+-- lowercase hex SHA-256 of the client's random token (D45: the token itself never reaches the server here).
+create function public.create_link(p_kind text, p_target uuid, p_token_sha256 text, p_expires_at timestamptz,
+                                   p_role text default null)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_id uuid;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if p_kind is null or p_kind not in ('send', 'invite') then
+    raise exception 'a link is a send or an invite' using errcode = '22023';
+  end if;
+  if p_token_sha256 is null or p_token_sha256 !~ '^[0-9a-f]{64}$' then
+    raise exception 'a link needs the token''s SHA-256 in lowercase hex' using errcode = '22023';
+  end if;
+  if p_expires_at is not null and p_expires_at <= now() then
+    raise exception 'a link cannot expire in the past' using errcode = '22023';
+  end if;
+
+  if p_kind = 'send' then
+    if p_role is not null then
+      raise exception 'a send link takes no role' using errcode = '22023';
+    end if;
+    perform 1 from public.sends s where s.id = p_target and s.sender = v_uid;
+    if not found then
+      raise exception 'no such send' using errcode = '42501';
+    end if;
+    if exists (select 1 from public.sends s where s.id = p_target and s.withdrawn_at is not null) then
+      raise exception 'this send was withdrawn' using errcode = '55000';
+    end if;
+    insert into public.links (kind, token_sha256, send_id, created_by, expires_at)
+    values ('send', p_token_sha256, p_target, v_uid, p_expires_at)
+    returning id into v_id;
+  else
+    if p_role is null or p_role not in ('add', 'view') then
+      raise exception 'an invite link needs the role add or view' using errcode = '22023';
+    end if;
+    if p_expires_at is null then
+      raise exception 'an invite link must expire' using errcode = '22023';
+    end if;
+    -- FOR SHARE waits for (and conflicts with) a concurrent stop sharing or delete, so its revoke trigger can't miss
+    -- this link: either it commits first and this sees the list unshared, or it waits until this link is in.
+    perform 1 from public.hit_lists l where l.id = p_target and l.owner_id = v_uid and l.deleted_at is null for share;
+    if not found then
+      raise exception 'not the list owner' using errcode = '42501';
+    end if;
+    if not exists (select 1 from public.hit_lists l where l.id = p_target and l.shared) then
+      raise exception 'share the list first' using errcode = '55000';
+    end if;
+    insert into public.links (kind, token_sha256, list_id, role, created_by, expires_at)
+    values ('invite', p_token_sha256, p_target, p_role, v_uid, least(p_expires_at, now() + interval '7 days'))
+    returning id into v_id;
+  end if;
+  return v_id;
+end;
+$$;
+
+-- The creator revokes a link (Sent, the member screen). Revoking again keeps the first time; anyone else, or an
+-- unknown id, gets the same 'no such link'.
+create function public.revoke_link(p_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  update public.links set revoked_at = coalesce(revoked_at, now()) where id = p_id and created_by = v_uid;
+  if not found then
+    raise exception 'no such link' using errcode = '42501';
+  end if;
+end;
+$$;
+
+-- The creator's own links, newest first (the Sent screen's Active · Expired · Revoked, a list's invite links); never
+-- the hash. p_kind NULL = both kinds.
+create function public.list_my_links(p_kind text)
+returns table (id uuid, kind text, send_id uuid, list_id uuid, role text, created_at timestamptz,
+               expires_at timestamptz, revoked_at timestamptz, used_at timestamptz)
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select l.id, l.kind, l.send_id, l.list_id, l.role, l.created_at, l.expires_at, l.revoked_at, l.used_at
+  from public.links l
+  where l.created_by = auth.uid() and (p_kind is null or l.kind = p_kind)
+  order by l.created_at desc, l.id;
+$$;
+
+-- What a link shows before sign-in, for the share-preview Edge Function only (the service role: granted to nobody
+-- else, and the JWT role claim is checked too). A live send link gives the send's frozen payload and its sender; a
+-- live invite link gives the list's name and the inviter. Unknown, expired, revoked, used (invite), withdrawn (send)
+-- and unshared or deleted (list) all give the same empty result (§3.6: never say which). Security invoker: the
+-- service role reads past RLS on its own. send_id is for the photos: S9 signs URLs only for objects under
+-- sends/<send_id>/ that pass photo_path_ok, never for a path read from the payload (the sender wrote it, and the
+-- service role would sign anyone's photo).
+create function public.preview_link(p_sha text)
+returns table (kind text, send_id uuid, payload jsonb, list_name text, sender_username extensions.citext,
+               sender_display_name text, expires_at timestamptz)
+language plpgsql
+stable
+set search_path = ''
+as $$
+begin
+  if (select auth.jwt() ->> 'role') is distinct from 'service_role' then
+    raise exception 'service role only' using errcode = '42501';
+  end if;
+  return query
+    select l.kind, s.id, s.payload, null::text, p.username, p.display_name, l.expires_at
+    from public.links l
+    join public.sends s on s.id = l.send_id
+    join public.profiles p on p.id = s.sender
+    where l.token_sha256 = p_sha and l.kind = 'send'
+      and l.revoked_at is null and (l.expires_at is null or l.expires_at > now())
+      and s.withdrawn_at is null
+    union all
+    select l.kind, null::uuid, null::jsonb, h.name, p.username, p.display_name, l.expires_at
+    from public.links l
+    join public.hit_lists h on h.id = l.list_id
+    join public.profiles p on p.id = l.created_by
+    where l.token_sha256 = p_sha and l.kind = 'invite'
+      and l.revoked_at is null and l.expires_at > now() and l.used_at is null
+      and h.shared and h.deleted_at is null;
+end;
+$$;
+
+-- A signed-in user joins a shared list with an invite link's token (pasted or scanned, §3.6); returns the list id.
+-- The token is hashed here as the client hashed it (SHA-256, lowercase hex). The link row is locked, so two redeems
+-- of one token run one after the other and the second finds it used. Unknown, expired, revoked, used, a list no longer
+-- shared or deleted, and a block either way between the caller and the owner (D50) all raise the same
+-- 'invalid invite'. The owner or a member (the redeemer retrying, say) gets the list id and nothing changes.
+-- An invitee's 'invited' row becomes 'member' (the Join trigger clears old spot rows); anyone else gets a new
+-- 'member' row with the link's role, and any spot row left from an earlier membership goes (D43). A definer function,
+-- so guard_member_update and the invite policy don't apply; the block guard trigger does, and its error is mapped as a
+-- second layer (the block check above, under the same pair lock, normally answers first).
+-- Against stop sharing / delete: the list is read without a lock, but the link row lock makes
+-- t30_revoke_invite_links (on the same link) wait for this redeem, and t30_unshare fires after it (name order), so
+-- its member delete sees the new row. Keep that trigger name sorting before t30_unshare. (Locking the list here
+-- after the link would deadlock with stop sharing, which goes list then link.)
+create function public.redeem_invite(p_token text)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_link public.links;
+  v_owner uuid;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  select * into v_link from public.links l
+  where l.token_sha256 = encode(extensions.digest(p_token, 'sha256'), 'hex') and l.kind = 'invite'
+  for update;
+  select h.owner_id into v_owner from public.hit_lists h
+  where h.id = v_link.list_id and h.shared and h.deleted_at is null;
+  if v_link.id is null or v_owner is null or v_link.revoked_at is not null or v_link.expires_at <= now() then
+    raise exception 'invalid invite' using errcode = '42501';
+  end if;
+  if v_uid = v_owner
+     or exists (select 1 from public.hit_list_members m
+                where m.list_id = v_link.list_id and m.user_id = v_uid and m.status = 'member') then
+    return v_link.list_id;
+  end if;
+  if v_link.used_at is not null then
+    raise exception 'invalid invite' using errcode = '42501';
+  end if;
+
+  perform public.lock_user_pair(v_owner, v_uid);
+  -- Two links of one list redeemed at once by the same user: the second waits here and finds the first's row.
+  if exists (select 1 from public.hit_list_members m
+             where m.list_id = v_link.list_id and m.user_id = v_uid and m.status = 'member') then
+    return v_link.list_id;
+  end if;
+  if exists (select 1 from public.blocks b
+             where (b.blocker = v_owner and b.blocked = v_uid) or (b.blocker = v_uid and b.blocked = v_owner)) then
+    raise exception 'invalid invite' using errcode = '42501';
+  end if;
+  begin
+    update public.hit_list_members m set status = 'member', role = v_link.role, joined_at = now()
+    where m.list_id = v_link.list_id and m.user_id = v_uid and m.status = 'invited';
+    if not found then
+      delete from public.hit_list_spots s where s.list_id = v_link.list_id and s.added_by = v_uid;
+      insert into public.hit_list_members (list_id, user_id, role, status, invited_by, joined_at)
+      values (v_link.list_id, v_uid, v_link.role, 'member', v_link.created_by, now());
+    end if;
+  exception when insufficient_privilege then
+    raise exception 'invalid invite' using errcode = '42501';
+  end;
+  update public.links set used_by = v_uid, used_at = now() where id = v_link.id;
+  return v_link.list_id;
+end;
+$$;
+
+-- The revoke trigger, the cascades from sends and hit_lists, and list_my_links look links up by these.
+create index links_list_idx on public.links (list_id);
+create index links_send_idx on public.links (send_id);
+create index links_created_by_idx on public.links (created_by);
+
+-- An invite link dies with its list's sharing: stopping sharing or deleting the list revokes every live invite link,
+-- so sharing again later doesn't bring old links back.
+create function public.revoke_list_invite_links()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  update public.links set revoked_at = now()
+  where list_id = new.id and kind = 'invite' and revoked_at is null;
+  return null;
+end;
+$$;
+
+create trigger t30_revoke_invite_links after update of shared, deleted_at on public.hit_lists
+  for each row when ((old.shared and not new.shared) or (old.deleted_at is null and new.deleted_at is not null))
+  execute function public.revoke_list_invite_links();
+
+grant execute on function public.create_link(text, uuid, text, timestamptz, text), public.revoke_link(uuid),
+  public.list_my_links(text), public.redeem_invite(text)
+  to authenticated;
+revoke execute on function public.preview_link(text) from public, anon, authenticated;
+grant execute on function public.preview_link(text) to service_role;
diff --git a/supabase/migrations/20261023060000_review_fixes.sql b/supabase/migrations/20261023060000_review_fixes.sql
new file mode 100644
index 0000000..d1c109d
--- /dev/null
+++ b/supabase/migrations/20261023060000_review_fixes.sql
@@ -0,0 +1,54 @@
+-- S3-08 milestone review fixes (docs/plans/2026-10-22-s3-backend.md, Review: S3-08).
+
+-- D50: a pending invitation between a blocked pair goes even when no friendship row is left to delete (an invite that
+-- raced Remove friend outlives the friendship, so t30_withdraw_invitations never saw it). Same body as before plus
+-- the direct delete, both directions, under the pair lock.
+create or replace function public.block_user(p_user uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if p_user = v_uid then
+    raise exception 'you cannot block yourself' using errcode = '22023';
+  end if;
+  if p_user is null or not exists (select 1 from public.profiles p where p.id = p_user) then
+    raise exception 'user not found' using errcode = 'P0002';
+  end if;
+  perform public.lock_user_pair(v_uid, p_user);
+  insert into public.blocks (blocker, blocked) values (v_uid, p_user) on conflict do nothing;
+  delete from public.friendships f where f.user_a = least(v_uid, p_user) and f.user_b = greatest(v_uid, p_user);
+  delete from public.hit_list_members m
+  using public.hit_lists l
+  where m.list_id = l.id and m.status = 'invited'
+    and ((l.owner_id = v_uid and m.user_id = p_user) or (l.owner_id = p_user and m.user_id = v_uid));
+end;
+$$;
+
+-- D50: Join (invited → member) is a new membership too, so it passes the same block guard as an insert (pair lock,
+-- blocks re-read). Sorts before t10_member_guard.
+create trigger t05_block_guard_join before update of status on public.hit_list_members
+  for each row when (old.status = 'invited' and new.status = 'member') execute function public.guard_invite_block();
+
+-- media.uploaded_by names the uploader: a client may leave it empty or put their own id there, never someone else's.
+drop policy media_insert on public.media;
+drop policy media_update on public.media;
+create policy media_insert on public.media for insert to authenticated
+  with check (
+    owner_id = (select auth.uid())
+    and (uploaded_by is null or uploaded_by = (select auth.uid()))
+    and exists (select 1 from public.spots s where s.id = spot_id and s.owner_id = (select auth.uid()))
+  );
+create policy media_update on public.media for update to authenticated
+  using (owner_id = (select auth.uid()))
+  with check (
+    owner_id = (select auth.uid())
+    and (uploaded_by is null or uploaded_by = (select auth.uid()))
+    and exists (select 1 from public.spots s where s.id = spot_id and s.owner_id = (select auth.uid()))
+  );
diff --git a/supabase/migrations/20261024010000_sends_s7.sql b/supabase/migrations/20261024010000_sends_s7.sql
new file mode 100644
index 0000000..425b8da
--- /dev/null
+++ b/supabase/migrations/20261024010000_sends_s7.sql
@@ -0,0 +1,158 @@
+-- S7-03: sending (docs/plans/2026-10-22-s7-send.md, "Photo copy"; D77 photos are staged before the send row, D80 the
+-- sender's name comes from the server). The client copies every photo to sends/<id>/ under a send id it made, then
+-- calls create_send, so a recipient never reads a send whose photos are missing. Append new migrations; never edit
+-- this one.
+
+-- Staging ---------------------------------------------------------------------------------------------------------
+
+-- Whether p_name is the caller's staged photo: a send photo path whose object the caller owns (p_owner_id, the
+-- object's owner_id) under a send id no send has yet. Once the send exists, can_read_send / can_write_photo decide.
+create function public.is_own_staged_photo(p_name text, p_owner_id text)
+returns boolean
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+begin
+  if v_uid is null or p_owner_id is distinct from v_uid::text or not public.photo_path_ok(p_name)
+     or split_part(p_name, '/', 1) <> 'sends' then
+    return false;
+  end if;
+  return not exists (select 1 from public.sends s where s.id = public.try_uuid(split_part(p_name, '/', 2)));
+end;
+$$;
+
+grant execute on function public.is_own_staged_photo(text, text) to authenticated;
+
+-- Storage's copy needs SELECT and INSERT, its remove DELETE and SELECT: the stager gets all three on their own staged
+-- objects, nobody else any.
+drop policy photos_select on storage.objects;
+drop policy photos_insert on storage.objects;
+drop policy photos_delete on storage.objects;
+create policy photos_select on storage.objects for select to authenticated
+  using (bucket_id = 'photos' and (public.can_read_photo(name) or public.is_own_staged_photo(name, owner_id)));
+create policy photos_insert on storage.objects for insert to authenticated
+  with check (bucket_id = 'photos'
+              and (public.can_write_photo(name, 'insert') or public.is_own_staged_photo(name, owner_id)));
+create policy photos_delete on storage.objects for delete to authenticated
+  using (bucket_id = 'photos'
+         and (public.can_write_photo(name, 'delete') or public.is_own_staged_photo(name, owner_id)));
+
+-- A rider's staged photos (a send that never got its row: the app was killed between the copy and create_send), for
+-- account-delete, which can't find them with Storage's list without walking every send folder. Service role only;
+-- not a definer function (the service role reads past RLS on its own).
+create function public.staged_send_objects(p_uid uuid)
+returns setof text
+language sql
+stable
+set search_path = ''
+as $$
+  select o.name from storage.objects o
+  where o.bucket_id = 'photos' and o.name like 'sends/%' and o.owner_id = p_uid::text
+    and not exists (select 1 from public.sends s where s.id = public.try_uuid(split_part(o.name, '/', 2)))
+  order by o.name;
+$$;
+
+revoke execute on function public.staged_send_objects(uuid) from public, anon, authenticated;
+grant execute on function public.staged_send_objects(uuid) to service_role;
+
+-- create_send -----------------------------------------------------------------------------------------------------
+
+-- As shipped (S3-06), plus: an id somebody else staged a photo under (or one nobody owns) is refused, so a send never
+-- shows another rider's photos; the caller needs a username; the payload's sender is the caller's profile (D80), so a
+-- forged one never reaches the recipient.
+create or replace function public.create_send(p_id uuid, p_recipient uuid, p_payload jsonb)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_profile public.profiles;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  if p_id is null or p_payload is null or jsonb_typeof(p_payload) <> 'object'
+     or octet_length(p_payload::text) > 1048576 then
+    raise exception 'a send needs an id and a payload object of at most 1 MB' using errcode = '22023';
+  end if;
+  if p_recipient = v_uid then
+    raise exception 'you cannot send to yourself' using errcode = '22023';
+  end if;
+  select * into v_profile from public.profiles p where p.id = v_uid;
+  if v_profile.username is null then
+    raise exception 'choose a username before sending' using errcode = '22023';
+  end if;
+  if exists (select 1 from storage.objects o
+             where o.bucket_id = 'photos' and o.name like 'sends/' || p_id::text || '/%'
+               and o.owner_id is distinct from v_uid::text) then
+    raise exception 'another rider''s photos are under this send id' using errcode = '42501';
+  end if;
+  if p_recipient is not null then
+    perform public.lock_user_pair(v_uid, p_recipient);
+    if not exists (select 1 from public.friendships f
+                   where f.user_a = least(v_uid, p_recipient) and f.user_b = greatest(v_uid, p_recipient)
+                     and f.status = 'accepted')
+       or exists (select 1 from public.blocks b
+                  where (b.blocker = v_uid and b.blocked = p_recipient)
+                     or (b.blocker = p_recipient and b.blocked = v_uid)) then
+      raise exception 'you can only send to friends' using errcode = '42501';
+    end if;
+  end if;
+  insert into public.sends (id, sender, recipient, payload)
+  values (p_id, v_uid, p_recipient,
+          p_payload || jsonb_build_object('sender', jsonb_build_object('username', v_profile.username::text,
+                                                                      'display_name', v_profile.display_name)));
+  return p_id;
+end;
+$$;
+
+-- mark_send_saved -------------------------------------------------------------------------------------------------
+
+-- As shipped, but a send saves once: a second phone or a stale Inbox item gets 55000 instead of saving a second set
+-- of copies. p_token is the saving phone's: the same token again (a retry after a lost answer) succeeds, so only the
+-- phone whose save went through inserts the copies. save_token is readable by the sender too: a random uuid.
+alter table public.sends add column save_token uuid;
+
+drop function public.mark_send_saved(uuid);
+create function public.mark_send_saved(p_id uuid, p_token uuid default null)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_row public.sends;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  select * into v_row from public.sends s where s.id = p_id for update;
+  if not found or v_row.recipient is distinct from v_uid or not public.can_read_send(p_id) then
+    raise exception 'no such send' using errcode = '42501';
+  end if;
+  if v_row.saved_at is not null then
+    if p_token is not null and v_row.save_token = p_token then
+      return;
+    end if;
+    raise exception 'this send was saved already' using errcode = '55000';
+  end if;
+  update public.sends set saved_at = now(), save_token = p_token where id = p_id;
+end;
+$$;
+
+revoke execute on function public.mark_send_saved(uuid, uuid) from public, anon;
+grant execute on function public.mark_send_saved(uuid, uuid) to authenticated;
+
+-- spots.from_username ---------------------------------------------------------------------------------------------
+
+-- 'From @ana' on a saved copy (D80: frozen at save time, synced with the spot). The profiles_username_format rule
+-- (citext keeps the case), so a mixed-case name never parks the recipient's push with 23514.
+alter table public.spots add column from_username text
+  constraint spots_from_username_format check (from_username is null or from_username ~ '^[A-Za-z0-9_.]{3,20}$');
diff --git a/supabase/migrations/20261025010000_shared_lists_s8.sql b/supabase/migrations/20261025010000_shared_lists_s8.sql
new file mode 100644
index 0000000..476c8da
--- /dev/null
+++ b/supabase/migrations/20261025010000_shared_lists_s8.sql
@@ -0,0 +1,85 @@
+-- S8-02: shared lists from the client (docs/plans/2026-10-22-s8-shared-lists.md, "Server"). Append new migrations;
+-- never edit this one.
+
+-- The caller's open invitations (D83): an invitee reads the list row but none of its spot rows (RLS), so the count
+-- '(12 spots)' comes from here. Live, shared lists only, and none where either side blocked the other (D50). The
+-- count is what a member would read (can_read_spot): a manual list's live spots added by their own owner while that
+-- owner is the list's owner or a joined member; an area list's owner's live, located spots inside the circle that
+-- pass its filters. Nothing about any spot but the count leaves.
+create function public.list_invitations()
+returns table (list_id uuid, name text, kind text, owner_id uuid, owner_username text, owner_display_name text,
+               role text, spot_count integer, invited_at timestamptz)
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select l.id, l.name, l.kind, l.owner_id, p.username, p.display_name, m.role,
+    case
+      when l.kind = 'manual' then (
+        select count(*)::integer
+        from public.hit_list_spots hs
+        join public.spots s on s.id = hs.spot_id
+        where hs.list_id = l.id
+          and s.deleted_at is null
+          and hs.added_by = s.owner_id
+          and (
+            s.owner_id = l.owner_id
+            or exists (
+              select 1 from public.hit_list_members mm
+              where mm.list_id = l.id and mm.user_id = s.owner_id and mm.status = 'member'
+            )
+          )
+      )
+      else (
+        select count(*)::integer
+        from public.spots s
+        where s.owner_id = l.owner_id
+          and s.deleted_at is null
+          and not (s.lat = 0 and s.lng = 0)
+          and extensions.st_dwithin(s.geog, l.area_center, l.area_radius_m, false)
+          and public.spot_matches_filters(s, l.area_filters)
+      )
+    end,
+    m.invited_at
+  from public.hit_list_members m
+  join public.hit_lists l on l.id = m.list_id
+  join public.profiles p on p.id = l.owner_id
+  where m.user_id = auth.uid()
+    and m.status = 'invited'
+    and l.shared
+    and l.deleted_at is null
+    and not exists (
+      select 1 from public.blocks b
+      where (b.blocker = l.owner_id and b.blocked = auth.uid()) or (b.blocker = auth.uid() and b.blocked = l.owner_id)
+    )
+  order by m.invited_at desc, l.id;
+$$;
+
+-- The owner turns sharing on and gets the row back (with its new rev). updated_at never moves backwards: a client
+-- update stamped with the phone's clock would lose to the stale guard after stop_sharing's server now().
+create function public.share_list(p_list uuid)
+returns public.hit_lists
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid uuid := auth.uid();
+  v_row public.hit_lists;
+begin
+  if v_uid is null then
+    raise exception 'not signed in' using errcode = '42501';
+  end if;
+  update public.hit_lists set shared = true, updated_at = greatest(updated_at, now())
+  where id = p_list and owner_id = v_uid and deleted_at is null
+  returning * into v_row;
+  if not found then
+    raise exception 'not a live list of yours' using errcode = '42501';
+  end if;
+  return v_row;
+end;
+$$;
+
+revoke execute on function public.list_invitations(), public.share_list(uuid) from public, anon;
+grant execute on function public.list_invitations(), public.share_list(uuid) to authenticated;
