@@ -0,0 +1,17 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteDatabase } from 'expo-sqlite';
+import { getSyncState } from '@/src/db/sync';
+
+/** The client holds a session for `uid` right now. */
+export async function signedInAs(client: SupabaseClient, uid: string): Promise<boolean> {
+  const { data, error } = await client.auth.getSession();
+  return !error && data.session?.user.id === uid;
+}
+
+/**
+ * Push and pull run only with a session for `uid`, on a phone whose rows are `uid`'s (sync_state.user_id): anything
+ * else would send one account's rows under another, or pull and reconcile one account's data into another's.
+ */
+export async function maySync(db: SQLiteDatabase, client: SupabaseClient, uid: string): Promise<boolean> {
+  return (await signedInAs(client, uid)) && (await getSyncState(db, 'user_id')) === uid;
+}
diff --git a/src/sync/adopt.ts b/src/sync/adopt.ts
new file mode 100644
index 0000000..1ad22f0
--- /dev/null
+++ b/src/sync/adopt.ts
@@ -0,0 +1,292 @@
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import {
+  adoptableMemberships,
+  clearOutbox,
+  countPending,
+  enqueueMemberships,
+  forgetAccount,
+  getSyncState,
+  resetCursors,
+  setSyncState,
+} from '@/src/db/sync';
+import { clearProfiles } from '@/src/db/profiles';
+import { useSyncStore } from '@/src/stores/sync-store';
+import { deleteSpotPhotos } from '@/src/utils/photo-storage';
+import { reloadStoresQuietly, runExclusive } from './engine';
+import { errorMessage } from './errors';
+import { defaultPhotoIO, deleteAllCachedPhotos, deleteCachedPhotos, type PhotoIO } from './photos';
+import { dropMemberships, forgetList } from './shared-rows';
+
+/*
+ * Whose rows are on the phone (S5-06, D38, D66, D67; docs/plans/2026-10-22-s5-sync.md "Adoption", "Sign out").
+ * Each runs on the sync queue (runExclusive), so no push or pull sees it half done, and each writes in one
+ * transaction: the exception to "no withTransactionAsync for app writes", accepted because they run at sign-in,
+ * sign-out or account deletion, when no screen is writing (only a town backfill could, and it is redone next launch).
+ * After the commit the photo folders of the removed spots go and the stores reload.
+ */
+
+export type AdoptResult = 'done' | 'needs_confirm';
+
+/** The spots and lists Keep after Delete account made phone-only (what its Remove then takes away). */
+export interface ReleasedRows {
+  spotIds: string[];
+  listIds: string[];
+}
+
+/** Rows adoption takes: live phone-only spots, live photos of live spots, live lists (a deleted one never uploads). */
+const ADOPTABLE_SPOTS = 'owner_id IS NULL AND deleted_at IS NULL';
+const ADOPTABLE_MEDIA =
+  'owner_id IS NULL AND deleted_at IS NULL AND spot_id IN (SELECT id FROM spots WHERE deleted_at IS NULL)';
+const ADOPTABLE_LISTS = 'owner_id IS NULL AND deleted_at IS NULL';
+
+/**
+ * Deletes every row that came with an account (owner_id set) except `keep`'s, memberships first, the friend names
+ * mirror (D72: they were that account's friends) and the members mirror (S8), and returns the removed spots' ids (for
+ * their photo folders and cached photos).
+ * `sync_state.user_id` must already be cleared, so no delete trigger queues a server DELETE.
+ */
+async function deleteAccountRows(db: SQLiteDatabase, keep: string | null): Promise<string[]> {
+  const owned = 'owner_id IS NOT NULL AND owner_id IS NOT ?';
+  const spots = await db.getAllAsync<{ id: string }>(`SELECT id FROM spots WHERE ${owned}`, keep);
+  await db.runAsync(
+    `DELETE FROM hit_list_spots
+     WHERE list_id IN (SELECT id FROM hit_lists WHERE ${owned}) OR spot_id IN (SELECT id FROM spots WHERE ${owned})`,
+    keep,
+    keep,
+  );
+  await db.runAsync(
+    `DELETE FROM media WHERE ${owned} OR spot_id IN (SELECT id FROM spots WHERE ${owned})`,
+    keep,
+    keep,
+  );
+  await db.runAsync(`DELETE FROM spots WHERE ${owned}`, keep);
+  await db.runAsync(`DELETE FROM hit_lists WHERE ${owned}`, keep);
+  await clearProfiles(db);
+  // the shared-list members mirror (S8) was that account's view too
+  await db.runAsync('DELETE FROM hit_list_members');
+  return spots.map((s) => s.id);
+}
+
+/** A row adoption would take. */
+async function hasPhoneOnlyRows(db: SQLiteDatabase): Promise<boolean> {
+  const row = await db.getFirstAsync<{ any: number }>(
+    `SELECT EXISTS (SELECT 1 FROM spots WHERE ${ADOPTABLE_SPOTS})
+         OR EXISTS (SELECT 1 FROM media WHERE ${ADOPTABLE_MEDIA})
+         OR EXISTS (SELECT 1 FROM hit_lists WHERE ${ADOPTABLE_LISTS}) AS any`,
+  );
+  return row?.any === 1;
+}
+
+/**
+ * Makes the phone `uid`'s (sign-in, and launch when already signed in). When another account's rows are here, they
+ * leave first with their photo files, outbox and cursors (D66); if any of their changes never reached the server it
+ * returns 'needs_confirm' and changes nothing, unless `confirmSwitch` (the rider chose Remove and continue). Then every
+ * live phone-only spot, photo and list gets `uid` as owner (one deleted before sign-in stays on the phone only, so its
+ * photos never upload), the triggers queue their upserts (user_id is set first),
+ * and the memberships that just became fully owned are queued after them. Idempotent: with nothing phone-only and the
+ * phone already `uid`'s it writes nothing. The caller syncs afterwards (never from inside: see runExclusive).
+ */
+export function adopt(
+  db: SQLiteDatabase,
+  uid: string,
+  opts: { confirmSwitch?: boolean } = {},
+): Promise<AdoptResult> {
+  return runExclusive(async (): Promise<AdoptResult> => {
+    const prev = await getSyncState(db, 'user_id');
+    const switching = prev !== uid;
+    if (prev !== undefined && switching && !opts.confirmSwitch && (await countPending(db)) > 0) return 'needs_confirm';
+    if (!switching && !(await hasPhoneOnlyRows(db))) return 'done';
+
+    let removed: string[] = [];
+    await db.withTransactionAsync(async () => {
+      if (switching) {
+        await forgetAccount(db, prev);
+        removed = await deleteAccountRows(db, uid);
+        // The new rider's rows that were here as the last account's friend's (S8) had their photos in the cache:
+        // under photos/ the downloads fetch them into Documents (user_id is cleared, so nothing queues).
+        await db.runAsync(
+          `UPDATE media SET file_path = substr(file_path, length('cache/') + 1)
+           WHERE owner_id = ? AND file_path LIKE 'cache/photos/%'`,
+          uid,
+        );
+        await clearOutbox(db);
+        await resetCursors(db);
+      }
+      const memberships = await adoptableMemberships(db);
+      await setSyncState(db, 'user_id', uid);
+      await db.runAsync(`UPDATE spots SET owner_id = ? WHERE ${ADOPTABLE_SPOTS}`, uid);
+      await db.runAsync(`UPDATE media SET owner_id = ? WHERE ${ADOPTABLE_MEDIA}`, uid);
+      await db.runAsync(`UPDATE hit_lists SET owner_id = ? WHERE ${ADOPTABLE_LISTS}`, uid);
+      await enqueueMemberships(db, memberships);
+    });
+    deleteSpotPhotos(removed);
+    deleteCachedPhotos(removed);
+    await reloadStoresQuietly(db);
+    return 'done';
+  });
+}
+
+/**
+ * Sign-out's Keep (S8, D86): others' rows leave the phone, so what stays is the rider's own and phone-only. Lists of
+ * other riders go with their memberships and members mirror (forgetList), others' spots with their photos and
+ * memberships (in the rider's lists too), all without queuing a server delete; the whole photo cache goes after the
+ * commit. The cursors restart, so the next sign-in reads the shared rows again. The rider's own rows, outbox and
+ * user_id are untouched. Resolves the removed spots' ids, or null (nothing removed) while a change waits to be backed
+ * up. Run it once signed out, so no sync pulls the rows back in between.
+ */
+export function removeForeignRows(db: SQLiteDatabase, uid: string): Promise<string[] | null> {
+  return runExclusive(async () => {
+    // a waiting change may be the rider's own spot going into (or out of) a friend's list: forgetList would drop it
+    if ((await countPending(db)) > 0) return null;
+    const foreign = 'owner_id IS NOT NULL AND owner_id <> ?';
+    let removed: string[] = [];
+    await db.withTransactionAsync(async () => {
+      const lists = await db.getAllAsync<{ id: string }>(`SELECT id FROM hit_lists WHERE ${foreign}`, uid);
+      for (const list of lists) await forgetList(db, list.id);
+      removed = (await db.getAllAsync<{ id: string }>(`SELECT id FROM spots WHERE ${foreign} ORDER BY id`, uid)).map(
+        (r) => r.id,
+      );
+      await dropMemberships(db, `spot_id IN (SELECT id FROM spots WHERE ${foreign})`, uid);
+      await db.runAsync(`DELETE FROM media WHERE ${foreign} OR spot_id IN (SELECT id FROM spots WHERE ${foreign})`, uid, uid);
+      await db.runAsync(`DELETE FROM spots WHERE ${foreign}`, uid);
+      await resetCursors(db);
+    });
+    deleteAllCachedPhotos();
+    await reloadStoresQuietly(db);
+    return removed;
+  });
+}
+
+/**
+ * Remove from this phone (D38): the account's rows (and whatever else came with it) and their photo files leave, the
+ * outbox and `uid`'s sync state are cleared; phone-only spots stay. Resolves false and removes nothing while a change
+ * still waits to be backed up (D69), unless `discardPending` (after Delete account: there is no account to reach).
+ */
+export function removeLocalAccountData(
+  db: SQLiteDatabase,
+  uid: string,
+  opts: { discardPending?: boolean } = {},
+): Promise<boolean> {
+  return runExclusive(async () => {
+    if (!opts.discardPending && (await countPending(db)) > 0) return false;
+    // from now on a new spot is phone-only, also while the sign-out itself still runs
+    useSyncStore.setState({ adoptedUserId: null });
+    let removed: string[] = [];
+    await db.withTransactionAsync(async () => {
+      await forgetAccount(db, uid);
+      removed = await deleteAccountRows(db, null);
+      await clearOutbox(db);
+      await resetCursors(db);
+    });
+    deleteSpotPhotos(removed);
+    deleteCachedPhotos(removed);
+    await reloadStoresQuietly(db);
+    return true;
+  });
+}
+
+/**
+ * Keep after Delete account (D67), run as soon as the account is gone, before the rider answers Keep / Remove (an
+ * unanswered alert must not leave rows a later sign-in would remove as another account's): `uid`'s spots, photos,
+ * lists and memberships become phone-only again (owner and rev cleared), so a later sign-in adopts them like any
+ * other; photo rows whose file never reached this phone go (there is nowhere left to download them from), rows of
+ * other accounts go, and the outbox, cursors and user_id are cleared. Photo files on the phone stay. Resolves the
+ * spots and lists it released, for removeReleasedRows.
+ */
+export function releaseAccountData(
+  db: SQLiteDatabase,
+  uid: string,
+  io: Pick<PhotoIO, 'exists'> = defaultPhotoIO,
+): Promise<ReleasedRows> {
+  return runExclusive(() => release(db, uid, io));
+}
+
+/**
+ * Delete account (S4-05) then Keep (D67) as one task on the sync queue: a sync already running finishes first, and
+ * none starts between the server delete and the release (a pull after the delete would see an empty account and
+ * reconcile the rider's list memberships away; after the release user_id is cleared, so no sync runs). `deleteServer`
+ * resolves whether the server deleted the account. A release that fails after the delete only warns: the account is
+ * gone either way.
+ */
+export function deleteAccountAndRelease(
+  db: SQLiteDatabase,
+  uid: string,
+  deleteServer: () => Promise<boolean>,
+  io: Pick<PhotoIO, 'exists'> = defaultPhotoIO,
+): Promise<{ deleted: false } | { deleted: true; released: ReleasedRows | null }> {
+  return runExclusive(async () => {
+    if (!(await deleteServer())) return { deleted: false };
+    try {
+      return { deleted: true, released: await release(db, uid, io) };
+    } catch (err) {
+      console.warn('[sync] keeping the spots after Delete account failed:', errorMessage(err));
+      return { deleted: true, released: null };
+    }
+  });
+}
+
+async function release(db: SQLiteDatabase, uid: string, io: Pick<PhotoIO, 'exists'>): Promise<ReleasedRows> {
+  useSyncStore.setState({ adoptedUserId: null });
+  let removed: string[] = [];
+  const released: ReleasedRows = { spotIds: [], listIds: [] };
+  await db.withTransactionAsync(async () => {
+    await forgetAccount(db, uid);
+    removed = await deleteAccountRows(db, uid);
+    const media = await db.getAllAsync<{ id: string; file_path: string }>(
+      'SELECT id, file_path FROM media WHERE owner_id = ?',
+      uid,
+    );
+    const missing = JSON.stringify(media.filter((m) => !io.exists(m.file_path)).map((m) => m.id));
+    await db.runAsync(
+      'UPDATE spots SET primary_photo_id = NULL WHERE primary_photo_id IN (SELECT value FROM json_each(?))',
+      missing,
+    );
+    await db.runAsync('DELETE FROM media WHERE id IN (SELECT value FROM json_each(?))', missing);
+    const ids = async (table: 'spots' | 'hit_lists') =>
+      (await db.getAllAsync<{ id: string }>(`SELECT id FROM ${table} WHERE owner_id = ? ORDER BY id`, uid)).map(
+        (r) => r.id,
+      );
+    released.spotIds = await ids('spots');
+    released.listIds = await ids('hit_lists');
+    await db.runAsync('UPDATE spots SET owner_id = NULL, rev = NULL WHERE owner_id = ?', uid);
+    await db.runAsync('UPDATE media SET owner_id = NULL, rev = NULL WHERE owner_id = ?', uid);
+    await db.runAsync('UPDATE hit_lists SET owner_id = NULL, rev = NULL WHERE owner_id = ?', uid);
+    await db.runAsync('UPDATE hit_list_spots SET rev = NULL WHERE rev IS NOT NULL');
+    await clearOutbox(db);
+    await resetCursors(db);
+  });
+  deleteSpotPhotos(removed);
+  deleteCachedPhotos(removed);
+  await reloadStoresQuietly(db);
+  return released;
+}
+
+/**
+ * Remove after Delete account: the spots and lists releaseAccountData released, with their photos, memberships and
+ * photo files. Rows a sign-in adopted since are no longer phone-only and stay.
+ */
+export function removeReleasedRows(db: SQLiteDatabase, released: ReleasedRows): Promise<void> {
+  return runExclusive(async () => {
+    const spots = JSON.stringify(released.spotIds);
+    const lists = JSON.stringify(released.listIds);
+    const phoneOnlyIn = 'owner_id IS NULL AND id IN (SELECT value FROM json_each(?))';
+    let removed: string[] = [];
+    await db.withTransactionAsync(async () => {
+      removed = (await db.getAllAsync<{ id: string }>(`SELECT id FROM spots WHERE ${phoneOnlyIn}`, spots)).map((r) => r.id);
+      const gone = JSON.stringify(removed);
+      await db.runAsync(
+        `DELETE FROM hit_list_spots WHERE spot_id IN (SELECT value FROM json_each(?))
+           OR list_id IN (SELECT id FROM hit_lists WHERE ${phoneOnlyIn})`,
+        gone,
+        lists,
+      );
+      await db.runAsync('DELETE FROM media WHERE spot_id IN (SELECT value FROM json_each(?))', gone);
+      await db.runAsync('DELETE FROM spots WHERE id IN (SELECT value FROM json_each(?))', gone);
+      await db.runAsync(`DELETE FROM hit_lists WHERE ${phoneOnlyIn}`, lists);
+    });
+    deleteSpotPhotos(removed);
+    deleteCachedPhotos(removed);
+    await reloadStoresQuietly(db);
+  });
+}
diff --git a/src/sync/auth.ts b/src/sync/auth.ts
new file mode 100644
index 0000000..b386250
--- /dev/null
+++ b/src/sync/auth.ts
@@ -0,0 +1,152 @@
+import { isAuthRetryableFetchError, type Session, type SupabaseClient } from '@supabase/supabase-js';
+
+import { SIGNED_OUT, useAuthStore, type AuthSnapshot } from '@/src/stores/auth-store';
+import { errorMessage } from '@/src/sync/errors';
+import { SESSION_STORAGE_KEY, sessionStorage } from '@/src/sync/session-storage';
+
+// The auth store's view of a session. A profile that cannot be read (offline launch, no row yet) is
+// 'signed_in' with no username, never 'needs_username': the rider is not trapped on the username
+// screen, and useAuthInit refetches the profile when the app is next active.
+export async function resolveAuthState(client: SupabaseClient, session: Session | null): Promise<AuthSnapshot> {
+  if (!session) return SIGNED_OUT;
+  const { user } = session;
+  const signedIn: AuthSnapshot = {
+    status: 'signed_in',
+    userId: user.id,
+    email: user.email ?? null,
+    username: null,
+    displayName: null,
+  };
+  try {
+    const { data, error } = await client
+      .from('profiles')
+      .select('username, display_name')
+      .eq('id', user.id)
+      .maybeSingle<{ username: string | null; display_name: string | null }>();
+    if (error || !data) return signedIn;
+    return {
+      ...signedIn,
+      status: data.username ? 'signed_in' : 'needs_username',
+      username: data.username,
+      displayName: data.display_name,
+    };
+  } catch {
+    return signedIn;
+  }
+}
+
+/**
+ * Reads the profile of `uid` again (one that failed to load, e.g. an offline launch) and shows it while `uid` is still
+ * the rider shown without a username. Never rejects.
+ */
+export async function refreshProfile(client: SupabaseClient, uid: string): Promise<void> {
+  try {
+    const { data } = await client.auth.getSession();
+    if (data.session?.user.id !== uid) return;
+    const snapshot = await resolveAuthState(client, data.session);
+    const shown = useAuthStore.getState();
+    if (snapshot.username && shown.userId === uid && !shown.username) shown.setAuth(snapshot);
+  } catch (err) {
+    console.warn('[auth] reading the profile again failed:', errorMessage(err));
+  }
+}
+
+const SEND_FAILED = "Couldn't send the code. Check your connection and try again.";
+
+/**
+ * Emails a 6-digit sign-in code (a new address gets an account). Resolves the message to show, or null when sent:
+ * the error's `message` (fixed copy when offline), never the object.
+ */
+export async function sendSignInCode(client: SupabaseClient, email: string): Promise<string | null> {
+  try {
+    const { error } = await client.auth.signInWithOtp({ email, options: { shouldCreateUser: true } });
+    if (!error) return null;
+    // Offline, auth-js's message is the fetch's ('Network request failed'). A reply it couldn't read (not JSON: a
+    // captive portal, a proxy) is an AuthUnknownError with the parse error's text, and a JSON body with no message
+    // field comes through stringified: neither is for the rider.
+    const unreadable = isAuthRetryableFetchError(error) || error.name === 'AuthUnknownError';
+    const message = error.message?.trim();
+    return unreadable || !message || /^[[{]/.test(message) ? SEND_FAILED : message;
+  } catch {
+    return SEND_FAILED;
+  }
+}
+
+/**
+ * Checks an emailed code. Resolves the signed-in account (its profile read as resolveAuthState does), or null when
+ * the code didn't work (wrong, expired, offline).
+ */
+export async function verifySignInCode(
+  client: SupabaseClient,
+  email: string,
+  token: string,
+): Promise<AuthSnapshot | null> {
+  try {
+    const { data, error } = await client.auth.verifyOtp({ email, token, type: 'email' });
+    if (error || !data.session) return null;
+    return await resolveAuthState(client, data.session);
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * What saving the @username came to: 'taken' is the unique index (23505), 'invalid' the format check (23514),
+ * 'failed' anything else, including an update that changed no row.
+ */
+export type SaveProfileResult = 'saved' | 'taken' | 'invalid' | 'failed';
+
+/**
+ * Writes the rider's @username and display name to their profile row (onboarding). The caller passes them already
+ * normalized. RLS lets a rider update only their own row, and filters any other update down to no rows without an
+ * error (the session is gone, the row is missing), so the updated row is read back to tell.
+ */
+export async function saveProfile(
+  client: SupabaseClient,
+  userId: string,
+  username: string,
+  displayName: string | null,
+): Promise<SaveProfileResult> {
+  try {
+    const { data, error } = await client
+      .from('profiles')
+      .update({ username, display_name: displayName })
+      .eq('id', userId)
+      .select('id');
+    if (!error) return data?.length ? 'saved' : 'failed';
+    if (error.code === '23505') return 'taken';
+    return error.code === '23514' ? 'invalid' : 'failed';
+  } catch {
+    return 'failed';
+  }
+}
+
+/**
+ * Signs the rider out (D62: plain sign out until S5 backs spots up and adds Keep / Remove). auth-js 2.118 removes the
+ * stored session itself when the server sign out fails or is refused (`_signOut`), so its `scope: 'local'` would add
+ * nothing. Offline with an expired access token it can't read the session (its refresh fails) and returns that error
+ * before removing anything; then, or when it throws, the stored session is removed here, or the next token refresh
+ * would sign the rider back in. The phone is always signed out afterwards.
+ */
+export async function signOutOfAccount(client: SupabaseClient): Promise<void> {
+  try {
+    const { error } = await client.auth.signOut();
+    if (!error) return;
+  } catch {
+    // Fall through to clearing the stored session.
+  }
+  await sessionStorage.removeItem(SESSION_STORAGE_KEY).catch(() => {});
+}
+
+/**
+ * Deletes the rider's account on the server through the account-delete Edge Function (D51), which takes the user
+ * from the session's JWT, never from a body. Resolves true only for its `{ ok: true }`; the caller then signs out.
+ */
+export async function deleteAccount(client: SupabaseClient): Promise<boolean> {
+  try {
+    const { data, error } = await client.functions.invoke<{ ok?: boolean }>('account-delete');
+    return !error && data?.ok === true;
+  } catch {
+    return false;
+  }
+}
diff --git a/src/sync/client.ts b/src/sync/client.ts
new file mode 100644
index 0000000..b01a72d
--- /dev/null
+++ b/src/sync/client.ts
@@ -0,0 +1,37 @@
+import { AppState } from 'react-native';
+import { createClient, type SupabaseClient } from '@supabase/supabase-js';
+
+import { SESSION_STORAGE_KEY, sessionStorage } from './session-storage';
+
+// The one Supabase client, built on first use. A build without both EXPO_PUBLIC_ values has none, and the
+// app is the signed-out app (§3.1). Read with the dot form: Expo inlines only process.env.EXPO_PUBLIC_X.
+let client: SupabaseClient | null = null;
+
+export function getSupabase(): SupabaseClient | null {
+  if (client) return client;
+  const url = process.env.EXPO_PUBLIC_SUPABASE_URL?.trim();
+  const anonKey = process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY?.trim();
+  if (!url || !anonKey) return null;
+
+  const created = createClient(url, anonKey, {
+    auth: {
+      storage: sessionStorage,
+      // Fixed rather than derived from the URL, so signOutOfAccount can clear it when auth-js can't.
+      storageKey: SESSION_STORAGE_KEY,
+      autoRefreshToken: true,
+      persistSession: true,
+      detectSessionInUrl: false,
+    },
+  });
+  // Refresh tokens only while the app is in the foreground (Supabase's Expo guide).
+  AppState.addEventListener('change', (state) => {
+    if (state === 'active') void created.auth.startAutoRefresh();
+    else void created.auth.stopAutoRefresh();
+  });
+  client = created;
+  return client;
+}
+
+export function isConfigured(): boolean {
+  return getSupabase() !== null;
+}
diff --git a/src/sync/copy.ts b/src/sync/copy.ts
new file mode 100644
index 0000000..c7a790c
--- /dev/null
+++ b/src/sync/copy.ts
@@ -0,0 +1,123 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import { File } from 'expo-file-system';
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import { getMediaForSpot, getSpot, insertMedia, insertSpot, updateSpot } from '@/src/db';
+import type { Media, Spot } from '@/src/types';
+import { newId } from '@/src/utils/id';
+import { isForeign } from '@/src/utils/ownership';
+import { photoFolder, photoRelativePath, resolvePhotoUri } from '@/src/utils/photo-storage';
+import { errorMessage } from './errors';
+import { currentOwnerId } from './owner';
+import { cachedPhotoUri, defaultPhotoIO, type PhotoIO } from './photos';
+import { reloadStoresQuietly } from './reload';
+
+/** What Save a copy needs of the files: the cache download (PhotoIO) and a copy into Paths.document. */
+export interface CopyIO extends Pick<PhotoIO, 'exists' | 'write' | 'remove'> {
+  /** Copies one media file_path to another, making the target's folder. */
+  copy(fromPath: string, toPath: string): Promise<void>;
+}
+
+export const defaultCopyIO: CopyIO = {
+  ...defaultPhotoIO,
+  async copy(fromPath, toPath) {
+    photoFolder(toPath).create({ intermediates: true, idempotent: true });
+    await new File(resolvePhotoUri(fromPath)).copy(new File(resolvePhotoUri(toPath)));
+  },
+};
+
+export interface CopyResult {
+  spotId: string;
+  /** Photos left out because they could not be downloaded (D89). */
+  missingPhotos: number;
+}
+
+/**
+ * Save a copy (S8, D47, D89): another rider's spot becomes the rider's own private spot. Its photos are downloaded
+ * into the cache first where missing (cachedPhotoUri), then copied to `photos/<newId>/<newMediaId>.jpg`; one that
+ * can't be downloaded is left out and counted. The copy keeps the name, town, tags, speed, notes and place, gets
+ * fresh ids and timestamps, `uid` as owner and the owner's @username as `from_username`, and is written through
+ * src/db so the triggers queue its backup. Then the stores reload. Rejects for a spot that isn't another rider's.
+ */
+export async function saveCopy(
+  db: SQLiteDatabase,
+  client: SupabaseClient | null,
+  uid: string,
+  spotId: string,
+  io: CopyIO = defaultCopyIO,
+): Promise<CopyResult> {
+  // the copy must be a row the triggers queue for `uid`: not while adoption hasn't made the phone theirs
+  if (currentOwnerId() !== uid) throw new Error("this phone isn't your account yet");
+  const source = await getSpot(db, spotId);
+  if (!source || !isForeign(source, uid)) throw new Error("not another rider's spot");
+
+  const id = newId();
+  const now = new Date().toISOString();
+  const photos: Media[] = [];
+  let missingPhotos = 0;
+  let primary: string | undefined;
+  for (const media of await getMediaForSpot(db, spotId)) {
+    const copy: Media = {
+      id: newId(),
+      spot_id: id,
+      file_path: '',
+      captured_at: media.captured_at,
+      location: media.location,
+      created_at: media.created_at,
+    };
+    copy.file_path = photoRelativePath(id, copy.id);
+    try {
+      await cachedPhotoUri(client, media, io);
+      await io.copy(media.file_path, copy.file_path);
+    } catch (err) {
+      missingPhotos += 1;
+      console.warn(`[copy] could not copy photo ${media.id}:`, errorMessage(err));
+      continue;
+    }
+    photos.push(copy);
+    if (media.id === source.primary_photo_id) primary = copy.id;
+  }
+
+  const spot: Spot = {
+    id,
+    name: source.name,
+    generated_name: source.generated_name,
+    location: source.location,
+    created_at: now,
+    updated_at: now,
+    feature_types: source.feature_types,
+    stopped: source.stopped,
+    natural_speed: source.natural_speed,
+    notes: source.notes,
+    primary_photo_id: primary,
+    owner_id: uid,
+    from_username: source.owner_username,
+  };
+  try {
+    await insertSpot(db, spot);
+  } catch (err) {
+    // the files no row points at
+    for (const photo of photos) io.remove(photo.file_path);
+    throw err;
+  }
+  // The copy exists (and is queued): a photo row that fails is left out and counted like a failed download, so the
+  // toast is true and a retry doesn't make a second copy (S8-09 review A#7).
+  let primaryLost = false;
+  for (const photo of photos) {
+    try {
+      await insertMedia(db, photo);
+    } catch (err) {
+      missingPhotos += 1;
+      io.remove(photo.file_path);
+      if (photo.id === primary) primaryLost = true;
+      console.warn(`[copy] could not save photo ${photo.id}:`, errorMessage(err));
+    }
+  }
+  if (primaryLost) {
+    await updateSpot(db, id, { primary_photo_id: null }).catch((err: unknown) =>
+      console.warn('[copy] could not clear the primary photo:', errorMessage(err)),
+    );
+  }
+  await reloadStoresQuietly(db);
+  return { spotId: id, missingPhotos };
+}
diff --git a/src/sync/engine.ts b/src/sync/engine.ts
new file mode 100644
index 0000000..1380a3a
--- /dev/null
+++ b/src/sync/engine.ts
@@ -0,0 +1,142 @@
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import { countFailed, countPending, getSyncState, lastOutboxId, lastSyncKey, setSyncState } from '@/src/db/sync';
+import { useSyncStore } from '@/src/stores/sync-store';
+import { getSupabase } from './client';
+import { errorMessage } from './errors';
+import { loadAndApplyFriends } from './friends';
+import { loadAndApplyInvites } from './lists';
+import { deleteCachedFiles, deleteCachedPhotos, downloadMissingPhotos } from './photos';
+import { pull } from './pull';
+import { push } from './push';
+import { runExclusive } from './queue';
+import { reloadStoresQuietly } from './reload';
+import { loadAndApplySends } from './sends';
+
+export { runExclusive };
+export { reloadStores, reloadStoresQuietly } from './reload';
+
+/** useSync's timer: a sync every 5 minutes while the app is open (D48). */
+export const SYNC_INTERVAL_MS = 300_000;
+
+/** The sync queued or running now (`started` once it runs); a call before it starts joins it. */
+let current: { promise: Promise<void>; started: boolean } | null = null;
+/** The one sync asked for while `current` runs: it starts after `current`, so a change saved meanwhile goes too. */
+let followUp: Promise<void> | null = null;
+
+/**
+ * Push, then pull, then the missing photo files, as the signed-in rider; single-flight: a call while a sync waits to
+ * start joins it, a call while one runs gets exactly one more sync after it (Retry or pull-to-refresh right after an
+ * edit must not join a sync already past its push). Nothing happens without a client, without a session, or while
+ * the phone's rows are not the session's rider's (sync_state.user_id: not adopted yet, or another account's). Never
+ * rejects: errors are `console.warn` and land in the sync store.
+ */
+export function syncNow(db: SQLiteDatabase): Promise<void> {
+  if (current && !current.started) return current.promise;
+  if (current) {
+    followUp ??= current.promise.then(() => {
+      followUp = null;
+      return syncNow(db);
+    });
+    return followUp;
+  }
+  const entry = {
+    started: false,
+    promise: runExclusive(() => {
+      entry.started = true;
+      return syncOnce(db);
+    }).finally(() => {
+      if (current === entry) current = null;
+    }),
+  };
+  current = entry;
+  return entry.promise;
+}
+
+async function sessionRider(db: SQLiteDatabase): Promise<string | null> {
+  const client = getSupabase();
+  if (!client) return null;
+  const { data } = await client.auth.getSession();
+  const uid = data.session?.user.id;
+  return uid && (await getSyncState(db, 'user_id')) === uid ? uid : null;
+}
+
+async function syncOnce(db: SQLiteDatabase): Promise<void> {
+  const client = getSupabase();
+  let uid: string | null;
+  try {
+    uid = await sessionRider(db);
+  } catch (err) {
+    console.warn('[sync] could not read the session:', errorMessage(err));
+    return;
+  }
+  if (!client || !uid) return;
+
+  const shown = useSyncStore.getState();
+  const sameRider = shown.userId === uid;
+  useSyncStore.setState({
+    userId: uid,
+    syncing: true,
+    failedCount: sameRider ? shown.failedCount : 0,
+    lastError: sameRider ? shown.lastError : null,
+    lastSyncAt: sameRider ? shown.lastSyncAt : null,
+  });
+
+  let error: string | null = null;
+  const fail = (what: string, err: unknown) => {
+    console.warn(`[sync] ${what} failed:`, errorMessage(err));
+    error ??= errorMessage(err);
+  };
+  try {
+    useSyncStore.setState({ lastSyncAt: (await getSyncState(db, lastSyncKey(uid))) ?? null });
+    // Backed up = every change queued before this sync reached the server (one saved meanwhile goes next time).
+    const queuedBefore = await lastOutboxId(db);
+
+    try {
+      const { failed } = await push(db, client, uid);
+      if (failed > 0) error ??= `push: ${failed} ${failed === 1 ? 'change' : 'changes'} failed`;
+    } catch (err) {
+      fail('push', err);
+    }
+    let changed = false;
+    try {
+      const result = await pull(db, client, uid);
+      changed = result.changed;
+      if (result.failed) error ??= 'pull: the server could not be read';
+      // others' rows the pull removed take their cached photos with them (S8; files aren't in the transaction)
+      deleteCachedPhotos(result.removedSpotIds ?? []);
+      deleteCachedFiles(result.removedPhotoPaths ?? []);
+    } catch (err) {
+      fail('pull', err);
+    }
+    try {
+      await downloadMissingPhotos(db, client, uid);
+    } catch (err) {
+      // the photos are already backed up; their files come next sync
+      console.warn('[sync] photo download failed:', errorMessage(err));
+    }
+    if (changed) await reloadStoresQuietly(db);
+
+    const failedCount = await countFailed(db);
+    const waiting = await countPending(db, queuedBefore);
+    if (waiting > 0) error ??= `${waiting} ${waiting === 1 ? 'change' : 'changes'} still waiting`;
+    // push and pull quietly do nothing once the session is gone: that is not a backup either
+    if (error === null && (await sessionRider(db)) !== uid) error = 'signed out during the sync';
+    if (error === null) {
+      const lastSyncAt = new Date().toISOString();
+      await setSyncState(db, lastSyncKey(uid), lastSyncAt);
+      useSyncStore.setState({ lastSyncAt });
+    }
+    useSyncStore.setState({ failedCount, lastError: error });
+    // friends and requests (S6), the sends to the rider (S7), then the list invitations (S8), once the backup is
+    // settled: a slow read never holds the pulled spots or 'Backed up' back; none rejects
+    await loadAndApplyFriends(db, client, uid);
+    await loadAndApplySends(db, client, uid);
+    await loadAndApplyInvites(db, client, uid);
+  } catch (err) {
+    fail('sync', err);
+    useSyncStore.setState({ lastError: error });
+  } finally {
+    useSyncStore.setState({ syncing: false });
+  }
+}
diff --git a/src/sync/errors.ts b/src/sync/errors.ts
new file mode 100644
index 0000000..b5e62d1
--- /dev/null
+++ b/src/sync/errors.ts
@@ -0,0 +1,7 @@
+export type ServerError = { message: string; code?: string };
+
+/** A supabase-js error as an Error that keeps its code (a caller may check '42501', '55000'…). */
+export const serverError = (error: ServerError) => Object.assign(new Error(error.message), { code: error.code });
+
+/** What a caught value says, for a `console.warn` or the sync store's lastError. */
+export const errorMessage = (err: unknown): string => (err instanceof Error ? err.message : String(err));
diff --git a/src/sync/friends.ts b/src/sync/friends.ts
new file mode 100644
index 0000000..88b5363
--- /dev/null
+++ b/src/sync/friends.ts
@@ -0,0 +1,333 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import { getProfiles, upsertProfiles } from '@/src/db/profiles';
+import { byName, useFriendsStore } from '@/src/stores/friends-store';
+import { useInboxStore, type FriendRequestItem } from '@/src/stores/inbox-store';
+import type { FriendProfile } from '@/src/types';
+import { maySync, signedInAs } from './account';
+import { errorMessage, serverError } from './errors';
+import { createTickets } from './tickets';
+import { runExclusive } from './queue';
+import { toIso } from './time';
+
+/*
+ * Friends (S6, docs/plans/2026-10-22-s6-friends.md "Data"): the server's functions and RLS decide everything
+ * (find_profile, send_friend_request, respond_friend_request, block_user, unblock_user; friendships rows the rider is
+ * in, the rider's own blocks, the profiles of friends and of riders who asked). Every call takes the client and the
+ * rider and does nothing without a session for that rider, so one process can run several riders (the integration
+ * test). Usernames reach the app only from find_profile (one exact name the rider typed) and from the profiles of the
+ * rider's own friendships rows: no select on profiles without an id filter. The mutations only call the server; the
+ * caller then runs refreshFriends.
+ */
+
+export type { FriendProfile };
+
+/** One friendships row from the rider's side: `profile` is the other rider. */
+export interface FriendRow {
+  friendshipId: string;
+  created_at: string;
+  profile: FriendProfile;
+}
+
+export interface FriendsData {
+  /** status 'accepted', by username */
+  friends: FriendRow[];
+  /** 'pending', asked by the other rider, newest first */
+  incoming: FriendRow[];
+  /** 'pending', asked by the rider, newest first; the server hides the target's name (from the mirror, D73) */
+  outgoing: FriendRow[];
+  /** riders the rider blocked (D74); the server hides their names too */
+  blocked: FriendProfile[];
+}
+
+export type AddStatus = 'self' | 'already_friends' | 'already_sent' | 'blocked_by_me' | 'sent' | 'accepted';
+
+/**
+ * What Add by username found. 'not_found' is also a rider who blocked you, one not onboarded yet, and a block that
+ * landed between find and send (D50: the blocked rider is never told, so the three read the same).
+ */
+export type AddResult =
+  | { status: 'invalid' }
+  | { found: false; status: 'not_found' }
+  | { found: true; status: AddStatus; profile: FriendProfile };
+
+/** Rows per page (PostgREST caps a response at 1000). */
+const PAGE = 500;
+/** Ids per profiles select, so the URL stays short. */
+const PROFILE_CHUNK = 100;
+const USERNAME = /^[a-z0-9_.]{3,20}$/;
+const NOT_FOUND = { found: false, status: 'not_found' } as const;
+
+/** A typed name as the server stores it (trimmed, one leading @ dropped, lowercase), or null if it can't be one (D39). */
+export function normaliseUsername(typed: string): string | null {
+  const trimmed = typed.trim();
+  const name = (trimmed.startsWith('@') ? trimmed.slice(1) : trimmed).toLowerCase();
+  return USERNAME.test(name) ? name : null;
+}
+
+interface FriendshipRow {
+  id: string;
+  user_a: string;
+  user_b: string;
+  status: 'pending' | 'accepted';
+  requested_by: string;
+  created_at: string;
+}
+
+/** Every row of `table` the rider may read, in pages ordered by `key`. */
+async function readAll<T extends Record<string, unknown>>(
+  client: SupabaseClient,
+  table: string,
+  columns: string,
+  key: keyof T & string,
+): Promise<T[]> {
+  const rows: T[] = [];
+  let last: unknown = null;
+  for (;;) {
+    let query = client.from(table).select(columns);
+    if (last !== null) query = query.gt(key, last);
+    const { data, error } = await query.order(key).limit(PAGE);
+    if (error) throw serverError(error);
+    const page = (data ?? []) as unknown as T[];
+    rows.push(...page);
+    if (page.length < PAGE) return rows;
+    last = page[page.length - 1][key];
+  }
+}
+
+/** The profiles of `ids` the server lets the rider read, by id. */
+export async function readProfiles(client: SupabaseClient, ids: string[]): Promise<FriendProfile[]> {
+  const profiles: FriendProfile[] = [];
+  for (let i = 0; i < ids.length; i += PROFILE_CHUNK) {
+    const { data, error } = await client
+      .from('profiles')
+      .select('id,username,display_name')
+      .in('id', ids.slice(i, i + PROFILE_CHUNK));
+    if (error) throw serverError(error);
+    profiles.push(...((data ?? []) as FriendProfile[]));
+  }
+  return profiles;
+}
+
+const placeholder = (id: string): FriendProfile => ({ id, username: null, display_name: null });
+const newestFirst = (a: FriendRow, b: FriendRow) => b.created_at.localeCompare(a.created_at);
+const byUsername = (a: FriendRow, b: FriendRow) => byName(a.profile, b.profile);
+
+/** loadFriends plus the profiles the server actually returned (the only ones the mirror takes). */
+async function fetchFriends(
+  client: SupabaseClient,
+  uid: string,
+): Promise<{ data: FriendsData; returned: FriendProfile[] } | null> {
+  if (!(await signedInAs(client, uid))) return null;
+  // RLS returns only rows the rider is in (friendships) or made (blocks): no filter on uid needed
+  const rows = await readAll<FriendshipRow & Record<string, unknown>>(
+    client,
+    'friendships',
+    'id,user_a,user_b,status,requested_by,created_at',
+    'id',
+  );
+  const blocks = await readAll<{ blocked: string; created_at: string }>(
+    client,
+    'blocks',
+    'blocked,created_at',
+    'blocked',
+  );
+  const other = (row: FriendshipRow) => (row.user_a === uid ? row.user_b : row.user_a);
+  const returned = await readProfiles(client, [...new Set(rows.map(other))]);
+  const byId = new Map(returned.map((p) => [p.id, p]));
+
+  // a block that landed between the two reads: the rider shows as blocked only (block_user removed the friendship)
+  const blockedIds = new Set(blocks.map((b) => b.blocked));
+  const data: FriendsData = { friends: [], incoming: [], outgoing: [], blocked: [] };
+  for (const row of rows) {
+    const id = other(row);
+    if (blockedIds.has(id)) continue;
+    const friend = {
+      friendshipId: row.id,
+      created_at: toIso(row.created_at) ?? row.created_at,
+      profile: byId.get(id) ?? placeholder(id),
+    };
+    if (row.status === 'accepted') data.friends.push(friend);
+    else (row.requested_by === uid ? data.outgoing : data.incoming).push(friend);
+  }
+  data.friends.sort(byUsername);
+  data.incoming.sort(newestFirst);
+  data.outgoing.sort(newestFirst);
+  data.blocked = blocks.map((b) => byId.get(b.blocked) ?? placeholder(b.blocked)).sort(byName);
+  return { data, returned };
+}
+
+/**
+ * The rider's friends, incoming and outgoing requests and blocks, straight from the server (names the server hides
+ * are null). Null without a session for `uid`; throws when a table can't be read.
+ */
+export async function loadFriends(client: SupabaseClient, uid: string): Promise<FriendsData | null> {
+  return (await fetchFriends(client, uid))?.data ?? null;
+}
+
+/** Puts `profiles` into the mirror on the sync queue, only while the phone is `uid`'s (never another account's). */
+function mirrorProfiles(db: SQLiteDatabase, client: SupabaseClient, uid: string, profiles: FriendProfile[]) {
+  void runExclusive(async () => {
+    try {
+      if (await maySync(db, client, uid)) await upsertProfiles(db, profiles);
+    } catch (err) {
+      console.warn('[friends] saving a name on the phone failed:', errorMessage(err));
+    }
+  });
+}
+
+/**
+ * Add by exact @username. An invalid name makes no call; null without a session for `uid`. A hit goes into the
+ * mirror (the rider typed it; that is how a sent request keeps its name, D73) before anything is sent. Throws on a
+ * server error other than the ones mapped here.
+ */
+export async function addFriend(
+  client: SupabaseClient,
+  db: SQLiteDatabase,
+  uid: string,
+  typed: string,
+): Promise<AddResult | null> {
+  const username = normaliseUsername(typed);
+  if (!username) return { status: 'invalid' };
+  if (!(await signedInAs(client, uid))) return null;
+
+  const found = await client.rpc('find_profile', { p_username: username });
+  if (found.error) throw serverError(found.error);
+  const hit = ((found.data ?? []) as FriendProfile[])[0];
+  if (!hit) return NOT_FOUND;
+  const profile: FriendProfile = {
+    id: hit.id,
+    username: hit.username,
+    display_name: hit.display_name,
+  };
+  if (profile.id === uid) return { found: true, status: 'self', profile };
+  mirrorProfiles(db, client, uid, [profile]);
+
+  const [userA, userB] = uid < profile.id ? [uid, profile.id] : [profile.id, uid];
+  const existing = await client
+    .from('friendships')
+    .select('id,status,requested_by')
+    .eq('user_a', userA)
+    .eq('user_b', userB)
+    .maybeSingle<Pick<FriendshipRow, 'id' | 'status' | 'requested_by'>>();
+  if (existing.error) throw serverError(existing.error);
+  if (existing.data?.status === 'accepted') return { found: true, status: 'already_friends', profile };
+  if (existing.data?.requested_by === uid) return { found: true, status: 'already_sent', profile };
+  const blocked = await client.from('blocks').select('blocked').eq('blocked', profile.id).maybeSingle();
+  if (blocked.error) throw serverError(blocked.error);
+  if (blocked.data) return { found: true, status: 'blocked_by_me', profile };
+
+  const sent = await client.rpc('send_friend_request', {
+    p_username: username,
+  });
+  if (sent.error) {
+    if (sent.error.code === 'P0002') return NOT_FOUND;
+    // 'unblock this user first': a block added on another phone after the check above; 42501 is also 'not signed in'
+    if (sent.error.code === '42501' && (await signedInAs(client, uid))) {
+      return { found: true, status: 'blocked_by_me', profile };
+    }
+    throw serverError(sent.error);
+  }
+  // they had asked first: the function accepted their request
+  return { found: true, status: existing.data ? 'accepted' : 'sent', profile };
+}
+
+/** Accept or decline a request; one already answered or withdrawn elsewhere resolves (the next load drops it). */
+export async function respond(
+  client: SupabaseClient,
+  uid: string,
+  friendshipId: string,
+  action: 'accept' | 'decline',
+): Promise<void> {
+  if (!(await signedInAs(client, uid))) return;
+  const { error } = await client.rpc('respond_friend_request', {
+    p_id: friendshipId,
+    p_action: action,
+  });
+  if (!error) return;
+  if (error.code === '42501' && (await signedInAs(client, uid))) return;
+  throw serverError(error);
+}
+
+/** Remove a friend, or Cancel a sent request: either side may delete the row. */
+export async function removeFriend(client: SupabaseClient, uid: string, friendshipId: string): Promise<void> {
+  if (!(await signedInAs(client, uid))) return;
+  const { error } = await client.from('friendships').delete().eq('id', friendshipId);
+  if (error) throw serverError(error);
+}
+
+/** Block a rider (the server also removes the friendship); one who deleted their account (P0002) is fine. */
+export async function block(client: SupabaseClient, uid: string, userId: string): Promise<void> {
+  if (!(await signedInAs(client, uid))) return;
+  const { error } = await client.rpc('block_user', { p_user: userId });
+  if (error && error.code !== 'P0002') throw serverError(error);
+}
+
+export async function unblock(client: SupabaseClient, uid: string, userId: string): Promise<void> {
+  if (!(await signedInAs(client, uid))) return;
+  const { error } = await client.rpc('unblock_user', { p_user: userId });
+  if (error) throw serverError(error);
+}
+
+const requestItem = (row: FriendRow): FriendRequestItem => ({
+  kind: 'friend_request',
+  id: row.friendshipId,
+  created_at: row.created_at,
+  friendshipId: row.friendshipId,
+  from: row.profile,
+});
+
+const loads = createTickets();
+
+/**
+ * Loads the rider's friends, mirrors the profiles the server returned, fills the names it hides from the mirror and
+ * applies the result to the friends store. Runs on the sync queue: the engine calls it inside its task, everything
+ * else through refreshFriends. Drops the result when a newer load was asked for, or when the session or the phone's
+ * account (sync_state.user_id) is no longer `uid`'s. Never rejects: an error warns and lands in the store.
+ */
+export async function loadAndApplyFriends(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  ticket: number = loads.take(uid),
+): Promise<void> {
+  const isNewest = () => loads.isNewest(uid, ticket);
+  try {
+    const fetched = await fetchFriends(client, uid);
+    if (!fetched || !isNewest() || !(await maySync(db, client, uid))) return;
+    const { data, returned } = fetched;
+    await upsertProfiles(db, returned);
+    const hidden = [...data.outgoing.map((f) => f.profile), ...data.blocked].filter((p) => p.username === null);
+    const mirrored = await getProfiles(
+      db,
+      hidden.map((p) => p.id),
+    );
+    const named = (p: FriendProfile) => (p.username === null ? (mirrored[p.id] ?? p) : p);
+    const filled: FriendsData = {
+      ...data,
+      outgoing: data.outgoing.map((f) => ({ ...f, profile: named(f.profile) })),
+      blocked: data.blocked.map(named).sort(byName),
+    };
+    // The Inbox's seen mark loads before its items: a cold start with a stored session fires no sign-in, so nothing
+    // else would read it. One that can't be read stays unloaded (badge 0); it isn't a friends load error.
+    try {
+      await useInboxStore.getState().loadSeen(db, uid);
+    } catch (err) {
+      console.warn('[friends] reading the Inbox seen mark failed:', errorMessage(err));
+    }
+    if (!isNewest() || !(await signedInAs(client, uid))) return;
+    // both stores move together; the Inbox takes only requests asked by others (never what the rider sent)
+    useFriendsStore.getState().applyFriends(uid, filled);
+    useInboxStore.getState().setItems(uid, 'friend_request', filled.incoming.map(requestItem));
+  } catch (err) {
+    console.warn('[friends] loading friends failed:', errorMessage(err));
+    if (isNewest()) useFriendsStore.getState().setLoadError(uid, errorMessage(err));
+  }
+}
+
+/** loadAndApplyFriends on the sync queue (screens, after a mutation). A runExclusive task must never await it. */
+export function refreshFriends(db: SQLiteDatabase, client: SupabaseClient, uid: string): Promise<void> {
+  const ticket = loads.take(uid);
+  return runExclusive(() => loadAndApplyFriends(db, client, uid, ticket));
+}
diff --git a/src/sync/join.ts b/src/sync/join.ts
new file mode 100644
index 0000000..1b27fe6
--- /dev/null
+++ b/src/sync/join.ts
@@ -0,0 +1,96 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import { useInboxStore } from '@/src/stores/inbox-store';
+import { parseToken } from '@/src/utils/link-token';
+import { maySync, signedInAs } from './account';
+import { syncNow } from './engine';
+import { errorMessage, serverError } from './errors';
+import { LinkGoneError } from './links';
+import { NotAllowedError, respondInvite } from './lists';
+
+/*
+ * Join, from the Inbox or the Lists tab (S8-06, docs/plans/2026-10-22-s8-shared-lists.md "Inbox invitations"): the
+ * rider's member row becomes 'member', then a sync, whose pull's fill brings the list and its spots. One join per
+ * rider and list at a time, whichever tab asked.
+ */
+
+/** 'joined' (the sync runs on), 'withdrawn' (the invitation is gone; the item left the Inbox) or 'failed' (try again). */
+export type JoinResult = 'joined' | 'withdrawn' | 'failed';
+
+const joining = new Map<string, Promise<JoinResult>>();
+
+/** Whether a join of `listId` by `uid` is waiting for the server (a Decline then waits: the join wins). */
+export function isJoining(uid: string, listId: string): boolean {
+  return joining.has(`${uid}:${listId}`);
+}
+
+/** Joins `listId`; resolves once the server answered, without waiting for the sync. Never rejects: a failure warns. */
+export function joinList(db: SQLiteDatabase, client: SupabaseClient, uid: string, listId: string): Promise<JoinResult> {
+  const key = `${uid}:${listId}`;
+  const running = joining.get(key);
+  if (running) return running;
+  const run = (async (): Promise<JoinResult> => {
+    try {
+      // false: no session for the rider, or the phone isn't theirs yet (adoption pending)
+      if (!(await respondInvite(db, client, uid, listId, 'join'))) return 'failed';
+    } catch (err) {
+      if (err instanceof NotAllowedError) {
+        useInboxStore.getState().removeItem(uid, 'invite', listId);
+        return 'withdrawn';
+      }
+      console.warn('[lists] joining failed:', errorMessage(err));
+      return 'failed';
+    } finally {
+      joining.delete(key);
+    }
+    useInboxStore.getState().removeItem(uid, 'invite', listId);
+    syncNow(db).catch((err: unknown) => console.warn('[lists] the sync after joining failed:', errorMessage(err)));
+    return 'joined';
+  })();
+  joining.set(key, run);
+  return run;
+}
+
+const redeeming = new Map<string, Promise<string | null>>();
+
+/**
+ * Joins a shared list with an invite link (S9, the Inbox's Paste a link): the token of a pasted link or a bare token
+ * goes to redeem_invite (single use; D60: the owner or an existing member gets the list id and nothing changes),
+ * then a sync brings the list and its spots (a failed sync only warns). Resolves the list id; LinkGoneError for text
+ * with no token and for every dead invite (42501 'invalid invite'); null without a session for `uid` on a phone that
+ * is theirs. One redeem per rider and token at a time.
+ */
+export function redeemInvite(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  textOrToken: string,
+): Promise<string | null> {
+  const token = parseToken(textOrToken);
+  if (token === null) return Promise.reject(new LinkGoneError());
+  const key = `${uid}:${token}`;
+  const running = redeeming.get(key);
+  if (running) return running;
+  const run = (async (): Promise<string | null> => {
+    try {
+      if (!(await maySync(db, client, uid))) return null;
+      const { data, error } = await client.rpc('redeem_invite', { p_token: token });
+      if (error) {
+        // 42501 is also "not signed in"
+        if (!(await signedInAs(client, uid))) return null;
+        throw error.code === '42501' ? new LinkGoneError() : serverError(error);
+      }
+      try {
+        await syncNow(db);
+      } catch (err) {
+        console.warn('[lists] the sync after joining by link failed:', errorMessage(err));
+      }
+      return data as string;
+    } finally {
+      redeeming.delete(key);
+    }
+  })();
+  redeeming.set(key, run);
+  return run;
+}
diff --git a/src/sync/links.ts b/src/sync/links.ts
new file mode 100644
index 0000000..d1619f1
--- /dev/null
+++ b/src/sync/links.ts
@@ -0,0 +1,195 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+
+import type { MemberRole } from '@/src/types';
+import { linkUrl, newToken, tokenHash } from '@/src/utils/link-token';
+import { signedInAs } from './account';
+import { serverError, type ServerError } from './errors';
+import { NotAllowedError } from './lists';
+import { serverTime } from './time';
+
+/*
+ * Links (S9, docs/plans/2026-10-22-s9-links.md "Client", D44/D45): a send link anyone holding it can look at in a
+ * browser until it expires, and an invite link (7 days, one use) that joins a shared list. The server keeps only the
+ * token's SHA-256 (create_link, revoke_link, list_my_links; preview_link behind the share-preview function); the
+ * plain token lives only in the URL's fragment. Every call takes the client and the rider and does nothing (null)
+ * without a session for that rider; a 42501 with the session there is NotAllowedError. Redeeming an invite is `redeemInvite` in join.ts (it syncs after).
+ */
+
+/** D92 *default*: where links point when EXPO_PUBLIC_SHARE_BASE_URL is unset (web/share/ served on the box). */
+export const DEFAULT_SHARE_BASE_URL = 'http://localhost:8080/share/';
+
+/** The page links open, read on every call (a test sets it). */
+export const shareBaseUrl = (): string => process.env.EXPO_PUBLIC_SHARE_BASE_URL || DEFAULT_SHARE_BASE_URL;
+
+/** The link is unknown, expired, revoked, withdrawn or used: the server never says which (§3.6). */
+export class LinkGoneError extends Error {
+  constructor() {
+    super("That link doesn't work any more");
+    this.name = 'LinkGoneError';
+  }
+}
+
+export type LinkExpiry = '1d' | '7d' | '30d' | 'never';
+export type LinkKind = 'send' | 'invite';
+export type LinkStatus = 'active' | 'expired' | 'revoked' | 'used';
+
+const DAY_MS = 864e5;
+const EXPIRY_DAYS: Record<Exclude<LinkExpiry, 'never'>, number> = { '1d': 1, '7d': 7, '30d': 30 };
+/** D44: an invite link lasts 7 days (the server cuts a later expiry to 7 days anyway). */
+const INVITE_DAYS = 7;
+
+const daysFromNow = (days: number) => new Date(Date.now() + days * DAY_MS).toISOString();
+
+/**
+ * A refusal: null when the session ended meanwhile (42501 is also "not signed in"), NotAllowedError for another 42501
+ * (not the list's owner any more), else the server error with its code.
+ */
+async function refusal(client: SupabaseClient, uid: string, error: ServerError): Promise<null> {
+  if (error.code === '42501') {
+    if (!(await signedInAs(client, uid))) return null;
+    throw new NotAllowedError();
+  }
+  throw serverError(error);
+}
+
+/** create_link with a new token; the URL carries the plain token, the server gets its hash. */
+async function createLink(
+  client: SupabaseClient,
+  uid: string,
+  args: { p_kind: LinkKind; p_target: string; p_expires_at: string | null; p_role?: MemberRole },
+): Promise<string | null> {
+  if (!(await signedInAs(client, uid))) return null;
+  const token = newToken();
+  const { error } = await client.rpc('create_link', { ...args, p_token_sha256: await tokenHash(token) });
+  if (error) return refusal(client, uid, error);
+  return linkUrl(shareBaseUrl(), token);
+}
+
+/** A link to the rider's send `sendId` (a link-only send, D94), expiring after `expiry` or never. */
+export const createSendLink = (client: SupabaseClient, uid: string, sendId: string, expiry: LinkExpiry) =>
+  createLink(client, uid, {
+    p_kind: 'send',
+    p_target: sendId,
+    p_expires_at: expiry === 'never' ? null : daysFromNow(EXPIRY_DAYS[expiry]),
+  });
+
+/** An invite link to the rider's shared list: one use, 7 days, the joiner gets `role`. */
+export const createInviteLink = (client: SupabaseClient, uid: string, listId: string, role: MemberRole) =>
+  createLink(client, uid, { p_kind: 'invite', p_target: listId, p_expires_at: daysFromNow(INVITE_DAYS), p_role: role });
+
+/** Revokes one of the rider's links (again is no error). Null without a session. */
+export async function revokeLink(client: SupabaseClient, uid: string, linkId: string): Promise<true | null> {
+  if (!(await signedInAs(client, uid))) return null;
+  const { error } = await client.rpc('revoke_link', { p_id: linkId });
+  if (error) return refusal(client, uid, error);
+  return true;
+}
+
+/** One link the rider made (never its token or hash). */
+export interface MyLink {
+  id: string;
+  kind: LinkKind;
+  sendId: string | null;
+  listId: string | null;
+  role: MemberRole | null;
+  createdAt: string;
+  /** null = never */
+  expiresAt: string | null;
+  usedBy: { id: string; username: string | null } | null;
+  status: LinkStatus;
+}
+
+interface LinkRow {
+  id: string;
+  kind: LinkKind;
+  send_id: string | null;
+  list_id: string | null;
+  role: MemberRole | null;
+  created_at: string;
+  expires_at: string | null;
+  revoked_at: string | null;
+  used_at: string | null;
+  used_by: string | null;
+  used_by_username: string | null;
+}
+
+/** Revoked wins over used, used over expired. */
+function statusOf(row: LinkRow, expiresAt: string | null, now: number): LinkStatus {
+  if (row.revoked_at) return 'revoked';
+  if (row.used_at) return 'used';
+  if (expiresAt !== null && Date.parse(expiresAt) <= now) return 'expired';
+  return 'active';
+}
+
+/** A server timestamp as the app's ISO (Hermes' Date.parse rejects Postgres' shapes). */
+
+/** The rider's links of `kind`, newest first. Null without a session; throws when the server can't be read. */
+export async function listMyLinks(client: SupabaseClient, uid: string, kind: LinkKind): Promise<MyLink[] | null> {
+  if (!(await signedInAs(client, uid))) return null;
+  const { data, error } = await client.rpc('list_my_links', { p_kind: kind });
+  if (error) throw serverError(error);
+  const now = Date.now();
+  return ((data ?? []) as LinkRow[]).map((row) => {
+    const expiresAt = row.expires_at === null ? null : serverTime(row.expires_at);
+    return {
+      id: row.id,
+      kind: row.kind,
+      sendId: row.send_id,
+      listId: row.list_id,
+      role: row.role,
+      createdAt: serverTime(row.created_at),
+      expiresAt,
+      usedBy: row.used_by ? { id: row.used_by, username: row.used_by_username } : null,
+      status: statusOf(row, expiresAt, now),
+    };
+  });
+}
+
+/** What a live link holds, as far as the app needs it (the page shows the rest). */
+export type LinkPreview =
+  | { kind: 'send'; count: number; sender: string | null }
+  | { kind: 'invite'; listName: string; inviter: string | null };
+
+type PreviewBody = {
+  kind?: unknown;
+  spots?: unknown;
+  sender?: { username?: unknown } | null;
+  list_name?: unknown;
+  inviter?: { username?: unknown } | null;
+};
+
+const usernameOf = (who: { username?: unknown } | null | undefined) =>
+  typeof who?.username === 'string' ? who.username : null;
+
+async function goneBody(context: { json?: () => Promise<unknown> } | undefined): Promise<boolean> {
+  try {
+    return ((await context?.json?.()) as { error?: unknown } | undefined)?.error === 'gone';
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Asks share-preview what a token is (no account needed there). Throws LinkGoneError for the function's 404 gone (or
+ * an answer that is neither kind) and a plain error for anything else (offline, a 500).
+ */
+export async function previewLink(client: SupabaseClient, token: string): Promise<LinkPreview> {
+  // D96: the token is the body (never the URL, which request logs keep)
+  const { data, error, response } = await client.functions.invoke<PreviewBody>('share-preview', {
+    method: 'POST',
+    body: token,
+  });
+  if (error) {
+    const context = (error as { context?: { status?: unknown; json?: () => Promise<unknown> } }).context;
+    // only the function's own gone body: the gateway also answers 404 when the function isn't there
+    if ((context?.status ?? response?.status) === 404 && (await goneBody(context))) throw new LinkGoneError();
+    throw error instanceof Error ? error : new Error(String(error));
+  }
+  if (data?.kind === 'send') {
+    return { kind: 'send', count: Array.isArray(data.spots) ? data.spots.length : 0, sender: usernameOf(data.sender) };
+  }
+  if (data?.kind === 'invite' && typeof data.list_name === 'string') {
+    return { kind: 'invite', listName: data.list_name, inviter: usernameOf(data.inviter) };
+  }
+  throw new LinkGoneError();
+}
diff --git a/src/sync/lists.ts b/src/sync/lists.ts
new file mode 100644
index 0000000..f5f2d67
--- /dev/null
+++ b/src/sync/lists.ts
@@ -0,0 +1,328 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import { deleteMember, getMembers, upsertMembers } from '@/src/db/hit-lists';
+import { upsertProfiles } from '@/src/db/profiles';
+import { useInboxStore, type InviteItem } from '@/src/stores/inbox-store';
+import type { FriendProfile, HitListKind, MemberRole } from '@/src/types';
+import { maySync } from './account';
+import { errorMessage, serverError, type ServerError } from './errors';
+import { deleteCachedPhotos } from './photos';
+import { applyListRow, memberFromServer } from './pull';
+import { runExclusive } from './queue';
+import { reloadStoresQuietly } from './reload';
+import { forgetList, removeMemberLocally, removeUnheldForeignSpots, unshareLocally } from './shared-rows';
+import { createTickets } from './tickets';
+import { toIso } from './time';
+
+/*
+ * Shared hit lists (S8, docs/plans/2026-10-22-s8-shared-lists.md "Data"): the server's functions and RLS decide
+ * everything (share_list, the hit_list_members policies, remove_member, leave_list, stop_sharing,
+ * list_invitations). Every call takes the client and the rider and does nothing (resolves false) unless the client
+ * holds a session for that rider and the phone's rows are theirs (maySync), so one process can run several riders
+ * (the integration test). The local writes after a call are only what the server answered (the list row with its
+ * rev, the member rows), so nothing echoes into the outbox; multi-row removals run on the sync queue in one
+ * transaction, and the cached photos go after the commit.
+ */
+
+/** The server refused (42501): the rider is no longer allowed this in the list (removed, unshared, not the owner). */
+export class NotAllowedError extends Error {
+  constructor(message = "You can't do that in this list any more.") {
+    super(message);
+    this.name = 'NotAllowedError';
+  }
+}
+
+/** D85: a list shares only once it is the rider's and backed up (no change of it waiting in the outbox). */
+export class ListNotBackedUpError extends Error {
+  constructor() {
+    super("This list isn't backed up yet.");
+    this.name = 'ListNotBackedUpError';
+  }
+}
+
+/** What Join reads when the owner withdrew the invitation (or the server no longer lets the rider join). */
+export const INVITATION_WITHDRAWN = 'This invitation was withdrawn.';
+
+const fail = (error: ServerError): Error => (error.code === '42501' ? new NotAllowedError() : serverError(error));
+
+type Row = Record<string, unknown>;
+
+/**
+ * Runs `write` on the sync queue in one transaction (no pull sees it half done), then deletes the cached photos. The
+ * server has already answered, so a local failure only warns: the transaction leaves every row, and the next pull's
+ * reconciliation removes them (a retry would get 42501 and read as a refusal; S8-09 review A#5).
+ */
+async function removeLocally(db: SQLiteDatabase, uid: string, write: () => Promise<void>): Promise<void> {
+  let removed: string[] = [];
+  try {
+    await runExclusive(() =>
+      db.withTransactionAsync(async () => {
+        await write();
+        removed = await removeUnheldForeignSpots(db, uid);
+      }),
+    );
+  } catch (err) {
+    removed = [];
+    console.warn('[lists] the local removal failed; the next sync removes the rows:', errorMessage(err));
+  }
+  deleteCachedPhotos(removed);
+  await reloadStoresQuietly(db);
+}
+
+/**
+ * Shares the rider's list with friends, all with one role (D88): turns sharing on (share_list, only when it isn't
+ * yet), writes the returned row at once (a failed invite then retries through `invite`), then invites. Throws
+ * ListNotBackedUpError before any call for a list that isn't the rider's or still waits in the outbox (D85).
+ */
+export async function shareList(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  listId: string,
+  friendIds: string[],
+  role: MemberRole,
+): Promise<boolean> {
+  if (!(await maySync(db, client, uid))) return false;
+  const list = await db.getFirstAsync<{ shared: number; waiting: number }>(
+    `SELECT shared, EXISTS (SELECT 1 FROM sync_outbox WHERE entity = 'hit_list' AND entity_id = l.id) AS waiting
+     FROM hit_lists l WHERE id = ? AND owner_id = ? AND deleted_at IS NULL`,
+    listId,
+    uid,
+  );
+  if (!list || list.waiting === 1) throw new ListNotBackedUpError();
+  if (list.shared !== 1) {
+    const { data, error } = await client.rpc('share_list', { p_list: listId });
+    if (error) throw fail(error);
+    await applyListRow(db, data as Row);
+    await reloadStoresQuietly(db);
+  }
+  return invite(db, client, uid, listId, friendIds, role);
+}
+
+/**
+ * Invites friends to a list the rider shares. An already invited friend is no error (a stale mirror), but a blocked
+ * one fails the batch (the server's block guard): "Couldn't share", not the not-allowed copy.
+ */
+export async function invite(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  listId: string,
+  friendIds: string[],
+  role: MemberRole,
+): Promise<boolean> {
+  if (!(await maySync(db, client, uid))) return false;
+  const rows = [...new Set(friendIds)].map((id) => ({
+    list_id: listId,
+    user_id: id,
+    role,
+    status: 'invited' as const,
+    invited_by: uid,
+  }));
+  if (rows.length === 0) return true;
+  const { error } = await client
+    .from('hit_list_members')
+    .upsert(rows, { onConflict: 'list_id,user_id', ignoreDuplicates: true });
+  if (error) throw serverError(error);
+  // ignoreDuplicates left a known row as it was on the server: so does the mirror (the next pull corrects any other)
+  const known = new Set((await getMembers(db, listId)).map((m) => m.user_id));
+  await upsertMembers(
+    db,
+    rows.filter((r) => !known.has(r.user_id)).map(({ list_id, user_id }) => ({ list_id, user_id, role, status: 'invited' })),
+  );
+  await reloadStoresQuietly(db);
+  return true;
+}
+
+/** The owner changes a member's role; a row the server no longer lets them change (0 rows) is NotAllowedError. */
+export async function setRole(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  listId: string,
+  userId: string,
+  role: MemberRole,
+): Promise<boolean> {
+  if (!(await maySync(db, client, uid))) return false;
+  const { data, error } = await client
+    .from('hit_list_members')
+    .update({ role })
+    .eq('list_id', listId)
+    .eq('user_id', userId)
+    .select('*');
+  if (error) throw fail(error);
+  const rows = (data ?? []) as Row[];
+  if (rows.length === 0) throw new NotAllowedError();
+  await upsertMembers(db, rows.map(memberFromServer));
+  await reloadStoresQuietly(db);
+  return true;
+}
+
+/** The owner removes a member or withdraws an invitation; their spots leave the list with them (D43). */
+export async function removeMember(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  listId: string,
+  userId: string,
+): Promise<boolean> {
+  if (!(await maySync(db, client, uid))) return false;
+  const { error } = await client.rpc('remove_member', { p_list: listId, p_user: userId });
+  if (error) throw fail(error);
+  await removeLocally(db, uid, () => removeMemberLocally(db, listId, userId));
+  return true;
+}
+
+/**
+ * The rider leaves someone else's list: the server takes their spots out of it (D43); the phone drops the list, its
+ * memberships and mirror rows, and the others' spots no other held list shows, with their cached photos.
+ */
+export async function leave(db: SQLiteDatabase, client: SupabaseClient, uid: string, listId: string): Promise<boolean> {
+  if (!(await maySync(db, client, uid))) return false;
+  const { error } = await client.rpc('leave_list', { p_list: listId });
+  if (error) throw fail(error);
+  await removeLocally(db, uid, async () => {
+    await forgetList(db, listId);
+  });
+  return true;
+}
+
+/**
+ * The owner stops sharing: the server drops every member, invitation and spot row not the owner's (t30_unshare); the
+ * phone writes the re-read list row (shared off, server rev), drops the mirror rows and the members' spots.
+ */
+export async function stopSharing(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  listId: string,
+): Promise<boolean> {
+  if (!(await maySync(db, client, uid))) return false;
+  const { error } = await client.rpc('stop_sharing', { p_list: listId });
+  if (error) throw fail(error);
+  const { data, error: readError } = await client.from('hit_lists').select('*').eq('id', listId);
+  if (readError) console.warn('[lists] re-reading the list after stop sharing failed:', readError.message);
+  const row = ((data ?? []) as Row[])[0];
+  await removeLocally(db, uid, async () => {
+    // a failed re-read leaves `shared` to the next pull (its rev is newer)
+    if (row) await applyListRow(db, row);
+    await unshareLocally(db, uid, listId);
+  });
+  return true;
+}
+
+/**
+ * Join or Decline an invitation (the rider's own member row). Join makes it 'member' (the caller then syncs: the pull's
+ * fill brings the list and its spots); an invitation withdrawn meanwhile answers 0 rows: NotAllowedError. Either
+ * answer, and a withdrawn invitation, takes the item off the Inbox.
+ */
+export async function respondInvite(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  listId: string,
+  answer: 'join' | 'decline',
+): Promise<boolean> {
+  if (!(await maySync(db, client, uid))) return false;
+  // an invitations load already running would put the item back
+  loads.take(uid);
+  const removeItem = () => useInboxStore.getState().removeItem(uid, 'invite', listId);
+  if (answer === 'join') {
+    const { data, error } = await client
+      .from('hit_list_members')
+      .update({ status: 'member' })
+      .eq('list_id', listId)
+      .eq('user_id', uid)
+      .select('*');
+    if (error) throw fail(error);
+    loads.take(uid);
+    const rows = (data ?? []) as Row[];
+    removeItem();
+    if (rows.length === 0) {
+      await deleteMember(db, listId, uid);
+      throw new NotAllowedError(INVITATION_WITHDRAWN);
+    }
+    await mirrorAnswer(() => upsertMembers(db, rows.map(memberFromServer)));
+  } else {
+    const { error } = await client.from('hit_list_members').delete().eq('list_id', listId).eq('user_id', uid);
+    if (error) throw fail(error);
+    loads.take(uid);
+    removeItem();
+    await mirrorAnswer(() => deleteMember(db, listId, uid));
+  }
+  await reloadStoresQuietly(db);
+  return true;
+}
+
+/** The server took the answer: a failed mirror write only warns (the next pull's full members read rewrites it). */
+async function mirrorAnswer(write: () => Promise<unknown>): Promise<void> {
+  try {
+    await write();
+  } catch (err) {
+    console.warn('[lists] the answer is in; mirroring it failed:', errorMessage(err));
+  }
+}
+
+interface InvitationRow {
+  list_id: string;
+  name: string;
+  kind: string;
+  owner_id: string;
+  owner_username: string | null;
+  owner_display_name: string | null;
+  role: string;
+  spot_count: number;
+  invited_at: string;
+}
+
+/**
+ * The rider's open invitations (list_invitations, D83: name, kind, owner, role and spot count; no spots), newest
+ * first, as Inbox items. Null without a session for `uid`; throws when the server can't be read.
+ */
+export async function loadInvites(client: SupabaseClient, uid: string): Promise<InviteItem[] | null> {
+  const { data: session } = await client.auth.getSession();
+  if (session.session?.user.id !== uid) return null;
+  const { data, error } = await client.rpc('list_invitations');
+  if (error) throw serverError(error);
+  return ((data ?? []) as InvitationRow[])
+    .map(
+      (row): InviteItem => ({
+        kind: 'invite',
+        id: row.list_id,
+        created_at: toIso(row.invited_at) ?? row.invited_at,
+        listId: row.list_id,
+        listName: row.name,
+        listKind: row.kind as HitListKind,
+        from: { id: row.owner_id, username: row.owner_username, display_name: row.owner_display_name },
+        role: row.role as MemberRole,
+        spotCount: row.spot_count,
+      }),
+    )
+    .sort((a, b) => b.created_at.localeCompare(a.created_at));
+}
+
+const loads = createTickets();
+
+/**
+ * Loads the invitations into the Inbox (kind 'invite') and the owners' names into the profiles mirror (D72). The
+ * engine runs it after the sends load. Drops the result when a newer load or an answer started meanwhile, or when
+ * the phone is no longer `uid`'s. Never rejects: an error warns.
+ */
+export async function loadAndApplyInvites(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  ticket: number = loads.take(uid),
+): Promise<void> {
+  try {
+    const items = await loadInvites(client, uid);
+    if (!items || !loads.isNewest(uid, ticket) || !(await maySync(db, client, uid))) return;
+    const owners: FriendProfile[] = items.map((i) => i.from).filter((p) => p.username !== null);
+    await upsertProfiles(db, owners);
+    // an answer that started during the awaits above takes a newer ticket
+    if (loads.isNewest(uid, ticket)) useInboxStore.getState().setItems(uid, 'invite', items);
+  } catch (err) {
+    console.warn('[lists] loading invitations failed:', errorMessage(err));
+  }
+}
diff --git a/src/sync/owner.ts b/src/sync/owner.ts
new file mode 100644
index 0000000..2630d94
