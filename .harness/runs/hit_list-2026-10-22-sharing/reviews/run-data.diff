+-- S9-02: links (docs/plans/2026-10-22-s9-links.md "Server"). list_my_links also names who used an invite link, for
+-- the members screen's 'Used by @ben'. Same columns as S3-07 plus used_by and used_by_username; still never the
+-- hash; still only the creator's links; still for signed-in riders only. Append new migrations; never edit this one.
+
+drop function public.list_my_links(text);
+
+create function public.list_my_links(p_kind text)
+returns table (id uuid, kind text, send_id uuid, list_id uuid, role text, created_at timestamptz,
+               expires_at timestamptz, revoked_at timestamptz, used_at timestamptz, used_by uuid,
+               used_by_username extensions.citext)
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select l.id, l.kind, l.send_id, l.list_id, l.role, l.created_at, l.expires_at, l.revoked_at, l.used_at, l.used_by,
+         p.username
+  from public.links l
+  left join public.profiles p on p.id = l.used_by
+  where l.created_by = auth.uid() and (p_kind is null or l.kind = p_kind)
+  order by l.created_at desc, l.id;
+$$;
+
+revoke execute on function public.list_my_links(text) from public, anon;
+grant execute on function public.list_my_links(text) to authenticated;
diff --git a/supabase/seed.sql b/supabase/seed.sql
new file mode 100644
index 0000000..32d9007
--- /dev/null
+++ b/supabase/seed.sql
@@ -0,0 +1,63 @@
+-- pgTAP helpers (docs/plans/2026-10-22-s3-backend.md, "pgTAP harness").
+-- seed.sql runs only on `supabase start` (fresh volume) and `supabase db reset`; a plain `supabase db push` never
+-- sends it. Never run `db push --include-seed` or `db reset --linked` against a cloud project (both would apply it).
+
+create schema if not exists tests;
+grant usage on schema tests to anon, authenticated, service_role;
+
+-- A user as GoTrue would insert one; the profile trigger creates the profiles row. Sets the username when given.
+create or replace function tests.create_user(email text, username text default null)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  uid uuid := gen_random_uuid();
+begin
+  insert into auth.users (instance_id, id, aud, role, email, created_at, updated_at)
+  values ('00000000-0000-0000-0000-000000000000', uid, 'authenticated', 'authenticated', email, now(), now());
+  if username is not null then
+    update public.profiles set username = create_user.username where id = uid;
+  end if;
+  return uid;
+end;
+$$;
+
+-- Act as a signed-in user for the rest of the transaction: auth.uid() returns uid, RLS applies.
+create or replace function tests.authenticate_as(uid uuid)
+returns void
+language plpgsql
+as $$
+begin
+  perform set_config('role', 'authenticated', true);
+  perform set_config('request.jwt.claims', json_build_object('sub', uid, 'role', 'authenticated')::text, true);
+end;
+$$;
+
+-- Act as the service role (RLS bypassed; preview_link's caller). Call it as postgres: after authenticate_as, run
+-- `reset role` first (authenticated may not switch to service_role).
+create or replace function tests.authenticate_as_service_role()
+returns void
+language plpgsql
+as $$
+begin
+  perform set_config('role', 'service_role', true);
+  perform set_config('request.jwt.claims', json_build_object('role', 'service_role')::text, true);
+end;
+$$;
+
+-- Act as anon: no user, no claims.
+create or replace function tests.clear_auth()
+returns void
+language plpgsql
+as $$
+begin
+  perform set_config('role', 'anon', true);
+  perform set_config('request.jwt.claims', '', true);
+end;
+$$;
+
+grant execute on all functions in schema tests to anon, authenticated, service_role;
+-- create_user writes auth.users as its definer: only the test runner (postgres) calls it, never a client role.
+revoke execute on function tests.create_user(text, text) from public, anon, authenticated, service_role;
