+import { create } from 'zustand';
+
+// The account as the app sees it, mirrored from the Supabase session by useAuthInit.
+// 'unconfigured': this build has no Supabase values; 'needs_username': signed in, no @username yet.
+export type AuthStatus = 'unconfigured' | 'signed_out' | 'signed_in' | 'needs_username';
+
+export interface AuthSnapshot {
+  status: AuthStatus;
+  userId: string | null;
+  email: string | null;
+  username: string | null;
+  displayName: string | null;
+}
+
+export const SIGNED_OUT: AuthSnapshot = {
+  status: 'signed_out',
+  userId: null,
+  email: null,
+  username: null,
+  displayName: null,
+};
+
+interface AuthState extends AuthSnapshot {
+  setAuth: (snapshot: AuthSnapshot) => void;
+  setProfile: (username: string, displayName: string | null) => void;
+}
+
+export const useAuthStore = create<AuthState>((set) => ({
+  ...SIGNED_OUT,
+
+  setAuth: (snapshot) => set(snapshot),
+
+  setProfile: (username, displayName) => set({ status: 'signed_in', username, displayName }),
+}));
diff --git a/src/stores/friends-store.ts b/src/stores/friends-store.ts
new file mode 100644
index 0000000..16dba9c
--- /dev/null
+++ b/src/stores/friends-store.ts
@@ -0,0 +1,93 @@
+import { create } from 'zustand';
+
+import type { FriendProfile, FriendsData } from '@/src/sync/friends';
+import { useAuthStore } from './auth-store';
+
+// The signed-in rider's friends, requests and blocks as the last friends load left them (src/sync/friends.ts
+// refreshFriends, the sync engine). Not persisted: names survive offline in the local profiles mirror instead (D72).
+export interface FriendsState extends FriendsData {
+  /** The rider these rows belong to; null until a load applied. */
+  userId: string | null;
+  /** When the last load applied (ISO), null before the first. */
+  loadedAt: string | null;
+  /** The last load's error message, null after one that went through. */
+  loadError: string | null;
+  /** Sets `uid`'s rows, unless `uid` is not the rider signed in now (a load that outlived a sign-out or switch). */
+  applyFriends: (uid: string, data: FriendsData) => void;
+  setLoadError: (uid: string, message: string) => void;
+  // After an action went through, so the row leaves at once: the load that confirms it waits its turn on the sync
+  // queue, maybe behind a backup. Each ignores a rider who is not the one shown.
+  /** A friendship removed, a sent request cancelled. */
+  dropFriendship: (uid: string, friendshipId: string) => void;
+  /** `profile` blocked: every row with them leaves (the server ends the friendship) and they are listed as blocked. */
+  noteBlocked: (uid: string, profile: FriendProfile) => void;
+  noteUnblocked: (uid: string, userId: string) => void;
+  clearFriends: () => void;
+}
+
+export const EMPTY_FRIENDS: FriendsData = {
+  friends: [],
+  incoming: [],
+  outgoing: [],
+  blocked: [],
+};
+
+const CLEARED = {
+  ...EMPTY_FRIENDS,
+  userId: null,
+  loadedAt: null,
+  loadError: null,
+};
+
+const isShown = (uid: string) => useAuthStore.getState().userId === uid;
+
+/** By username, riders whose name is unknown last (by id, so the order is stable). */
+export const byName = (a: FriendProfile, b: FriendProfile) =>
+  (a.username ?? '\uffff').localeCompare(b.username ?? '\uffff') || a.id.localeCompare(b.id);
+
+export const useFriendsStore = create<FriendsState>((set) => ({
+  ...CLEARED,
+
+  applyFriends: (uid, data) => {
+    if (!isShown(uid)) return;
+    set({
+      ...data,
+      userId: uid,
+      loadedAt: new Date().toISOString(),
+      loadError: null,
+    });
+  },
+
+  setLoadError: (uid, message) => {
+    if (isShown(uid)) set({ loadError: message });
+  },
+
+  dropFriendship: (uid, friendshipId) => {
+    if (!isShown(uid)) return;
+    const keep = (rows: FriendsData['friends']) => rows.filter((f) => f.friendshipId !== friendshipId);
+    set((s) => ({ friends: keep(s.friends), incoming: keep(s.incoming), outgoing: keep(s.outgoing) }));
+  },
+
+  noteBlocked: (uid, profile) => {
+    if (!isShown(uid)) return;
+    const keep = (rows: FriendsData['friends']) => rows.filter((f) => f.profile.id !== profile.id);
+    set((s) => ({
+      friends: keep(s.friends),
+      incoming: keep(s.incoming),
+      outgoing: keep(s.outgoing),
+      blocked: s.blocked.some((p) => p.id === profile.id) ? s.blocked : [...s.blocked, profile].sort(byName),
+    }));
+  },
+
+  noteUnblocked: (uid, userId) => {
+    if (isShown(uid)) set((s) => ({ blocked: s.blocked.filter((p) => p.id !== userId) }));
+  },
+
+  clearFriends: () => set(CLEARED),
+}));
+
+// One account's friends never show under another: every change of the signed-in rider (sign-out, an account switch,
+// a session that fell back to signed out) empties the store, whichever path changed it.
+useAuthStore.subscribe((state, prev) => {
+  if (state.userId !== prev.userId) useFriendsStore.getState().clearFriends();
+});
diff --git a/src/stores/hit-lists-store.ts b/src/stores/hit-lists-store.ts
new file mode 100644
index 0000000..0763951
--- /dev/null
+++ b/src/stores/hit-lists-store.ts
@@ -0,0 +1,188 @@
+import { create } from 'zustand';
+import { DEFAULT_FILTERS, type GeoPoint, type HitList, type HitListUpdate, type Spot, type SpotFilters } from '@/src/types';
+import { isAreaList, spotsInCircle } from '@/src/utils/area';
+import type { InboxItem, InviteItem } from './inbox-store';
+import { selectFilteredSpots } from './spots-store';
+
+interface HitListsState {
+  /** Live lists, in the order loaded (getHitLists: oldest first) then created. */
+  lists: HitList[];
+  /** spotId → the ids of the lists it is in. May still name a list that was deleted: the selectors skip those. */
+  membershipBySpot: Record<string, string[]>;
+  /** The Spots tab's list picker; null = 'My spots'. */
+  activeListId: string | null;
+
+  setLists: (lists: HitList[]) => void;
+  setMemberships: (membershipBySpot: Record<string, string[]>) => void;
+  addList: (list: HitList) => void;
+  updateList: (id: string, updates: HitListUpdate) => void;
+  /** Swaps in this version of the list, by id (a failed write's revert, which may need to drop a key). */
+  replaceList: (list: HitList) => void;
+  /** Also resets activeListId to null when it was this list. */
+  removeList: (id: string) => void;
+  /** No duplicates: a spot already in the list keeps its place. */
+  addMemberships: (listId: string, spotIds: string[]) => void;
+  /** Drops spots left in no list from the map. */
+  removeMemberships: (listId: string, spotIds: string[]) => void;
+  setActiveListId: (id: string | null) => void;
+}
+
+export const useHitListsStore = create<HitListsState>((set) => ({
+  lists: [],
+  membershipBySpot: {},
+  activeListId: null,
+
+  setLists: (lists) => set({ lists }),
+  setMemberships: (membershipBySpot) => set({ membershipBySpot }),
+
+  addList: (list) => set((s) => ({ lists: [...s.lists, list] })),
+
+  updateList: (id, { area_place, ...rest }) =>
+    set((s) => {
+      // An undefined key keeps the stored value, as updateHitList in src/db does; area_place: null clears the place.
+      const defined = Object.fromEntries(Object.entries(rest).filter(([, v]) => v !== undefined));
+      return {
+        lists: s.lists.map((l) => {
+          if (l.id !== id) return l;
+          const next: HitList = { ...l, ...defined };
+          if (area_place === null) delete next.area_place;
+          else if (area_place !== undefined) next.area_place = area_place;
+          return next;
+        }),
+      };
+    }),
+
+  replaceList: (list) => set((s) => ({ lists: s.lists.map((l) => (l.id === list.id ? list : l)) })),
+
+  removeList: (id) =>
+    set((s) => ({
+      lists: s.lists.filter((l) => l.id !== id),
+      activeListId: s.activeListId === id ? null : s.activeListId,
+    })),
+
+  addMemberships: (listId, spotIds) =>
+    set((s) => {
+      const next = { ...s.membershipBySpot };
+      for (const spotId of spotIds) {
+        const current = next[spotId] ?? [];
+        if (!current.includes(listId)) next[spotId] = [...current, listId];
+      }
+      return { membershipBySpot: next };
+    }),
+
+  removeMemberships: (listId, spotIds) =>
+    set((s) => {
+      const next = { ...s.membershipBySpot };
+      for (const spotId of spotIds) {
+        const current = next[spotId];
+        if (!current?.includes(listId)) continue;
+        const rest = current.filter((id) => id !== listId);
+        if (rest.length > 0) next[spotId] = rest;
+        else delete next[spotId];
+      }
+      return { membershipBySpot: next };
+    }),
+
+  setActiveListId: (activeListId) => set({ activeListId }),
+}));
+
+// ── Selectors ───────────────────────────────────────────
+// Pure: screens select the raw state and useMemo these. A selector that builds a new array inside the store hook
+// would hand zustand 5 a fresh value on every render and loop.
+
+/**
+ * The one rule for "in the area" (picker count, area lists, detail, sheet): live, located, inside the circle (the
+ * boundary counts), passing the filters; in `spots` order.
+ */
+export function selectAreaSpots(spots: Spot[], center: GeoPoint, radiusM: number, filters: SpotFilters): Spot[] {
+  return selectFilteredSpots(spotsInCircle(spots.filter((s) => s.deleted_at === undefined), center, radiusM), filters);
+}
+
+/**
+ * The list's live spots, in `spots` order. A manual list's come from its memberships; an area list's are computed from
+ * its circle and filters (never stored), and an area list missing its centre or radius holds none.
+ */
+export function selectListSpots(
+  list: HitList,
+  spots: Spot[],
+  membershipBySpot: Record<string, string[]>,
+): Spot[] {
+  if (list.kind === 'area') {
+    if (!isAreaList(list)) return [];
+    // the server's area rule is the owner's spots (S8): never a member's own, never a friend's in a list of mine
+    const owners = spots.filter(
+      (s) => s.owner_id === undefined || list.owner_id === undefined || s.owner_id === list.owner_id,
+    );
+    return selectAreaSpots(owners, list.area_center, list.area_radius_m, list.area_filters ?? DEFAULT_FILTERS);
+  }
+  return spots.filter((s) => s.deleted_at === undefined && membershipBySpot[s.id]?.includes(list.id));
+}
+
+/** Lists by name, case-insensitive (oldest first among equal names); a new array, the input is untouched. */
+export function selectListsByName(lists: HitList[]): HitList[] {
+  return [...lists].sort(
+    (a, b) =>
+      a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }) || a.created_at.localeCompare(b.created_at),
+  );
+}
+
+/** The live lists the spot is in, by name: the manual lists it was added to and the area lists whose circle holds it. */
+export function selectSpotLists(
+  spot: Spot,
+  lists: HitList[],
+  membershipBySpot: Record<string, string[]>,
+): HitList[] {
+  return selectListsByName(
+    lists.filter((l) => l.deleted_at === undefined && selectListSpots(l, [spot], membershipBySpot).length > 0),
+  );
+}
+
+/** `{ [listId]: live spots in it }` for every list given, 0 for an empty one. */
+export function selectListCounts(
+  lists: HitList[],
+  spots: Spot[],
+  membershipBySpot: Record<string, string[]>,
+): Record<string, number> {
+  const counts: Record<string, number> = {};
+  const manualIds = new Set<string>();
+  for (const list of lists) {
+    if (list.kind === 'area') counts[list.id] = selectListSpots(list, spots, membershipBySpot).length;
+    else {
+      counts[list.id] = 0;
+      manualIds.add(list.id);
+    }
+  }
+  // Manual lists: one pass over the spots.
+  for (const spot of spots) {
+    if (spot.deleted_at !== undefined) continue;
+    for (const listId of membershipBySpot[spot.id] ?? []) {
+      if (manualIds.has(listId)) counts[listId] += 1;
+    }
+  }
+  return counts;
+}
+
+/**
+ * Others' lists the rider joined (S8): an owner that isn't `uid` and a members row of `uid`'s with status 'member'
+ * (an invitation isn't joined, D57), by name.
+ */
+export function selectSharedWithMe(lists: HitList[], uid: string): HitList[] {
+  return selectListsByName(
+    lists.filter(
+      (l) =>
+        l.owner_id !== undefined &&
+        l.owner_id !== uid &&
+        (l.members ?? []).some((m) => m.user_id === uid && m.status === 'member'),
+    ),
+  );
+}
+
+/**
+ * The rider's open invitations (status 'invited'), newest first: the Inbox's invite items, from list_invitations()
+ * (D83: an invited rider doesn't hold the list, only its name and count). Takes the Inbox store's items.
+ */
+export function selectInvitations(items: InboxItem[]): InviteItem[] {
+  return items
+    .filter((i): i is InviteItem => i.kind === 'invite')
+    .sort((a, b) => b.created_at.localeCompare(a.created_at));
+}
diff --git a/src/stores/inbox-store.ts b/src/stores/inbox-store.ts
new file mode 100644
index 0000000..297cfb8
--- /dev/null
+++ b/src/stores/inbox-store.ts
@@ -0,0 +1,147 @@
+import type { SQLiteDatabase } from 'expo-sqlite';
+import { create } from 'zustand';
+
+import { getSyncState, inboxSeenKey, setSyncState } from '@/src/db/sync';
+import type { FriendProfile, HitListKind, MemberRole } from '@/src/types';
+import type { SendPayload, SendSender } from '@/src/utils/send-payload';
+import { useAuthStore } from './auth-store';
+
+// The Inbox tab's items and the badge (S6-04, docs/plans/2026-10-22-s6-friends.md "Inbox tab"): only items addressed
+// to the rider, tagged by kind, so S7 (sends) and S8 (invitations) add kinds without touching the badge. Not persisted
+// except the seen mark: the newest server created_at the rider has seen, per rider in sync_state (D75).
+
+/** Every kind in the order the Inbox shows its sections. */
+export const INBOX_KINDS = ['friend_request', 'send', 'invite'] as const;
+export type InboxKind = (typeof INBOX_KINDS)[number];
+
+interface InboxItemBase {
+  id: string;
+  /** server time, through toIso */
+  created_at: string;
+}
+
+export interface FriendRequestItem extends InboxItemBase {
+  kind: 'friend_request';
+  friendshipId: string;
+  /** the rider who asked */
+  from: FriendProfile;
+}
+
+/** Spots a friend sent the rider (S7): the frozen copy, until they Save or Dismiss it. `id` is the send's id. */
+export interface SendItem extends InboxItemBase {
+  kind: 'send';
+  sendId: string;
+  /** the payload's sender, written by the server (D80) */
+  from: SendSender;
+  payload: SendPayload;
+}
+
+/**
+ * An invitation to a friend's shared hit list (S8, D83): its name, kind, owner and spot count from
+ * list_invitations(), no spots until Join. `id` is the list's id; `created_at` the server's invited_at.
+ */
+export interface InviteItem extends InboxItemBase {
+  kind: 'invite';
+  listId: string;
+  listName: string;
+  listKind: HitListKind;
+  /** the list's owner, who invited the rider */
+  from: FriendProfile;
+  role: MemberRole;
+  spotCount: number;
+}
+
+export type InboxItem = FriendRequestItem | SendItem | InviteItem;
+
+/** An invitation's spot count: '12 spots', '1 spot', 'no spots yet'. */
+export function inviteSpotCount(item: InviteItem): string {
+  return item.spotCount === 0 ? 'no spots yet' : item.spotCount === 1 ? '1 spot' : `${item.spotCount} spots`;
+}
+
+/** '@ana invited you to Downtown (12 spots)' (D83: the count, never the spots). */
+export function inviteLine(item: InviteItem): string {
+  const who = item.from.username ? `@${item.from.username}` : 'A friend';
+  return `${who} invited you to ${item.listName} (${inviteSpotCount(item)})`;
+}
+
+type ItemsOf<K extends InboxKind> = Extract<InboxItem, { kind: K }>[];
+
+export interface InboxState {
+  /** The rider these items belong to; null until something applied. */
+  userId: string | null;
+  items: InboxItem[];
+  /** The seen mark: undefined until loaded (badge 0), null when loaded and never set. */
+  seenAt: string | null | undefined;
+  /** Replaces the items of `kind` only, unless `uid` is not the rider signed in now. */
+  setItems: <K extends InboxKind>(uid: string, kind: K, items: ItemsOf<K>) => void;
+  /** Drops one item at once (answered, blocked), before the next load replaces the kind. */
+  removeItem: (uid: string, kind: InboxKind, id: string) => void;
+  /** Reads `uid`'s stored seen mark (never moves the one in memory back). */
+  loadSeen: (db: SQLiteDatabase, uid: string) => Promise<void>;
+  /** Marks every item seen: stores max(stored, shown, newest item) under `uid`'s key. */
+  markSeen: (db: SQLiteDatabase, uid: string) => Promise<void>;
+  clearInbox: () => void;
+}
+
+const CLEARED = { userId: null, items: [], seenAt: undefined };
+
+const isShown = (uid: string) => useAuthStore.getState().userId === uid;
+
+/** The later of ISO timestamps (one shape, so they compare as strings); null when none is set. */
+function latest(...times: (string | null | undefined)[]): string | null {
+  return times.reduce<string | null>((max, t) => (t && (max === null || t > max) ? t : max), null);
+}
+
+export const useInboxStore = create<InboxState>((set, get) => ({
+  ...CLEARED,
+
+  setItems: (uid, kind, items) => {
+    if (!isShown(uid)) return;
+    const s = get();
+    if (s.userId !== uid) {
+      set({ userId: uid, items, seenAt: undefined });
+      return;
+    }
+    set({ items: [...s.items.filter((i) => i.kind !== kind), ...items] });
+  },
+
+  removeItem: (uid, kind, id) => {
+    const s = get();
+    if (s.userId !== uid || !isShown(uid)) return;
+    set({ items: s.items.filter((i) => i.kind !== kind || i.id !== id) });
+  },
+
+  loadSeen: async (db, uid) => {
+    const stored = (await getSyncState(db, inboxSeenKey(uid))) ?? null;
+    if (!isShown(uid)) return;
+    const s = get();
+    if (s.userId !== uid) set({ userId: uid, items: [], seenAt: stored });
+    else set({ seenAt: latest(s.seenAt, stored) });
+  },
+
+  markSeen: async (db, uid) => {
+    const s = get();
+    if (s.userId !== uid || !isShown(uid)) return;
+    const newest = latest(...s.items.map((i) => i.created_at));
+    if (newest === null || (s.seenAt != null && s.seenAt >= newest)) return;
+    const stored = (await getSyncState(db, inboxSeenKey(uid))) ?? null;
+    const next = latest(stored, get().seenAt, newest);
+    if (get().userId !== uid || !isShown(uid) || next === null) return;
+    if (next !== stored) await setSyncState(db, inboxSeenKey(uid), next);
+    if (get().userId === uid) set({ seenAt: latest(get().seenAt, next) });
+  },
+
+  clearInbox: () => set(CLEARED),
+}));
+
+/** The badge: items newer than the seen mark; 0 until the mark is loaded. */
+export function selectUnseenCount(s: Pick<InboxState, 'items' | 'seenAt'>): number {
+  const { seenAt } = s;
+  if (seenAt === undefined) return 0;
+  return s.items.filter((i) => seenAt === null || i.created_at > seenAt).length;
+}
+
+// One account's Inbox never shows under another: every change of the signed-in rider empties it.
+useAuthStore.subscribe((state, prev) => {
+  if (state.userId !== prev.userId) useInboxStore.getState().clearInbox();
+});
