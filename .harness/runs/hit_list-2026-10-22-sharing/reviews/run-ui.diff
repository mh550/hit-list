+            {sendAction}
+            {shareAction}
+          </View>
+        ) : null}
+      </View>
+    ) : undefined;
+
+  const renameButton = owner ? (
+    <HeaderTextButton onPress={() => setRenaming(true)} accessibilityLabel="Rename list">
+      Rename
