+      accessibilityState={{ disabled: !idle }}>
+      <Text style={[styles.link, !idle && styles.linkDisabled]}>{label}</Text>
+    </Pressable>
+  );
+
+  if (mode === 'link') {
+    return (
+      <ScrollView contentContainerStyle={styles.content}>
+        {spotsRow}
+        <View style={styles.chips}>
+          <ChipGroup>
+            {EXPIRIES.map((e) => (
+              <Chip
+                key={e.value}
+                label={e.label}
+                role="radio"
+                selected={expiry === e.value}
