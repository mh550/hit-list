+    gap: spacing.md,
+    paddingHorizontal: spacing.lg,
+    paddingVertical: spacing.md,
+    borderBottomWidth: StyleSheet.hairlineWidth,
+    borderBottomColor: palette.gray[200],
+  },
+  rowPressed: {
+    backgroundColor: palette.gray[100],
+  },
+  rowLabel: {
