+  const at = now();
+  return {
+    id: newId(),
+    name,
+    location: { latitude: 47.6062, longitude: -122.3321 },
+    created_at: at,
+    updated_at: at,
+    feature_types: [FeatureType.Rail, FeatureType.Ledge],
+    stopped: true,
+    natural_speed: 0,
+    owner_id: owner,
