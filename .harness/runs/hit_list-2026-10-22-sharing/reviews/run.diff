+    await setSyncState(db, 'user_id', A);
+    await seedOwnedBy(A, 'a');
+    await insertSpot(db, createTestSpot({ id: 'ana-s1', owner_id: ANA }));
+    await insertMedia(
+      db,
+      createTestMedia({ id: 'ana-m1', spot_id: 'ana-s1', file_path: 'cache/photos/ana-s1/ana-m1.jpg' }),
+    );
+    new Directory(Paths.cache, 'photos', 'ana-s1').create({ intermediates: true });
+    fakeFs.__putFile(anaCached);
+    await insertHitList(db, createTestHitList({ id: 'ana-l1', name: 'Crew', owner_id: ANA, shared: true }));
+    await addSpotsToList(db, 'ana-l1', ['ana-s1', 'a-s1']);
+    await addSpotsToList(db, 'a-l1', ['ana-s1']);
+    await db.runAsync("UPDATE spots SET rev = 1 WHERE owner_id = ?", ANA);
+    await db.runAsync("UPDATE media SET rev = 1 WHERE owner_id = ?", ANA);
+    await db.runAsync("UPDATE hit_lists SET rev = 1 WHERE owner_id = ?", ANA);
+    await db.runAsync('UPDATE hit_list_spots SET rev = 1');
+    await db.runAsync(
+      "INSERT INTO hit_list_members (list_id, user_id, role, status) VALUES ('ana-l1', ?, 'add', 'member')",
+      A,
+    );
+    await setCursor(db, 'spots', 40);
+    await db.runAsync('DELETE FROM sync_outbox');
+  }
+
+  it("removes others' spots, photos, lists and memberships, queues nothing, keeps the rider's own and their photos", async () => {
+    await seedShared();
+
+    await removeForeignRows(db, A);
+
+    expect((await getSpots(db)).map((s) => s.id).sort()).toEqual(['a-s1', 'a-s2']);
+    expect((await getAllMedia(db)).map((m) => m.id)).toEqual(['a-m1']);
+    expect((await getHitLists(db)).map((l) => l.id)).toEqual(['a-l1']);
+    expect(await getListMemberships(db)).toEqual({ 'a-s1': ['a-l1'] });
+    expect(await count('hit_list_members')).toBe(0);
+    expect(await outboxOps(db)).toEqual([]);
+    expect(fakeFs.__fileExists(anaCached)).toBe(false);
+    expect(fakeFs.__fileExists(photoUri('a-s1', 'a-m1'))).toBe(true);
+    // the next sign-in reads the shared rows again from the start
+    expect(await getCursor(db, 'spots')).toBe(0);
+    expect(await getSyncState(db, 'user_id')).toBe(A);
+    expect(useSpotsStore.getState().spots.map((s) => s.id).sort()).toEqual(['a-s1', 'a-s2']);
+  });
+
+  it('removes nothing while a change still waits to be backed up (it may be a spot going into a friend\'s list)', async () => {
+    await seedShared();
+    await addSpotsToList(db, 'ana-l1', ['a-s2']);
+    expect(await countPending(db)).toBe(1);
+
+    await expect(removeForeignRows(db, A)).resolves.toBeNull();
+    expect(await count('spots')).toBe(3);
+    expect(await countPending(db)).toBe(1);
+    expect(fakeFs.__fileExists(anaCached)).toBe(true);
+  });
+
+  it("the sync store follows the phone's account (sync_state.user_id): adopt sets it, Remove clears it", async () => {
+    await adopt(db, B);
+    expect(useSyncStore.getState().phoneUserId).toBe(B);
+    await removeLocalAccountData(db, B);
+    expect(useSyncStore.getState().phoneUserId).toBeNull();
+  });
+
+  it('an account switch re-paths the new rider\'s cached photos to photos/… so they download into Documents (S8-02 review #7)', async () => {
+    await setSyncState(db, 'user_id', A);
+    await insertSpot(db, createTestSpot({ id: 'b-s1', owner_id: B }));
+    await insertMedia(db, createTestMedia({ id: 'b-m1', spot_id: 'b-s1', file_path: 'cache/photos/b-s1/b-m1.jpg' }));
+    await db.runAsync('UPDATE media SET rev = 1');
+    await db.runAsync('UPDATE spots SET rev = 1');
+
+    await adopt(db, B);
+
+    expect((await getAllMedia(db)).map((m) => m.file_path)).toEqual(['photos/b-s1/b-m1.jpg']);
+    expect(await outboxOps(db)).toEqual([]);
+  });
+});
+
+describe("the Inbox seen mark (S6-04) leaves with the account", () => {
+  const SEEN = '2026-10-22T10:00:00.000Z';
+
+  it("another account signing in clears the last account's mark", async () => {
+    await setSyncState(db, 'user_id', A);
+    await setSyncState(db, `inbox_seen_at:${A}`, SEEN);
+
+    await adopt(db, B);
+
+    expect(await getSyncState(db, `inbox_seen_at:${A}`)).toBeUndefined();
+  });
+
+  it('Remove from this phone clears it', async () => {
+    await setSyncState(db, 'user_id', A);
+    await setSyncState(db, `inbox_seen_at:${A}`, SEEN);
+
+    await removeLocalAccountData(db, A);
+
+    expect(await getSyncState(db, `inbox_seen_at:${A}`)).toBeUndefined();
+  });
+
+  it('Keep after Delete account clears it', async () => {
+    await setSyncState(db, 'user_id', A);
+    await setSyncState(db, `inbox_seen_at:${A}`, SEEN);
+
+    await releaseAccountData(db, A, { exists: () => true });
+
+    expect(await getSyncState(db, `inbox_seen_at:${A}`)).toBeUndefined();
+  });
+});
diff --git a/src/__tests__/sync-client.test.ts b/src/__tests__/sync-client.test.ts
new file mode 100644
index 0000000..04c3900
--- /dev/null
+++ b/src/__tests__/sync-client.test.ts
@@ -0,0 +1,120 @@
+// getSupabase(): no client without both EXPO_PUBLIC_ values; one cached client with them, whose token
+// refresh follows AppState (Supabase's Expo guide; GoTrueClient.d.ts startAutoRefresh/stopAutoRefresh).
+import { AppState, type AppStateStatus } from 'react-native';
+
+jest.mock('@supabase/supabase-js', () => ({
+  createClient: jest.fn(() => ({
+    auth: { startAutoRefresh: jest.fn(), stopAutoRefresh: jest.fn() },
+  })),
+}));
+
+type ClientModule = typeof import('@/src/sync/client');
+type SupabaseModule = { createClient: jest.Mock };
+
+const URL_VALUE = 'http://127.0.0.1:54321';
+const KEY_VALUE = 'anon-key-for-tests';
+const saved = { url: process.env.EXPO_PUBLIC_SUPABASE_URL, key: process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY };
+
+function setEnv(url: string | undefined, key: string | undefined) {
+  if (url === undefined) delete process.env.EXPO_PUBLIC_SUPABASE_URL;
+  else process.env.EXPO_PUBLIC_SUPABASE_URL = url;
+  if (key === undefined) delete process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY;
+  else process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY = key;
+}
+
+// A fresh module registry per test, so the cached client never leaks between cases.
+function load(): { client: ClientModule; supabase: SupabaseModule } {
+  let client!: ClientModule;
+  let supabase!: SupabaseModule;
+  jest.isolateModules(() => {
+    client = jest.requireActual('@/src/sync/client');
+    supabase = jest.requireMock('@supabase/supabase-js');
+  });
+  return { client, supabase };
+}
+
+let appStateListeners: ((state: AppStateStatus) => void)[];
+
+beforeEach(() => {
+  appStateListeners = [];
+  jest.spyOn(AppState, 'addEventListener').mockImplementation((type, listener) => {
+    if (type === 'change') appStateListeners.push(listener as (state: AppStateStatus) => void);
+    return { remove: jest.fn() } as unknown as ReturnType<typeof AppState.addEventListener>;
+  });
+});
+
+afterEach(() => {
+  setEnv(saved.url, saved.key);
+  jest.restoreAllMocks();
+});
+
+describe('getSupabase', () => {
+  it('returns null and isConfigured() is false when the URL is unset', () => {
+    setEnv(undefined, KEY_VALUE);
+    const { client, supabase } = load();
+
+    expect(client.getSupabase()).toBeNull();
+    expect(client.isConfigured()).toBe(false);
+    expect(supabase.createClient).not.toHaveBeenCalled();
+  });
+
+  it('returns null when only the URL is set', () => {
+    setEnv(URL_VALUE, undefined);
+    const { client } = load();
+
+    expect(client.getSupabase()).toBeNull();
+  });
+
+  it('returns null when a value is only whitespace', () => {
+    setEnv(URL_VALUE, '   ');
+    const { client } = load();
+
+    expect(client.getSupabase()).toBeNull();
+    expect(client.isConfigured()).toBe(false);
+  });
+
+  it('builds one client with the URL, the key and the session options, and returns it every call', () => {
+    setEnv(URL_VALUE, KEY_VALUE);
+    const { client, supabase } = load();
+
+    const first = client.getSupabase();
+    const second = client.getSupabase();
+
+    expect(first).not.toBeNull();
+    expect(second).toBe(first);
+    expect(client.isConfigured()).toBe(true);
+    expect(supabase.createClient).toHaveBeenCalledTimes(1);
+    expect(supabase.createClient).toHaveBeenCalledWith(URL_VALUE, KEY_VALUE, {
+      auth: expect.objectContaining({
+        persistSession: true,
+        autoRefreshToken: true,
+        detectSessionInUrl: false,
+        // A fixed key, so a sign out that auth-js can't finish (offline, expired token) can clear it itself.
+        storageKey: 'hitlist.auth.session',
+        storage: expect.objectContaining({
+          getItem: expect.any(Function),
+          setItem: expect.any(Function),
+          removeItem: expect.any(Function),
+        }),
+      }),
+    });
+  });
+
+  it('starts token refresh when the app is active and stops it in the background', () => {
+    setEnv(URL_VALUE, KEY_VALUE);
+    const { client } = load();
+    const auth = client.getSupabase()!.auth as unknown as { startAutoRefresh: jest.Mock; stopAutoRefresh: jest.Mock };
+
+    expect(appStateListeners).toHaveLength(1);
+    appStateListeners[0]('active');
+    expect(auth.startAutoRefresh).toHaveBeenCalledTimes(1);
+    expect(auth.stopAutoRefresh).not.toHaveBeenCalled();
+
+    appStateListeners[0]('background');
+    expect(auth.stopAutoRefresh).toHaveBeenCalledTimes(1);
+
+    // A second getSupabase() adds no second listener.
+    client.getSupabase();
+    expect(appStateListeners).toHaveLength(1);
+  });
+});
diff --git a/src/__tests__/sync-copy.test.ts b/src/__tests__/sync-copy.test.ts
