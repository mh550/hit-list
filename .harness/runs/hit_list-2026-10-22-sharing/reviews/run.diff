+    expect(back).toHaveBeenCalledTimes(1);
+    expect(mockUpdateHitList.mock.invocationCallOrder[0]).toBeLessThan(back.mock.invocationCallOrder[0]);
+    expect(mockCreateList).not.toHaveBeenCalled();
