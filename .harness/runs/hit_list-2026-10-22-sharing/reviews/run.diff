+      error: new AuthRetryableFetchError('Network request failed', 0),
+    } as never);
+    render(<SignInScreen />);
+    fireEvent.changeText(screen.getByLabelText('Email'), 'ana@example.com');
+    await act(async () => {
+      fireEvent.press(sendButton());
