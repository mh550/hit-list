+
+  it('selectListCounts counts area lists the same way, next to manual ones', () => {
+    const manual = createTestHitList({ id: 'M' });
+    expect(selectListCounts([manual, area, railsOnly], spots, { far: ['M'], rail: ['M'] })).toEqual({
+      M: 2,
