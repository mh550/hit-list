+import { Pressable, StyleSheet, Text } from 'react-native';
+
+import { palette, spacing } from '@/src/constants/theme';
+
+interface Props {
+  /** The visible text. */
+  children: string;
+  onPress: () => void;
+  /** Defaults to the text. */
+  accessibilityLabel?: string;
