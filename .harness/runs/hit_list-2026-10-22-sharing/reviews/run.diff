+    expect(selectSpotLists(rail, lists, { rail: ['M'] }).map((l) => l.id)).toEqual(['AREA', 'RAILS', 'M']);
+    expect(selectSpotLists(ledge, lists, {}).map((l) => l.id)).toEqual(['AREA']);
