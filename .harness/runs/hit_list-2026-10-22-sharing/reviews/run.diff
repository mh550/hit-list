+      expect(screen.queryByRole('button', { name: /^Revoke/ })).toBeNull();
+      // and it reads the links again
+      expect(listSentLinks).toHaveBeenCalled();
+    });
+
+    it('Cancel on the confirm revokes nothing', async () => {
+      signIn([], [ACTIVE]);
+      await renderScreen();
+
+      await act(async () => {
+        fireEvent.press(screen.getByRole('button', { name: 'Revoke the link to 3 spots' }));
+      });
+      await act(async () => {
+        lastAlert().buttons.find((b) => b.text === 'Cancel')!.onPress?.();
+      });
+
+      expect(revokeSentLink).not.toHaveBeenCalled();
+      expect(screen.getByText('Link · 3 spots · Active until Nov 21')).toBeOnTheScreen();
+    });
+
+    it("a failed revoke warns, alerts \"Couldn't reach the server\" and keeps the row Active", async () => {
+      signIn([], [ACTIVE]);
+      jest.mocked(revokeSentLink).mockRejectedValue(new Error('offline'));
+      await renderScreen();
+
+      await confirmRevoke();
+
+      expect(alert).toHaveBeenLastCalledWith("Couldn't reach the server", 'Try again.');
+      expect(warn).toHaveBeenCalledWith(expect.stringContaining('[Sent]'), 'offline');
+      expect(screen.getByText('Link · 3 spots · Active until Nov 21')).toBeOnTheScreen();
+      expect(screen.getByRole('button', { name: 'Revoke the link to 3 spots' })).toBeOnTheScreen();
+    });
+
+    it('a revoke that withdrew the send but failed on the link re-reads the links, which then read Revoked', async () => {
+      signIn([], [ACTIVE]);
+      jest.mocked(revokeSentLink).mockRejectedValue(new Error('offline'));
+      await renderScreen();
+      jest.mocked(listSentLinks).mockResolvedValue([{ ...ACTIVE, status: 'revoked' }]);
+
+      await confirmRevoke();
+
+      expect(await screen.findByText('Link · 3 spots · Revoked')).toBeOnTheScreen();
+    });
+
+    it('a revoke that finds no session (signed out meanwhile) alerts nothing and keeps the row Active', async () => {
+      signIn([], [ACTIVE]);
+      jest.mocked(revokeSentLink).mockResolvedValue(null);
+      await renderScreen();
+
+      await confirmRevoke();
+
+      expect(alert).toHaveBeenCalledTimes(1); // the confirm only
+      expect(screen.getByText('Link · 3 spots · Active until Nov 21')).toBeOnTheScreen();
+    });
+
+    it('a double tap on the confirm sends one revoke, and the row shows a spinner meanwhile', async () => {
+      signIn([], [ACTIVE]);
+      let finish: () => void = () => {};
+      jest.mocked(revokeSentLink).mockImplementation(() => new Promise((resolve) => (finish = () => resolve(true))));
+      await renderScreen();
+
+      await act(async () => {
+        fireEvent.press(screen.getByRole('button', { name: 'Revoke the link to 3 spots' }));
+      });
+      const confirm = lastAlert().buttons.find((b) => b.text === 'Revoke')!;
+      await act(async () => {
+        confirm.onPress?.();
+        confirm.onPress?.();
+      });
+      expect(screen.getByLabelText('Revoking')).toBeOnTheScreen();
+      await act(async () => finish());
+
+      expect(revokeSentLink).toHaveBeenCalledTimes(1);
+      expect(screen.getByText('Link · 3 spots · Revoked')).toBeOnTheScreen();
+    });
+
+    it('the screen never says Share', async () => {
+      signIn([BEN], [ACTIVE, EXPIRED]);
+      await renderScreen();
+
+      expect(screen.queryByText(/share/i)).toBeNull();
+      const source = readFileSync(join(__dirname, '../../app/sent/index.tsx'), 'utf8');
+      expect(source).not.toMatch(/share/i);
+    });
+  });
+});
diff --git a/src/__tests__/session-storage.test.ts b/src/__tests__/session-storage.test.ts
new file mode 100644
index 0000000..142cf73
--- /dev/null
+++ b/src/__tests__/session-storage.test.ts
@@ -0,0 +1,172 @@
+// The session store (D61): SecureStore holds a small session; a large one is AES-GCM encrypted into
+// AsyncStorage with a fresh key in SecureStore. Both stores are mocked in jest.setup.ts with the members
+// of node_modules/expo-secure-store/build/SecureStore.d.ts (getItemAsync, setItemAsync, deleteItemAsync)
+// and the package's own @react-native-async-storage/async-storage/jest/async-storage-mock.
+import * as SecureStore from 'expo-secure-store';
+import AsyncStorage from '@react-native-async-storage/async-storage';
+
+import { sessionStorage } from '@/src/sync/session-storage';
+
+const KEY = 'sb-127-auth-token';
+const secure = (SecureStore as unknown as { __store: Map<string, string> }).__store;
+
+beforeEach(async () => {
+  secure.clear();
+  await AsyncStorage.clear();
+});
+
+describe('sessionStorage', () => {
+  it('stores a 100-byte value in SecureStore only', async () => {
+    const value = 'a'.repeat(100);
+
+    await sessionStorage.setItem(KEY, value);
+
+    expect(secure.get(KEY)).toBe(value);
+    expect(await AsyncStorage.getItem(KEY)).toBeNull();
+    expect(await sessionStorage.getItem(KEY)).toBe(value);
+  });
+
+  it('encrypts a 5000-byte value into AsyncStorage with a random key in SecureStore', async () => {
+    const value = JSON.stringify({ access_token: 'x'.repeat(4980) });
+
+    await sessionStorage.setItem(KEY, value);
+
+    expect(secure.get(KEY)).toMatch(/^aes256gcm:/);
+    expect(secure.get(KEY)).not.toContain('xxxx');
+    const stored = await AsyncStorage.getItem(KEY);
+    expect(stored).not.toBeNull();
+    expect(stored).not.toBe(value);
+    expect(stored).not.toContain('access_token');
+    expect(await sessionStorage.getItem(KEY)).toBe(value);
+  });
+
+  it('uses a fresh key on every large write', async () => {
+    const value = 'b'.repeat(5000);
+
+    await sessionStorage.setItem(KEY, value);
+    const first = secure.get(KEY);
+    await sessionStorage.setItem(KEY, value);
+
+    expect(secure.get(KEY)).not.toBe(first);
+    expect(await sessionStorage.getItem(KEY)).toBe(value);
+  });
+
+  it('drops the ciphertext when a large value is replaced by a small one', async () => {
+    await sessionStorage.setItem(KEY, 'c'.repeat(5000));
+    await sessionStorage.setItem(KEY, 'small');
+
+    expect(await AsyncStorage.getItem(KEY)).toBeNull();
+    expect(await sessionStorage.getItem(KEY)).toBe('small');
+  });
+
+  it('removeItem clears both stores', async () => {
+    await sessionStorage.setItem(KEY, 'd'.repeat(5000));
+
+    await sessionStorage.removeItem(KEY);
+
+    expect(secure.has(KEY)).toBe(false);
+    expect(await AsyncStorage.getItem(KEY)).toBeNull();
+    expect(await sessionStorage.getItem(KEY)).toBeNull();
+  });
+
+  it('returns null for a missing key', async () => {
+    expect(await sessionStorage.getItem('nothing-here')).toBeNull();
+  });
+
+  it('reads a key with no ciphertext (after a reinstall) as signed out and clears it', async () => {
+    await sessionStorage.setItem(KEY, 'e'.repeat(5000));
+    // The iOS keychain outlives the app; AsyncStorage does not.
+    await AsyncStorage.removeItem(KEY);
+
+    expect(await sessionStorage.getItem(KEY)).toBeNull();
+    expect(secure.has(KEY)).toBe(false);
+  });
+
+  it('reads tampered ciphertext as signed out without throwing', async () => {
+    await sessionStorage.setItem(KEY, 'f'.repeat(5000));
+    const stored = (await AsyncStorage.getItem(KEY)) as string;
+    const bytes = Buffer.from(stored, 'base64');
+    bytes[20] ^= 0xff;
+    await AsyncStorage.setItem(KEY, bytes.toString('base64'));
+
+    await expect(sessionStorage.getItem(KEY)).resolves.toBeNull();
+    expect(secure.has(KEY)).toBe(false);
+    expect(await AsyncStorage.getItem(KEY)).toBeNull();
+  });
+
+  it('counts UTF-8 bytes, not characters: 1500 multibyte characters (é, an emoji) are encrypted', async () => {
+    const value = 'é'.repeat(1499) + '😀';
+    expect(value.length).toBeLessThan(2048);
+
+    await sessionStorage.setItem(KEY, value);
+
+    expect(secure.get(KEY)).toMatch(/^aes256gcm:/);
+    expect(await sessionStorage.getItem(KEY)).toBe(value);
+  });
+
+  it('keeps a value of exactly 2048 bytes in SecureStore', async () => {
+    const value = 'g'.repeat(2048);
+
+    await sessionStorage.setItem(KEY, value);
+
+    expect(secure.get(KEY)).toBe(value);
+    expect(await AsyncStorage.getItem(KEY)).toBeNull();
+  });
+
+  it('writes SecureStore entries readable after first unlock (background refresh)', async () => {
+    await sessionStorage.setItem(KEY, 'h');
+
+    expect(SecureStore.setItemAsync).toHaveBeenLastCalledWith(KEY, 'h', {
+      keychainAccessible: SecureStore.AFTER_FIRST_UNLOCK,
+    });
+
+    await sessionStorage.setItem(KEY, 'h'.repeat(5000));
+
+    expect(SecureStore.setItemAsync).toHaveBeenLastCalledWith(KEY, expect.stringMatching(/^aes256gcm:/), {
+      keychainAccessible: SecureStore.AFTER_FIRST_UNLOCK,
+    });
+  });
+
+  it('ends with a readable session when two large writes overlap', async () => {
+    const first = 'i'.repeat(5000);
+    const second = 'j'.repeat(5000);
+    // The first write's ciphertext lands late, after the second write has finished.
+    const realSetItem = jest.mocked(AsyncStorage.setItem).getMockImplementation()!;
+    jest.mocked(AsyncStorage.setItem).mockImplementationOnce(async (key, value) => {
+      await new Promise((resolve) => setTimeout(resolve, 10));
+      return realSetItem(key, value);
+    });
+
+    await Promise.all([sessionStorage.setItem(KEY, first), sessionStorage.setItem(KEY, second)]);
+
+    expect(await sessionStorage.getItem(KEY)).toBe(second);
+  });
+
+  it('a read during a large write waits for it instead of wiping the session', async () => {
+    await sessionStorage.setItem(KEY, 'l'.repeat(5000));
+    const next = 'm'.repeat(5000);
+
+    const write = sessionStorage.setItem(KEY, next);
+    const read = sessionStorage.getItem(KEY);
+    await write;
+
+    expect(await read).toBe(next);
+    expect(await sessionStorage.getItem(KEY)).toBe(next);
+  });
+
+  it('keeps the session when AsyncStorage fails to read for a moment', async () => {
+    const value = 'k'.repeat(5000);
+    await sessionStorage.setItem(KEY, value);
+    jest.mocked(AsyncStorage.getItem).mockRejectedValueOnce(new Error('disk busy'));
+
+    expect(await sessionStorage.getItem(KEY)).toBeNull();
+
+    expect(await sessionStorage.getItem(KEY)).toBe(value);
+  });
+
+  it('never throws when the keychain read fails', async () => {
+    jest.mocked(SecureStore.getItemAsync).mockRejectedValueOnce(new Error('keychain locked'));
+
+    await expect(sessionStorage.getItem(KEY)).resolves.toBeNull();
+  });
+});
diff --git a/src/__tests__/share-list-sheet.test.tsx b/src/__tests__/share-list-sheet.test.tsx
new file mode 100644
index 0000000..e9b423f
--- /dev/null
+++ b/src/__tests__/share-list-sheet.test.tsx
@@ -0,0 +1,382 @@
+import { readFileSync } from 'fs';
+import { join } from 'path';
+import { act, fireEvent, render, screen } from '@testing-library/react-native';
+import { useRouter } from 'expo-router';
+import { useSQLiteContext as sharedDb } from 'expo-sqlite';
+
+import { createFakeSupabase, fakeSession, type FakeSupabase } from './helpers/fake-supabase';
+
+let mockFake: FakeSupabase | null = null;
+jest.mock('@/src/sync/client', () => ({
+  getSupabase: () => mockFake,
+  isConfigured: () => mockFake !== null,
+}));
+// The calls themselves are src/sync/lists.ts's (sync-lists.test.ts); here only what the sheet asks of them.
+jest.mock('@/src/sync/lists', () => ({
+  ...jest.requireActual('@/src/sync/lists'),
+  shareList: jest.fn(),
+  invite: jest.fn(),
+}));
+jest.mock('@/src/sync/engine', () => ({ syncNow: jest.fn().mockResolvedValue(undefined) }));
+jest.mock('@/src/sync/friends', () => ({
+  ...jest.requireActual('@/src/sync/friends'),
+  refreshFriends: jest.fn().mockResolvedValue(undefined),
+}));
+
+import { ACCOUNTS_NOT_SET_UP } from '@/src/components';
+import { ShareListSheet } from '@/src/components/ShareListSheet';
+import { useHitListsStore, useSpotsStore } from '@/src/stores';
+import { SIGNED_OUT, useAuthStore, type AuthSnapshot } from '@/src/stores/auth-store';
+import { EMPTY_FRIENDS, useFriendsStore } from '@/src/stores/friends-store';
+import { clearToast, useToastStore } from '@/src/stores/toast-store';
+import { syncNow } from '@/src/sync/engine';
+import { type FriendsData } from '@/src/sync/friends';
+import { invite, ListNotBackedUpError, NotAllowedError, shareList } from '@/src/sync/lists';
+import type { HitList } from '@/src/types';
+import { CITIES, createTestHitList, createTestSpot } from './factories';
+
+const RIDER: AuthSnapshot = {
+  status: 'signed_in',
+  userId: 'user-me',
+  email: 'me@example.com',
+  username: 'me',
+  displayName: null,
+};
+
+const profile = (id: string, username: string | null, display_name: string | null = null) => ({
+  id,
+  username,
+  display_name,
+});
+const ANA = profile('id-ana', 'ana', 'Ana B');
+const BEN = profile('id-ben', 'ben');
+const CAL = profile('id-cal', 'cal');
+const friendRow = (p: typeof ANA) => ({ friendshipId: `f-${p.id}`, created_at: '2026-10-20T10:00:00.000Z', profile: p });
+const FRIENDS: FriendsData = { ...EMPTY_FRIENDS, friends: [ANA, BEN].map(friendRow) };
+
+const D34 = (name: string) =>
+  `Everyone here sees every spot in ${name} — including spots added later — until you remove them or stop sharing.`;
+const AREA_LINE = "They'll see your spots inside this area, now and later";
+const NOT_BACKED_UP = "This list isn't backed up yet. Try again when you're online.";
+const FAILED = "Couldn't share. Try again.";
+
+const db = sharedDb();
+let router: { push: jest.Mock };
+let onClose: jest.Mock;
+let warn: jest.SpyInstance;
+
+const spots = Array.from({ length: 12 }, (_, i) => createTestSpot({ id: `s${i}`, owner_id: 'user-me' }));
+const downtown = createTestHitList({ id: 'L-downtown', name: 'Downtown', owner_id: 'user-me' });
+
+function setList(list: HitList, spotIds = spots.map((s) => s.id)) {
+  useHitListsStore.setState({
+    lists: [list],
+    membershipBySpot: Object.fromEntries(spotIds.map((id) => [id, [list.id]])),
+    activeListId: null,
+  });
+}
+
+function signIn(data: FriendsData = FRIENDS) {
+  mockFake?.setSession(fakeSession({ userId: 'user-me' }));
+  useAuthStore.setState(RIDER);
+  useFriendsStore.getState().applyFriends('user-me', data);
+}
+
+async function renderSheet(mode: 'share' | 'invite' = 'share', listId = downtown.id) {
+  render(<ShareListSheet listId={listId} mode={mode} onClose={onClose} />);
+  await act(async () => {});
+}
+
+const friend = (handle: string) => screen.getByRole('checkbox', { name: handle });
+const shareButton = (name = 'Share') => screen.getByRole('button', { name });
+const allText = () =>
+  screen
+    .queryAllByText(/./)
+    .map((t) => [t.props.children].flat().join(''))
+    .join('\n');
+
+async function press(el: ReturnType<typeof screen.getByRole>) {
+  await act(async () => {
+    fireEvent.press(el);
+  });
+}
+
+beforeEach(() => {
+  mockFake = createFakeSupabase();
+  useAuthStore.setState(SIGNED_OUT);
+  useFriendsStore.getState().clearFriends();
+  clearToast();
+  useSpotsStore.setState({ spots });
+  setList(downtown);
+  router = { push: jest.fn() };
+  jest.mocked(useRouter).mockReturnValue(router as never);
+  onClose = jest.fn();
+  warn = jest.spyOn(console, 'warn').mockImplementation(() => {});
+  jest.mocked(shareList).mockReset().mockResolvedValue(true);
+  jest.mocked(invite).mockReset().mockResolvedValue(true);
+  jest.mocked(syncNow).mockReset().mockResolvedValue(undefined);
+});
+
+afterEach(() => {
+  clearToast();
+  warn.mockRestore();
+});
+
+describe('ShareListSheet without an account', () => {
+  it("an unconfigured build says accounts aren't set up", async () => {
+    mockFake = null;
+    await renderSheet();
+    expect(screen.getByText(ACCOUNTS_NOT_SET_UP)).toBeOnTheScreen();
+    expect(screen.queryByRole('button', { name: 'Share' })).toBeNull();
+  });
+
+  it("signed out shows 'Sign in to share hit lists' and Sign in, which closes and opens sign-in", async () => {
+    await renderSheet();
+    expect(screen.getByText('Sign in to share hit lists')).toBeOnTheScreen();
+    expect(screen.queryByRole('button', { name: 'Share' })).toBeNull();
+
+    fireEvent.press(screen.getByRole('button', { name: 'Sign in' }));
+    expect(onClose).toHaveBeenCalled();
+    expect(router.push).toHaveBeenCalledWith('/auth/sign-in');
+  });
+
+  it('Cancel closes the sheet', async () => {
+    await renderSheet();
+    fireEvent.press(screen.getByRole('button', { name: 'Cancel' }));
+    expect(onClose).toHaveBeenCalled();
+  });
+});
+
+describe('ShareListSheet signed in', () => {
+  it("shows 'Share Downtown', a checkbox per friend, the roles, the D34 sentence and the count line", async () => {
+    signIn();
+    await renderSheet();
+
+    expect(screen.getByText('Share Downtown')).toBeOnTheScreen();
+    expect(friend('@ana').props.accessibilityState).toMatchObject({ checked: false });
+    expect(friend('@ben').props.accessibilityState).toMatchObject({ checked: false });
+    expect(screen.getByText('Ana B')).toBeOnTheScreen();
+    expect(screen.getByRole('tab', { name: 'Can add spots' }).props.accessibilityState).toMatchObject({ selected: true });
+    expect(screen.getByRole('tab', { name: 'View only' }).props.accessibilityState).toMatchObject({ selected: false });
+    expect(screen.getByText(D34('Downtown'))).toBeOnTheScreen();
+    expect(screen.getByText('12 spots will become visible to them')).toBeOnTheScreen();
+    expect(screen.queryByText(AREA_LINE)).toBeNull();
+  });
+
+  it("reads 'One spot will become visible to them' for one, and no count line for an empty list", async () => {
+    signIn();
+    setList(downtown, ['s0']);
+    await renderSheet();
+    expect(screen.getByText('One spot will become visible to them')).toBeOnTheScreen();
+
+    await act(async () => setList(downtown, []));
+    expect(screen.queryByText(/will become visible/)).toBeNull();
+  });
+
+  it('Share is disabled until a friend is checked; a second tap unchecks', async () => {
+    signIn();
+    await renderSheet();
+    expect(shareButton().props.accessibilityState).toMatchObject({ disabled: true });
+
+    fireEvent.press(friend('@ana'));
+    expect(friend('@ana').props.accessibilityState).toMatchObject({ checked: true });
+    expect(shareButton().props.accessibilityState).toMatchObject({ disabled: false });
+
+    fireEvent.press(friend('@ana'));
+    expect(shareButton().props.accessibilityState).toMatchObject({ disabled: true });
+  });
+
+  it("Share backs up, calls shareList(listId, [ana], 'add'), closes and toasts 'Shared Downtown with @ana'", async () => {
+    signIn();
+    await renderSheet();
+
+    fireEvent.press(friend('@ana'));
+    await press(shareButton());
+
+    expect(syncNow).toHaveBeenCalledWith(db);
+    expect(jest.mocked(syncNow).mock.invocationCallOrder[0]).toBeLessThan(
+      jest.mocked(shareList).mock.invocationCallOrder[0],
+    );
+    expect(shareList).toHaveBeenCalledWith(db, mockFake, 'user-me', 'L-downtown', ['id-ana'], 'add');
+    expect(invite).not.toHaveBeenCalled();
+    expect(onClose).toHaveBeenCalled();
+    expect(useToastStore.getState().text).toBe('Shared Downtown with @ana');
+  });
+
+  it("View only shares with role 'view'; two friends toast 'with 2 friends'", async () => {
+    signIn();
+    await renderSheet();
+
+    fireEvent.press(screen.getByRole('tab', { name: 'View only' }));
+    fireEvent.press(friend('@ana'));
+    fireEvent.press(friend('@ben'));
+    await press(shareButton());
+
+    expect(shareList).toHaveBeenCalledWith(db, mockFake, 'user-me', 'L-downtown', ['id-ana', 'id-ben'], 'view');
+    expect(useToastStore.getState().text).toBe('Shared Downtown with 2 friends');
+  });
+
+  it('a double tap shares once', async () => {
+    signIn();
+    let finish: (v: boolean) => void = () => {};
+    jest.mocked(shareList).mockReturnValue(new Promise((r) => (finish = r)));
+    await renderSheet();
+
+    fireEvent.press(friend('@ana'));
+    // two taps before any re-render: the button isn't disabled yet, only the ref stops the second
+    const button = shareButton();
+    await act(async () => {
+      fireEvent.press(button);
+      fireEvent.press(button);
+    });
+    expect(syncNow).toHaveBeenCalledTimes(1);
+    expect(shareList).toHaveBeenCalledTimes(1);
+    // can't close while the server call runs
+    fireEvent.press(screen.getByRole('button', { name: 'Cancel' }));
+    expect(onClose).not.toHaveBeenCalled();
+
+    await act(async () => finish(true));
+    expect(onClose).toHaveBeenCalledTimes(1);
+  });
+
+  it('Cancel during the backup closes the sheet and nothing is shared', async () => {
+    signIn();
+    let backedUp: () => void = () => {};
+    jest.mocked(syncNow).mockReturnValue(new Promise<void>((r) => (backedUp = r)));
+    await renderSheet();
+
+    fireEvent.press(friend('@ana'));
+    await press(shareButton());
+    fireEvent.press(screen.getByRole('button', { name: 'Cancel' }));
+    expect(onClose).toHaveBeenCalledTimes(1);
+
+    await act(async () => backedUp());
+    expect(shareList).not.toHaveBeenCalled();
+  });
+
+  it("a list not backed up yet shows the D85 line and stays open", async () => {
+    signIn();
+    jest.mocked(shareList).mockRejectedValue(new ListNotBackedUpError());
+    await renderSheet();
+
+    fireEvent.press(friend('@ana'));
+    await press(shareButton());
+
+    expect(screen.getByText(NOT_BACKED_UP)).toBeOnTheScreen();
+    expect(onClose).not.toHaveBeenCalled();
+    expect(friend('@ana').props.accessibilityState).toMatchObject({ checked: true });
+  });
+
+  it("a server error shows \"Couldn't share. Try again.\" and warns; a lost session (false) says the same", async () => {
+    signIn();
+    jest.mocked(shareList).mockRejectedValueOnce(new Error('boom')).mockResolvedValueOnce(false);
+    await renderSheet();
+
+    fireEvent.press(friend('@ana'));
+    await press(shareButton());
+    expect(screen.getByText(FAILED)).toBeOnTheScreen();
+    expect(warn).toHaveBeenCalled();
+
+    await press(shareButton());
+    expect(screen.getByText(FAILED)).toBeOnTheScreen();
+    expect(onClose).not.toHaveBeenCalled();
+  });
+
+  it("a 42501 shows \"You can't do that in this list any more.\"", async () => {
+    signIn();
+    jest.mocked(shareList).mockRejectedValue(new NotAllowedError());
+    await renderSheet();
+
+    fireEvent.press(friend('@ana'));
+    await press(shareButton());
+    expect(screen.getByText("You can't do that in this list any more.")).toBeOnTheScreen();
+  });
+
+  it("no friends: 'Add a friend first' and 'Find friends', which closes and opens Friends", async () => {
+    signIn(EMPTY_FRIENDS);
+    await renderSheet();
