+  ('00000000-0000-0000-0000-0000000000e7', 'G', 'area', false, 48.0, -122.0, 1000, null, null),
+  ('00000000-0000-0000-0000-0000000000e8', 'H', 'area', true, 48.1, -122.0, 1000, null, now())
