index 0000000..cb3c617
--- /dev/null
+++ b/src/__tests__/sync-copy.test.ts
@@ -0,0 +1,167 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteDatabase } from 'expo-sqlite';
+import { createMigratedTestDb } from './helpers/node-sqlite-db';
+import { createFakeSupabase, fakeSession, type FakeSupabase } from './helpers/fake-supabase';
+import { fakeFs } from './helpers/fake-fs';
+import { ME, adoptPhoneFor, outboxOps } from './helpers/outbox';
+import { createTestMedia, createTestSpot } from './factories';
+
+import { getMediaForSpot, getSpot, getSpots, insertMedia, insertSpot } from '@/src/db';
+import { upsertProfiles } from '@/src/db/profiles';
+import { saveCopy } from '@/src/sync/copy';
+import { useSpotsStore } from '@/src/stores';
+import { INITIAL_SYNC, useSyncStore } from '@/src/stores/sync-store';
+import { FeatureType } from '@/src/types';
+
+const ANA = 'rider-ana';
+const DOC = 'file:///data/Documents/';
+const CACHE = 'file:///data/Caches/';
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+
+let db: SQLiteDatabase;
+let fake: FakeSupabase;
+const client = () => fake as unknown as SupabaseClient;
+
+const anas = createTestSpot({
+  id: 'anas-ledge',
+  name: 'Courthouse ledge',
+  generated_name: 'Capitol Hill',
+  owner_id: ANA,
+  feature_types: [FeatureType.Ledge, FeatureType.Rail],
+  stopped: true,
+  natural_speed: 0,
+  notes: 'Security after 6',
+  location: { latitude: 47.62, longitude: -122.31 },
+  created_at: '2026-09-01T10:00:00.000Z',
+  updated_at: '2026-09-02T10:00:00.000Z',
+});
+const first = createTestMedia({
+  id: 'p1',
+  spot_id: anas.id,
+  file_path: `cache/photos/${anas.id}/p1.jpg`,
+  captured_at: '2026-09-01',
+  created_at: '2026-09-01T10:00:00.000Z',
+});
+const second = createTestMedia({
+  id: 'p2',
+  spot_id: anas.id,
+  file_path: `cache/photos/${anas.id}/p2.jpg`,
+  created_at: '2026-09-01T10:01:00.000Z',
+});
+const BYTES1 = new Uint8Array([1, 1]);
+const BYTES2 = new Uint8Array([2, 2]);
+
+beforeEach(async () => {
+  fakeFs.__resetFs();
+  db = await createMigratedTestDb();
+  await adoptPhoneFor(db);
+  fake = createFakeSupabase({ session: fakeSession({ userId: ME }) });
+  await upsertProfiles(db, [{ id: ANA, username: 'ana', display_name: null }]);
+  // others' rows arrive by pull: owned by ana, so no trigger queues them here
+  await insertSpot(db, { ...anas, primary_photo_id: second.id });
+  await insertMedia(db, first);
+  await insertMedia(db, second);
+  fakeFs.__putFile(`${CACHE}photos/${anas.id}/p1.jpg`, BYTES1);
+  fake.objects.set(`photos/${ANA}/${anas.id}/p2.jpg`, BYTES2);
+  useSpotsStore.setState({ spots: [] });
+  useSyncStore.setState({ ...INITIAL_SYNC, adoptedUserId: ME });
+});
+
+describe('saveCopy (S8, D47/D89): another rider\'s spot becomes the rider\'s own private spot', () => {
+  it('inserts an owned copy From @ana with the same name, tags, speed, notes, place and town, queued for backup', async () => {
+    const result = await saveCopy(db, client(), ME, anas.id);
+
+    expect(result.spotId).toMatch(UUID);
+    expect(result.missingPhotos).toBe(0);
+    const copy = await getSpot(db, result.spotId);
+    expect(copy).toMatchObject({
+      owner_id: ME,
+      from_username: 'ana',
+      name: 'Courthouse ledge',
+      generated_name: 'Capitol Hill',
+      feature_types: [FeatureType.Ledge, FeatureType.Rail],
+      stopped: true,
+      natural_speed: 0,
+      notes: 'Security after 6',
+      location: anas.location,
+    });
+    expect(copy?.copied_from_send).toBeUndefined();
+    expect(copy?.created_at).not.toBe(anas.created_at);
+    const ops = await outboxOps(db);
+    expect(ops.filter(([, id]) => id === result.spotId)).toEqual([['spot', result.spotId, 'upsert']]);
+    expect(ops.filter(([entity]) => entity === 'media')).toHaveLength(2);
+    // ana's spot is untouched, and the stores show the copy
+    expect(await getSpot(db, anas.id)).toMatchObject({ owner_id: ANA, name: 'Courthouse ledge' });
+    expect(useSpotsStore.getState().spots.map((s) => s.id).sort()).toEqual(
+      (await getSpots(db)).map((s) => s.id).sort(),
+    );
+  });
+
+  it('copies each cached photo into Paths.document/photos/<newId>/ as owned media (downloading a missing one first), primary mapped', async () => {
+    const { spotId } = await saveCopy(db, client(), ME, anas.id);
+
+    const media = await getMediaForSpot(db, spotId);
+    expect(media).toHaveLength(2);
+    for (const m of media) {
+      expect(m.id).toMatch(UUID);
+      expect(m.owner_id).toBe(ME);
+      expect(m.file_path).toBe(`photos/${spotId}/${m.id}.jpg`);
+    }
+    expect(media.map((m) => fakeFs.__fileBytes(`${DOC}${m.file_path}`))).toEqual([BYTES1, BYTES2]);
+    expect(media[0].captured_at).toBe('2026-09-01');
+    expect((await getSpot(db, spotId))?.primary_photo_id).toBe(media[1].id);
+    // the download landed in the cache, never in Documents under ana's spot
+    expect(fakeFs.__fileBytes(`${CACHE}photos/${anas.id}/p2.jpg`)).toEqual(BYTES2);
+    expect(fakeFs.__fileExists(`${DOC}photos/${anas.id}/p2.jpg`)).toBe(false);
+  });
+
+  it('a photo that cannot be downloaded is left out and counted (missingPhotos: 1); the primary is cleared', async () => {
+    fake.objects.clear();
+    const warn = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+    const { spotId, missingPhotos } = await saveCopy(db, client(), ME, anas.id);
+
+    expect(missingPhotos).toBe(1);
+    const media = await getMediaForSpot(db, spotId);
+    expect(media).toHaveLength(1);
+    expect(fakeFs.__fileBytes(`${DOC}${media[0].file_path}`)).toEqual(BYTES1);
+    expect((await getSpot(db, spotId))?.primary_photo_id).toBeUndefined();
+    warn.mockRestore();
+  });
+
+  it('a photo row that fails to insert after the spot is saved is left out and counted, never a second copy (review A#7)', async () => {
+    // the copy's second photo (the primary) fails: the spot and the first photo are already saved and queued
+    await db.execAsync(`CREATE TRIGGER fail_second_photo BEFORE INSERT ON media
+      WHEN NEW.spot_id <> 'anas-ledge' AND (SELECT count(*) FROM media WHERE spot_id = NEW.spot_id) >= 1
+      BEGIN SELECT RAISE(ABORT, 'disk full'); END`);
+    const warn = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+    const { spotId, missingPhotos } = await saveCopy(db, client(), ME, anas.id);
+
+    expect(missingPhotos).toBe(1);
+    expect((await getSpots(db)).filter((s) => s.owner_id === ME)).toHaveLength(1);
+    const media = await getMediaForSpot(db, spotId);
+    expect(media).toHaveLength(1);
+    // the primary was the photo that failed: the copy has none, and the failed file is gone
+    expect((await getSpot(db, spotId))?.primary_photo_id).toBeUndefined();
+    expect(fakeFs.__writes().filter((uri) => uri.startsWith(`${DOC}photos/${spotId}/`)).filter((uri) => fakeFs.__fileExists(uri))).toEqual([
+      `${DOC}${media[0].file_path}`,
+    ]);
+    warn.mockRestore();
+  });
+
+  it("refuses the rider's own spot or one that isn't here, writing nothing", async () => {
+    await insertSpot(db, createTestSpot({ id: 'mine', owner_id: ME }));
+    const before = await outboxOps(db);
+    await expect(saveCopy(db, client(), ME, 'mine')).rejects.toThrow("not another rider's spot");
+    await expect(saveCopy(db, client(), ME, 'gone')).rejects.toThrow("not another rider's spot");
+    expect(await outboxOps(db)).toEqual(before);
+  });
+
+  it("refuses while the phone isn't the rider's yet (adoption pending): the copy would never back up", async () => {
+    useSyncStore.setState({ adoptedUserId: null });
+    await expect(saveCopy(db, client(), ME, anas.id)).rejects.toThrow("this phone isn't your account yet");
+    expect(await getSpots(db)).toHaveLength(1);
+    expect(fakeFs.__writes()).toEqual([]);
+  });
+});
diff --git a/src/__tests__/sync-engine.test.ts b/src/__tests__/sync-engine.test.ts
new file mode 100644
index 0000000..b6b562a
--- /dev/null
+++ b/src/__tests__/sync-engine.test.ts
@@ -0,0 +1,492 @@
+import type { SQLiteDatabase } from 'expo-sqlite';
+import { createMigratedTestDb } from './helpers/node-sqlite-db';
+import { createFakeSupabase, fakeSession, type FakeSupabase } from './helpers/fake-supabase';
+import { ME, adoptPhoneFor } from './helpers/outbox';
+import { createTestHitList, createTestMedia, createTestSpot } from './factories';
+import { fakeFs } from './helpers/fake-fs';
+
+let mockFake: FakeSupabase | null = null;
+jest.mock('@/src/sync/client', () => ({
+  getSupabase: () => mockFake,
+  isConfigured: () => mockFake !== null,
+}));
+jest.mock('@/src/sync/push', () => ({ push: jest.fn() }));
+jest.mock('@/src/sync/pull', () => ({ pull: jest.fn() }));
+// getSpots stays real; a test can slip a local change in while the engine's reload reads.
+jest.mock('@/src/db', () => {
+  const actual = jest.requireActual('@/src/db');
+  return { ...actual, getSpots: jest.fn(actual.getSpots) };
+});
+jest.mock('@/src/sync/photos', () => ({ ...jest.requireActual('@/src/sync/photos'), downloadMissingPhotos: jest.fn() }));
+
+import { addSpotsToList, getSpots, insertHitList, insertMedia, insertSpot } from '@/src/db';
+import { enqueue, getSyncState, setSyncState } from '@/src/db/sync';
+import { push } from '@/src/sync/push';
+import { pull } from '@/src/sync/pull';
+import { downloadMissingPhotos } from '@/src/sync/photos';
+import { runExclusive, syncNow } from '@/src/sync/engine';
+import { INITIAL_SYNC, useSyncStore } from '@/src/stores/sync-store';
+import { useHitListsStore, useMediaStore, useSpotsStore } from '@/src/stores';
+import { SIGNED_OUT, useAuthStore } from '@/src/stores/auth-store';
+import { useFriendsStore } from '@/src/stores/friends-store';
+import { useInboxStore } from '@/src/stores/inbox-store';
+
+const mockPush = jest.mocked(push);
+const mockPull = jest.mocked(pull);
+const mockDownload = jest.mocked(downloadMissingPhotos);
+
+let db: SQLiteDatabase;
+
+beforeEach(async () => {
+  db = await createMigratedTestDb();
+  await adoptPhoneFor(db, ME);
+  mockFake = createFakeSupabase({ session: fakeSession({ userId: ME }) });
+  mockPush.mockReset().mockResolvedValue({ pushed: 0, failed: 0 });
+  mockPull.mockReset().mockResolvedValue({ changed: false });
+  mockDownload.mockReset().mockResolvedValue(0);
+  useSyncStore.setState(INITIAL_SYNC);
+  useSpotsStore.setState({ spots: [] });
+  useMediaStore.setState({ mediaBySpot: {} });
+  useHitListsStore.setState({ lists: [], membershipBySpot: {} });
+  useAuthStore.setState({ ...SIGNED_OUT });
+  useFriendsStore.getState().clearFriends();
+  useInboxStore.getState().clearInbox();
+});
+
+describe('syncNow', () => {
+  it('runs push, then pull, then the photo downloads, as the session rider', async () => {
+    await syncNow(db);
+
+    expect(mockPush).toHaveBeenCalledTimes(1);
+    expect(mockPush).toHaveBeenCalledWith(db, mockFake, ME);
+    expect(mockPull).toHaveBeenCalledWith(db, mockFake, ME);
+    expect(mockDownload).toHaveBeenCalledWith(db, mockFake, ME);
+    const [pushOrder] = mockPush.mock.invocationCallOrder;
+    const [pullOrder] = mockPull.mock.invocationCallOrder;
+    const [downloadOrder] = mockDownload.mock.invocationCallOrder;
+    expect(pushOrder).toBeLessThan(pullOrder);
+    expect(pullOrder).toBeLessThan(downloadOrder);
+  });
+
+  it('is single-flight: a second call while one runs awaits the same sync', async () => {
+    let releasePush!: () => void;
+    mockPush.mockImplementationOnce(
+      () => new Promise((resolve) => (releasePush = () => resolve({ pushed: 1, failed: 0 }))),
+    );
+
+    const first = syncNow(db);
+    const second = syncNow(db);
+    await new Promise((r) => setImmediate(r));
+    expect(useSyncStore.getState().syncing).toBe(true);
+    releasePush();
+    await Promise.all([first, second]);
+
+    expect(mockPush).toHaveBeenCalledTimes(1);
+    expect(mockPull).toHaveBeenCalledTimes(1);
+    expect(useSyncStore.getState().syncing).toBe(false);
