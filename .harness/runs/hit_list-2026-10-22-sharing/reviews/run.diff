+-- Removed member loses read on the next query -----------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.member2')::uuid);
+select is_empty($$ select id from public.spots where id = '00000000-0000-0000-0000-0000000000b3' $$,
