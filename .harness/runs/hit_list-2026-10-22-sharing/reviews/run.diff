+  '42501', null, 'view member cannot add a spot'
+);
+select throws_ok(
+  $$ update public.hit_list_members set role = 'add'
+     where list_id = '00000000-0000-0000-0000-0000000000e1' and user_id = current_setting('t.viewer')::uuid $$,
+  '42501', null, 'view member cannot make themselves an adder'
+);
+
+-- Invitations: Decline and withdraw through the functions, Join's rules -------------------------------------------
+select tests.authenticate_as(current_setting('t.decliner')::uuid);
+select lives_ok($$ select public.leave_list('00000000-0000-0000-0000-0000000000e1') $$,
+                'invitee declines through leave_list');
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select lives_ok($$ select public.remove_member('00000000-0000-0000-0000-0000000000e1',
+                                               current_setting('t.withdrawn')::uuid) $$,
+                'owner withdraws an invitation with remove_member');
+select tests.authenticate_as(current_setting('t.joiner')::uuid);
+select throws_ok(
+  $$ update public.hit_list_members set status = 'member', role = 'add'
+     where list_id = '00000000-0000-0000-0000-0000000000e1' and user_id = current_setting('t.joiner')::uuid $$,
+  '42501', null, 'a view invitee cannot join as an adder'
+);
+select results_eq(
+  $$ update public.hit_list_members set status = 'member', joined_at = '2000-01-01T00:00:00Z'
+     where list_id = '00000000-0000-0000-0000-0000000000e1' and user_id = current_setting('t.joiner')::uuid
+     returning joined_at > now() - interval '1 minute' $$,
+  $$ values (true) $$,
+  'Join stamps joined_at itself (a client value is ignored)'
+);
+select tests.authenticate_as(current_setting('t.late')::uuid);
+select throws_ok(
+  $$ update public.hit_list_members set status = 'member'
+     where list_id = '00000000-0000-0000-0000-0000000000e4' and user_id = current_setting('t.late')::uuid $$,
+  '42501', null, 'invitee cannot join a deleted list'
+);
+reset role;
+select ok(
+  not exists (select 1 from public.hit_list_members
+              where list_id = '00000000-0000-0000-0000-0000000000e1'
+                and user_id in (current_setting('t.decliner')::uuid, current_setting('t.withdrawn')::uuid))
+  and not exists (select 1 from public.hit_list_spots
+                  where list_id = '00000000-0000-0000-0000-0000000000e1'
+                    and added_by = current_setting('t.joiner')::uuid),
+  'declined and withdrawn invitations are gone; Join cleared a row left from an earlier membership'
+);
+
+-- leave_list (D43) --------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select throws_ok($$ select public.leave_list('00000000-0000-0000-0000-0000000000e1') $$,
+                 'the owner cannot leave their own list', 'owner cannot leave their own list');
+select tests.authenticate_as(current_setting('t.leaver')::uuid);
+select is(public.can_read_spot('00000000-0000-0000-0000-0000000000a1'), true, 'member reads the list spot before leaving');
+select lives_ok($$ select public.leave_list('00000000-0000-0000-0000-0000000000e1') $$, 'member leaves the list');
+select is(public.can_read_spot('00000000-0000-0000-0000-0000000000a1'), false, 'left member can_read_spot false');
+reset role;
+select ok(
+  not exists (select 1 from public.hit_list_members
+              where list_id = '00000000-0000-0000-0000-0000000000e1' and user_id = current_setting('t.leaver')::uuid)
+  and not exists (select 1 from public.hit_list_spots
+                  where list_id = '00000000-0000-0000-0000-0000000000e1'
+                    and added_by = current_setting('t.leaver')::uuid)
+  and exists (select 1 from public.hit_list_spots
+              where list_id = '00000000-0000-0000-0000-0000000000e1'
+                and spot_id = '00000000-0000-0000-0000-0000000000a1')
+  and exists (select 1 from public.spots where id = '00000000-0000-0000-0000-0000000000c3'),
+  'leave_list removes member and their spots (the owner''s stay, the spot itself stays)'
+);
+
+-- remove_member (D43) -----------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select lives_ok($$ select public.remove_member('00000000-0000-0000-0000-0000000000e1',
+                                               current_setting('t.removee')::uuid) $$,
+                'owner removes a member');
+select throws_ok($$ select public.remove_member('00000000-0000-0000-0000-0000000000e1',
+                                                current_setting('t.stranger')::uuid) $$,
+                 'not a member of this list', 'remove_member raises for someone not in the list');
+select tests.authenticate_as(current_setting('t.removee')::uuid);
+select is(public.can_read_spot('00000000-0000-0000-0000-0000000000a1'), false, 'remove_member drops read');
+select is_empty($$ select id from public.hit_lists $$, 'removed member reads the list no more');
+reset role;
+select ok(
+  not exists (select 1 from public.hit_list_spots
+              where list_id = '00000000-0000-0000-0000-0000000000e1'
+                and added_by = current_setting('t.removee')::uuid),
+  'remove_member takes the member''s spots out of the list'
+);
+
+-- A direct DELETE by the owner does the same (one trigger for Leave, Remove, Decline, Stop sharing) ----------------
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+delete from public.hit_list_members
+where list_id = '00000000-0000-0000-0000-0000000000e1' and user_id = current_setting('t.adder')::uuid;
+reset role;
+select ok(
+  not exists (select 1 from public.hit_list_spots
+              where list_id = '00000000-0000-0000-0000-0000000000e1'
+                and added_by = current_setting('t.adder')::uuid),
+  'a direct delete of a membership takes the member''s spots out too'
+);
+
+-- stop_sharing on e5 (members adder 'add' with b3, viewer 'view'; invitee pending; owner's a5; the stray c5) --------------------------------------
+select tests.authenticate_as(current_setting('t.adder')::uuid);
+select is(public.can_read_spot('00000000-0000-0000-0000-0000000000a5'), true,
+          'member reads the list spot before stop_sharing');
+select throws_ok($$ select public.stop_sharing('00000000-0000-0000-0000-0000000000e5') $$,
+                 'not the list owner', 'only the owner can stop sharing');
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select lives_ok($$ select public.stop_sharing('00000000-0000-0000-0000-0000000000e5') $$, 'owner stops sharing');
+select tests.authenticate_as(current_setting('t.adder')::uuid);
+select is(public.can_read_spot('00000000-0000-0000-0000-0000000000a5'), false, 'stop_sharing drops every member read');
+reset role;
+select results_eq(
+  $$ select l.shared,
+            (select count(*) from public.hit_list_members m where m.list_id = l.id),
+            array(select s.spot_id from public.hit_list_spots s where s.list_id = l.id)
+     from public.hit_lists l where l.id = '00000000-0000-0000-0000-0000000000e5' $$,
+  $$ values (false, 0::bigint, array['00000000-0000-0000-0000-0000000000a5'::uuid]) $$,
+  'stop_sharing unshares, drops every member and every row but the owner''s'
+);
+
+-- Unsharing by a plain UPDATE (a sync push) does the same ---------------------------------------------------------
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+update public.hit_lists set shared = false where id = '00000000-0000-0000-0000-0000000000e1';
+reset role;
+select ok(
+  not exists (select 1 from public.hit_list_members where list_id = '00000000-0000-0000-0000-0000000000e1')
+  and not exists (select 1 from public.hit_list_spots
+                  where list_id = '00000000-0000-0000-0000-0000000000e1'
+                    and added_by <> current_setting('t.owner')::uuid)
+  and exists (select 1 from public.hit_list_spots
+              where list_id = '00000000-0000-0000-0000-0000000000e1'
+                and added_by = current_setting('t.owner')::uuid),
+  'unsharing by a plain update drops every member and every row but the owner''s'
+);
+select tests.authenticate_as(current_setting('t.viewer')::uuid);
+select is_empty($$ select id from public.hit_lists $$, 'a former member reads no list once it is unshared');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/050-friends-rls.test.sql b/supabase/tests/050-friends-rls.test.sql
new file mode 100644
index 0000000..7107803
--- /dev/null
+++ b/supabase/tests/050-friends-rls.test.sql
@@ -0,0 +1,387 @@
+-- S3-05: profiles, friendships and blocks (D39 exact usernames, D50 blocking). §3.3 cases; the Case table in
+-- docs/plans/2026-10-22-s3-backend.md names each test.
+begin;
+select plan(91);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.me', tests.create_user('me@test.local', 'rider_me')::text, true);
+select set_config('t.ana', tests.create_user('ana@test.local', 'ana')::text, true);
+select set_config('t.friend', tests.create_user('friend@test.local', 'friend')::text, true);
+select set_config('t.stranger', tests.create_user('stranger@test.local', 'stranger')::text, true);
+select set_config('t.owner', tests.create_user('owner@test.local', 'owner')::text, true);
+select set_config('t.co', tests.create_user('co@test.local', 'comember')::text, true);
+select set_config('t.inv', tests.create_user('inv@test.local', 'invitee')::text, true);
+select set_config('t.goner', tests.create_user('goner@test.local', 'goner')::text, true);
+select set_config('t.blocker', tests.create_user('blocker@test.local', 'blocker')::text, true);
+select set_config('t.blockee', tests.create_user('blockee@test.local', 'blockee')::text, true);
+select set_config('t.noname', tests.create_user('noname@test.local')::text, true);
+select set_config('t.asker', tests.create_user('asker@test.local', 'asker')::text, true);
+select set_config('t.asker2', tests.create_user('asker2@test.local', 'asker_two')::text, true);
+select set_config('t.victim', tests.create_user('victim@test.local', 'victim')::text, true);
+select set_config('t.pest', tests.create_user('pest@test.local', 'pest')::text, true);
+select set_config('t.loner', tests.create_user('loner@test.local', 'loner')::text, true);
+select set_config('t.lonemate', tests.create_user('lonemate@test.local', 'lonemate')::text, true);
+update public.profiles set display_name = 'Ana R' where id = current_setting('t.ana')::uuid;
+
+-- Friendships (as postgres): me–friend and me–victim accepted; asker, asker2 and pest asked me (pending).
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(m, o), greatest(m, o), status, case when status = 'accepted' then m else o end
+from (select current_setting('t.me')::uuid as m, current_setting('t.' || who)::uuid as o, status
+      from (values ('friend', 'accepted'), ('victim', 'accepted')) as v(who, status)) p;
+with r as (
+  insert into public.friendships (user_a, user_b, status, requested_by)
+  select least(m, o), greatest(m, o), 'pending', o
+  from (select current_setting('t.me')::uuid as m, current_setting('t.' || who)::uuid as o, who
+        from unnest(array['asker', 'asker2', 'pest']) as who) p
+  returning id, requested_by
+)
+select set_config('t.f_' || case requested_by when current_setting('t.asker')::uuid then 'asker'
+                                              when current_setting('t.asker2')::uuid then 'asker2'
+                                              else 'pest' end, id::text, true)
+from r;
+
+-- Blocks: blocker blocked me; I blocked blockee.
+insert into public.blocks (blocker, blocked)
+values (current_setting('t.blocker')::uuid, current_setting('t.me')::uuid),
+       (current_setting('t.me')::uuid, current_setting('t.blockee')::uuid);
+
+-- Lists: f1 owner's shared 'Crew' (me and comember members, invitee invited) · f2 owner's shared but deleted 'Old
+-- crew' (me and goner members) · f3 mine, shared (victim invited, pest a member) · f4 pest's, shared (me invited) ·
+-- f5 friend's, shared (me invited; Remove friend withdraws it) · f6 loner's, not shared (me and lonemate members:
+-- only the service role can leave that state, unsharing drops members) · f7 comember's, shared (me invited: a third
+-- party's invitation a block leaves alone).
+insert into public.hit_lists (id, owner_id, name, kind, shared, updated_at, deleted_at)
+select id::uuid, current_setting('t.' || who)::uuid, name, 'manual', name <> 'Unshared', '2026-10-22T12:00:00Z',
+       deleted
+from (values
+  ('00000000-0000-0000-0000-0000000000f1', 'owner', 'Crew', null::timestamptz),
+  ('00000000-0000-0000-0000-0000000000f2', 'owner', 'Old crew', now()),
+  ('00000000-0000-0000-0000-0000000000f3', 'me', 'Mine', null),
+  ('00000000-0000-0000-0000-0000000000f4', 'pest', 'Pest list', null),
+  ('00000000-0000-0000-0000-0000000000f5', 'friend', 'Friend list', null),
+  ('00000000-0000-0000-0000-0000000000f6', 'loner', 'Unshared', null),
+  ('00000000-0000-0000-0000-0000000000f7', 'co', 'Third party', null)
+) as v(id, who, name, deleted);
+insert into public.hit_list_members (list_id, user_id, role, status)
+select l::uuid, current_setting('t.' || who)::uuid, 'add', status
+from (values
+  ('00000000-0000-0000-0000-0000000000f1', 'me', 'member'),
+  ('00000000-0000-0000-0000-0000000000f1', 'co', 'member'),
+  ('00000000-0000-0000-0000-0000000000f1', 'inv', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f2', 'me', 'member'),
+  ('00000000-0000-0000-0000-0000000000f2', 'goner', 'member'),
+  ('00000000-0000-0000-0000-0000000000f3', 'victim', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f3', 'pest', 'member'),
+  ('00000000-0000-0000-0000-0000000000f4', 'me', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f5', 'me', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f6', 'me', 'member'),
+  ('00000000-0000-0000-0000-0000000000f6', 'lonemate', 'member'),
+  ('00000000-0000-0000-0000-0000000000f7', 'me', 'invited')
+) as v(l, who, status);
+
+-- Shape -------------------------------------------------------------------------------------------------------------
+select policies_are('public', 'profiles', array['profiles_select', 'profiles_update'],
+                    'profiles has select and update policies (no insert: the signup trigger; no delete)');
+select policies_are('public', 'friendships', array['friendships_select', 'friendships_delete'],
+                    'friendships has select and delete policies (requests and answers go through functions)');
+select policies_are('public', 'blocks', array['blocks_select', 'blocks_delete'],
+                    'blocks has select and delete policies (block_user inserts)');
+select ok((select count(*) = 6 and bool_and(roles = array['authenticated']::name[]) from pg_policies
+           where schemaname = 'public' and tablename in ('profiles', 'friendships', 'blocks')),
+          'every profile, friendship and block policy applies to authenticated only (anon gets none)');
+select is(
+  array(select p from unnest(array['can_read_profile', 'find_profile', 'send_friend_request', 'lock_user_pair', 'guard_invite_block',
+                                   'withdraw_pair_invitations',
+                                   'respond_friend_request', 'block_user', 'unblock_user']) as p
+        where not exists (select 1 from pg_proc
+                          where proname = p and pronamespace = 'public'::regnamespace
+                            and prosecdef and 'search_path=""' = any(proconfig))),
+  '{}'::text[],
+  'every S3-05 function is security definer with search_path pinned'
+);
+select trigger_is('public', 'hit_list_members', 't05_block_guard', 'public', 'guard_invite_block',
+                  'a new membership takes the pair lock and re-checks blocks (no invite slips in behind a block)');
+select trigger_is('public', 'friendships', 't30_withdraw_invitations', 'public', 'withdraw_pair_invitations',
+                  'removing a friendship withdraws pending invitations between the two');
+select is(
+  array(select proname::text from pg_proc
+        where pronamespace = 'public'::regnamespace
+          and proname in ('can_read_profile', 'find_profile', 'send_friend_request', 'respond_friend_request',
+                          'block_user', 'unblock_user', 'keep_profile_identity', 'lock_user_pair',
+                          'guard_invite_block', 'withdraw_pair_invitations')
+          and has_function_privilege('authenticated', oid, 'execute')
+          and not has_function_privilege('anon', oid, 'execute')
+        order by 1),
+  array['block_user', 'can_read_profile', 'find_profile', 'respond_friend_request', 'send_friend_request',
+        'unblock_user'],
+  'authenticated executes the S3-05 functions, anon none, nobody the trigger function or the pair lock'
+);
+
+-- Who reads a profile -----------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select set_eq(
+  $$ select id from public.profiles $$,
+  $$ select current_setting('t.' || who)::uuid
+     from unnest(array['me', 'friend', 'victim', 'asker', 'asker2', 'pest', 'owner', 'co']) as who $$,
+  'a user reads exactly their own, friends'', requests to them and co-members'' profiles'
+);
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select is_empty($$ select id from public.profiles where id <> current_setting('t.stranger')::uuid $$,
+                'stranger reads no profile');
+select tests.authenticate_as(current_setting('t.friend')::uuid);
+select results_eq($$ select username::text from public.profiles where id = current_setting('t.me')::uuid $$,
+                  $$ values ('rider_me') $$, 'accepted friend reads the profile');
+select tests.authenticate_as(current_setting('t.co')::uuid);
+select results_eq($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                  $$ values (current_setting('t.me')::uuid) $$, 'co-member reads the profile (both members)');
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select results_eq($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                  $$ values (current_setting('t.me')::uuid) $$, 'list owner reads a member''s profile');
+select results_eq($$ select id from public.profiles where id = current_setting('t.inv')::uuid $$,
+                  $$ values (current_setting('t.inv')::uuid) $$, 'list owner reads an invitee''s profile');
+select tests.authenticate_as(current_setting('t.inv')::uuid);
+select results_eq($$ select id from public.profiles where id = current_setting('t.owner')::uuid $$,
+                  $$ values (current_setting('t.owner')::uuid) $$, 'invitee reads the list owner''s profile');
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'invitee reads no member''s profile');
+select tests.authenticate_as(current_setting('t.goner')::uuid);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'a deleted list makes no co-members');
+select is_empty($$ select id from public.profiles where id = current_setting('t.owner')::uuid $$,
+                'a deleted list''s member reads its owner''s profile no more');
+select tests.authenticate_as(current_setting('t.asker')::uuid);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'the sender of a pending request does not read the receiver''s profile (find_profile is the way)');
+select tests.authenticate_as(current_setting('t.lonemate')::uuid);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'members of an unshared list are not co-members');
+select is_empty($$ select id from public.profiles where id = current_setting('t.loner')::uuid $$,
+                'an unshared list''s owner and member are not co-members');
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select is(public.can_read_profile(current_setting('t.stranger')::uuid), false,
+          'can_read_profile is false for a stranger');
+reset role;
+select tests.clear_auth();
+select is_empty($$ select id from public.profiles $$, 'anon reads no profile');
+select throws_ok($$ select * from public.find_profile('ana') $$, '42501', null, 'anon cannot call find_profile');
+reset role;
+
+-- find_profile: exact, case-insensitive, three columns, silent for unknown, NULL and blocked ---------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select results_eq(
+  $$ select * from public.find_profile('Ana') $$,
+  $$ values (current_setting('t.ana')::uuid, 'ana'::extensions.citext, 'Ana R'::text) $$,
+  'find_profile(''Ana'') returns ana''s id, username and display name and nothing else'
+);
+select is_empty($$ select * from public.find_profile('an') $$, 'find_profile is exact (no prefix match)');
+select is_empty($$ select * from public.find_profile('nobody_here') $$,
+                'find_profile returns nothing for an unknown username');
+select is_empty($$ select * from public.find_profile(null) $$, 'find_profile(NULL) never matches a NULL username');
+select is_empty($$ select * from public.find_profile('') $$, 'find_profile('''') matches nothing');
+select is_empty($$ select * from public.find_profile('blocker') $$,
+                'find_profile returns nothing to someone the target blocked');
+select results_eq($$ select id from public.find_profile('blockee') $$,
+                  $$ values (current_setting('t.blockee')::uuid) $$,
+                  'the blocker still finds the user they blocked (to unblock them)');
+
+-- send_friend_request -----------------------------------------------------------------------------------------------
+select lives_ok($$ select set_config('t.req', public.send_friend_request('ANA')::text, true) $$,
+                'a user sends a friend request by username, any case');
+select results_eq(
+  $$ select user_a = least(current_setting('t.me')::uuid, current_setting('t.ana')::uuid),
+            user_b = greatest(current_setting('t.me')::uuid, current_setting('t.ana')::uuid),
+            status, requested_by = current_setting('t.me')::uuid
+     from public.friendships where id = current_setting('t.req', true)::uuid $$,
+  $$ values (true, true, 'pending', true) $$,
+  'send_friend_request inserts an ordered pending row requested by the caller'
+);
+select results_eq($$ select public.send_friend_request('ana') = current_setting('t.req', true)::uuid $$,
+                  $$ values (true) $$, 'a repeated request returns the same row');
+select results_eq($$ select status from public.friendships where id = current_setting('t.req', true)::uuid $$,
+                  $$ values ('pending') $$, 'asking again does not accept your own request');
+select tests.authenticate_as(current_setting('t.ana')::uuid);
+select results_eq($$ select public.send_friend_request('rider_me') = current_setting('t.req', true)::uuid $$,
+                  $$ values (true) $$, 'a request the other way returns the same row');
+reset role;
+select results_eq(
+  $$ select count(*), bool_and(status = 'accepted') from public.friendships
+     where user_a = least(current_setting('t.me')::uuid, current_setting('t.ana')::uuid)
+       and user_b = greatest(current_setting('t.me')::uuid, current_setting('t.ana')::uuid) $$,
+  $$ values (1::bigint, true) $$,
+  'a request the other way accepts instead of duplicating'
+);
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select throws_ok($$ select public.send_friend_request('blocker') $$, 'P0002', 'user not found',
+                 'blocked user cannot send friend request');
+select throws_ok($$ select public.send_friend_request('nobody_here') $$, 'P0002', 'user not found',
+                 'a request to an unknown username raises the same error as a block');
+select throws_ok($$ select public.send_friend_request('blockee') $$, '42501', null,
+                 'a user cannot send a friend request to someone they blocked');
+select throws_ok($$ select public.send_friend_request('rider_me') $$, '22023', null,
+                 'a user cannot send a friend request to themselves');
+reset role;
+select tests.clear_auth();
+select throws_ok($$ select public.send_friend_request('ana') $$, '42501', null,
+                 'anon cannot call send_friend_request');
+reset role;
+
+-- respond_friend_request --------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.asker')::uuid);
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'accept') $$,
+                 '42501', null, 'the requester cannot accept their own request');
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'accept') $$,
+                 '42501', null, 'someone outside the pair cannot respond');
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'maybe') $$,
+                 '22023', null, 'respond_friend_request takes only accept or decline');
+select lives_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'accept') $$,
+                'the person asked accepts');
+select results_eq($$ select status from public.friendships where id = current_setting('t.f_asker')::uuid $$,
+                  $$ values ('accepted') $$, 'an accepted request is a friendship');
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'decline') $$,
+                 '42501', null, 'an accepted friendship cannot be answered again');
+select lives_ok($$ select public.respond_friend_request(current_setting('t.f_asker2')::uuid, 'decline') $$,
+                'the person asked declines');
+reset role;
+select is_empty($$ select id from public.friendships where id = current_setting('t.f_asker2')::uuid $$,
+                'a declined request is deleted');
+
+-- friendships: read and remove only your own; no direct writes ----------------------------------------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select set_eq(
+  $$ select case when user_a = current_setting('t.me')::uuid then user_b else user_a end from public.friendships $$,
+  $$ select current_setting('t.' || who)::uuid from unnest(array['friend', 'victim', 'asker', 'pest', 'ana']) as who $$,
+  'a user reads exactly the friendships they are in'
+);
+select throws_ok(
+  $$ insert into public.friendships (user_a, user_b, status, requested_by)
+     values (least(current_setting('t.me')::uuid, current_setting('t.stranger')::uuid),
+             greatest(current_setting('t.me')::uuid, current_setting('t.stranger')::uuid), 'accepted',
+             current_setting('t.me')::uuid) $$,
+  '42501', null, 'nobody inserts a friendship directly'
+);
+select is_empty($$ update public.friendships set status = 'accepted' where id = current_setting('t.f_pest')::uuid
+                   returning id $$, 'nobody updates a friendship directly');
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select is_empty($$ select id from public.friendships $$, 'stranger reads no friendship');
+select is_empty($$ delete from public.friendships returning id $$, 'stranger removes no friendship');
+select tests.authenticate_as(current_setting('t.friend')::uuid);
+select results_eq(
+  $$ delete from public.friendships where current_setting('t.me')::uuid in (user_a, user_b) returning status $$,
+  $$ values ('accepted') $$, 'either friend removes the friendship'
+);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'a removed friend reads the profile no more');
+reset role;
+select is_empty($$ select 1 from public.hit_list_members
+                   where list_id = '00000000-0000-0000-0000-0000000000f5' and user_id = current_setting('t.me')::uuid $$,
+                'removing a friend withdraws their pending invitation');
+
+-- block_user / unblock_user (D50) ---------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select lives_ok($$ select public.block_user(current_setting('t.victim')::uuid) $$, 'a user blocks a friend');
+select lives_ok($$ select public.block_user(current_setting('t.victim')::uuid) $$, 'blocking twice is harmless');
+select lives_ok($$ select public.block_user(current_setting('t.pest')::uuid) $$,
+                'a user blocks someone with a pending request');
+select throws_ok($$ select public.block_user(current_setting('t.me')::uuid) $$, '22023', null,
+                 'a user cannot block themselves');
+select throws_ok($$ select public.block_user('00000000-0000-0000-0000-00000000dead') $$, 'P0002', 'user not found',
+                 'blocking an unknown id raises');
+select set_eq($$ select blocked from public.blocks $$,
+              $$ select current_setting('t.' || who)::uuid from unnest(array['victim', 'pest', 'blockee']) as who $$,
+              'the blocker reads their blocks');
+reset role;
+select is((select count(*) from public.blocks
+           where blocker = current_setting('t.me')::uuid and blocked = current_setting('t.victim')::uuid),
+          1::bigint, 'block_user inserts one block row');
+select is_empty(
+  $$ select id from public.friendships
+     where current_setting('t.me')::uuid in (user_a, user_b)
+       and (current_setting('t.victim')::uuid in (user_a, user_b) or current_setting('t.pest')::uuid in (user_a, user_b)) $$,
+  'block_user deletes the friendship and the blocked user''s pending request'
+);
+select is_empty(
+  $$ select 1 from public.hit_list_members
+     where (list_id = '00000000-0000-0000-0000-0000000000f3' and user_id = current_setting('t.victim')::uuid)
+        or (list_id = '00000000-0000-0000-0000-0000000000f4' and user_id = current_setting('t.me')::uuid) $$,
+  'block_user deletes pending invitations between the two, both ways'
+);
+select results_eq(
+  $$ select status from public.hit_list_members
+     where list_id = '00000000-0000-0000-0000-0000000000f3' and user_id = current_setting('t.pest')::uuid $$,
+  $$ values ('member') $$,
+  'a shared list both are in stays as it is (D50)'
+);
+select results_eq(
+  $$ select status from public.hit_list_members
+     where (list_id = '00000000-0000-0000-0000-0000000000f1' and user_id = current_setting('t.inv')::uuid)
+        or (list_id = '00000000-0000-0000-0000-0000000000f7' and user_id = current_setting('t.me')::uuid) $$,
+  $$ values ('invited'), ('invited') $$,
+  'block_user leaves other lists'' invitations alone'
+);
+select throws_ok(
+  $$ insert into public.hit_list_members (list_id, user_id, status)
+     values ('00000000-0000-0000-0000-0000000000f3', current_setting('t.victim')::uuid, 'invited') $$,
+  'blocked users cannot be added to each other''s lists',
+  'the block guard refuses a membership between a blocked pair even past the policies'
+);
+select throws_ok(
+  $$ insert into public.hit_list_members (list_id, user_id, status)
+     values ('00000000-0000-0000-0000-0000000000f3', current_setting('t.blocker')::uuid, 'member') $$,
+  'blocked users cannot be added to each other''s lists',
+  'the block guard works whichever side blocked'
+);
+select tests.authenticate_as(current_setting('t.victim')::uuid);
+select is_empty($$ select * from public.blocks $$, 'the blocked user reads nothing about the block');
+select is_empty($$ delete from public.blocks returning blocked $$, 'the blocked user cannot lift the block');
+select lives_ok($$ select public.unblock_user(current_setting('t.me')::uuid), public.unblock_user(current_setting('t.victim')::uuid) $$,
+                'unblock_user by the blocked user runs');
+reset role;
+select is((select count(*) from public.blocks
+           where blocker = current_setting('t.me')::uuid and blocked = current_setting('t.victim')::uuid),
+          1::bigint, 'the blocked user cannot lift the block with unblock_user');
+select tests.authenticate_as(current_setting('t.victim')::uuid);
+select is_empty($$ select * from public.find_profile('rider_me') $$, 'find_profile returns nothing for a blocked caller');
+select throws_ok($$ select public.send_friend_request('rider_me') $$, 'P0002', 'user not found',
+                 'a newly blocked user cannot send friend request either');
+select throws_ok(
+  $$ insert into public.blocks (blocker, blocked)
+     values (current_setting('t.victim')::uuid, current_setting('t.me')::uuid) $$,
+  '42501', null, 'nobody inserts a block directly'
+);
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select lives_ok($$ select public.unblock_user(current_setting('t.blockee')::uuid) $$, 'a user unblocks someone');
+select is_empty($$ select blocked from public.blocks where blocked = current_setting('t.blockee')::uuid $$,
+                'unblock_user deletes the block');
+select lives_ok($$ select public.send_friend_request('blockee') $$, 'after unblocking, a friend request works again');
+
+-- Own profile: update username and display name; id fixed; no insert or delete ----------------------------------
+select results_eq(
+  $$ update public.profiles set username = 'Me_Two', display_name = 'Me Two'
+     where id = current_setting('t.me')::uuid returning username::text, display_name $$,
+  $$ values ('Me_Two', 'Me Two') $$,
+  'a user updates their own username and display name'
+);
+select throws_ok($$ update public.profiles set id = current_setting('t.stranger')::uuid
+                    where id = current_setting('t.me')::uuid $$,
+                 'profile id and created_at are fixed', 'a user cannot change their profile id');
+select throws_ok($$ update public.profiles set display_name = repeat('x', 51) where id = current_setting('t.me')::uuid $$,
+                 '23514', null, 'a display name longer than 50 characters is refused (D58)');
+select lives_ok($$ update public.profiles set display_name = repeat('x', 50) where id = current_setting('t.me')::uuid $$,
+                'a 50-character display name is accepted');
+select throws_ok($$ update public.profiles set created_at = now() - interval '1 year'
+                    where id = current_setting('t.me')::uuid $$,
+                 'profile id and created_at are fixed', 'a user cannot change their profile created_at');
+select is_empty($$ update public.profiles set display_name = 'Hacked' where id = current_setting('t.owner')::uuid
+                   returning id $$, 'a user cannot update someone else''s profile');
+select throws_ok($$ insert into public.profiles (id) values (gen_random_uuid()) $$, '42501', null,
+                 'nobody inserts a profile directly');
+select is_empty($$ delete from public.profiles where id = current_setting('t.me')::uuid returning id $$,
+                'nobody deletes a profile directly');
+select throws_ok($$ update public.profiles set username = 'ANA' where id = current_setting('t.me')::uuid $$,
+                 '23505', null, 'a username taken in another case is refused');
+select is_empty($$ select * from public.find_profile('rider_me') $$, 'the old username finds nothing after a rename');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/060-sends-rls.test.sql b/supabase/tests/060-sends-rls.test.sql
new file mode 100644
index 0000000..bb0a346
--- /dev/null
+++ b/supabase/tests/060-sends-rls.test.sql
@@ -0,0 +1,222 @@
+-- S3-06: sends (D40 frozen copy, D50 blocking). A send is read by its sender and, while it is not withdrawn and they
+-- haven't blocked the sender, its recipient; every write goes through create_send / withdraw_send / mark_send_saved /
+-- dismiss_send. §3.3 cases; the Case table in docs/plans/2026-10-22-s3-backend.md names each test.
+begin;
+select plan(60);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.sender', tests.create_user('sender@test.local', 'sender')::text, true);
+select set_config('t.rec', tests.create_user('rec@test.local', 'recipient')::text, true);
+select set_config('t.third', tests.create_user('third@test.local', 'third')::text, true);
+select set_config('t.nofriend', tests.create_user('nofriend@test.local', 'nofriend')::text, true);
+select set_config('t.blocker', tests.create_user('blocker@test.local', 'blocker')::text, true);
+select set_config('t.blockee', tests.create_user('blockee@test.local', 'blockee')::text, true);
+select set_config('t.later', tests.create_user('later@test.local', 'later')::text, true);
+select set_config('t.asked', tests.create_user('asked@test.local', 'asked')::text, true);
+
+-- Accepted friendships with the sender: recipient, third's friend is the recipient (so third can call create_send
+-- at all), later (blocks the sender after a send). blocker and blockee also have a friendship row next to a block:
+-- block_user deletes it, so this is the state a send racing a block would see, and create_send must still refuse.
+-- The sender has only asked 'asked' (pending).
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(a, b), greatest(a, b), 'accepted', a
+from (select current_setting('t.' || x)::uuid as a, current_setting('t.' || y)::uuid as b
+      from (values ('sender', 'rec'), ('sender', 'later'), ('third', 'rec'), ('sender', 'blocker'),
+                   ('sender', 'blockee')) as v(x, y)) p;
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(a, b), greatest(a, b), 'pending', a
+from (select current_setting('t.sender')::uuid as a, current_setting('t.asked')::uuid as b) p;
+insert into public.blocks (blocker, blocked)
+values (current_setting('t.blocker')::uuid, current_setting('t.sender')::uuid),
+       (current_setting('t.sender')::uuid, current_setting('t.blockee')::uuid);
+
+-- create_send ------------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select is(
+  public.create_send('00000000-0000-0000-0000-0000000005e1', current_setting('t.rec')::uuid,
+                     '{"spots": [{"name": "Library rail"}]}'),
+  '00000000-0000-0000-0000-0000000005e1'::uuid,
+  'create_send returns the new send''s id'
+);
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e2', current_setting('t.rec')::uuid,
+                                             '{"spots": []}') $$, 'sender sends a second spot set');
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e3', current_setting('t.rec')::uuid,
+                                             '{"spots": []}') $$, 'sender sends a third spot set');
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e4', null, '{"spots": []}') $$,
+                'sender creates a link-only send (no recipient)');
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e5', current_setting('t.later')::uuid,
+                                             '{"spots": []}') $$, 'sender sends to a friend who blocks them later');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f1',
+                                              current_setting('t.nofriend')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'create_send to someone who is not a friend raises');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f8',
+                                              current_setting('t.asked')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'create_send to someone who has not accepted yet raises');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f2',
+                                              current_setting('t.blocker')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'blocked sender cannot create_send');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f3',
+                                              current_setting('t.blockee')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'a sender cannot send to someone they blocked');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f4',
+                                              current_setting('t.sender')::uuid, '{}') $$,
+                 '22023', null, 'create_send to yourself raises');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f5', current_setting('t.rec')::uuid,
+                                              null) $$,
+                 '22023', null, 'create_send refuses a NULL payload');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f9', current_setting('t.rec')::uuid,
+                                              '[{"name": "x"}]') $$,
+                 '22023', null, 'create_send refuses a payload that is not a JSON object');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005fa', current_setting('t.rec')::uuid,
+                                              jsonb_build_object('notes', repeat('x', 1048577))) $$,
+                 '22023', null, 'create_send refuses a payload over 1 MB');
+select throws_ok(
+  $$ insert into public.sends (id, sender, recipient, payload)
+     values ('00000000-0000-0000-0000-0000000005f6', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+             '{}') $$,
+  '42501', null, 'nobody inserts a send directly'
+);
+
+reset role;
+select results_eq(
+  $$ select sender, recipient, payload, withdrawn_at, saved_at, dismissed_at from public.sends
+     where id = '00000000-0000-0000-0000-0000000005e1' $$,
+  $$ values (current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+             '{"sender": {"username": "sender", "display_name": null}, "spots": [{"name": "Library rail"}]}'::jsonb, null::timestamptz, null::timestamptz,
+             null::timestamptz) $$,
+  'create_send inserts one row with the caller as sender'
+);
+select is((select count(*)::int from public.sends where id::text like '00000000-0000-0000-0000-0000000005f%'), 0,
+          'no refused send left a row');
+
+-- The recipient (a friend of the sender, too) cannot take over an existing send by reusing its id.
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e1',
+                                              current_setting('t.sender')::uuid, '{"spots": "mine now"}') $$,
+                 '23505', null, 'create_send cannot take over an existing send id');
+
+-- Who reads a send -------------------------------------------------------------------------------------------------
+select results_eq(
+  $$ select id from public.sends order by id $$,
+  $$ values ('00000000-0000-0000-0000-0000000005e1'::uuid), ('00000000-0000-0000-0000-0000000005e2'::uuid),
+            ('00000000-0000-0000-0000-0000000005e3'::uuid) $$,
+  'recipient reads exactly the sends to them'
+);
+select results_eq(
+  $$ select payload from public.sends where id = '00000000-0000-0000-0000-0000000005e1' $$,
+  $$ values ('{"sender": {"username": "sender", "display_name": null}, "spots": [{"name": "Library rail"}]}'::jsonb) $$,
+  'recipient reads the send''s payload'
+);
+select is_empty($$ select id from public.sends where id = '00000000-0000-0000-0000-0000000005e4' $$,
+                'a link-only send is not readable by a friend of its sender');
+
+select tests.authenticate_as(current_setting('t.third')::uuid);
+select is_empty($$ select id from public.sends $$, 'third user reads no send');
+
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select results_eq(
+  $$ select id from public.sends order by id $$,
+  $$ values ('00000000-0000-0000-0000-0000000005e1'::uuid), ('00000000-0000-0000-0000-0000000005e2'::uuid),
+            ('00000000-0000-0000-0000-0000000005e3'::uuid), ('00000000-0000-0000-0000-0000000005e4'::uuid),
+            ('00000000-0000-0000-0000-0000000005e5'::uuid) $$,
+  'sender reads every send they made, the link-only one included'
+);
+
+reset role;
+select tests.clear_auth();
+select is_empty($$ select id from public.sends $$, 'anon reads no send');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f7', current_setting('t.rec')::uuid,
+                                              '{}') $$,
+                 '42501', null, 'anon cannot call create_send');
+reset role;
+select ok(not has_function_privilege('anon', p, 'execute'), 'anon cannot execute ' || p)
+from unnest(array['public.create_send(uuid, uuid, jsonb)', 'public.withdraw_send(uuid)',
+                  'public.mark_send_saved(uuid, uuid)', 'public.dismiss_send(uuid)', 'public.can_read_send(uuid)',
+                  'public.can_read_photo(text)', 'public.can_write_photo(text, text)']) as p;
+
+-- No direct writes ------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select is_empty($$ update public.sends set payload = '{"spots": "changed"}'
+                   where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the recipient cannot update the payload');
+select is_empty($$ update public.sends set withdrawn_at = null, saved_at = now()
+                   where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the recipient cannot set saved_at directly');
+select is_empty($$ delete from public.sends where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the recipient cannot delete a send');
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select is_empty($$ update public.sends set recipient = current_setting('t.third')::uuid
+                   where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the sender cannot redirect a send directly');
+select is_empty($$ delete from public.sends where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the sender cannot delete a send directly');
+reset role;
+select results_eq(
+  $$ select recipient, payload, saved_at from public.sends where id = '00000000-0000-0000-0000-0000000005e1' $$,
+  $$ values (current_setting('t.rec')::uuid, '{"sender": {"username": "sender", "display_name": null}, "spots": [{"name": "Library rail"}]}'::jsonb, null::timestamptz) $$,
+  'the direct updates and deletes changed nothing'
+);
+
+-- Save and Dismiss (recipient only) ----------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'the sender cannot mark their send saved');
+select throws_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'the sender cannot dismiss their send');
+select tests.authenticate_as(current_setting('t.third')::uuid);
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'a third user cannot mark a send saved');
+select throws_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'a third user cannot dismiss a send');
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'a third user cannot withdraw a send');
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'the recipient cannot withdraw a send');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e4') $$, '42501', 'no such send',
+                 'nobody saves a link-only send through mark_send_saved');
+select lives_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e2') $$, 'the recipient saves a send');
+select lives_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e1') $$,
+                'the recipient dismisses a send');
+select results_eq(
+  $$ select id, saved_at is not null, dismissed_at is not null from public.sends
+     where id in ('00000000-0000-0000-0000-0000000005e1', '00000000-0000-0000-0000-0000000005e2') order by id $$,
+  $$ values ('00000000-0000-0000-0000-0000000005e1'::uuid, false, true),
+            ('00000000-0000-0000-0000-0000000005e2'::uuid, true, false) $$,
+  'mark_send_saved sets saved_at and dismiss_send sets dismissed_at'
+);
+
+-- Withdraw (sender only, until saved, D40) ----------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e2') $$, '55000', null,
+                 'withdraw_send after the recipient saved raises');
+select lives_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e3') $$, 'the sender withdraws a send');
+select set_config('t.withdrawn_at', (select withdrawn_at::text from public.sends
+                                      where id = '00000000-0000-0000-0000-0000000005e3'), true);
+select ok(current_setting('t.withdrawn_at') <> '', 'the sender still sees a withdrawn send, withdrawn_at set');
+select lives_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e3') $$,
+                'withdrawing again is harmless');
+select is((select withdrawn_at::text from public.sends where id = '00000000-0000-0000-0000-0000000005e3'),
+          current_setting('t.withdrawn_at'), 'withdrawing again keeps the first withdrawn_at');
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-00000000dead') $$, '42501', 'no such send',
+                 'withdraw_send on an unknown id raises the same error');
+
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select is_empty($$ select id from public.sends where id = '00000000-0000-0000-0000-0000000005e3' $$,
+                'recipient reads nothing after withdraw');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e3') $$, '42501', 'no such send',
+                 'the recipient cannot save a withdrawn send');
+select throws_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e3') $$, '42501', 'no such send',
+                 'the recipient cannot dismiss a withdrawn send');
+
+-- D50: a recipient who blocks the sender sees their pending sends no more ------------------------------------------------
+select tests.authenticate_as(current_setting('t.later')::uuid);
+select results_eq($$ select id from public.sends $$, $$ values ('00000000-0000-0000-0000-0000000005e5'::uuid) $$,
+                  'the friend reads the send before blocking');
+select lives_ok($$ select public.block_user(current_setting('t.sender')::uuid) $$, 'the friend blocks the sender');
+select is_empty($$ select id from public.sends $$, 'a recipient who blocks the sender reads their send no more');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e5') $$, '42501', 'no such send',
+                 'a recipient cannot save a send from someone they blocked');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/070-storage-rls.test.sql b/supabase/tests/070-storage-rls.test.sql
new file mode 100644
index 0000000..c37bb22
--- /dev/null
+++ b/supabase/tests/070-storage-rls.test.sql
@@ -0,0 +1,360 @@
+-- S3-06: the private photos bucket. A spot's photo '<owner>/<spot>/<media>.jpg' is read by whoever reads the spot
+-- (can_read_spot) while the photo is live; a send's photo 'sends/<send>/<media>.jpg' by whoever reads the send. Writes
+-- land only under the writer's own spot or send. Rows are inserted into storage.objects as the users, as the Storage
+-- API does. §3.3 cases; the Case table in docs/plans/2026-10-22-s3-backend.md names each test.
+begin;
+select plan(47);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.owner', tests.create_user('owner@test.local', 'owner')::text, true);
+select set_config('t.member', tests.create_user('member@test.local', 'member')::text, true);
+select set_config('t.stranger', tests.create_user('stranger@test.local', 'stranger')::text, true);
+select set_config('t.sender', tests.create_user('sender@test.local', 'sender')::text, true);
+select set_config('t.rec', tests.create_user('rec@test.local', 'recipient')::text, true);
+select set_config('t.third', tests.create_user('third@test.local', 'third')::text, true);
+
+-- Spots: b1 (owner, in shared list 'Crew' where member is a member), b2 (owner, in no list), b3 (stranger's).
+insert into public.spots (id, owner_id, lat, lng, updated_at)
+values ('00000000-0000-0000-0000-0000000000b1', current_setting('t.owner')::uuid, 47.6, -122.3, now()),
+       ('00000000-0000-0000-0000-0000000000b2', current_setting('t.owner')::uuid, 47.6, -122.3, now()),
+       ('00000000-0000-0000-0000-0000000000b3', current_setting('t.stranger')::uuid, 47.6, -122.3, now());
+-- Photos: c1 live and c2 removed (soft-deleted) on b1, c3 on b2.
+insert into public.media (id, spot_id, owner_id, updated_at, deleted_at)
+values ('00000000-0000-0000-0000-0000000000c1', '00000000-0000-0000-0000-0000000000b1',
+        current_setting('t.owner')::uuid, now(), null),
+       ('00000000-0000-0000-0000-0000000000c2', '00000000-0000-0000-0000-0000000000b1',
+        current_setting('t.owner')::uuid, now(), now()),
+       ('00000000-0000-0000-0000-0000000000c3', '00000000-0000-0000-0000-0000000000b2',
+        current_setting('t.owner')::uuid, now(), null);
+insert into public.hit_lists (id, owner_id, name, kind, shared, updated_at)
+values ('00000000-0000-0000-0000-0000000000d1', current_setting('t.owner')::uuid, 'Crew', 'manual', true, now());
+insert into public.hit_list_spots (list_id, spot_id, added_by)
+values ('00000000-0000-0000-0000-0000000000d1', '00000000-0000-0000-0000-0000000000b1',
+        current_setting('t.owner')::uuid);
+insert into public.hit_list_members (list_id, user_id, role, status)
+values ('00000000-0000-0000-0000-0000000000d1', current_setting('t.member')::uuid, 'add', 'member');
+-- Sends: e1 sender → recipient (live), e2 sender → recipient (withdrawn), e3 sender → recipient (saved).
+insert into public.sends (id, sender, recipient, payload, withdrawn_at, saved_at)
+values ('00000000-0000-0000-0000-0000000000e1', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+        '{}', null, null),
+       ('00000000-0000-0000-0000-0000000000e2', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+        '{}', now(), null),
+       ('00000000-0000-0000-0000-0000000000e3', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+        '{}', null, now());
+-- Objects written past the policies (as postgres): photos of the withdrawn and the saved send, a stray object under the
+-- stranger's prefix that names the owner's spot, a four-segment name under the owner's prefix that would parse as
+-- c1's photo, and the owner's path in another bucket.
+insert into storage.objects (bucket_id, name)
+values ('photos', 'sends/00000000-0000-0000-0000-0000000000e2/00000000-0000-0000-0000-0000000000f2.jpg'),
+       ('photos', 'sends/00000000-0000-0000-0000-0000000000e3/00000000-0000-0000-0000-0000000000f6.jpg'),
+       ('photos', current_setting('t.stranger') || '/00000000-0000-0000-0000-0000000000b1/'
+                  || '00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                  || '00000000-0000-0000-0000-0000000000c1.jpg/x');
+insert into storage.buckets (id, name, public) values ('zz_other', 'zz_other', false);
+insert into storage.objects (bucket_id, name)
+values ('zz_other', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                    || '00000000-0000-0000-0000-0000000000c1.jpg');
+
+-- The bucket -------------------------------------------------------------------------------------------------------
+select results_eq($$ select public, file_size_limit, allowed_mime_types from storage.buckets where id = 'photos' $$,
+                  $$ values (false, 10485760::bigint, array['image/jpeg']) $$,
+                  'the photos bucket exists, private, JPEG only, 10 MB');
+
+-- The path parser: exactly '<uuid>/<uuid>/<uuid>.jpg' or 'sends/<uuid>/<uuid>.jpg'.
+select results_eq(
+  $$ select n, public.photo_path_ok(n) from (values
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('sends/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/x/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.png'),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg/x'),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/photo.jpg'),
+       ('00000000-0000-0000-0000-0000000000a1/spot/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('owner/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('00000000-0000-0000-0000-0000000000A1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('SENDS/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/'),
+       (''),
+       (null)
+     ) as v(n) $$,
+  $$ values
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg', true),
+       ('sends/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000c1.jpg', true),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000c1.jpg', false),
+       ('00000000-0000-0000-0000-0000000000c1.jpg', false),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/x/00000000-0000-0000-0000-0000000000c1.jpg', false),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.png', false),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg/x', false),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/photo.jpg', false),
+       ('00000000-0000-0000-0000-0000000000a1/spot/00000000-0000-0000-0000-0000000000c1.jpg', false),
+       ('owner/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg', false),
+       ('00000000-0000-0000-0000-0000000000A1/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg', false),
+       ('SENDS/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000c1.jpg', false),
+       ('00000000-0000-0000-0000-0000000000a1/00000000-0000-0000-0000-0000000000b1/', false),
+       ('', false),
+       (null::text, false) $$,
+  'photo_path_ok accepts only three-segment <uuid>/<uuid>/<uuid>.jpg and sends/<uuid>/<uuid>.jpg paths, lowercase'
+);
+select is(public.try_uuid('not a uuid'), null, 'try_uuid returns NULL for text that is not a uuid');
+
+-- Spot photos: writes -----------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select lives_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     select 'photos', current_setting('t.owner') || '/' || s || '/' || m || '.jpg'
+     from (values ('00000000-0000-0000-0000-0000000000b1', '00000000-0000-0000-0000-0000000000c1'),
+                  ('00000000-0000-0000-0000-0000000000b1', '00000000-0000-0000-0000-0000000000c2'),
+                  ('00000000-0000-0000-0000-0000000000b2', '00000000-0000-0000-0000-0000000000c3')) as v(s, m) $$,
+  'owner uploads photos of their own spots'
+);
+select lives_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                       || '00000000-0000-0000-0000-0000000000c9.jpg') $$,
+  'owner uploads a photo before its media row exists'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b3/'
+                       || '00000000-0000-0000-0000-0000000000c8.jpg') $$,
+  '42501', null, 'owner cannot upload under their prefix for a spot they do not own'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.stranger') || '/00000000-0000-0000-0000-0000000000b1/'
+                       || '00000000-0000-0000-0000-0000000000c8.jpg') $$,
+  '42501', null, 'owner cannot upload under someone else''s prefix, even for their own spot'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000c8.jpg') $$,
+  '42501', null, 'a path with fewer than three segments is refused'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/x/'
+                       || '00000000-0000-0000-0000-0000000000c8.jpg') $$,
+  '42501', null, 'a path with four segments is refused'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('zz_other', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                         || '00000000-0000-0000-0000-0000000000c8.jpg') $$,
+  '42501', null, 'nobody writes to another bucket'
+);
+select throws_ok(
+  $$ update storage.objects set name = current_setting('t.stranger') || '/00000000-0000-0000-0000-0000000000b1/'
+                                       || '00000000-0000-0000-0000-0000000000c3.jpg'
+     where name = current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b2/'
+                  || '00000000-0000-0000-0000-0000000000c3.jpg' $$,
+  '42501', null, 'owner cannot move a photo object under someone else''s prefix'
+);
+select throws_ok(
+  $$ update storage.objects set name = current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b3/'
+                                       || '00000000-0000-0000-0000-0000000000c3.jpg'
+     where name = current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b2/'
+                  || '00000000-0000-0000-0000-0000000000c3.jpg' $$,
+  '42501', null, 'owner cannot move a photo object to a spot they do not own'
+);
+select results_eq(
+  $$ insert into storage.objects (bucket_id, name, metadata)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                       || '00000000-0000-0000-0000-0000000000c1.jpg', '{"v": 1}')
+     on conflict (bucket_id, name collate "C", version) do update set metadata = excluded.metadata
+     returning metadata $$,
+  $$ values ('{"v": 1}'::jsonb) $$,
+  'owner overwrites their own photo object (upsert)'
+);
+select results_eq(
+  $$ update storage.objects set name = current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b2/'
+                                       || '00000000-0000-0000-0000-0000000000c9.jpg'
+     where name = current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                  || '00000000-0000-0000-0000-0000000000c9.jpg'
+     returning name $$,
+  $$ values (current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b2/'
+             || '00000000-0000-0000-0000-0000000000c9.jpg') $$,
+  'owner moves a photo object between their own spots'
+);
+update storage.objects set name = current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                                  || '00000000-0000-0000-0000-0000000000c9.jpg'
+where name = current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b2/'
+             || '00000000-0000-0000-0000-0000000000c9.jpg';
+
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                       || '00000000-0000-0000-0000-0000000000c7.jpg') $$,
+  '42501', null, 'stranger cannot upload under the owner''s prefix'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.stranger') || '/00000000-0000-0000-0000-0000000000b1/'
+                       || '00000000-0000-0000-0000-0000000000c7.jpg') $$,
+  '42501', null, 'stranger cannot upload under their own prefix for the owner''s spot'
+);
+
+-- Spot photos: reads ----------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select results_eq(
+  $$ select name from storage.objects order by name $$,
+  $$ select current_setting('t.owner') || n from (values
+       ('/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c2.jpg'),
+       ('/00000000-0000-0000-0000-0000000000b1/00000000-0000-0000-0000-0000000000c9.jpg'),
+       ('/00000000-0000-0000-0000-0000000000b2/00000000-0000-0000-0000-0000000000c3.jpg')) as v(n) order by 1 $$,
+  'owner reads exactly their own photo objects, removed photos and not-yet-recorded ones included'
+);
+
+select tests.authenticate_as(current_setting('t.member')::uuid);
+select results_eq(
+  $$ select name from storage.objects $$,
+  $$ values (current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+             || '00000000-0000-0000-0000-0000000000c1.jpg') $$,
+  'member reads exactly the live photo objects of spots they can read'
+);
+select is_empty($$ select name from storage.objects where name like '%/00000000-0000-0000-0000-0000000000b2/%' $$,
+                'member reads no photo object of a spot they cannot read');
+select is_empty($$ select name from storage.objects where name like '%/00000000-0000-0000-0000-0000000000c2.jpg' $$,
+                'member reads no object of a removed photo');
+select is_empty($$ select name from storage.objects where name like '%/00000000-0000-0000-0000-0000000000c9.jpg' $$,
+                'member reads no object without a media row');
+select is_empty($$ select name from storage.objects where name like current_setting('t.stranger') || '/%' $$,
+                'member reads no object whose prefix is not the spot owner''s');
+select is_empty($$ update storage.objects set metadata = '{"x": 1}' where name like '%/00000000-0000-0000-0000-0000000000c1.jpg'
+                   returning name $$,
+                'member cannot overwrite the owner''s photo object');
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                       || '00000000-0000-0000-0000-0000000000c6.jpg') $$,
+  '42501', null, 'member cannot upload a photo to the owner''s spot'
+);
+select set_config('storage.allow_delete_query', 'true', true);
+select is_empty($$ delete from storage.objects where name like '%/00000000-0000-0000-0000-0000000000c1.jpg' returning name $$,
+                'member cannot delete the owner''s photo object');
+
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select is_empty($$ select name from storage.objects where bucket_id = 'photos' and name not like current_setting('t.stranger') || '/%' $$,
+                'stranger reads no photo object');
+reset role;
+select tests.clear_auth();
+select is_empty($$ select name from storage.objects $$, 'anon reads no photo object');
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                       || '00000000-0000-0000-0000-0000000000c5.jpg') $$,
+  '42501', null, 'anon cannot upload a photo'
+);
+reset role;
+
+-- The owner deletes their own object (the Storage API sets storage.allow_delete_query for its deletes).
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select results_eq(
+  $$ delete from storage.objects where name like '%/00000000-0000-0000-0000-0000000000c9.jpg' returning name $$,
+  $$ values (current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+             || '00000000-0000-0000-0000-0000000000c9.jpg') $$,
+  'owner deletes their own photo object'
+);
+
+-- Removed member loses read immediately, photos included.
+reset role;
+delete from public.hit_list_members
+where list_id = '00000000-0000-0000-0000-0000000000d1' and user_id = current_setting('t.member')::uuid;
+select tests.authenticate_as(current_setting('t.member')::uuid);
+select is_empty($$ select name from storage.objects $$, 'removed member reads no photo object');
+
+-- Send photos -------------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select lives_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000f1.jpg') $$,
+  'the sender uploads a photo into their send'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000000e2/00000000-0000-0000-0000-0000000000f3.jpg') $$,
+  '42501', null, 'the sender cannot upload into a withdrawn send'
+);
+-- S7 (D77): a photo is staged under a send id before the send exists, owned by its stager (100-sends-s7).
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', 'sends/00000000-0000-0000-0000-00000000dead/00000000-0000-0000-0000-0000000000f3.jpg') $$,
+  '42501', null, 'nobody uploads into a send that does not exist without owning the object'
+);
+select lives_ok(
+  $$ insert into storage.objects (bucket_id, name, owner_id)
+     values ('photos', 'sends/00000000-0000-0000-0000-00000000dead/00000000-0000-0000-0000-0000000000f3.jpg',
+             current_setting('t.sender')) $$,
+  'a rider stages a photo for a send id nobody has used'
+);
+select results_eq(
+  $$ select name from storage.objects order by name $$,
+  $$ values ('sends/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000f1.jpg'),
+            ('sends/00000000-0000-0000-0000-0000000000e2/00000000-0000-0000-0000-0000000000f2.jpg'),
+            ('sends/00000000-0000-0000-0000-0000000000e3/00000000-0000-0000-0000-0000000000f6.jpg'),
+            ('sends/00000000-0000-0000-0000-00000000dead/00000000-0000-0000-0000-0000000000f3.jpg') $$,
+  'the sender reads their sends'' photo objects, a withdrawn one''s and a staged one''s included'
+);
+
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select results_eq(
+  $$ select name from storage.objects order by name $$,
+  $$ values ('sends/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000f1.jpg'),
+            ('sends/00000000-0000-0000-0000-0000000000e3/00000000-0000-0000-0000-0000000000f6.jpg') $$,
+  'the recipient reads the photo objects of live and saved sends and none of a withdrawn send'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000f4.jpg') $$,
+  '42501', null, 'the recipient cannot upload into a send'
+);
+select is_empty($$ update storage.objects set metadata = '{"x": 1}' returning name $$,
+                'the recipient cannot overwrite a send photo object');
+
+select tests.authenticate_as(current_setting('t.third')::uuid);
+select is_empty($$ select name from storage.objects $$, 'a third user reads no send photo object');
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000000e1/00000000-0000-0000-0000-0000000000f5.jpg') $$,
+  '42501', null, 'a third user cannot upload into someone else''s send'
+);
+
+-- Send photos are write-once (D40: the recipient keeps what they were sent): no overwrite, and nothing new or
+-- deleted once the recipient saved.
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select set_config('storage.allow_delete_query', 'true', true);
+select is_empty($$ update storage.objects set metadata = '{"x": 1}'
+                   where name like 'sends/00000000-0000-0000-0000-0000000000e1/%' returning name $$,
+                'the sender cannot overwrite a send photo object');
+select is_empty($$ update storage.objects set metadata = '{"x": 1}'
+                   where name like 'sends/00000000-0000-0000-0000-0000000000e2/%' returning name $$,
+                'the sender cannot overwrite a withdrawn send''s photo object');
+select is_empty($$ update storage.objects set metadata = '{"x": 1}'
+                   where name like 'sends/00000000-0000-0000-0000-0000000000e3/%' returning name $$,
+                'the sender cannot overwrite a saved send''s photo object');
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000000e3/00000000-0000-0000-0000-0000000000f7.jpg') $$,
+  '42501', null, 'the sender cannot upload into a saved send'
+);
+select is_empty($$ delete from storage.objects where name like 'sends/00000000-0000-0000-0000-0000000000e3/%'
+                   returning name $$,
+                'the sender cannot delete a saved send''s photo object');
+select results_eq(
+  $$ delete from storage.objects where name like 'sends/00000000-0000-0000-0000-0000000000e2/%' returning name $$,
+  $$ values ('sends/00000000-0000-0000-0000-0000000000e2/00000000-0000-0000-0000-0000000000f2.jpg') $$,
+  'the sender deletes a withdrawn send''s photo object'
+);
+
+-- D50: once the recipient blocks the sender, the send's photos go with the send.
+reset role;
+insert into public.blocks (blocker, blocked) values (current_setting('t.rec')::uuid, current_setting('t.sender')::uuid);
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select is_empty($$ select name from storage.objects $$, 'a recipient who blocked the sender reads no photo of their send');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/080-links-rls.test.sql b/supabase/tests/080-links-rls.test.sql
new file mode 100644
index 0000000..d089050
--- /dev/null
+++ b/supabase/tests/080-links-rls.test.sql
@@ -0,0 +1,465 @@
+-- S3-07: links (D44 send and invite links, D45 only a token's SHA-256 is stored). Nobody touches the links table
+-- directly; create_link / revoke_link / list_my_links are for the signed-in creator, preview_link is for the service
+-- role (the share-preview Edge Function, S9), redeem_invite joins a shared list once. §3.3 cases; the Case table in
+-- docs/plans/2026-10-22-s3-backend.md names each test.
+begin;
+select plan(116);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.sender', tests.create_user('sender@test.local', 'sender')::text, true);
+select set_config('t.owner', tests.create_user('owner@test.local', 'owner')::text, true);
+select set_config('t.member', tests.create_user('member@test.local', 'member')::text, true);
+select set_config('t.invitee', tests.create_user('invitee@test.local', 'invitee')::text, true);
+select set_config('t.joiner', tests.create_user('joiner@test.local', 'joiner')::text, true);
+select set_config('t.joiner2', tests.create_user('joiner2@test.local', 'joiner2')::text, true);
+select set_config('t.viewer', tests.create_user('viewer@test.local', 'viewer')::text, true);
+select set_config('t.blocked', tests.create_user('blocked@test.local', 'blocked')::text, true);
+select set_config('t.blocker', tests.create_user('blocker@test.local', 'blocker')::text, true);
+select set_config('t.stranger', tests.create_user('stranger@test.local', 'stranger')::text, true);
+update public.profiles set display_name = 'Sam Sender' where id = current_setting('t.sender')::uuid;
+update public.profiles set display_name = 'Olive Owner' where id = current_setting('t.owner')::uuid;
+
+-- The owner is friends with the invitee (who has an open invitation to e1) and has blocked 'blocked'; 'blocker' has
+-- blocked the owner. Nobody else is anybody's friend: an invite link needs no friendship (the link is the consent).
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(o, i), greatest(o, i), 'accepted', o
+from (select current_setting('t.owner')::uuid as o, current_setting('t.invitee')::uuid as i) p;
+insert into public.blocks (blocker, blocked)
+values (current_setting('t.owner')::uuid, current_setting('t.blocked')::uuid),
+       (current_setting('t.blocker')::uuid, current_setting('t.owner')::uuid);
+
+-- Lists (as postgres) ----------------------------------------------------------------------------------------------
+-- e1 shared (member is a member, invitee is invited) · e2 not shared · e3 shared, deleted · e4 shared (unshared
+-- later) · e5 shared (deleted later) · e6 the stranger's, shared.
+insert into public.hit_lists (id, owner_id, name, kind, shared, updated_at, deleted_at)
+select id::uuid, current_setting('t.' || who)::uuid, name, 'manual', shared, '2026-10-22T12:00:00Z', deleted::timestamptz
+from (values
+  ('00000000-0000-0000-0000-0000000008e1', 'owner', 'Downtown rails', true, null),
+  ('00000000-0000-0000-0000-0000000008e2', 'owner', 'Private', false, null),
+  ('00000000-0000-0000-0000-0000000008e3', 'owner', 'Gone', true, '2026-10-22T12:00:00Z'),
+  ('00000000-0000-0000-0000-0000000008e4', 'owner', 'Unshared later', true, null),
+  ('00000000-0000-0000-0000-0000000008e5', 'owner', 'Deleted later', true, null),
+  ('00000000-0000-0000-0000-0000000008e6', 'stranger', 'Not yours', true, null)
+) as v(id, who, name, shared, deleted);
+insert into public.hit_list_members (list_id, user_id, role, status, invited_by, joined_at)
+values ('00000000-0000-0000-0000-0000000008e1', current_setting('t.member')::uuid, 'add', 'member',
+        current_setting('t.owner')::uuid, now()),
+       ('00000000-0000-0000-0000-0000000008e1', current_setting('t.invitee')::uuid, 'view', 'invited',
+        current_setting('t.owner')::uuid, null);
+
+-- Spots: o1 the owner's, in e1 · j1 the joiner's, a row in e1 left from an earlier membership (joining clears it).
+insert into public.spots (id, owner_id, lat, lng, updated_at)
+values ('00000000-0000-0000-0000-0000000008a1', current_setting('t.owner')::uuid, 40.0, -105.0, '2026-10-22T12:00:00Z'),
+       ('00000000-0000-0000-0000-0000000008a2', current_setting('t.joiner')::uuid, 40.0, -105.0, '2026-10-22T12:00:00Z');
+insert into public.hit_list_spots (list_id, spot_id, added_by)
+values ('00000000-0000-0000-0000-0000000008e1', '00000000-0000-0000-0000-0000000008a1', current_setting('t.owner')::uuid),
+       ('00000000-0000-0000-0000-0000000008e1', '00000000-0000-0000-0000-0000000008a2', current_setting('t.joiner')::uuid);
+
+-- Sends (link-only, recipient NULL): d1 live · d2 withdrawn after its link is made · d3 already withdrawn.
+insert into public.sends (id, sender, recipient, payload, withdrawn_at)
+values ('00000000-0000-0000-0000-0000000008d1', current_setting('t.sender')::uuid, null,
+        '{"spots": [{"name": "Library rail"}]}', null),
+       ('00000000-0000-0000-0000-0000000008d2', current_setting('t.sender')::uuid, null, '{"spots": []}', null),
+       ('00000000-0000-0000-0000-0000000008d3', current_setting('t.sender')::uuid, null, '{"spots": []}', now());
+
+-- Token hashes the way a client makes them: SHA-256 of the token, lowercase hex.
+select set_config('t.sha_' || tok, encode(extensions.digest(tok, 'sha256'), 'hex'), true)
+from unnest(array['send_live', 'send_never', 'send_withdrawn', 'send_expired', 'send_revoked', 'inv_view',
+                  'inv_invitee', 'inv_expired', 'inv_revoked', 'inv_blocked', 'inv_unshare', 'inv_deleted',
+                  'inv_owner', 'inv_long', 'refused']) as tok;
+
+-- create_link -----------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select isnt(
+  public.create_link('send', '00000000-0000-0000-0000-0000000008d1', current_setting('t.sha_send_live'),
+                     now() + interval '30 days'),
+  null,
+  'create_link for a send by its sender succeeds'
+);
+select lives_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                             current_setting('t.sha_send_never'), null) $$,
+                'a send link may never expire (D44)');
+select lives_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d2',
+                                             current_setting('t.sha_send_withdrawn'), now() + interval '1 day') $$,
+                'sender links the send they will withdraw');
+select lives_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                             current_setting('t.sha_send_expired'), now() + interval '1 day') $$,
+                'sender makes a link that will expire');
+select set_config('t.link_revoked',
+  public.create_link('send', '00000000-0000-0000-0000-0000000008d1', current_setting('t.sha_send_revoked'),
+                     now() + interval '7 days')::text, true);
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d3',
+                                              current_setting('t.sha_refused'), null) $$,
+                 '55000', null, 'create_link refuses a withdrawn send');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                              current_setting('t.sha_refused'), null, 'add') $$,
+                 '22023', null, 'a send link takes no role');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                              current_setting('t.sha_refused'), now() - interval '1 minute') $$,
+                 '22023', null, 'create_link refuses an expiry in the past');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                              upper(current_setting('t.sha_refused')), null) $$,
+                 '22023', null, 'create_link refuses a hash that is not lowercase hex');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1', 'abc123', null) $$,
+                 '22023', null, 'create_link refuses a hash that is not 64 characters');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1', 'my-secret-token',
+                                              null) $$,
+                 '22023', null, 'create_link refuses a plain token (only a hash is stored, D45)');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                              current_setting('t.sha_send_live'), null) $$,
+                 '23505', null, 'create_link cannot reuse a token hash');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                              current_setting('t.sha_refused'), now() + interval '7 days', 'add') $$,
+                 '42501', null, 'the sender cannot make an invite link to someone else''s list');
+
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select isnt(
+  public.create_link('invite', '00000000-0000-0000-0000-0000000008e1', encode(extensions.digest('abc', 'sha256'), 'hex'),
+                     now() + interval '7 days', 'add'),
+  null,
+  'create_link for an invite by the list owner succeeds'
+);
+select lives_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                             current_setting('t.sha_' || tok), now() + interval '7 days', role)
+                   from (values ('inv_view', 'view'), ('inv_invitee', 'add'), ('inv_expired', 'add'),
+                                ('inv_revoked', 'add'), ('inv_blocked', 'add'), ('inv_owner', 'add'))
+                        as v(tok, role) $$,
+                'the owner makes more invite links to the list');
+select lives_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e4',
+                                             current_setting('t.sha_inv_unshare'), now() + interval '1 day', 'add'),
+                          public.create_link('invite', '00000000-0000-0000-0000-0000000008e5',
+                                             current_setting('t.sha_inv_deleted'), now() + interval '1 day', 'add') $$,
+                'the owner links the lists they will unshare and delete');
+select lives_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                             current_setting('t.sha_inv_long'), now() + interval '30 days', 'view') $$,
+                'the owner asks for a 30-day invite link');
+select throws_ok($$ select public.create_link('page', '00000000-0000-0000-0000-0000000008e1',
+                                              current_setting('t.sha_refused'), now() + interval '1 day', 'add') $$,
+                 '22023', null, 'create_link takes only send or invite');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                              current_setting('t.sha_refused'), now(), 'add') $$,
+                 '22023', null, 'create_link refuses a link that expires now');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                              current_setting('t.sha_refused'), now() + interval '7 days') $$,
+                 '22023', null, 'an invite link needs a role');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                              current_setting('t.sha_refused'), now() + interval '7 days', 'admin') $$,
+                 '22023', null, 'an invite link''s role is add or view');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                              current_setting('t.sha_refused'), null, 'add') $$,
+                 '22023', null, 'an invite link must expire');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e2',
+                                              current_setting('t.sha_refused'), now() + interval '7 days', 'add') $$,
+                 '55000', null, 'create_link refuses an invite to a list that is not shared');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e3',
+                                              current_setting('t.sha_refused'), now() + interval '7 days', 'add') $$,
+                 '42501', null, 'create_link refuses an invite to a deleted list');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e6',
+                                              current_setting('t.sha_refused'), now() + interval '7 days', 'add') $$,
+                 '42501', null, 'the owner cannot make an invite link to someone else''s list');
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008ff',
+                                              current_setting('t.sha_refused'), now() + interval '7 days', 'add') $$,
+                 '42501', null, 'an invite link to an unknown list raises the same error');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                              current_setting('t.sha_refused'), null) $$,
+                 '42501', null, 'someone else cannot link the sender''s send');
+
+select tests.authenticate_as(current_setting('t.member')::uuid);
+select throws_ok($$ select public.create_link('invite', '00000000-0000-0000-0000-0000000008e1',
+                                              current_setting('t.sha_refused'), now() + interval '7 days', 'add') $$,
+                 '42501', null, 'a member cannot make an invite link');
+
+select tests.clear_auth();
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                              current_setting('t.sha_refused'), null) $$,
+                 '42501', null, 'anon cannot call create_link');
+
+reset role;
+select results_eq(
+  $$ select kind, send_id, list_id, role, created_by, expires_at, revoked_at, used_by, used_at from public.links
+     where token_sha256 in (current_setting('t.sha_send_live'), encode(extensions.digest('abc', 'sha256'), 'hex'))
+     order by kind desc $$,
+  $$ values ('send', '00000000-0000-0000-0000-0000000008d1'::uuid, null::uuid, null::text,
+             current_setting('t.sender')::uuid, now() + interval '30 days', null::timestamptz, null::uuid,
+             null::timestamptz),
+            ('invite', null::uuid, '00000000-0000-0000-0000-0000000008e1'::uuid, 'add',
+             current_setting('t.owner')::uuid, now() + interval '7 days', null::timestamptz, null::uuid,
+             null::timestamptz) $$,
+  'create_link stores the kind, target, role, creator and expiry'
+);
+select is((select expires_at from public.links where token_sha256 = current_setting('t.sha_inv_long')),
+          now() + interval '7 days', 'an invite link lasts at most 7 days (D44)');
+select is((select expires_at from public.links where token_sha256 = current_setting('t.sha_inv_unshare')),
+          now() + interval '1 day', 'a shorter invite expiry is kept');
+select is((select count(*)::int from public.links where token_sha256 = current_setting('t.sha_refused')), 0,
+          'no refused link left a row');
+select is((select count(*)::int from public.links), 15, 'fifteen links were made');
+
+-- No direct access ------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select is_empty($$ select id from public.links $$, 'authenticated reads no links');
+select throws_ok(
+  $$ insert into public.links (kind, token_sha256, send_id, created_by)
+     values ('send', current_setting('t.sha_refused'), '00000000-0000-0000-0000-0000000008d1',
+             current_setting('t.sender')::uuid) $$,
+  '42501', null, 'authenticated cannot insert links'
+);
+select is_empty($$ update public.links set revoked_at = null, expires_at = null returning id $$,
+                'authenticated cannot update links');
+select is_empty($$ delete from public.links returning id $$, 'authenticated cannot delete links');
+select tests.clear_auth();
+select is_empty($$ select id from public.links $$, 'anon reads no links');
+reset role;
+select is((select count(*)::int from public.links), 15, 'the direct writes changed nothing');
+
+-- list_my_links ---------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select is((select count(*)::int from public.list_my_links('send')), 5, 'list_my_links returns the sender''s send links');
+select is_empty($$ select id from public.list_my_links('invite') $$, 'the sender has no invite links');
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select is((select count(*)::int from public.list_my_links('invite')), 10,
+          'list_my_links returns the owner''s invite links');
+select is((select count(*)::int from public.list_my_links(null)), 10, 'list_my_links(NULL) returns every kind');
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select is_empty($$ select id from public.list_my_links(null) $$, 'a stranger lists no links');
+reset role;
+select ok(pg_get_function_result('public.list_my_links(text)'::regprocedure) !~ 'sha',
+          'list_my_links never returns the hash');
+
+-- revoke_link -----------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select throws_ok($$ select public.revoke_link(current_setting('t.link_revoked')::uuid) $$, '42501', 'no such link',
+                 'someone else cannot revoke a link');
+select throws_ok($$ select public.revoke_link('00000000-0000-0000-0000-0000000008ff') $$, '42501', 'no such link',
+                 'revoking an unknown link raises the same error');
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select lives_ok($$ select public.revoke_link(current_setting('t.link_revoked')::uuid) $$, 'the creator revokes a link');
+select is((select revoked_at from public.list_my_links('send') where id = current_setting('t.link_revoked')::uuid),
+          now(), 'list_my_links shows the revoked link with revoked_at set');
+-- An earlier revoke (the clock can't move inside a test): revoking again keeps that time.
+reset role;
+update public.links set revoked_at = '2026-10-01T00:00:00Z' where id = current_setting('t.link_revoked')::uuid;
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select lives_ok($$ select public.revoke_link(current_setting('t.link_revoked')::uuid) $$, 'revoking again is harmless');
+select is((select revoked_at from public.list_my_links('send') where id = current_setting('t.link_revoked')::uuid),
+          '2026-10-01T00:00:00Z'::timestamptz, 'revoking again keeps the first time');
+select lives_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000008d2') $$, 'the sender withdraws a linked send');
+
+-- Expire two links and revoke one invite (as postgres: the clock can't move inside a test).
+reset role;
+update public.links set expires_at = now() - interval '1 second'
+where token_sha256 in (current_setting('t.sha_send_expired'), current_setting('t.sha_inv_expired'));
+select set_config('t.link_inv_revoked',
+                  (select id::text from public.links where token_sha256 = current_setting('t.sha_inv_revoked')), true);
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select lives_ok($$ select public.revoke_link(current_setting('t.link_inv_revoked')::uuid) $$,
+                'the owner revokes an invite link');
+select lives_ok($$ select public.stop_sharing('00000000-0000-0000-0000-0000000008e4') $$, 'the owner stops sharing e4');
+select lives_ok($$ update public.hit_lists set deleted_at = now(), updated_at = now()
+                   where id = '00000000-0000-0000-0000-0000000008e5' $$, 'the owner deletes e5');
+reset role;
+select is((select count(*)::int from public.links
+           where token_sha256 in (current_setting('t.sha_inv_unshare'), current_setting('t.sha_inv_deleted'))
+             and revoked_at is not null), 2,
+          'stopping sharing or deleting a list revokes its invite links');
+select is((select count(*)::int from public.links
+           where revoked_at is not null
+             and token_sha256 not in (current_setting('t.sha_inv_unshare'), current_setting('t.sha_inv_deleted'),
+                                      current_setting('t.sha_inv_revoked'), current_setting('t.sha_send_revoked'))), 0,
+          'it leaves other lists'' invite links and send links alone');
+update public.hit_lists set shared = true where id = '00000000-0000-0000-0000-0000000008e4';
+-- Live invite links to the unshared e2 and the deleted e3, as only the service role could make them.
+insert into public.links (kind, token_sha256, list_id, role, created_by, expires_at)
+select 'invite', encode(extensions.digest(tok, 'sha256'), 'hex'), list_id::uuid, 'add',
+       current_setting('t.owner')::uuid, now() + interval '1 day'
+from (values ('inv_private', '00000000-0000-0000-0000-0000000008e2'),
+             ('inv_gone', '00000000-0000-0000-0000-0000000008e3')) as v(tok, list_id);
+
+-- preview_link (the service role) ---------------------------------------------------------------------------------
+select tests.authenticate_as_service_role();
+select results_eq(
+  $$ select kind, send_id, payload, list_name, sender_username::text, sender_display_name, expires_at
+     from public.preview_link(current_setting('t.sha_send_live')) $$,
+  $$ values ('send', '00000000-0000-0000-0000-0000000008d1'::uuid, '{"spots": [{"name": "Library rail"}]}'::jsonb,
+             null::text, 'sender', 'Sam Sender', now() + interval '30 days') $$,
+  'preview_link returns a live send link''s kind, send id (photos are signed only under sends/<id>/), payload, sender and expiry'
+);
+select results_eq(
+  $$ select kind, expires_at from public.preview_link(current_setting('t.sha_send_never')) $$,
+  $$ values ('send', null::timestamptz) $$,
+  'a send link that never expires previews'
+);
+select results_eq(
+  $$ select kind, send_id, payload, list_name, sender_username::text, sender_display_name, expires_at
+     from public.preview_link(encode(extensions.digest('abc', 'sha256'), 'hex')) $$,
+  $$ values ('invite', null::uuid, null::jsonb, 'Downtown rails', 'owner', 'Olive Owner', now() + interval '7 days') $$,
+  'preview_link returns a live invite link''s kind, list name and inviter'
+);
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_send_expired')) $$,
+                'expired link previews nothing');
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_send_revoked')) $$,
+                'revoked link previews nothing');
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_send_withdrawn')) $$,
+                'withdrawn send link previews nothing');
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_refused')) $$,
+                'unknown link previews nothing');
+select is_empty($$ select * from public.preview_link('not a hash') $$, 'a malformed hash previews nothing');
+select is_empty($$ select * from public.preview_link(null) $$, 'a NULL hash previews nothing');
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_inv_expired')) $$,
+                'an expired invite link previews nothing');
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_inv_revoked')) $$,
+                'a revoked invite link previews nothing');
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_inv_unshare')) $$,
+                'an invite link of a list that stopped sharing previews nothing, even shared again');
+select is_empty($$ select * from public.preview_link(current_setting('t.sha_inv_deleted')) $$,
+                'an invite link of a deleted list previews nothing');
+select is_empty($$ select * from public.preview_link(encode(extensions.digest('inv_private', 'sha256'), 'hex'))
+                   union all
+                   select * from public.preview_link(encode(extensions.digest('inv_gone', 'sha256'), 'hex')) $$,
+                'an unrevoked invite link of an unshared or deleted list previews nothing');
+reset role;
+select set_config('role', 'service_role', true);
+select set_config('request.jwt.claims', '{"role": "authenticated"}', true);
+select throws_ok($$ select * from public.preview_link(current_setting('t.sha_send_live')) $$, '42501', null,
+                 'preview_link checks the JWT role claim is service_role');
+reset role;
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select throws_ok($$ select * from public.preview_link(current_setting('t.sha_send_live')) $$, '42501', null,
+                 'preview_link raises for authenticated');
+select tests.clear_auth();
+select throws_ok($$ select * from public.preview_link(current_setting('t.sha_send_live')) $$, '42501', null,
+                 'preview_link raises for anon');
+
+-- redeem_invite ---------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.joiner')::uuid);
+select is(public.redeem_invite('abc'), '00000000-0000-0000-0000-0000000008e1'::uuid,
+          'redeem_invite returns the list id (the token''s SHA-256 hex matches a client''s)');
+reset role;
+select results_eq(
+  $$ select role, status, invited_by, joined_at from public.hit_list_members
+     where list_id = '00000000-0000-0000-0000-0000000008e1' and user_id = current_setting('t.joiner')::uuid $$,
+  $$ values ('add', 'member', current_setting('t.owner')::uuid, now()) $$,
+  'redeem_invite makes the caller a member with the link''s role'
+);
+select results_eq(
+  $$ select used_by, used_at from public.links where token_sha256 = encode(extensions.digest('abc', 'sha256'), 'hex') $$,
+  $$ values (current_setting('t.joiner')::uuid, now()) $$,
+  'redeem_invite marks the link used by the caller'
+);
+select is_empty($$ select 1 from public.hit_list_spots
+                   where list_id = '00000000-0000-0000-0000-0000000008e1'
+                     and spot_id = '00000000-0000-0000-0000-0000000008a2' $$,
+                'joining by link clears a row left from an earlier membership');
+select tests.authenticate_as(current_setting('t.joiner')::uuid);
+select ok(public.can_read_spot('00000000-0000-0000-0000-0000000008a1'), 'the new member reads the list''s spots');
+select is(public.redeem_invite('abc'), '00000000-0000-0000-0000-0000000008e1'::uuid,
+          'the redeemer retrying the same link gets the list again');
+select tests.authenticate_as(current_setting('t.joiner2')::uuid);
+select throws_ok($$ select public.redeem_invite('abc') $$, '42501', 'invalid invite', 'second redeem raises invalid invite');
+reset role;
+select tests.authenticate_as_service_role();
+select is_empty($$ select * from public.preview_link(encode(extensions.digest('abc', 'sha256'), 'hex')) $$,
+                'a used invite link previews nothing');
+reset role;
+select is((select count(*)::int from public.hit_list_members
+           where list_id = '00000000-0000-0000-0000-0000000008e1'
+             and user_id in (current_setting('t.joiner')::uuid, current_setting('t.joiner2')::uuid)), 1,
+          'two redeems of one token yield one member row');
+
+select tests.authenticate_as(current_setting('t.viewer')::uuid);
+select lives_ok($$ select public.redeem_invite('inv_view') $$, 'a view link''s redeemer joins');
+select tests.authenticate_as(current_setting('t.invitee')::uuid);
+select lives_ok($$ select public.redeem_invite('inv_invitee') $$, 'an invitee joins by link');
+reset role;
+select results_eq(
+  $$ select user_id, role, status, joined_at is not null from public.hit_list_members
+     where list_id = '00000000-0000-0000-0000-0000000008e1'
+       and user_id in (current_setting('t.viewer')::uuid, current_setting('t.invitee')::uuid)
+     order by role desc $$,
+  $$ values (current_setting('t.viewer')::uuid, 'view', 'member', true),
+            (current_setting('t.invitee')::uuid, 'add', 'member', true) $$,
+  'a view link makes a view member; an invitee''s row becomes a member with the link''s role'
+);
+select is((select used_by from public.links where token_sha256 = current_setting('t.sha_inv_invitee')),
+          current_setting('t.invitee')::uuid, 'an invitee joining by link uses the link up');
+
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select is(public.redeem_invite('inv_owner'), '00000000-0000-0000-0000-0000000008e1'::uuid,
+          'the owner opening their own link gets the list');
+select tests.authenticate_as(current_setting('t.member')::uuid);
+select is(public.redeem_invite('inv_owner'), '00000000-0000-0000-0000-0000000008e1'::uuid,
+          'a member opening a link gets the list');
+reset role;
+select results_eq(
+  $$ select used_by, used_at, (select role from public.hit_list_members
+                               where list_id = '00000000-0000-0000-0000-0000000008e1'
+                                 and user_id = current_setting('t.member')::uuid)
+     from public.links where token_sha256 = current_setting('t.sha_inv_owner') $$,
+  $$ values (null::uuid, null::timestamptz, 'add') $$,
+  'the owner and a member leave the link unused and the member''s role as it was'
+);
+
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select throws_ok($$ select public.redeem_invite('no_such_token') $$, '42501', 'invalid invite',
+                 'an unknown invite raises invalid invite');
+select throws_ok($$ select public.redeem_invite('inv_expired') $$, '42501', 'invalid invite',
+                 'expired invite raises invalid invite');
+select throws_ok($$ select public.redeem_invite('inv_revoked') $$, '42501', 'invalid invite',
+                 'revoked invite raises invalid invite');
+select throws_ok($$ select public.redeem_invite('inv_unshare') $$, '42501', 'invalid invite',
+                 'an invite to a list that stopped sharing raises invalid invite');
+select throws_ok($$ select public.redeem_invite('inv_deleted') $$, '42501', 'invalid invite',
+                 'an invite to a deleted list raises invalid invite');
+select throws_ok($$ select public.redeem_invite('send_live') $$, '42501', 'invalid invite',
+                 'a send link is not an invite');
+select throws_ok($$ select public.redeem_invite('inv_private') $$, '42501', 'invalid invite',
+                 'an unrevoked invite to an unshared list raises invalid invite');
+select throws_ok($$ select public.redeem_invite('inv_gone') $$, '42501', 'invalid invite',
+                 'an unrevoked invite to a deleted list raises invalid invite');
+select throws_ok($$ select public.redeem_invite(null) $$, '42501', 'invalid invite', 'a NULL token raises invalid invite');
+select throws_ok(format('select public.redeem_invite(%L)', encode(extensions.digest('abc', 'sha256'), 'hex')),
+                 '42501', 'invalid invite', 'redeem_invite takes the token, not its hash');
+select tests.authenticate_as(current_setting('t.blocked')::uuid);
+select throws_ok($$ select public.redeem_invite('inv_blocked') $$, '42501', 'invalid invite',
+                 'blocked user cannot redeem invite');
+select tests.authenticate_as(current_setting('t.blocker')::uuid);
+select throws_ok($$ select public.redeem_invite('inv_blocked') $$, '42501', 'invalid invite',
+                 'a user who blocked the owner cannot redeem their invite');
+reset role;
+select results_eq(
+  $$ select l.used_at, (select count(*)::int from public.hit_list_members m
+                        where m.user_id in (current_setting('t.blocked')::uuid, current_setting('t.blocker')::uuid))
+     from public.links l where l.token_sha256 = current_setting('t.sha_inv_blocked') $$,
+  $$ values (null::timestamptz, 0) $$,
+  'the refused redeems left the link unused and made no member'
+);
+
+select tests.authenticate_as(current_setting('t.joiner')::uuid);
+select lives_ok($$ select public.leave_list('00000000-0000-0000-0000-0000000008e1') $$, 'the joiner leaves');
+select throws_ok($$ select public.redeem_invite('abc') $$, '42501', 'invalid invite',
+                 'a redeemer who left cannot rejoin with the used link');
+select tests.clear_auth();
+select throws_ok($$ select public.redeem_invite('inv_long') $$, '42501', null, 'anon cannot redeem');
+reset role;
+select set_config('role', 'authenticated', true);
+select set_config('request.jwt.claims', '{"role": "authenticated"}', true);
+select throws_ok($$ select public.redeem_invite('inv_long') $$, '42501', 'not signed in',
+                 'redeem_invite refuses a token without a user');
+select throws_ok($$ select public.create_link('send', '00000000-0000-0000-0000-0000000008d1',
+                                              current_setting('t.sha_refused'), null) $$, '42501', 'not signed in',
+                 'create_link refuses a token without a user');
+select throws_ok($$ select public.revoke_link(current_setting('t.link_revoked')::uuid) $$, '42501', 'not signed in',
+                 'revoke_link refuses a token without a user');
+
+-- Privileges ------------------------------------------------------------------------------------------------------
+reset role;
+select ok(not has_function_privilege('anon', p, 'execute'), 'anon cannot execute ' || p)
+from unnest(array['public.create_link(text, uuid, text, timestamp with time zone, text)', 'public.revoke_link(uuid)',
+                  'public.preview_link(text)', 'public.redeem_invite(text)', 'public.list_my_links(text)']) as p;
+select ok(not has_function_privilege('authenticated', 'public.preview_link(text)', 'execute'),
+          'authenticated cannot execute public.preview_link(text)');
+select ok(has_function_privilege('service_role', 'public.preview_link(text)', 'execute'),
+          'the service role executes public.preview_link(text)');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/090-review.test.sql b/supabase/tests/090-review.test.sql
new file mode 100644
index 0000000..b474c99
--- /dev/null
+++ b/supabase/tests/090-review.test.sql
@@ -0,0 +1,256 @@
+-- S3-08: the milestone review's written answers, each proved here over the catalog (so a later migration that breaks
+-- one fails this file) or by behaviour: definer functions, no RLS recursion, can_read_spot's indexes, the rev
+-- triggers and soft deletes, and what anon can execute. The storage path parser is proved in 070
+-- ('photo_path_ok accepts only three-segment …', 'a path with fewer than three segments is refused').
+begin;
+select plan(31);
+
+-- 1. Every security definer function pins search_path and checks the caller.
+select is_empty(
+  $$ select p.proname from pg_proc p
+     where p.pronamespace = 'public'::regnamespace and p.prosecdef
+       and not coalesce(p.proconfig @> array['search_path=""'], false) $$,
+  'every security definer function in public pins search_path to empty'
+);
+select is_empty(
+  $$ select p.proname from pg_proc p
+     where p.pronamespace = 'public'::regnamespace and p.prosecdef
+       and has_function_privilege('authenticated', p.oid, 'execute')
+       and position('auth.uid()' in regexp_replace(p.prosrc, '--[^\n]*', '', 'g')) = 0 $$,
+  'every security definer function a signed-in client can call checks auth.uid()'
+);
+select results_eq(
+  $$ select p.proname::text collate "default" from pg_proc p
+     where p.pronamespace = 'public'::regnamespace and p.prosecdef
+       and not has_function_privilege('authenticated', p.oid, 'execute')
+       and p.prorettype <> 'trigger'::regtype
+     order by 1 $$,
+  $$ values ('lock_user_pair') $$,
+  'the only definer function no client calls that is not a trigger is lock_user_pair'
+);
+select is_empty(
+  $$ select p.proname from pg_proc p
+     where p.pronamespace = 'public'::regnamespace
+       and (p.proacl is null or exists (select 1 from aclexplode(p.proacl) a where a.grantee = 0)) $$,
+  'no function in public is executable by PUBLIC'
+);
+
+-- 2. No RLS recursion: a policy reads another table only through a definer helper, except the insert/update checks
+-- that read spots, and no spots policy reads a table.
+select results_eq(
+  $$ select distinct lower(m[2]) collate "default" from pg_policies pol,
+       regexp_matches(coalesce(pol.qual, '') || ' ' || coalesce(pol.with_check, ''), '(FROM|JOIN)\s+([a-z_.]+)', 'gi') m
+     where pol.schemaname in ('public', 'storage') order by 1 $$,
+  $$ values ('spots') $$,
+  'the only table a policy reads directly is spots'
+);
+select is_empty(
+  $$ select pol.policyname from pg_policies pol
+     where pol.schemaname = 'public' and pol.tablename = 'spots'
+       and coalesce(pol.qual, '') || coalesce(pol.with_check, '') ~* '(from|join)\s' $$,
+  'no spots policy reads another table'
+);
+
+-- A member of a shared list reads every policy table without a recursion error.
+select set_config('t.owner', tests.create_user('owner9@test.local', 'owner9')::text, true);
+select set_config('t.member', tests.create_user('member9@test.local', 'member9')::text, true);
+insert into public.spots (id, owner_id, name, lat, lng, updated_at)
+values ('00000000-0000-0000-0000-0000000009b1', current_setting('t.owner')::uuid, 'Rail', 47.6, -122.3, now());
+insert into public.media (id, spot_id, owner_id, updated_at)
+values ('00000000-0000-0000-0000-0000000009c1', '00000000-0000-0000-0000-0000000009b1',
+        current_setting('t.owner')::uuid, now());
+insert into public.hit_lists (id, owner_id, name, kind, shared, updated_at)
+values ('00000000-0000-0000-0000-0000000009d1', current_setting('t.owner')::uuid, 'Shared', 'manual', true, now());
+insert into public.hit_list_spots (list_id, spot_id, added_by)
+values ('00000000-0000-0000-0000-0000000009d1', '00000000-0000-0000-0000-0000000009b1',
+        current_setting('t.owner')::uuid);
+insert into public.hit_list_members (list_id, user_id, role, status, invited_by, joined_at)
+values ('00000000-0000-0000-0000-0000000009d1', current_setting('t.member')::uuid, 'view', 'member',
+        current_setting('t.owner')::uuid, now());
+
+select tests.authenticate_as(current_setting('t.member')::uuid);
+select results_eq(
+  $$ select (select count(*) from public.profiles)::int, (select count(*) from public.hit_lists)::int,
+            (select count(*) from public.hit_list_members)::int, (select count(*) from public.hit_list_spots)::int,
+            (select count(*) from public.spots)::int, (select count(*) from public.media)::int $$,
+  $$ values (2, 1, 1, 1, 1, 1) $$,
+  'a member reads profiles, the list, its members, rows, spot and photo with no recursion'
+);
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select results_eq(
+  $$ select (select count(*) from public.profiles)::int, (select count(*) from public.hit_list_members)::int $$,
+  $$ values (2, 1) $$,
+  'the owner reads the member''s profile and membership with no recursion'
+);
+reset role;
+select set_config('request.jwt.claims', '', true);
+
+-- 3. can_read_spot is STABLE and its shared-list lookup uses indexes. The plan is of the function's own body (taken
+-- from pg_proc, parameters bound as literals), with sequential scans priced out so a missing index would show up.
+select volatility_is('public', 'can_read_spot', array['uuid', 'uuid'], 'stable', 'can_read_spot is STABLE');
+select is_indexed('public', 'hit_list_spots', array['spot_id'], 'hit_list_spots has an index on spot_id');
+select col_is_pk('public', 'hit_list_members', array['list_id', 'user_id'],
+                 'hit_list_members is keyed by (list_id, user_id)');
+select is_indexed('public', 'hit_list_members', array['user_id', 'list_id'],
+                  'hit_list_members has an index on (user_id, list_id)');
+
+create function pg_temp.can_read_spot_plan() returns setof text language plpgsql as $f$
+declare
+  body text;
+  r text;
+begin
+  select replace(replace(p.prosrc, 'p_spot_id', quote_literal('00000000-0000-0000-0000-0000000009b1') || '::uuid'),
+                 'p_uid', quote_literal(current_setting('t.member')) || '::uuid')
+    into body from pg_proc p where p.oid = 'public.can_read_spot(uuid, uuid)'::regprocedure;
+  for r in execute 'explain (costs off) ' || body loop
+    return next r;
+  end loop;
+end
+$f$;
+set local enable_seqscan = off;
+select set_config('t.plan', (select string_agg(l, E'\n') from pg_temp.can_read_spot_plan() l), true);
+reset enable_seqscan;
+select unalike(current_setting('t.plan'), '%Seq Scan%', 'can_read_spot''s plan has no sequential scan');
+select matches(current_setting('t.plan'), 'Index Scan using spots_pkey on spots',
+               'can_read_spot finds the spot by its primary key');
+select matches(current_setting('t.plan'), '(Index Scan using|Index Only Scan using|Bitmap Index Scan on) hit_list_spots_spot_idx',
+               'can_read_spot finds the spot''s list rows by hit_list_spots(spot_id)');
+select matches(current_setting('t.plan'), '(Index Scan using|Index Only Scan using|Bitmap Index Scan on) hit_list_members_(pkey|user_idx)',
+               'can_read_spot finds memberships by an index on hit_list_members (list_id, user_id)');
+
+-- 4. One rev trigger, BEFORE INSERT OR UPDATE FOR EACH ROW on any column, on every synced table, and soft deletes
+-- bump it.
+select results_eq(
+  $$ select c.relname::text collate "default" from pg_trigger t join pg_class c on c.oid = t.tgrelid
+     where t.tgname = 't20_rev' and t.tgfoid = 'public.bump_rev()'::regprocedure
+       and (t.tgtype & 31) = 23 and cardinality(t.tgattr::int2[]) = 0 and t.tgenabled = 'O'
+     order by 1 $$,
+  $$ values ('hit_list_members'), ('hit_list_spots'), ('hit_lists'), ('media'), ('profiles'), ('spots') $$,
+  'every synced table has t20_rev BEFORE INSERT OR UPDATE FOR EACH ROW on any column'
+);
+select is_empty(
+  $$ select tgname from pg_trigger where tgfoid = 'public.bump_rev()'::regprocedure and tgname <> 't20_rev' $$,
+  'bump_rev is used by no other trigger'
+);
+
+select set_config('t.media_rev', (select rev::text from public.media where id = '00000000-0000-0000-0000-0000000009c1'),
+                  true);
+update public.media set deleted_at = now() + interval '1 minute', updated_at = now() + interval '1 minute'
+where id = '00000000-0000-0000-0000-0000000009c1';
+select cmp_ok((select rev from public.media where id = '00000000-0000-0000-0000-0000000009c1'), '>',
+              current_setting('t.media_rev')::bigint, 'a photo soft delete bumps rev');
+select set_config('t.list_rev', (select rev::text from public.hit_lists where id = '00000000-0000-0000-0000-0000000009d1'),
+                  true);
+update public.hit_lists set deleted_at = now() + interval '1 minute', updated_at = now() + interval '1 minute'
+where id = '00000000-0000-0000-0000-0000000009d1';
+select cmp_ok((select rev from public.hit_lists where id = '00000000-0000-0000-0000-0000000009d1'), '>',
+              current_setting('t.list_rev')::bigint, 'a list soft delete bumps rev');
+select set_config('t.spot_rev', (select rev::text from public.spots where id = '00000000-0000-0000-0000-0000000009b1'),
+                  true);
+update public.spots set deleted_at = now() + interval '1 minute', updated_at = now() + interval '1 minute'
+where id = '00000000-0000-0000-0000-0000000009b1';
+select cmp_ok((select rev from public.spots where id = '00000000-0000-0000-0000-0000000009b1'), '>',
+              current_setting('t.spot_rev')::bigint, 'a spot soft delete bumps rev');
+
+-- 5. anon: executes no function in public (also 010), and the two link entry points refuse it.
+select is_empty(
+  $$ select p.proname from pg_proc p
+     where p.pronamespace = 'public'::regnamespace and has_function_privilege('anon', p.oid, 'execute') $$,
+  'anon executes no function in public'
+);
+select ok(not has_function_privilege('authenticated', 'public.preview_link(text)', 'execute')
+          and has_function_privilege('service_role', 'public.preview_link(text)', 'execute'),
+          'preview_link is executable by the service role only');
+select tests.clear_auth();
+select throws_ok($$ select public.redeem_invite('any-token') $$, '42501', null, 'anon cannot redeem an invite');
+
+-- Every action a client calls refuses a token without a user (role authenticated, no sub), not just anon (which fails
+-- on EXECUTE first). Each one is called with NULL arguments; anything but 42501 'not signed in' is listed.
+create function pg_temp.actions_without_user() returns setof text language plpgsql as $f$
+declare
+  f record;
+begin
+  for f in
+    select p.oid::regprocedure as sig, p.oid::regproc::text as fn,
+           (select string_agg('null::' || format_type(t, null), ', ' order by o)
+              from unnest(p.proargtypes::oid[]) with ordinality as a(t, o)) as args
+    from pg_proc p
+    where p.pronamespace = 'public'::regnamespace and p.prosecdef and p.provolatile = 'v'
+      and p.prorettype <> 'trigger'::regtype and has_function_privilege('authenticated', p.oid, 'execute')
+  loop
+    begin
+      execute format('select %s(%s)', f.fn, coalesce(f.args, ''));
+      return next f.sig::text || ': no error';
+    exception when others then
+      if sqlstate <> '42501' or sqlerrm <> 'not signed in' then
+        return next f.sig::text || ': ' || sqlstate || ' ' || sqlerrm;
+      end if;
+    end;
+  end loop;
+end
+$f$;
+select set_config('role', 'authenticated', true);
+select set_config('request.jwt.claims', '{"role": "authenticated"}', true);
+select is_empty($$ select * from pg_temp.actions_without_user() $$,
+                'every client action raises not signed in for a token without a user');
+reset role;
+select set_config('request.jwt.claims', '', true);
+
+-- seed.sql's helpers: tests.create_user writes auth.users as its definer, so no client role may call it.
+select ok(not has_function_privilege('anon', 'tests.create_user(text, text)', 'execute')
+          and not has_function_privilege('authenticated', 'tests.create_user(text, text)', 'execute'),
+          'no client role executes tests.create_user');
+
+-- Review fixes (S3-08). D50: an invitation that outlived its friendship (an invite racing Remove friend) still goes
+-- when either rider blocks the other, and a blocked pair can't Join.
+select set_config('t.rider', tests.create_user('rider9@test.local', 'rider9')::text, true);
+select set_config('t.rider2', tests.create_user('rider9b@test.local', 'rider9b')::text, true);
+insert into public.hit_lists (id, owner_id, name, kind, shared, updated_at)
+values ('00000000-0000-0000-0000-0000000009d2', current_setting('t.owner')::uuid, 'Second', 'manual', true, now());
+insert into public.hit_list_members (list_id, user_id, role, status, invited_by)
+values ('00000000-0000-0000-0000-0000000009d2', current_setting('t.rider')::uuid, 'add', 'invited',
+        current_setting('t.owner')::uuid),
+       ('00000000-0000-0000-0000-0000000009d2', current_setting('t.rider2')::uuid, 'add', 'invited',
+        current_setting('t.owner')::uuid);
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select public.block_user(current_setting('t.rider')::uuid);
+reset role;
+select is_empty(
+  $$ select 1 from public.hit_list_members
+     where list_id = '00000000-0000-0000-0000-0000000009d2' and user_id = current_setting('t.rider')::uuid $$,
+  'block_user withdraws an invitation between the pair even with no friendship'
+);
+insert into public.blocks (blocker, blocked) values (current_setting('t.rider2')::uuid, current_setting('t.owner')::uuid);
+select tests.authenticate_as(current_setting('t.rider2')::uuid);
+select throws_ok(
+  $$ update public.hit_list_members set status = 'member'
+     where list_id = '00000000-0000-0000-0000-0000000009d2' and user_id = current_setting('t.rider2')::uuid $$,
+  '42501', null, 'a blocked pair cannot Join through an invitation left from before the block'
+);
+
+-- media.uploaded_by names the uploader: the owner can't put someone else's id there.
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+insert into public.spots (id, owner_id, name, lat, lng, updated_at)
+values ('00000000-0000-0000-0000-0000000009b2', current_setting('t.owner')::uuid, 'Bank', 47.6, -122.3, now());
+select throws_ok(
+  $$ insert into public.media (id, spot_id, owner_id, uploaded_by, updated_at)
+     values ('00000000-0000-0000-0000-0000000009c2', '00000000-0000-0000-0000-0000000009b2',
+             current_setting('t.owner')::uuid, current_setting('t.member')::uuid, now()) $$,
+  '42501', null, 'owner cannot insert a photo uploaded_by someone else'
+);
+select lives_ok(
+  $$ insert into public.media (id, spot_id, owner_id, uploaded_by, updated_at)
+     values ('00000000-0000-0000-0000-0000000009c3', '00000000-0000-0000-0000-0000000009b2',
+             current_setting('t.owner')::uuid, current_setting('t.owner')::uuid, now()) $$,
+  'owner inserts a photo uploaded_by themselves'
+);
+select throws_ok(
+  $$ update public.media set uploaded_by = current_setting('t.member')::uuid, updated_at = now() + interval '2 minutes'
+     where id = '00000000-0000-0000-0000-0000000009c3' $$,
+  '42501', null, 'owner cannot set a photo''s uploaded_by to someone else'
+);
+reset role;
+select set_config('request.jwt.claims', '', true);
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/100-sends-s7.test.sql b/supabase/tests/100-sends-s7.test.sql
new file mode 100644
index 0000000..5f56203
--- /dev/null
+++ b/supabase/tests/100-sends-s7.test.sql
@@ -0,0 +1,203 @@
+-- S7-03: sending (docs/plans/2026-10-22-s7-send.md, "Photo copy" and "Server migration"; D77 photos are staged
+-- before the send row, D80 the sender's name comes from the server). A staged photo is an object under sends/<id>/
+-- with the stager's owner_id and no sends row with that id: only its stager writes, reads and deletes it, and
+-- create_send refuses an id somebody else staged into. mark_send_saved saves once. spots.from_username is a
+-- username. staged_send_objects is the service role's (account-delete).
+begin;
+select plan(34);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.sender', tests.create_user('sender@test.local', 'Ana_B')::text, true);
+select set_config('t.rec', tests.create_user('rec@test.local', 'recipient')::text, true);
+select set_config('t.stranger', tests.create_user('stranger@test.local', 'stranger')::text, true);
+select set_config('t.noname', tests.create_user('noname@test.local')::text, true);
+update public.profiles set display_name = 'Ana B' where id = current_setting('t.sender')::uuid;
+
+-- The sender and the noname rider are the recipient's friends.
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(a, b), greatest(a, b), 'accepted', a
+from (select current_setting('t.' || x)::uuid as a, current_setting('t.' || y)::uuid as b
+      from (values ('sender', 'rec'), ('noname', 'rec')) as v(x, y)) p;
+
+-- An existing send of the sender's (e0), and objects written past the policies (as postgres): one the stranger
+-- staged under a1, one with no owner under a2.
+insert into public.sends (id, sender, recipient, payload)
+values ('00000000-0000-0000-0000-0000000007e0', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+        '{}');
+insert into storage.objects (bucket_id, name, owner_id)
+values ('photos', 'sends/00000000-0000-0000-0000-0000000007a1/00000000-0000-0000-0000-0000000007f1.jpg',
+        current_setting('t.stranger')),
+       ('photos', 'sends/00000000-0000-0000-0000-0000000007a2/00000000-0000-0000-0000-0000000007f2.jpg', null);
+
+-- Staging ------------------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select lives_ok(
+  $$ insert into storage.objects (bucket_id, name, owner_id)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000007b1/00000000-0000-0000-0000-0000000007c1.jpg',
+             current_setting('t.sender')) $$,
+  'a rider stages a photo for a send id nobody has used'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name, owner_id)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000007b1/00000000-0000-0000-0000-0000000007c2.jpg',
+             current_setting('t.stranger')) $$,
+  '42501', null, 'staging with another rider''s owner_id is refused'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000007b1/00000000-0000-0000-0000-0000000007c3.jpg') $$,
+  '42501', null, 'staging without an owner_id is refused'
+);
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name, owner_id)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000007b1/not-a-uuid.jpg', current_setting('t.sender')) $$,
+  '42501', null, 'staging still needs a photo path'
+);
+select results_eq(
+  $$ select name from storage.objects where name like 'sends/%' order by name $$,
+  $$ values ('sends/00000000-0000-0000-0000-0000000007b1/00000000-0000-0000-0000-0000000007c1.jpg') $$,
+  'the stager reads their own staged photo and nobody else''s'
+);
+
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select is_empty($$ select name from storage.objects where name like 'sends/%' $$,
+                'the recipient-to-be reads no staged photo');
+
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select set_config('storage.allow_delete_query', 'true', true);
+select is_empty($$ select name from storage.objects where name like 'sends/00000000-0000-0000-0000-0000000007b1/%' $$,
+                'a stranger reads no staged photo of another rider');
+select is_empty($$ delete from storage.objects where name like 'sends/00000000-0000-0000-0000-0000000007b1/%'
+                   returning name $$,
+                'a stranger cannot delete a staged photo of another rider');
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name, owner_id)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000007e0/00000000-0000-0000-0000-0000000007c4.jpg',
+             current_setting('t.stranger')) $$,
+  '42501', null, 'another rider cannot stage into an existing send''s id'
+);
+
+select tests.clear_auth();
+select throws_ok(
+  $$ insert into storage.objects (bucket_id, name, owner_id)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000007b9/00000000-0000-0000-0000-0000000007c5.jpg', null) $$,
+  '42501', null, 'anon cannot stage a photo'
+);
+
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select lives_ok(
+  $$ insert into storage.objects (bucket_id, name, owner_id)
+     values ('photos', 'sends/00000000-0000-0000-0000-0000000007b2/00000000-0000-0000-0000-0000000007c6.jpg',
+             current_setting('t.sender')) $$,
+  'the sender stages a photo for a send they will abandon'
+);
+select results_eq(
+  $$ delete from storage.objects where name like 'sends/00000000-0000-0000-0000-0000000007b2/%' returning name $$,
+  $$ values ('sends/00000000-0000-0000-0000-0000000007b2/00000000-0000-0000-0000-0000000007c6.jpg') $$,
+  'the stager deletes their own staged photo'
+);
+
+-- create_send ------------------------------------------------------------------------------------------------------
+select throws_ok(
+  $$ select public.create_send('00000000-0000-0000-0000-0000000007a1', current_setting('t.rec')::uuid,
+                               '{"v": 1, "spots": []}') $$,
+  '42501', null, 'create_send refuses an id another rider staged a photo under'
+);
+select throws_ok(
+  $$ select public.create_send('00000000-0000-0000-0000-0000000007a2', current_setting('t.rec')::uuid,
+                               '{"v": 1, "spots": []}') $$,
+  '42501', null, 'create_send refuses an id with a staged photo nobody owns'
+);
+select lives_ok(
+  $$ select public.create_send('00000000-0000-0000-0000-0000000007b1', current_setting('t.rec')::uuid,
+                               '{"v": 1, "sender": {"username": "forged", "display_name": "Not Ana"}, "spots": []}') $$,
+  'create_send takes the staged id'
+);
+select results_eq(
+  $$ select payload from public.sends where id = '00000000-0000-0000-0000-0000000007b1' $$,
+  $$ values ('{"v": 1, "sender": {"username": "Ana_B", "display_name": "Ana B"}, "spots": []}'::jsonb) $$,
+  'create_send writes the sender from the caller''s profile over a forged one'
+);
+select lives_ok(
+  $$ select public.create_send('00000000-0000-0000-0000-0000000007b3', current_setting('t.rec')::uuid,
+                               '{"v": 1, "spots": []}') $$,
+  'create_send without a sender in the payload adds one'
+);
+select is(
+  (select payload -> 'sender' from public.sends where id = '00000000-0000-0000-0000-0000000007b3'),
+  '{"username": "Ana_B", "display_name": "Ana B"}'::jsonb,
+  'the added sender is the caller''s username and display name'
+);
+
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select results_eq(
+  $$ select name from storage.objects where name like 'sends/%' order by name $$,
+  $$ values ('sends/00000000-0000-0000-0000-0000000007b1/00000000-0000-0000-0000-0000000007c1.jpg') $$,
+  'once the send exists its recipient reads the photo staged for it'
+);
+
+select tests.authenticate_as(current_setting('t.noname')::uuid);
+select throws_ok(
+  $$ select public.create_send('00000000-0000-0000-0000-0000000007b4', current_setting('t.rec')::uuid,
+                               '{"v": 1, "spots": []}') $$,
+  '22023', null, 'create_send refuses a rider who has no username yet'
+);
+
+-- mark_send_saved saves once ---------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select lives_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000007b1') $$,
+                'the recipient saves a send');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000007b1') $$, '55000', null,
+                 'saving a send twice raises 55000');
+select lives_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000007b3',
+                                                 '00000000-0000-0000-0000-0000000007a9') $$,
+                'a phone saves a send with its save token');
+select lives_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000007b3',
+                                                 '00000000-0000-0000-0000-0000000007a9') $$,
+                'the same token again (a retry after a lost answer) succeeds');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000007b3',
+                                                  '00000000-0000-0000-0000-0000000007aa') $$, '55000', null,
+                 'another phone''s token raises 55000');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000007b3') $$, '55000', null,
+                 'no token after a tokened save raises 55000');
+
+-- spots.from_username ----------------------------------------------------------------------------------------------
+select has_column('public', 'spots', 'from_username', 'spots has from_username');
+select lives_ok(
+  $$ insert into public.spots (id, owner_id, lat, lng, updated_at, copied_from_send, from_username)
+     values ('00000000-0000-0000-0000-0000000007d1', current_setting('t.rec')::uuid, 47.6, -122.3, now(),
+             '00000000-0000-0000-0000-0000000007b1', 'Ana_B') $$,
+  'a copy keeps the sender''s username as it is spelled'
+);
+select throws_ok(
+  $$ insert into public.spots (id, owner_id, lat, lng, updated_at, from_username)
+     values ('00000000-0000-0000-0000-0000000007d2', current_setting('t.rec')::uuid, 47.6, -122.3, now(), 'a b') $$,
+  '23514', null, 'from_username must be a username'
+);
+select results_eq(
+  $$ select copied_from_send, from_username from public.spots where id = '00000000-0000-0000-0000-0000000007d1' $$,
+  $$ values ('00000000-0000-0000-0000-0000000007b1'::uuid, 'Ana_B'::text) $$,
+  'the copy reads back with its send and its sender'
+);
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select is_empty($$ select id from public.spots where id = '00000000-0000-0000-0000-0000000007d1' $$,
+                'the sender cannot read the recipient''s copy');
+
+-- staged_send_objects (account-delete's leftovers) -----------------------------------------------------------------
+reset role;
+insert into storage.objects (bucket_id, name, owner_id)
+values ('photos', 'sends/00000000-0000-0000-0000-0000000007b5/00000000-0000-0000-0000-0000000007c7.jpg',
+        current_setting('t.sender'));
+select ok(not has_function_privilege('authenticated', 'public.staged_send_objects(uuid)', 'execute'),
+          'authenticated cannot execute staged_send_objects');
+select ok(not has_function_privilege('anon', 'public.staged_send_objects(uuid)', 'execute'),
+          'anon cannot execute staged_send_objects');
+select tests.authenticate_as_service_role();
+select results_eq(
+  $$ select * from public.staged_send_objects(current_setting('t.sender')::uuid) $$,
+  $$ values ('sends/00000000-0000-0000-0000-0000000007b5/00000000-0000-0000-0000-0000000007c7.jpg'::text) $$,
+  'staged_send_objects lists the rider''s staged photos and none of a send that exists'
+);
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/110-shared-lists-s8.test.sql b/supabase/tests/110-shared-lists-s8.test.sql
new file mode 100644
index 0000000..64f08be
--- /dev/null
+++ b/supabase/tests/110-shared-lists-s8.test.sql
@@ -0,0 +1,197 @@
+-- S8-02: shared lists from the client (docs/plans/2026-10-22-s8-shared-lists.md, "Server"; D83 an invitee sees the
+-- list's name, owner and spot count but no spots until Join). list_invitations() is the caller's open invitations of
+-- live, shared lists with the count a member would read; share_list(p_list) turns sharing on for the owner only.
+begin;
+select plan(26);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.ana', tests.create_user('ana@test.local', 'ana')::text, true);
+select set_config('t.ben', tests.create_user('ben@test.local', 'ben')::text, true);
+select set_config('t.cal', tests.create_user('cal@test.local', 'cal')::text, true);
+select set_config('t.dan', tests.create_user('dan@test.local', 'dan')::text, true);
+select set_config('t.eve', tests.create_user('eve@test.local', 'eve')::text, true);
+select set_config('t.fay', tests.create_user('fay@test.local', 'fay')::text, true);
+select set_config('t.hal', tests.create_user('hal@test.local', 'hal')::text, true);
+update public.profiles set display_name = 'Ana A' where id = current_setting('t.ana')::uuid;
+
+-- ana's friends: ben, cal, dan, fay, hal. eve is nobody's friend.
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(o, f), greatest(o, f), 'accepted', o
+from (select current_setting('t.ana')::uuid as o, current_setting('t.' || who)::uuid as f
+      from unnest(array['ben', 'cal', 'dan', 'fay', 'hal']) as who) p;
+
+-- Lists, all ana's (as postgres): f1 'Downtown' shared manual · f2 'Area' shared area (1 km round 40,-105, rails) ·
+-- f3 'Gone' shared manual, soft-deleted · f4 'Crew' shared manual (stop sharing) · f5 'Private' manual, not shared.
+insert into public.hit_lists (id, owner_id, name, kind, shared, area_center_lat, area_center_lng, area_radius_m,
+                              area_filters, updated_at, deleted_at)
+select id::uuid, current_setting('t.ana')::uuid, name, kind, shared, clat, clng, r, filters, '2026-10-22T12:00:00Z',
+       deleted
+from (values
+  ('00000000-0000-0000-0000-0000000011f1', 'Downtown', 'manual', true, null::float8, null::float8, null::int,
+   null::jsonb, null::timestamptz),
+  ('00000000-0000-0000-0000-0000000011f2', 'Area', 'area', true, 40.0, -105.0, 1000, '{"types": ["rail"]}', null),
+  ('00000000-0000-0000-0000-0000000011f3', 'Gone', 'manual', true, null, null, null, null, now()),
+  ('00000000-0000-0000-0000-0000000011f4', 'Crew', 'manual', true, null, null, null, null, null),
+  ('00000000-0000-0000-0000-0000000011f5', 'Private', 'manual', false, null, null, null, null, null)
+) as v(id, name, kind, shared, clat, clng, r, filters, deleted);
+
+-- Spots: a1–a3 ana's in f1 · a4 ana's in f1, deleted · c1 cal's in f1 (cal is a member) · e1 eve's, a stray row in
+-- f1 (eve is not in the list) · r1 ana's rail inside f2's circle · r2 ana's ledge inside it · r3 ana's rail outside it ·
+-- r4 ana's rail with no location · x1 cal's rail inside the circle (not the owner's).
+insert into public.spots (id, owner_id, lat, lng, feature_types, updated_at, deleted_at)
+select id::uuid, current_setting('t.' || who)::uuid, lat, lng, types, '2026-10-22T12:00:00Z', deleted
+from (values
+  ('00000000-0000-0000-0000-0000000011a1', 'ana', 40.0, -105.0, '{}'::text[], null::timestamptz),
+  ('00000000-0000-0000-0000-0000000011a2', 'ana', 40.0, -105.0, '{}', null),
+  ('00000000-0000-0000-0000-0000000011a3', 'ana', 40.0, -105.0, '{}', null),
+  ('00000000-0000-0000-0000-0000000011a4', 'ana', 40.0, -105.0, '{}', now()),
+  ('00000000-0000-0000-0000-0000000011c1', 'cal', 40.0, -105.0, '{}', null),
+  ('00000000-0000-0000-0000-0000000011e1', 'eve', 40.0, -105.0, '{}', null),
+  ('00000000-0000-0000-0000-0000000011b1', 'ana', 40.0, -105.0, '{rail}', null),
+  ('00000000-0000-0000-0000-0000000011b2', 'ana', 40.001, -105.0, '{ledge}', null),
+  ('00000000-0000-0000-0000-0000000011b3', 'ana', 41.0, -105.0, '{rail}', null),
+  ('00000000-0000-0000-0000-0000000011b4', 'ana', 0.0, 0.0, '{rail}', null),
+  ('00000000-0000-0000-0000-0000000011b5', 'cal', 40.0, -105.0, '{rail}', null)
+) as v(id, who, lat, lng, types, deleted);
+
+insert into public.hit_list_members (list_id, user_id, role, status, invited_by, invited_at)
+select l::uuid, current_setting('t.' || who)::uuid, role, status, current_setting('t.ana')::uuid, at::timestamptz
+from (values
+  ('00000000-0000-0000-0000-0000000011f1', 'cal', 'add', 'member', '2026-10-20T10:00:00Z'),
+  ('00000000-0000-0000-0000-0000000011f1', 'ben', 'add', 'invited', '2026-10-21T10:00:00Z'),
+  ('00000000-0000-0000-0000-0000000011f2', 'ben', 'view', 'invited', '2026-10-22T10:00:00Z'),
+  ('00000000-0000-0000-0000-0000000011f3', 'ben', 'add', 'invited', '2026-10-22T11:00:00Z'),
+  ('00000000-0000-0000-0000-0000000011f1', 'dan', 'view', 'invited', '2026-10-21T10:00:00Z'),
+  ('00000000-0000-0000-0000-0000000011f1', 'fay', 'add', 'invited', '2026-10-21T10:00:00Z'),
+  ('00000000-0000-0000-0000-0000000011f4', 'hal', 'add', 'invited', '2026-10-21T10:00:00Z'),
+  ('00000000-0000-0000-0000-0000000011f4', 'cal', 'add', 'member', '2026-10-20T10:00:00Z')
+) as v(l, who, role, status, at);
+
+insert into public.hit_list_spots (list_id, spot_id, added_by)
+select '00000000-0000-0000-0000-0000000011f1'::uuid, s::uuid, current_setting('t.' || who)::uuid
+from (values
+  ('00000000-0000-0000-0000-0000000011a1', 'ana'),
+  ('00000000-0000-0000-0000-0000000011a2', 'ana'),
+  ('00000000-0000-0000-0000-0000000011a3', 'ana'),
+  ('00000000-0000-0000-0000-0000000011a4', 'ana'),
+  ('00000000-0000-0000-0000-0000000011c1', 'cal'),
+  ('00000000-0000-0000-0000-0000000011e1', 'eve')
+) as v(s, who);
+
+-- list_invitations -------------------------------------------------------------------------------------------------
+select has_function('public', 'list_invitations', array[]::text[], 'list_invitations() exists');
+select ok((select prosecdef from pg_proc where proname = 'list_invitations'), 'list_invitations is security definer');
+
+select tests.clear_auth();
+select throws_ok($$ select * from public.list_invitations() $$, '42501', null, 'anon cannot call list_invitations');
+reset role;
+
+select tests.authenticate_as(current_setting('t.eve')::uuid);
+select is_empty($$ select * from public.list_invitations() $$, 'a stranger has no invitations');
+
+select tests.authenticate_as(current_setting('t.ben')::uuid);
+select results_eq(
+  $$ select name, kind, owner_id, owner_username, owner_display_name, role, spot_count
+     from public.list_invitations() order by name $$,
+  $$ values ('Area'::text, 'area'::text, current_setting('t.ana')::uuid, 'ana'::text, 'Ana A'::text, 'view'::text, 1),
+            ('Downtown', 'manual', current_setting('t.ana')::uuid, 'ana', 'Ana A', 'add', 4) $$,
+  'an invitee sees each live shared list''s name, kind, owner and the count a member would read (no deleted list)'
+);
+select results_eq(
+  $$ select list_id from public.list_invitations() $$,
+  $$ values ('00000000-0000-0000-0000-0000000011f2'::uuid), ('00000000-0000-0000-0000-0000000011f1'::uuid) $$,
+  'newest invitation first'
+);
+select is(
+  (select invited_at from public.list_invitations() where name = 'Downtown'),
+  '2026-10-21T10:00:00Z'::timestamptz,
+  'each row carries invited_at'
+);
+select is_empty($$ select * from public.spots where id::text like '00000000-0000-0000-0000-0000000011%' $$,
+                'an invitee still reads none of the spots (D83)');
+
+select tests.authenticate_as(current_setting('t.cal')::uuid);
+select is_empty($$ select * from public.list_invitations() $$, 'a joined member has no invitation');
+
+-- answers and withdrawals take the row away ------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.dan')::uuid);
+select results_eq($$ select name from public.list_invitations() $$, $$ values ('Downtown'::text) $$,
+                  'dan is invited to Downtown');
+delete from public.hit_list_members where list_id = '00000000-0000-0000-0000-0000000011f1' and user_id = auth.uid();
+select is_empty($$ select * from public.list_invitations() $$, 'after Decline the invitation is gone');
+
+select tests.authenticate_as(current_setting('t.ben')::uuid);
+update public.hit_list_members set status = 'member'
+where list_id = '00000000-0000-0000-0000-0000000011f1' and user_id = auth.uid();
+select results_eq($$ select name from public.list_invitations() $$, $$ values ('Area'::text) $$,
+                  'after Join the joined list leaves the invitations');
+
+select tests.authenticate_as(current_setting('t.ana')::uuid);
+select lives_ok($$ select public.remove_member('00000000-0000-0000-0000-0000000011f2', current_setting('t.ben')::uuid) $$,
+                'the owner withdraws an invitation');
+select tests.authenticate_as(current_setting('t.ben')::uuid);
+select is_empty($$ select * from public.list_invitations() $$, 'a withdrawn invitation is gone');
+
+select tests.authenticate_as(current_setting('t.ana')::uuid);
+select lives_ok($$ select public.stop_sharing('00000000-0000-0000-0000-0000000011f4') $$, 'ana stops sharing Crew');
+select tests.authenticate_as(current_setting('t.hal')::uuid);
+select is_empty($$ select * from public.list_invitations() $$, 'after Stop sharing the invitation is gone');
+
+reset role;
+select tests.authenticate_as(current_setting('t.fay')::uuid);
+select results_eq($$ select name from public.list_invitations() $$, $$ values ('Downtown'::text) $$,
+                  'fay is invited to Downtown');
+reset role;
+insert into public.blocks (blocker, blocked) values (current_setting('t.fay')::uuid, current_setting('t.ana')::uuid);
+select tests.authenticate_as(current_setting('t.fay')::uuid);
+select is_empty($$ select * from public.list_invitations() $$, 'a block between invitee and owner hides it');
+
+-- and the other way round: the owner blocks the invitee (S8-02 review #9)
+reset role;
+insert into public.hit_list_members (list_id, user_id, role, status, invited_by)
+values ('00000000-0000-0000-0000-0000000011f1', current_setting('t.dan')::uuid, 'view', 'invited',
+        current_setting('t.ana')::uuid);
+select tests.authenticate_as(current_setting('t.dan')::uuid);
+select results_eq($$ select name from public.list_invitations() $$, $$ values ('Downtown'::text) $$,
+                  'dan is invited to Downtown again');
+reset role;
+insert into public.blocks (blocker, blocked) values (current_setting('t.ana')::uuid, current_setting('t.dan')::uuid);
+select tests.authenticate_as(current_setting('t.dan')::uuid);
+select is_empty($$ select * from public.list_invitations() $$, 'a block by the owner hides it from the invitee');
+
+-- share_list -------------------------------------------------------------------------------------------------------
+reset role;
+select set_config('t.rev_before', (select rev::text from public.hit_lists where id = '00000000-0000-0000-0000-0000000011f5'), true);
+select tests.authenticate_as(current_setting('t.ana')::uuid);
+select results_eq(
+  $$ select id, shared, rev > current_setting('t.rev_before')::bigint
+     from public.share_list('00000000-0000-0000-0000-0000000011f5') $$,
+  $$ values ('00000000-0000-0000-0000-0000000011f5'::uuid, true, true) $$,
+  'the owner turns sharing on and gets the row back with a new rev'
+);
+
+select tests.authenticate_as(current_setting('t.cal')::uuid);
+select throws_ok($$ select public.share_list('00000000-0000-0000-0000-0000000011f1') $$, '42501', null,
+                 'a member cannot turn sharing on');
+select tests.authenticate_as(current_setting('t.eve')::uuid);
+select throws_ok($$ select public.share_list('00000000-0000-0000-0000-0000000011f5') $$, '42501', null,
+                 'a stranger cannot turn sharing on');
+select tests.authenticate_as(current_setting('t.ana')::uuid);
+select throws_ok($$ select public.share_list('00000000-0000-0000-0000-0000000011f3') $$, '42501', null,
+                 'a deleted list cannot be shared');
+
+-- after Stop sharing (server now() as updated_at) a phone whose clock is behind still turns it on again
+reset role;
+update public.hit_lists set updated_at = now() + interval '1 hour' where id = '00000000-0000-0000-0000-0000000011f4';
+select tests.authenticate_as(current_setting('t.ana')::uuid);
+select results_eq(
+  $$ select shared from public.share_list('00000000-0000-0000-0000-0000000011f4') $$,
+  $$ values (true) $$,
+  'sharing comes back on after Stop sharing, whatever the phone''s clock'
+);
+reset role;
+select is_empty($$ select * from public.hit_list_members where list_id = '00000000-0000-0000-0000-0000000011f4' $$,
+                'its old members stay gone');
+
+select * from finish();
+rollback;
