+    expect(mockPush).not.toHaveBeenCalled();
+  });
+
+  it('Cancel leaves select mode with nothing selected', () => {
+    render(<SpotsScreen />);
+    fireEvent(row(/Alley rail/), 'longPress');
+    fireEvent.press(row(/Bank to wall/));
