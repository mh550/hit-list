+        showToast(sentTo(result.sentTo));
+        onClose();
+        return;
+      }
+      if (result && result.sentTo.length > 0) {
+        // The ones before the failure got theirs: Try again sends only to the rest.
+        const done = new Set(result.sentTo.map((f) => f.id));
