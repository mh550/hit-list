+    expect(cleared.area_place).toBeUndefined();
+    expect('area_place' in cleared).toBe(false);
+    expect(cleared.area_radius_m).toBe(8047);
+  });
+});
+
+describe('shared lists (S8)', () => {
+  const ME = 'rider-me';
+  const ANA = 'rider-ana';
