+    const row = (await listSentLinks(a.client, a.userId))!.find((l) => l.status === 'active');
+    expect(row).toEqual(expect.objectContaining({ count: 1, status: 'active' }));
+    expect(await revokeSentLink(a.client, a.userId, row!)).toBe(true);
