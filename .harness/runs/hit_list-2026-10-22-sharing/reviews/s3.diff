+              where list_id = '00000000-0000-0000-0000-0000000000e1'
+                and added_by = current_setting('t.adder')::uuid),
+  'a direct delete of a membership takes the member''s spots out too'
+);
+
+-- stop_sharing on e5 (members adder 'add' with b3, viewer 'view'; invitee pending; owner's a5; the stray c5) --------------------------------------
+select tests.authenticate_as(current_setting('t.adder')::uuid);
+select is(public.can_read_spot('00000000-0000-0000-0000-0000000000a5'), true,
+          'member reads the list spot before stop_sharing');
+select throws_ok($$ select public.stop_sharing('00000000-0000-0000-0000-0000000000e5') $$,
+                 'not the list owner', 'only the owner can stop sharing');
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select lives_ok($$ select public.stop_sharing('00000000-0000-0000-0000-0000000000e5') $$, 'owner stops sharing');
+select tests.authenticate_as(current_setting('t.adder')::uuid);
+select is(public.can_read_spot('00000000-0000-0000-0000-0000000000a5'), false, 'stop_sharing drops every member read');
+reset role;
+select results_eq(
+  $$ select l.shared,
+            (select count(*) from public.hit_list_members m where m.list_id = l.id),
+            array(select s.spot_id from public.hit_list_spots s where s.list_id = l.id)
+     from public.hit_lists l where l.id = '00000000-0000-0000-0000-0000000000e5' $$,
+  $$ values (false, 0::bigint, array['00000000-0000-0000-0000-0000000000a5'::uuid]) $$,
+  'stop_sharing unshares, drops every member and every row but the owner''s'
+);
+
+-- Unsharing by a plain UPDATE (a sync push) does the same ---------------------------------------------------------
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+update public.hit_lists set shared = false where id = '00000000-0000-0000-0000-0000000000e1';
+reset role;
+select ok(
+  not exists (select 1 from public.hit_list_members where list_id = '00000000-0000-0000-0000-0000000000e1')
+  and not exists (select 1 from public.hit_list_spots
+                  where list_id = '00000000-0000-0000-0000-0000000000e1'
+                    and added_by <> current_setting('t.owner')::uuid)
+  and exists (select 1 from public.hit_list_spots
+              where list_id = '00000000-0000-0000-0000-0000000000e1'
+                and added_by = current_setting('t.owner')::uuid),
+  'unsharing by a plain update drops every member and every row but the owner''s'
+);
+select tests.authenticate_as(current_setting('t.viewer')::uuid);
+select is_empty($$ select id from public.hit_lists $$, 'a former member reads no list once it is unshared');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/050-friends-rls.test.sql b/supabase/tests/050-friends-rls.test.sql
new file mode 100644
index 0000000..7107803
--- /dev/null
+++ b/supabase/tests/050-friends-rls.test.sql
@@ -0,0 +1,387 @@
+-- S3-05: profiles, friendships and blocks (D39 exact usernames, D50 blocking). §3.3 cases; the Case table in
+-- docs/plans/2026-10-22-s3-backend.md names each test.
+begin;
+select plan(91);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.me', tests.create_user('me@test.local', 'rider_me')::text, true);
+select set_config('t.ana', tests.create_user('ana@test.local', 'ana')::text, true);
+select set_config('t.friend', tests.create_user('friend@test.local', 'friend')::text, true);
+select set_config('t.stranger', tests.create_user('stranger@test.local', 'stranger')::text, true);
+select set_config('t.owner', tests.create_user('owner@test.local', 'owner')::text, true);
+select set_config('t.co', tests.create_user('co@test.local', 'comember')::text, true);
+select set_config('t.inv', tests.create_user('inv@test.local', 'invitee')::text, true);
+select set_config('t.goner', tests.create_user('goner@test.local', 'goner')::text, true);
+select set_config('t.blocker', tests.create_user('blocker@test.local', 'blocker')::text, true);
+select set_config('t.blockee', tests.create_user('blockee@test.local', 'blockee')::text, true);
+select set_config('t.noname', tests.create_user('noname@test.local')::text, true);
+select set_config('t.asker', tests.create_user('asker@test.local', 'asker')::text, true);
+select set_config('t.asker2', tests.create_user('asker2@test.local', 'asker_two')::text, true);
+select set_config('t.victim', tests.create_user('victim@test.local', 'victim')::text, true);
+select set_config('t.pest', tests.create_user('pest@test.local', 'pest')::text, true);
+select set_config('t.loner', tests.create_user('loner@test.local', 'loner')::text, true);
+select set_config('t.lonemate', tests.create_user('lonemate@test.local', 'lonemate')::text, true);
+update public.profiles set display_name = 'Ana R' where id = current_setting('t.ana')::uuid;
+
+-- Friendships (as postgres): me–friend and me–victim accepted; asker, asker2 and pest asked me (pending).
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(m, o), greatest(m, o), status, case when status = 'accepted' then m else o end
+from (select current_setting('t.me')::uuid as m, current_setting('t.' || who)::uuid as o, status
+      from (values ('friend', 'accepted'), ('victim', 'accepted')) as v(who, status)) p;
+with r as (
+  insert into public.friendships (user_a, user_b, status, requested_by)
+  select least(m, o), greatest(m, o), 'pending', o
+  from (select current_setting('t.me')::uuid as m, current_setting('t.' || who)::uuid as o, who
+        from unnest(array['asker', 'asker2', 'pest']) as who) p
+  returning id, requested_by
+)
+select set_config('t.f_' || case requested_by when current_setting('t.asker')::uuid then 'asker'
+                                              when current_setting('t.asker2')::uuid then 'asker2'
+                                              else 'pest' end, id::text, true)
+from r;
+
+-- Blocks: blocker blocked me; I blocked blockee.
+insert into public.blocks (blocker, blocked)
+values (current_setting('t.blocker')::uuid, current_setting('t.me')::uuid),
+       (current_setting('t.me')::uuid, current_setting('t.blockee')::uuid);
+
+-- Lists: f1 owner's shared 'Crew' (me and comember members, invitee invited) · f2 owner's shared but deleted 'Old
+-- crew' (me and goner members) · f3 mine, shared (victim invited, pest a member) · f4 pest's, shared (me invited) ·
+-- f5 friend's, shared (me invited; Remove friend withdraws it) · f6 loner's, not shared (me and lonemate members:
+-- only the service role can leave that state, unsharing drops members) · f7 comember's, shared (me invited: a third
+-- party's invitation a block leaves alone).
+insert into public.hit_lists (id, owner_id, name, kind, shared, updated_at, deleted_at)
+select id::uuid, current_setting('t.' || who)::uuid, name, 'manual', name <> 'Unshared', '2026-10-22T12:00:00Z',
+       deleted
+from (values
+  ('00000000-0000-0000-0000-0000000000f1', 'owner', 'Crew', null::timestamptz),
+  ('00000000-0000-0000-0000-0000000000f2', 'owner', 'Old crew', now()),
+  ('00000000-0000-0000-0000-0000000000f3', 'me', 'Mine', null),
+  ('00000000-0000-0000-0000-0000000000f4', 'pest', 'Pest list', null),
+  ('00000000-0000-0000-0000-0000000000f5', 'friend', 'Friend list', null),
+  ('00000000-0000-0000-0000-0000000000f6', 'loner', 'Unshared', null),
+  ('00000000-0000-0000-0000-0000000000f7', 'co', 'Third party', null)
+) as v(id, who, name, deleted);
+insert into public.hit_list_members (list_id, user_id, role, status)
+select l::uuid, current_setting('t.' || who)::uuid, 'add', status
+from (values
+  ('00000000-0000-0000-0000-0000000000f1', 'me', 'member'),
+  ('00000000-0000-0000-0000-0000000000f1', 'co', 'member'),
+  ('00000000-0000-0000-0000-0000000000f1', 'inv', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f2', 'me', 'member'),
+  ('00000000-0000-0000-0000-0000000000f2', 'goner', 'member'),
+  ('00000000-0000-0000-0000-0000000000f3', 'victim', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f3', 'pest', 'member'),
+  ('00000000-0000-0000-0000-0000000000f4', 'me', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f5', 'me', 'invited'),
+  ('00000000-0000-0000-0000-0000000000f6', 'me', 'member'),
+  ('00000000-0000-0000-0000-0000000000f6', 'lonemate', 'member'),
+  ('00000000-0000-0000-0000-0000000000f7', 'me', 'invited')
+) as v(l, who, status);
+
+-- Shape -------------------------------------------------------------------------------------------------------------
+select policies_are('public', 'profiles', array['profiles_select', 'profiles_update'],
+                    'profiles has select and update policies (no insert: the signup trigger; no delete)');
+select policies_are('public', 'friendships', array['friendships_select', 'friendships_delete'],
+                    'friendships has select and delete policies (requests and answers go through functions)');
+select policies_are('public', 'blocks', array['blocks_select', 'blocks_delete'],
+                    'blocks has select and delete policies (block_user inserts)');
+select ok((select count(*) = 6 and bool_and(roles = array['authenticated']::name[]) from pg_policies
+           where schemaname = 'public' and tablename in ('profiles', 'friendships', 'blocks')),
+          'every profile, friendship and block policy applies to authenticated only (anon gets none)');
+select is(
+  array(select p from unnest(array['can_read_profile', 'find_profile', 'send_friend_request', 'lock_user_pair', 'guard_invite_block',
+                                   'withdraw_pair_invitations',
+                                   'respond_friend_request', 'block_user', 'unblock_user']) as p
+        where not exists (select 1 from pg_proc
+                          where proname = p and pronamespace = 'public'::regnamespace
+                            and prosecdef and 'search_path=""' = any(proconfig))),
+  '{}'::text[],
+  'every S3-05 function is security definer with search_path pinned'
+);
+select trigger_is('public', 'hit_list_members', 't05_block_guard', 'public', 'guard_invite_block',
+                  'a new membership takes the pair lock and re-checks blocks (no invite slips in behind a block)');
+select trigger_is('public', 'friendships', 't30_withdraw_invitations', 'public', 'withdraw_pair_invitations',
+                  'removing a friendship withdraws pending invitations between the two');
+select is(
+  array(select proname::text from pg_proc
+        where pronamespace = 'public'::regnamespace
+          and proname in ('can_read_profile', 'find_profile', 'send_friend_request', 'respond_friend_request',
+                          'block_user', 'unblock_user', 'keep_profile_identity', 'lock_user_pair',
+                          'guard_invite_block', 'withdraw_pair_invitations')
+          and has_function_privilege('authenticated', oid, 'execute')
+          and not has_function_privilege('anon', oid, 'execute')
+        order by 1),
+  array['block_user', 'can_read_profile', 'find_profile', 'respond_friend_request', 'send_friend_request',
+        'unblock_user'],
+  'authenticated executes the S3-05 functions, anon none, nobody the trigger function or the pair lock'
+);
+
+-- Who reads a profile -----------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select set_eq(
+  $$ select id from public.profiles $$,
+  $$ select current_setting('t.' || who)::uuid
+     from unnest(array['me', 'friend', 'victim', 'asker', 'asker2', 'pest', 'owner', 'co']) as who $$,
+  'a user reads exactly their own, friends'', requests to them and co-members'' profiles'
+);
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select is_empty($$ select id from public.profiles where id <> current_setting('t.stranger')::uuid $$,
+                'stranger reads no profile');
+select tests.authenticate_as(current_setting('t.friend')::uuid);
+select results_eq($$ select username::text from public.profiles where id = current_setting('t.me')::uuid $$,
+                  $$ values ('rider_me') $$, 'accepted friend reads the profile');
+select tests.authenticate_as(current_setting('t.co')::uuid);
+select results_eq($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                  $$ values (current_setting('t.me')::uuid) $$, 'co-member reads the profile (both members)');
+select tests.authenticate_as(current_setting('t.owner')::uuid);
+select results_eq($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                  $$ values (current_setting('t.me')::uuid) $$, 'list owner reads a member''s profile');
+select results_eq($$ select id from public.profiles where id = current_setting('t.inv')::uuid $$,
+                  $$ values (current_setting('t.inv')::uuid) $$, 'list owner reads an invitee''s profile');
+select tests.authenticate_as(current_setting('t.inv')::uuid);
+select results_eq($$ select id from public.profiles where id = current_setting('t.owner')::uuid $$,
+                  $$ values (current_setting('t.owner')::uuid) $$, 'invitee reads the list owner''s profile');
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'invitee reads no member''s profile');
+select tests.authenticate_as(current_setting('t.goner')::uuid);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'a deleted list makes no co-members');
+select is_empty($$ select id from public.profiles where id = current_setting('t.owner')::uuid $$,
+                'a deleted list''s member reads its owner''s profile no more');
+select tests.authenticate_as(current_setting('t.asker')::uuid);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'the sender of a pending request does not read the receiver''s profile (find_profile is the way)');
+select tests.authenticate_as(current_setting('t.lonemate')::uuid);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'members of an unshared list are not co-members');
+select is_empty($$ select id from public.profiles where id = current_setting('t.loner')::uuid $$,
+                'an unshared list''s owner and member are not co-members');
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select is(public.can_read_profile(current_setting('t.stranger')::uuid), false,
+          'can_read_profile is false for a stranger');
+reset role;
+select tests.clear_auth();
+select is_empty($$ select id from public.profiles $$, 'anon reads no profile');
+select throws_ok($$ select * from public.find_profile('ana') $$, '42501', null, 'anon cannot call find_profile');
+reset role;
+
+-- find_profile: exact, case-insensitive, three columns, silent for unknown, NULL and blocked ---------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select results_eq(
+  $$ select * from public.find_profile('Ana') $$,
+  $$ values (current_setting('t.ana')::uuid, 'ana'::extensions.citext, 'Ana R'::text) $$,
+  'find_profile(''Ana'') returns ana''s id, username and display name and nothing else'
+);
+select is_empty($$ select * from public.find_profile('an') $$, 'find_profile is exact (no prefix match)');
+select is_empty($$ select * from public.find_profile('nobody_here') $$,
+                'find_profile returns nothing for an unknown username');
+select is_empty($$ select * from public.find_profile(null) $$, 'find_profile(NULL) never matches a NULL username');
+select is_empty($$ select * from public.find_profile('') $$, 'find_profile('''') matches nothing');
+select is_empty($$ select * from public.find_profile('blocker') $$,
+                'find_profile returns nothing to someone the target blocked');
+select results_eq($$ select id from public.find_profile('blockee') $$,
+                  $$ values (current_setting('t.blockee')::uuid) $$,
+                  'the blocker still finds the user they blocked (to unblock them)');
+
+-- send_friend_request -----------------------------------------------------------------------------------------------
+select lives_ok($$ select set_config('t.req', public.send_friend_request('ANA')::text, true) $$,
+                'a user sends a friend request by username, any case');
+select results_eq(
+  $$ select user_a = least(current_setting('t.me')::uuid, current_setting('t.ana')::uuid),
+            user_b = greatest(current_setting('t.me')::uuid, current_setting('t.ana')::uuid),
+            status, requested_by = current_setting('t.me')::uuid
+     from public.friendships where id = current_setting('t.req', true)::uuid $$,
+  $$ values (true, true, 'pending', true) $$,
+  'send_friend_request inserts an ordered pending row requested by the caller'
+);
+select results_eq($$ select public.send_friend_request('ana') = current_setting('t.req', true)::uuid $$,
+                  $$ values (true) $$, 'a repeated request returns the same row');
+select results_eq($$ select status from public.friendships where id = current_setting('t.req', true)::uuid $$,
+                  $$ values ('pending') $$, 'asking again does not accept your own request');
+select tests.authenticate_as(current_setting('t.ana')::uuid);
+select results_eq($$ select public.send_friend_request('rider_me') = current_setting('t.req', true)::uuid $$,
+                  $$ values (true) $$, 'a request the other way returns the same row');
+reset role;
+select results_eq(
+  $$ select count(*), bool_and(status = 'accepted') from public.friendships
+     where user_a = least(current_setting('t.me')::uuid, current_setting('t.ana')::uuid)
+       and user_b = greatest(current_setting('t.me')::uuid, current_setting('t.ana')::uuid) $$,
+  $$ values (1::bigint, true) $$,
+  'a request the other way accepts instead of duplicating'
+);
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select throws_ok($$ select public.send_friend_request('blocker') $$, 'P0002', 'user not found',
+                 'blocked user cannot send friend request');
+select throws_ok($$ select public.send_friend_request('nobody_here') $$, 'P0002', 'user not found',
+                 'a request to an unknown username raises the same error as a block');
+select throws_ok($$ select public.send_friend_request('blockee') $$, '42501', null,
+                 'a user cannot send a friend request to someone they blocked');
+select throws_ok($$ select public.send_friend_request('rider_me') $$, '22023', null,
+                 'a user cannot send a friend request to themselves');
+reset role;
+select tests.clear_auth();
+select throws_ok($$ select public.send_friend_request('ana') $$, '42501', null,
+                 'anon cannot call send_friend_request');
+reset role;
+
+-- respond_friend_request --------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.asker')::uuid);
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'accept') $$,
+                 '42501', null, 'the requester cannot accept their own request');
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'accept') $$,
+                 '42501', null, 'someone outside the pair cannot respond');
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'maybe') $$,
+                 '22023', null, 'respond_friend_request takes only accept or decline');
+select lives_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'accept') $$,
+                'the person asked accepts');
+select results_eq($$ select status from public.friendships where id = current_setting('t.f_asker')::uuid $$,
+                  $$ values ('accepted') $$, 'an accepted request is a friendship');
+select throws_ok($$ select public.respond_friend_request(current_setting('t.f_asker')::uuid, 'decline') $$,
+                 '42501', null, 'an accepted friendship cannot be answered again');
+select lives_ok($$ select public.respond_friend_request(current_setting('t.f_asker2')::uuid, 'decline') $$,
+                'the person asked declines');
+reset role;
+select is_empty($$ select id from public.friendships where id = current_setting('t.f_asker2')::uuid $$,
+                'a declined request is deleted');
+
+-- friendships: read and remove only your own; no direct writes ----------------------------------------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select set_eq(
+  $$ select case when user_a = current_setting('t.me')::uuid then user_b else user_a end from public.friendships $$,
+  $$ select current_setting('t.' || who)::uuid from unnest(array['friend', 'victim', 'asker', 'pest', 'ana']) as who $$,
+  'a user reads exactly the friendships they are in'
+);
+select throws_ok(
+  $$ insert into public.friendships (user_a, user_b, status, requested_by)
+     values (least(current_setting('t.me')::uuid, current_setting('t.stranger')::uuid),
+             greatest(current_setting('t.me')::uuid, current_setting('t.stranger')::uuid), 'accepted',
+             current_setting('t.me')::uuid) $$,
+  '42501', null, 'nobody inserts a friendship directly'
+);
+select is_empty($$ update public.friendships set status = 'accepted' where id = current_setting('t.f_pest')::uuid
+                   returning id $$, 'nobody updates a friendship directly');
+select tests.authenticate_as(current_setting('t.stranger')::uuid);
+select is_empty($$ select id from public.friendships $$, 'stranger reads no friendship');
+select is_empty($$ delete from public.friendships returning id $$, 'stranger removes no friendship');
+select tests.authenticate_as(current_setting('t.friend')::uuid);
+select results_eq(
+  $$ delete from public.friendships where current_setting('t.me')::uuid in (user_a, user_b) returning status $$,
+  $$ values ('accepted') $$, 'either friend removes the friendship'
+);
+select is_empty($$ select id from public.profiles where id = current_setting('t.me')::uuid $$,
+                'a removed friend reads the profile no more');
+reset role;
+select is_empty($$ select 1 from public.hit_list_members
+                   where list_id = '00000000-0000-0000-0000-0000000000f5' and user_id = current_setting('t.me')::uuid $$,
+                'removing a friend withdraws their pending invitation');
+
+-- block_user / unblock_user (D50) ---------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select lives_ok($$ select public.block_user(current_setting('t.victim')::uuid) $$, 'a user blocks a friend');
+select lives_ok($$ select public.block_user(current_setting('t.victim')::uuid) $$, 'blocking twice is harmless');
+select lives_ok($$ select public.block_user(current_setting('t.pest')::uuid) $$,
+                'a user blocks someone with a pending request');
+select throws_ok($$ select public.block_user(current_setting('t.me')::uuid) $$, '22023', null,
+                 'a user cannot block themselves');
+select throws_ok($$ select public.block_user('00000000-0000-0000-0000-00000000dead') $$, 'P0002', 'user not found',
+                 'blocking an unknown id raises');
+select set_eq($$ select blocked from public.blocks $$,
+              $$ select current_setting('t.' || who)::uuid from unnest(array['victim', 'pest', 'blockee']) as who $$,
+              'the blocker reads their blocks');
+reset role;
+select is((select count(*) from public.blocks
+           where blocker = current_setting('t.me')::uuid and blocked = current_setting('t.victim')::uuid),
+          1::bigint, 'block_user inserts one block row');
+select is_empty(
+  $$ select id from public.friendships
+     where current_setting('t.me')::uuid in (user_a, user_b)
+       and (current_setting('t.victim')::uuid in (user_a, user_b) or current_setting('t.pest')::uuid in (user_a, user_b)) $$,
+  'block_user deletes the friendship and the blocked user''s pending request'
+);
+select is_empty(
+  $$ select 1 from public.hit_list_members
+     where (list_id = '00000000-0000-0000-0000-0000000000f3' and user_id = current_setting('t.victim')::uuid)
+        or (list_id = '00000000-0000-0000-0000-0000000000f4' and user_id = current_setting('t.me')::uuid) $$,
+  'block_user deletes pending invitations between the two, both ways'
+);
+select results_eq(
+  $$ select status from public.hit_list_members
+     where list_id = '00000000-0000-0000-0000-0000000000f3' and user_id = current_setting('t.pest')::uuid $$,
+  $$ values ('member') $$,
+  'a shared list both are in stays as it is (D50)'
+);
+select results_eq(
+  $$ select status from public.hit_list_members
+     where (list_id = '00000000-0000-0000-0000-0000000000f1' and user_id = current_setting('t.inv')::uuid)
+        or (list_id = '00000000-0000-0000-0000-0000000000f7' and user_id = current_setting('t.me')::uuid) $$,
+  $$ values ('invited'), ('invited') $$,
+  'block_user leaves other lists'' invitations alone'
+);
+select throws_ok(
+  $$ insert into public.hit_list_members (list_id, user_id, status)
+     values ('00000000-0000-0000-0000-0000000000f3', current_setting('t.victim')::uuid, 'invited') $$,
+  'blocked users cannot be added to each other''s lists',
+  'the block guard refuses a membership between a blocked pair even past the policies'
+);
+select throws_ok(
+  $$ insert into public.hit_list_members (list_id, user_id, status)
+     values ('00000000-0000-0000-0000-0000000000f3', current_setting('t.blocker')::uuid, 'member') $$,
+  'blocked users cannot be added to each other''s lists',
+  'the block guard works whichever side blocked'
+);
+select tests.authenticate_as(current_setting('t.victim')::uuid);
+select is_empty($$ select * from public.blocks $$, 'the blocked user reads nothing about the block');
+select is_empty($$ delete from public.blocks returning blocked $$, 'the blocked user cannot lift the block');
+select lives_ok($$ select public.unblock_user(current_setting('t.me')::uuid), public.unblock_user(current_setting('t.victim')::uuid) $$,
+                'unblock_user by the blocked user runs');
+reset role;
+select is((select count(*) from public.blocks
+           where blocker = current_setting('t.me')::uuid and blocked = current_setting('t.victim')::uuid),
+          1::bigint, 'the blocked user cannot lift the block with unblock_user');
+select tests.authenticate_as(current_setting('t.victim')::uuid);
+select is_empty($$ select * from public.find_profile('rider_me') $$, 'find_profile returns nothing for a blocked caller');
+select throws_ok($$ select public.send_friend_request('rider_me') $$, 'P0002', 'user not found',
+                 'a newly blocked user cannot send friend request either');
+select throws_ok(
+  $$ insert into public.blocks (blocker, blocked)
+     values (current_setting('t.victim')::uuid, current_setting('t.me')::uuid) $$,
+  '42501', null, 'nobody inserts a block directly'
+);
+select tests.authenticate_as(current_setting('t.me')::uuid);
+select lives_ok($$ select public.unblock_user(current_setting('t.blockee')::uuid) $$, 'a user unblocks someone');
+select is_empty($$ select blocked from public.blocks where blocked = current_setting('t.blockee')::uuid $$,
+                'unblock_user deletes the block');
+select lives_ok($$ select public.send_friend_request('blockee') $$, 'after unblocking, a friend request works again');
+
+-- Own profile: update username and display name; id fixed; no insert or delete ----------------------------------
+select results_eq(
+  $$ update public.profiles set username = 'Me_Two', display_name = 'Me Two'
+     where id = current_setting('t.me')::uuid returning username::text, display_name $$,
+  $$ values ('Me_Two', 'Me Two') $$,
+  'a user updates their own username and display name'
+);
+select throws_ok($$ update public.profiles set id = current_setting('t.stranger')::uuid
+                    where id = current_setting('t.me')::uuid $$,
+                 'profile id and created_at are fixed', 'a user cannot change their profile id');
+select throws_ok($$ update public.profiles set display_name = repeat('x', 51) where id = current_setting('t.me')::uuid $$,
+                 '23514', null, 'a display name longer than 50 characters is refused (D58)');
+select lives_ok($$ update public.profiles set display_name = repeat('x', 50) where id = current_setting('t.me')::uuid $$,
+                'a 50-character display name is accepted');
+select throws_ok($$ update public.profiles set created_at = now() - interval '1 year'
+                    where id = current_setting('t.me')::uuid $$,
+                 'profile id and created_at are fixed', 'a user cannot change their profile created_at');
+select is_empty($$ update public.profiles set display_name = 'Hacked' where id = current_setting('t.owner')::uuid
+                   returning id $$, 'a user cannot update someone else''s profile');
+select throws_ok($$ insert into public.profiles (id) values (gen_random_uuid()) $$, '42501', null,
+                 'nobody inserts a profile directly');
+select is_empty($$ delete from public.profiles where id = current_setting('t.me')::uuid returning id $$,
+                'nobody deletes a profile directly');
+select throws_ok($$ update public.profiles set username = 'ANA' where id = current_setting('t.me')::uuid $$,
+                 '23505', null, 'a username taken in another case is refused');
+select is_empty($$ select * from public.find_profile('rider_me') $$, 'the old username finds nothing after a rename');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/060-sends-rls.test.sql b/supabase/tests/060-sends-rls.test.sql
new file mode 100644
index 0000000..678a8dd
--- /dev/null
+++ b/supabase/tests/060-sends-rls.test.sql
@@ -0,0 +1,222 @@
+-- S3-06: sends (D40 frozen copy, D50 blocking). A send is read by its sender and, while it is not withdrawn and they
+-- haven't blocked the sender, its recipient; every write goes through create_send / withdraw_send / mark_send_saved /
+-- dismiss_send. §3.3 cases; the Case table in docs/plans/2026-10-22-s3-backend.md names each test.
+begin;
+select plan(60);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.sender', tests.create_user('sender@test.local', 'sender')::text, true);
+select set_config('t.rec', tests.create_user('rec@test.local', 'recipient')::text, true);
+select set_config('t.third', tests.create_user('third@test.local', 'third')::text, true);
+select set_config('t.nofriend', tests.create_user('nofriend@test.local', 'nofriend')::text, true);
+select set_config('t.blocker', tests.create_user('blocker@test.local', 'blocker')::text, true);
+select set_config('t.blockee', tests.create_user('blockee@test.local', 'blockee')::text, true);
+select set_config('t.later', tests.create_user('later@test.local', 'later')::text, true);
+select set_config('t.asked', tests.create_user('asked@test.local', 'asked')::text, true);
+
+-- Accepted friendships with the sender: recipient, third's friend is the recipient (so third can call create_send
+-- at all), later (blocks the sender after a send). blocker and blockee also have a friendship row next to a block:
+-- block_user deletes it, so this is the state a send racing a block would see, and create_send must still refuse.
+-- The sender has only asked 'asked' (pending).
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(a, b), greatest(a, b), 'accepted', a
+from (select current_setting('t.' || x)::uuid as a, current_setting('t.' || y)::uuid as b
+      from (values ('sender', 'rec'), ('sender', 'later'), ('third', 'rec'), ('sender', 'blocker'),
+                   ('sender', 'blockee')) as v(x, y)) p;
+insert into public.friendships (user_a, user_b, status, requested_by)
+select least(a, b), greatest(a, b), 'pending', a
+from (select current_setting('t.sender')::uuid as a, current_setting('t.asked')::uuid as b) p;
+insert into public.blocks (blocker, blocked)
+values (current_setting('t.blocker')::uuid, current_setting('t.sender')::uuid),
+       (current_setting('t.sender')::uuid, current_setting('t.blockee')::uuid);
+
+-- create_send ------------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select is(
+  public.create_send('00000000-0000-0000-0000-0000000005e1', current_setting('t.rec')::uuid,
+                     '{"spots": [{"name": "Library rail"}]}'),
+  '00000000-0000-0000-0000-0000000005e1'::uuid,
+  'create_send returns the new send''s id'
+);
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e2', current_setting('t.rec')::uuid,
+                                             '{"spots": []}') $$, 'sender sends a second spot set');
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e3', current_setting('t.rec')::uuid,
+                                             '{"spots": []}') $$, 'sender sends a third spot set');
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e4', null, '{"spots": []}') $$,
+                'sender creates a link-only send (no recipient)');
+select lives_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e5', current_setting('t.later')::uuid,
+                                             '{"spots": []}') $$, 'sender sends to a friend who blocks them later');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f1',
+                                              current_setting('t.nofriend')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'create_send to someone who is not a friend raises');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f8',
+                                              current_setting('t.asked')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'create_send to someone who has not accepted yet raises');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f2',
+                                              current_setting('t.blocker')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'blocked sender cannot create_send');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f3',
+                                              current_setting('t.blockee')::uuid, '{}') $$,
+                 '42501', 'you can only send to friends', 'a sender cannot send to someone they blocked');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f4',
+                                              current_setting('t.sender')::uuid, '{}') $$,
+                 '22023', null, 'create_send to yourself raises');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f5', current_setting('t.rec')::uuid,
+                                              null) $$,
+                 '22023', null, 'create_send refuses a NULL payload');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f9', current_setting('t.rec')::uuid,
+                                              '[{"name": "x"}]') $$,
+                 '22023', null, 'create_send refuses a payload that is not a JSON object');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005fa', current_setting('t.rec')::uuid,
+                                              jsonb_build_object('notes', repeat('x', 1048577))) $$,
+                 '22023', null, 'create_send refuses a payload over 1 MB');
+select throws_ok(
+  $$ insert into public.sends (id, sender, recipient, payload)
+     values ('00000000-0000-0000-0000-0000000005f6', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+             '{}') $$,
+  '42501', null, 'nobody inserts a send directly'
+);
+
+reset role;
+select results_eq(
+  $$ select sender, recipient, payload, withdrawn_at, saved_at, dismissed_at from public.sends
+     where id = '00000000-0000-0000-0000-0000000005e1' $$,
+  $$ values (current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+             '{"spots": [{"name": "Library rail"}]}'::jsonb, null::timestamptz, null::timestamptz,
+             null::timestamptz) $$,
+  'create_send inserts one row with the caller as sender'
+);
+select is((select count(*)::int from public.sends where id::text like '00000000-0000-0000-0000-0000000005f%'), 0,
+          'no refused send left a row');
+
+-- The recipient (a friend of the sender, too) cannot take over an existing send by reusing its id.
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005e1',
+                                              current_setting('t.sender')::uuid, '{"spots": "mine now"}') $$,
+                 '23505', null, 'create_send cannot take over an existing send id');
+
+-- Who reads a send -------------------------------------------------------------------------------------------------
+select results_eq(
+  $$ select id from public.sends order by id $$,
+  $$ values ('00000000-0000-0000-0000-0000000005e1'::uuid), ('00000000-0000-0000-0000-0000000005e2'::uuid),
+            ('00000000-0000-0000-0000-0000000005e3'::uuid) $$,
+  'recipient reads exactly the sends to them'
+);
+select results_eq(
+  $$ select payload from public.sends where id = '00000000-0000-0000-0000-0000000005e1' $$,
+  $$ values ('{"spots": [{"name": "Library rail"}]}'::jsonb) $$,
+  'recipient reads the send''s payload'
+);
+select is_empty($$ select id from public.sends where id = '00000000-0000-0000-0000-0000000005e4' $$,
+                'a link-only send is not readable by a friend of its sender');
+
+select tests.authenticate_as(current_setting('t.third')::uuid);
+select is_empty($$ select id from public.sends $$, 'third user reads no send');
+
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select results_eq(
+  $$ select id from public.sends order by id $$,
+  $$ values ('00000000-0000-0000-0000-0000000005e1'::uuid), ('00000000-0000-0000-0000-0000000005e2'::uuid),
+            ('00000000-0000-0000-0000-0000000005e3'::uuid), ('00000000-0000-0000-0000-0000000005e4'::uuid),
+            ('00000000-0000-0000-0000-0000000005e5'::uuid) $$,
+  'sender reads every send they made, the link-only one included'
+);
+
+reset role;
+select tests.clear_auth();
+select is_empty($$ select id from public.sends $$, 'anon reads no send');
+select throws_ok($$ select public.create_send('00000000-0000-0000-0000-0000000005f7', current_setting('t.rec')::uuid,
+                                              '{}') $$,
+                 '42501', null, 'anon cannot call create_send');
+reset role;
+select ok(not has_function_privilege('anon', p, 'execute'), 'anon cannot execute ' || p)
+from unnest(array['public.create_send(uuid, uuid, jsonb)', 'public.withdraw_send(uuid)',
+                  'public.mark_send_saved(uuid)', 'public.dismiss_send(uuid)', 'public.can_read_send(uuid)',
+                  'public.can_read_photo(text)', 'public.can_write_photo(text, text)']) as p;
+
+-- No direct writes ------------------------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select is_empty($$ update public.sends set payload = '{"spots": "changed"}'
+                   where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the recipient cannot update the payload');
+select is_empty($$ update public.sends set withdrawn_at = null, saved_at = now()
+                   where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the recipient cannot set saved_at directly');
+select is_empty($$ delete from public.sends where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the recipient cannot delete a send');
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select is_empty($$ update public.sends set recipient = current_setting('t.third')::uuid
+                   where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the sender cannot redirect a send directly');
+select is_empty($$ delete from public.sends where id = '00000000-0000-0000-0000-0000000005e1' returning id $$,
+                'the sender cannot delete a send directly');
+reset role;
+select results_eq(
+  $$ select recipient, payload, saved_at from public.sends where id = '00000000-0000-0000-0000-0000000005e1' $$,
+  $$ values (current_setting('t.rec')::uuid, '{"spots": [{"name": "Library rail"}]}'::jsonb, null::timestamptz) $$,
+  'the direct updates and deletes changed nothing'
+);
+
+-- Save and Dismiss (recipient only) ----------------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'the sender cannot mark their send saved');
+select throws_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'the sender cannot dismiss their send');
+select tests.authenticate_as(current_setting('t.third')::uuid);
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'a third user cannot mark a send saved');
+select throws_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'a third user cannot dismiss a send');
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'a third user cannot withdraw a send');
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e2') $$, '42501', 'no such send',
+                 'the recipient cannot withdraw a send');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e4') $$, '42501', 'no such send',
+                 'nobody saves a link-only send through mark_send_saved');
+select lives_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e2') $$, 'the recipient saves a send');
+select lives_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e1') $$,
+                'the recipient dismisses a send');
+select results_eq(
+  $$ select id, saved_at is not null, dismissed_at is not null from public.sends
+     where id in ('00000000-0000-0000-0000-0000000005e1', '00000000-0000-0000-0000-0000000005e2') order by id $$,
+  $$ values ('00000000-0000-0000-0000-0000000005e1'::uuid, false, true),
+            ('00000000-0000-0000-0000-0000000005e2'::uuid, true, false) $$,
+  'mark_send_saved sets saved_at and dismiss_send sets dismissed_at'
+);
+
+-- Withdraw (sender only, until saved, D40) ----------------------------------------------------------------------------
+select tests.authenticate_as(current_setting('t.sender')::uuid);
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e2') $$, '55000', null,
+                 'withdraw_send after the recipient saved raises');
+select lives_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e3') $$, 'the sender withdraws a send');
+select set_config('t.withdrawn_at', (select withdrawn_at::text from public.sends
+                                      where id = '00000000-0000-0000-0000-0000000005e3'), true);
+select ok(current_setting('t.withdrawn_at') <> '', 'the sender still sees a withdrawn send, withdrawn_at set');
+select lives_ok($$ select public.withdraw_send('00000000-0000-0000-0000-0000000005e3') $$,
+                'withdrawing again is harmless');
+select is((select withdrawn_at::text from public.sends where id = '00000000-0000-0000-0000-0000000005e3'),
+          current_setting('t.withdrawn_at'), 'withdrawing again keeps the first withdrawn_at');
+select throws_ok($$ select public.withdraw_send('00000000-0000-0000-0000-00000000dead') $$, '42501', 'no such send',
+                 'withdraw_send on an unknown id raises the same error');
+
+select tests.authenticate_as(current_setting('t.rec')::uuid);
+select is_empty($$ select id from public.sends where id = '00000000-0000-0000-0000-0000000005e3' $$,
+                'recipient reads nothing after withdraw');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e3') $$, '42501', 'no such send',
+                 'the recipient cannot save a withdrawn send');
+select throws_ok($$ select public.dismiss_send('00000000-0000-0000-0000-0000000005e3') $$, '42501', 'no such send',
+                 'the recipient cannot dismiss a withdrawn send');
+
+-- D50: a recipient who blocks the sender sees their pending sends no more ------------------------------------------------
+select tests.authenticate_as(current_setting('t.later')::uuid);
+select results_eq($$ select id from public.sends $$, $$ values ('00000000-0000-0000-0000-0000000005e5'::uuid) $$,
+                  'the friend reads the send before blocking');
+select lives_ok($$ select public.block_user(current_setting('t.sender')::uuid) $$, 'the friend blocks the sender');
+select is_empty($$ select id from public.sends $$, 'a recipient who blocks the sender reads their send no more');
+select throws_ok($$ select public.mark_send_saved('00000000-0000-0000-0000-0000000005e5') $$, '42501', 'no such send',
+                 'a recipient cannot save a send from someone they blocked');
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/070-storage-rls.test.sql b/supabase/tests/070-storage-rls.test.sql
new file mode 100644
index 0000000..c0f538b
--- /dev/null
+++ b/supabase/tests/070-storage-rls.test.sql
@@ -0,0 +1,352 @@
+-- S3-06: the private photos bucket. A spot's photo '<owner>/<spot>/<media>.jpg' is read by whoever reads the spot
+-- (can_read_spot) while the photo is live; a send's photo 'sends/<send>/<media>.jpg' by whoever reads the send. Writes
+-- land only under the writer's own spot or send. Rows are inserted into storage.objects as the users, as the Storage
+-- API does. §3.3 cases; the Case table in docs/plans/2026-10-22-s3-backend.md names each test.
+begin;
+select plan(46);
+
+-- People ----------------------------------------------------------------------------------------------------------
+select set_config('t.owner', tests.create_user('owner@test.local', 'owner')::text, true);
+select set_config('t.member', tests.create_user('member@test.local', 'member')::text, true);
+select set_config('t.stranger', tests.create_user('stranger@test.local', 'stranger')::text, true);
+select set_config('t.sender', tests.create_user('sender@test.local', 'sender')::text, true);
+select set_config('t.rec', tests.create_user('rec@test.local', 'recipient')::text, true);
+select set_config('t.third', tests.create_user('third@test.local', 'third')::text, true);
+
+-- Spots: b1 (owner, in shared list 'Crew' where member is a member), b2 (owner, in no list), b3 (stranger's).
+insert into public.spots (id, owner_id, lat, lng, updated_at)
+values ('00000000-0000-0000-0000-0000000000b1', current_setting('t.owner')::uuid, 47.6, -122.3, now()),
+       ('00000000-0000-0000-0000-0000000000b2', current_setting('t.owner')::uuid, 47.6, -122.3, now()),
+       ('00000000-0000-0000-0000-0000000000b3', current_setting('t.stranger')::uuid, 47.6, -122.3, now());
+-- Photos: c1 live and c2 removed (soft-deleted) on b1, c3 on b2.
+insert into public.media (id, spot_id, owner_id, updated_at, deleted_at)
+values ('00000000-0000-0000-0000-0000000000c1', '00000000-0000-0000-0000-0000000000b1',
+        current_setting('t.owner')::uuid, now(), null),
+       ('00000000-0000-0000-0000-0000000000c2', '00000000-0000-0000-0000-0000000000b1',
+        current_setting('t.owner')::uuid, now(), now()),
+       ('00000000-0000-0000-0000-0000000000c3', '00000000-0000-0000-0000-0000000000b2',
+        current_setting('t.owner')::uuid, now(), null);
+insert into public.hit_lists (id, owner_id, name, kind, shared, updated_at)
+values ('00000000-0000-0000-0000-0000000000d1', current_setting('t.owner')::uuid, 'Crew', 'manual', true, now());
+insert into public.hit_list_spots (list_id, spot_id, added_by)
+values ('00000000-0000-0000-0000-0000000000d1', '00000000-0000-0000-0000-0000000000b1',
+        current_setting('t.owner')::uuid);
+insert into public.hit_list_members (list_id, user_id, role, status)
+values ('00000000-0000-0000-0000-0000000000d1', current_setting('t.member')::uuid, 'add', 'member');
+-- Sends: e1 sender → recipient (live), e2 sender → recipient (withdrawn), e3 sender → recipient (saved).
+insert into public.sends (id, sender, recipient, payload, withdrawn_at, saved_at)
+values ('00000000-0000-0000-0000-0000000000e1', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+        '{}', null, null),
+       ('00000000-0000-0000-0000-0000000000e2', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+        '{}', now(), null),
+       ('00000000-0000-0000-0000-0000000000e3', current_setting('t.sender')::uuid, current_setting('t.rec')::uuid,
+        '{}', null, now());
+-- Objects written past the policies (as postgres): photos of the withdrawn and the saved send, a stray object under the
+-- stranger's prefix that names the owner's spot, a four-segment name under the owner's prefix that would parse as
+-- c1's photo, and the owner's path in another bucket.
+insert into storage.objects (bucket_id, name)
+values ('photos', 'sends/00000000-0000-0000-0000-0000000000e2/00000000-0000-0000-0000-0000000000f2.jpg'),
+       ('photos', 'sends/00000000-0000-0000-0000-0000000000e3/00000000-0000-0000-0000-0000000000f6.jpg'),
+       ('photos', current_setting('t.stranger') || '/00000000-0000-0000-0000-0000000000b1/'
+                  || '00000000-0000-0000-0000-0000000000c1.jpg'),
+       ('photos', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                  || '00000000-0000-0000-0000-0000000000c1.jpg/x');
+insert into storage.buckets (id, name, public) values ('zz_other', 'zz_other', false);
+insert into storage.objects (bucket_id, name)
+values ('zz_other', current_setting('t.owner') || '/00000000-0000-0000-0000-0000000000b1/'
+                    || '00000000-0000-0000-0000-0000000000c1.jpg');
+
+-- The bucket -------------------------------------------------------------------------------------------------------
+select results_eq($$ select public, file_size_limit, allowed_mime_types from storage.buckets where id = 'photos' $$,
+                  $$ values (false, 10485760::bigint, array['image/jpeg']) $$,
+                  'the photos bucket exists, private, JPEG only, 10 MB');
+
