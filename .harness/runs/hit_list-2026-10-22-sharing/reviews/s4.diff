diff --git a/scripts/supabase-env.mjs b/scripts/supabase-env.mjs
new file mode 100644
index 0000000..25ea572
--- /dev/null
+++ b/scripts/supabase-env.mjs
@@ -0,0 +1,45 @@
+#!/usr/bin/env node
+// Runs a command with the local Supabase stack's URL and keys in its environment (S4-06, used by
+// `npm run test:integration`). They are read from `npx supabase status -o json` at run time and handed to the command
+// only, so no key is ever written to a file. Exits 2 when the stack isn't running; otherwise with the command's code.
+//
+//   node scripts/supabase-env.mjs <command> [args…]
+import { spawnSync } from 'node:child_process';
+
+function notRunning() {
+  console.error('Start the stack first: npm run db:start');
+  process.exit(2);
+}
+
+// A hung Docker daemon would hang `status`; after a minute it counts as not running.
+const status = spawnSync('npx', ['supabase', 'status', '-o', 'json'], { encoding: 'utf8', timeout: 60000 });
+if (status.error || status.status !== 0) notRunning();
+
+let parsed;
+try {
+  parsed = JSON.parse(status.stdout);
+} catch {
+  notRunning();
+}
+const { API_URL, ANON_KEY, SERVICE_ROLE_KEY } = parsed ?? {};
+if (!API_URL || !ANON_KEY || !SERVICE_ROLE_KEY) notRunning();
+
+const [command, ...args] = process.argv.slice(2);
+if (!command) {
+  console.error('Usage: node scripts/supabase-env.mjs <command> [args…]');
+  process.exit(2);
+}
+const result = spawnSync(command, args, {
+  stdio: 'inherit',
+  env: {
+    ...process.env,
+    SUPABASE_URL: API_URL,
+    SUPABASE_ANON_KEY: ANON_KEY,
+    SUPABASE_SERVICE_ROLE_KEY: SERVICE_ROLE_KEY,
+  },
+});
+if (result.error) {
+  console.error(`Could not run ${command}: ${result.error.message}`);
+  process.exit(1);
+}
+process.exit(result.status ?? 1);
diff --git a/src/__integration__/accounts.test.ts b/src/__integration__/accounts.test.ts
new file mode 100644
index 0000000..fe6edbb
--- /dev/null
+++ b/src/__integration__/accounts.test.ts
@@ -0,0 +1,220 @@
+/**
+ * Accounts against the local stack (S4-06): sign up, the username rules, sign out and back in, and the account-delete
+ * Edge Function run for real (docs/plans/2026-10-22-s4-accounts.md, "Integration harness"). Needs the stack:
+ * npm run db:start, then npm run test:integration.
+ */
+import { randomUUID } from 'node:crypto';
+
+import {
+  adminClient,
+  anonClient,
+  anonKey,
+  createRider,
+  deleteRider,
+  emailCode,
+  signInAgain,
+  supabaseUrl,
+  uniqueUsername,
+  type Rider,
+} from './helpers';
+
+const JPEG = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46, 0x00, 0xff, 0xd9]);
+
+let one: Rider;
+let two: Rider;
+
+beforeAll(async () => {
+  one = await createRider(uniqueUsername('one'));
+  two = await createRider(uniqueUsername('two'));
+});
+
+afterAll(async () => {
+  await Promise.all([one, two].filter(Boolean).map((rider) => deleteRider(rider.userId)));
+});
+
+describe('signing up', () => {
+  it('gives each rider their own user id', () => {
+    expect(one.userId).toMatch(/^[0-9a-f-]{36}$/);
+    expect(two.userId).toMatch(/^[0-9a-f-]{36}$/);
+    expect(one.userId).not.toBe(two.userId);
+  });
+
+  it('leaves each rider with a session for their own user', async () => {
+    for (const rider of [one, two]) {
+      const { data, error } = await rider.client.auth.getSession();
+      expect(error).toBeNull();
+      expect(data.session?.user.id).toBe(rider.userId);
+      expect(data.session?.access_token).toEqual(expect.any(String));
+    }
+  });
+
+  it('saves the username on the profile row', async () => {
+    const { data, error } = await one.client.from('profiles').select('username').eq('id', one.userId).single();
+    expect(error).toBeNull();
+    expect(data?.username).toBe(one.username);
+  });
+});
+
+describe('signing out and back in', () => {
+  it('ends the session, and a new email code restores one for the same user', async () => {
+    const rider = await createRider(uniqueUsername('again'));
+    try {
+      const { error: signOutError } = await rider.client.auth.signOut();
+      expect(signOutError).toBeNull();
+      expect((await rider.client.auth.getSession()).data.session).toBeNull();
+
+      const token = await emailCode(rider.email);
+      const { data, error } = await rider.client.auth.verifyOtp({ email: rider.email, token, type: 'email' });
+      expect(error).toBeNull();
+      expect(data.user?.id).toBe(rider.userId);
+      expect((await rider.client.auth.getSession()).data.session?.user.id).toBe(rider.userId);
+    } finally {
+      await deleteRider(rider.userId);
+    }
+  });
+
+  it('a used code does not sign in a second time', async () => {
+    const rider = await createRider(uniqueUsername('used'));
+    try {
+      const token = await emailCode(rider.email);
+      const first = await signInAgainWith(rider.email, token);
+      expect(first.error).toBeNull();
+      const second = await signInAgainWith(rider.email, token);
+      expect(second.error).not.toBeNull();
+      expect(second.data.session).toBeNull();
+    } finally {
+      await deleteRider(rider.userId);
+    }
+  });
+});
+
+/** verifyOtp with a given code on a fresh client. */
+function signInAgainWith(email: string, token: string) {
+  return anonClient().auth.verifyOtp({ email, token, type: 'email' });
+}
+
+describe('usernames', () => {
+  it("the second rider cannot take the first's username (23505)", async () => {
+    const { data, error } = await two.client
+      .from('profiles')
+      .update({ username: one.username })
+      .eq('id', two.userId)
+      .select('id');
+    expect(error?.code).toBe('23505');
+    expect(data).toBeNull();
+  });
+
+  it('nor the same name in other letter case (citext)', async () => {
+    const { error } = await two.client
+      .from('profiles')
+      .update({ username: one.username.toUpperCase() })
+      .eq('id', two.userId)
+      .select('id');
+    expect(error?.code).toBe('23505');
+  });
+
+  it('a malformed username is refused by the format check (23514)', async () => {
+    const { error } = await two.client.from('profiles').update({ username: 'an-a' }).eq('id', two.userId).select('id');
+    expect(error?.code).toBe('23514');
+  });
+
+  it('the first rider finds the second by username, in any case', async () => {
+    const { data, error } = await one.client.rpc('find_profile', { p_username: two.username.toUpperCase() });
+    expect(error).toBeNull();
+    expect(data).toEqual([{ id: two.userId, username: two.username, display_name: null }]);
+  });
+});
+
+describe('account-delete', () => {
+  const functionUrl = () => `${supabaseUrl()}/functions/v1/account-delete`;
+
+  it('refuses a request with no rider JWT (401)', async () => {
+    const response = await fetch(functionUrl(), {
+      method: 'POST',
+      headers: { apikey: anonKey(), 'Content-Type': 'application/json' },
+      body: '{}',
+    });
+    expect(response.status).toBe(401);
+    // The function's own answer: the local gateway lets a request with no Authorization header through.
+    expect(await response.json()).toEqual({ error: 'unauthorized' });
+  });
+
+  it('refuses a request whose bearer is the anon key, not a rider (401)', async () => {
+    const response = await fetch(functionUrl(), {
+      method: 'POST',
+      headers: { apikey: anonKey(), Authorization: `Bearer ${anonKey()}` },
+    });
+    expect(response.status).toBe(401);
+    expect(await response.json()).toEqual({ error: 'unauthorized' });
+  });
+
+  describe('as rider two, naming rider one in the body', () => {
+    const spotId = randomUUID();
+    const mediaId = randomUUID();
+    const photoPath = () => `${two.userId}/${spotId}/${mediaId}.jpg`;
+    let result: { data: unknown; error: unknown };
+
+    // A failed delete would leave the photo behind; deleting the user (the outer afterAll) never removes files.
+    afterAll(async () => {
+      await adminClient().storage.from('photos').remove([photoPath()]);
+    });
+
+    beforeAll(async () => {
+      const { error: spotError } = await two.client.from('spots').insert({
+        id: spotId,
+        owner_id: two.userId,
+        lat: 47.6,
+        lng: -122.3,
+        updated_at: new Date().toISOString(),
+      });
+      if (spotError) throw spotError;
+      const { error: uploadError } = await two.client.storage
+        .from('photos')
+        .upload(photoPath(), JPEG, { contentType: 'image/jpeg' });
+      if (uploadError) throw uploadError;
+      const listed = await adminClient().storage.from('photos').list(`${two.userId}/${spotId}`);
+      expect(listed.data?.map((entry) => entry.name)).toEqual([`${mediaId}.jpg`]);
+
+      result = await two.client.functions.invoke('account-delete', { body: { user_id: one.userId } });
+    });
+
+    it('answers { ok: true }', () => {
+      expect(result.error).toBeNull();
+      expect(result.data).toEqual({ ok: true });
+    });
+
+    it('deletes rider two', async () => {
+      const { data, error } = await adminClient().auth.admin.getUserById(two.userId);
+      expect(data.user).toBeNull();
+      expect(error?.status).toBe(404);
+    });
+
+    it("cascades away rider two's profile and spot", async () => {
+      const admin = adminClient();
+      const profiles = await admin.from('profiles').select('id').eq('id', two.userId);
+      expect(profiles.data).toEqual([]);
+      const spots = await admin.from('spots').select('id').eq('id', spotId);
+      expect(spots.data).toEqual([]);
+    });
+
+    it("removes rider two's photo from Storage", async () => {
+      const { data, error } = await adminClient().storage.from('photos').list(`${two.userId}/${spotId}`);
+      expect(error).toBeNull();
+      expect(data).toEqual([]);
+    });
+
+    it("rider one's find_profile no longer finds rider two", async () => {
+      const { data, error } = await one.client.rpc('find_profile', { p_username: two.username });
+      expect(error).toBeNull();
+      expect(data).toEqual([]);
+    });
+
+    it('leaves rider one, whom the body named, untouched', async () => {
+      const { data } = await adminClient().auth.admin.getUserById(one.userId);
+      expect(data.user?.id).toBe(one.userId);
+      const fresh = await signInAgain(one.email);
+      const { data: profile } = await fresh.from('profiles').select('username').eq('id', one.userId).single();
+      expect(profile?.username).toBe(one.username);
+    });
+  });
+});
diff --git a/src/__integration__/helpers.ts b/src/__integration__/helpers.ts
new file mode 100644
index 0000000..c1825ca
--- /dev/null
+++ b/src/__integration__/helpers.ts
@@ -0,0 +1,100 @@
+/**
+ * Riders against the local stack (S4-06). Run only by `npm run test:integration`, which reads the URL and keys from
+ * `npx supabase status -o json` (scripts/supabase-env.mjs); nothing here is a key.
+ *
+ * A rider signs in the way the app does (an email code), but the code comes from the Auth admin API instead of the
+ * mailbox: `auth.admin.generateLink({ type: 'magiclink', email })` returns it as `properties.email_otp`. Member names
+ * are from node_modules/@supabase/auth-js/dist/module/lib/types.d.ts (`GenerateLinkProperties.email_otp`, l.849) and
+ * node_modules/@supabase/auth-js/dist/module/GoTrueAdminApi.d.ts (`generateLink` l.249, `createUser` l.330,
+ * `getUserById` l.430, `deleteUser` l.608).
+ */
+import { randomUUID } from 'node:crypto';
+
+import { createClient, type SupabaseClient } from '@supabase/supabase-js';
+
+export type Rider = { client: SupabaseClient; userId: string; username: string; email: string };
+
+function env(name: 'SUPABASE_URL' | 'SUPABASE_ANON_KEY' | 'SUPABASE_SERVICE_ROLE_KEY'): string {
+  const values = {
+    SUPABASE_URL: process.env.SUPABASE_URL,
+    SUPABASE_ANON_KEY: process.env.SUPABASE_ANON_KEY,
+    SUPABASE_SERVICE_ROLE_KEY: process.env.SUPABASE_SERVICE_ROLE_KEY,
+  };
+  const value = values[name];
+  if (!value) throw new Error(`${name} is not set: run these tests with npm run test:integration`);
+  return value;
+}
+
+/** No session is stored and none is refreshed in the background, so a test run leaves no timers behind. */
+const NO_PERSIST = { auth: { persistSession: false, autoRefreshToken: false } };
+
+export const supabaseUrl = () => env('SUPABASE_URL');
+export const anonKey = () => env('SUPABASE_ANON_KEY');
+
+export function adminClient(): SupabaseClient {
+  return createClient(env('SUPABASE_URL'), env('SUPABASE_SERVICE_ROLE_KEY'), NO_PERSIST);
+}
+
+export function anonClient(): SupabaseClient {
+  return createClient(env('SUPABASE_URL'), env('SUPABASE_ANON_KEY'), NO_PERSIST);
+}
+
+/** A fresh 6-digit email code for an existing user, as if read from the mail. */
+export async function emailCode(email: string): Promise<string> {
+  const { data, error } = await adminClient().auth.admin.generateLink({ type: 'magiclink', email });
+  if (error) throw error;
+  return data.properties.email_otp;
+}
+
+/** Signs `client` in with a fresh email code; resolves the user id of the session. */
+export async function verifyWithCode(client: SupabaseClient, email: string): Promise<string> {
+  const token = await emailCode(email);
+  const { data, error } = await client.auth.verifyOtp({ email, token, type: 'email' });
+  if (error) throw error;
+  if (!data.session || !data.user) throw new Error(`verifyOtp gave no session for ${email}`);
+  return data.user.id;
+}
+
+/** A fresh anon client signed in as `email` with a new code. */
+export async function signInAgain(email: string): Promise<SupabaseClient> {
+  const client = anonClient();
+  await verifyWithCode(client, email);
+  return client;
+}
+
+/**
+ * A new rider: an auth user (email already confirmed), signed in on their own anon client with an email code, with
+ * `username` set on their profile row (made by the handle_new_user trigger) as the username screen does.
+ */
+export async function createRider(username: string): Promise<Rider> {
+  const email = `${username}-${randomUUID().slice(0, 8)}@example.test`;
+  const { data: created, error: createError } = await adminClient().auth.admin.createUser({
+    email,
+    email_confirm: true,
+  });
+  if (createError) throw createError;
+
+  // A rider half made (no session, no username) is deleted here: the caller never gets an id to clean up with.
+  try {
+    const client = anonClient();
+    const userId = await verifyWithCode(client, email);
+    const { data, error } = await client.from('profiles').update({ username }).eq('id', userId).select('id');
+    if (error) throw error;
+    if (data.length !== 1) throw new Error(`no profile row was updated for ${email}`);
+    return { client, userId, username, email };
+  } catch (error) {
+    await deleteRider(created.user.id);
+    throw error;
+  }
+}
+
+/** Deletes a rider left by a test; a rider already gone is fine. */
+export async function deleteRider(userId: string): Promise<void> {
+  const { error } = await adminClient().auth.admin.deleteUser(userId);
+  if (error && error.status !== 404) throw error;
+}
+
+/** A unique username for a test run (D39: 3–20 of a–z 0–9 _ .). */
+export function uniqueUsername(prefix: string): string {
+  return `${prefix}_${randomUUID().replace(/-/g, '').slice(0, 8)}`;
+}
diff --git a/src/__tests__/auth-code.test.tsx b/src/__tests__/auth-code.test.tsx
new file mode 100644
index 0000000..4c359c1
