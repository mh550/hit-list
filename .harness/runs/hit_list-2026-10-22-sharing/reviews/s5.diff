+
+      await setSyncState(db, 'user_id', 'u1');
+      expect(await getSyncState(db, 'user_id')).toBe('u1');
+
+      await setSyncState(db, 'user_id', 'u2');
+      expect(await getSyncState(db, 'user_id')).toBe('u2');
