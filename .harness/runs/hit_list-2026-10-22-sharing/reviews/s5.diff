+
+    signIn();
+
+    await waitFor(() => expect(mockSyncNow).toHaveBeenCalledTimes(1));
+    expect(mockAdopt).toHaveBeenCalledTimes(1);
+  });
+
+  it('new spots and lists get the rider as owner only once adoption is done, and none after sign-out', async () => {
