diff --git a/src/sync/photos.ts b/src/sync/photos.ts
new file mode 100644
index 0000000..6981f44
--- /dev/null
+++ b/src/sync/photos.ts
@@ -0,0 +1,145 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import { Directory, File, Paths } from 'expo-file-system';
+import type { SQLiteDatabase } from 'expo-sqlite';
+import { ImageManipulator, SaveFormat, type ImageRef } from 'expo-image-manipulator';
+import type { Media } from '@/src/types';
+import { resolvePhotoUri } from '@/src/utils/photo-storage';
+
+/** Uploads are re-encoded (D46): the long edge at most this many px, JPEG at this quality. */
+export const UPLOAD_MAX_EDGE = 2048;
+export const UPLOAD_JPEG_QUALITY = 0.85;
+export const PHOTOS_BUCKET = 'photos';
+
+/**
+ * How push reaches a media row's file. Injectable: Jest fakes it, the integration test (S5-07) reads with Node's fs.
+ * Paths are `media.file_path` as stored (relative to Paths.document, or an absolute uri when the copy failed).
+ */
+export interface PhotoIO {
+  exists(filePath: string): boolean;
+  /** The upload copy (see preparePhoto); `cleanup` deletes it. */
+  prepare(filePath: string): Promise<{ uri: string; bytes: Uint8Array; cleanup(): void }>;
+  /** Writes a downloaded photo to a relative `photos/<spot>/<media>.jpg` path, making its folder. */
+  write(filePath: string, bytes: Uint8Array): void;
+}
+
+/** Where a photo lives in the bucket; always derived, local media has no storage_path column. */
+export const storagePath = (owner: string, media: Pick<Media, 'id' | 'spot_id'>) =>
+  `${owner}/${media.spot_id}/${media.id}.jpg`;
+
+/**
+ * Re-encodes a photo for upload into a new file in the cache directory (where the manipulator saves) and reads its
+ * bytes. The original under Paths.document/photos is only read.
+ */
+export async function preparePhoto(localUri: string): Promise<{ uri: string; bytes: Uint8Array }> {
+  const context = ImageManipulator.manipulate(localUri);
+  const images: ImageRef[] = [];
+  try {
+    let image = await context.renderAsync();
+    images.push(image);
+    if (Math.max(image.width, image.height) > UPLOAD_MAX_EDGE) {
+      context.resize(image.width >= image.height ? { width: UPLOAD_MAX_EDGE } : { height: UPLOAD_MAX_EDGE });
+      image = await context.renderAsync();
+      images.push(image);
+    }
+    const saved = await image.saveAsync({ compress: UPLOAD_JPEG_QUALITY, format: SaveFormat.JPEG });
+    try {
+      return { uri: saved.uri, bytes: await new File(saved.uri).bytes() };
+    } catch (err) {
+      deleteCopy(saved.uri);
+      throw err;
+    }
+  } finally {
+    for (const image of images) image.release();
+    context.release();
+  }
+}
+
+function deleteCopy(uri: string): void {
+  try {
+    new File(uri).delete();
+  } catch (err) {
+    console.warn('[sync] could not delete the upload copy', err);
+  }
+}
+
+export const defaultPhotoIO: PhotoIO = {
+  exists: (filePath) => new File(resolvePhotoUri(filePath)).exists,
+  async prepare(filePath) {
+    const prepared = await preparePhoto(resolvePhotoUri(filePath));
+    return {
+      ...prepared,
+      cleanup: () => deleteCopy(prepared.uri),
+    };
+  },
+  write(filePath, bytes) {
+    new Directory(Paths.document, filePath.slice(0, filePath.lastIndexOf('/'))).create({
+      intermediates: true,
+      idempotent: true,
+    });
+    new File(resolvePhotoUri(filePath)).write(bytes);
+  },
+};
+
+/** Uploads to photos/<owner>/<spot>/<media>.jpg (upsert: a retry after a failed row write re-uploads harmlessly). */
+export async function uploadPhoto(
+  client: SupabaseClient,
+  owner: string,
+  media: Pick<Media, 'id' | 'spot_id'>,
+  bytes: Uint8Array,
+): Promise<string> {
+  const path = storagePath(owner, media);
+  const { error } = await client.storage
+    .from(PHOTOS_BUCKET)
+    .upload(path, bytes, { contentType: 'image/jpeg', upsert: true });
+  if (error) throw new Error(error.message);
+  return path;
+}
+
+/** A downloaded Blob's bytes. React Native's Blob has no arrayBuffer(); its FileReader reads one (Node's Blob has it). */
+function blobBytes(blob: Blob): Promise<Uint8Array> {
+  if (typeof blob.arrayBuffer === 'function') return blob.arrayBuffer().then((buffer) => new Uint8Array(buffer));
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(new Uint8Array(reader.result as ArrayBuffer));
+    reader.onerror = () => reject(reader.error ?? new Error('could not read the download'));
+    reader.readAsArrayBuffer(blob);
+  });
+}
+
+/**
+ * The rider's own live photos of live spots that reached the server (`rev` set: pulled, or this phone's push came
+ * back) but whose file is not on this phone: a second phone, or a reinstall. Up to `limit` downloads per sync, one at a time, newest
+ * first; a failure warns and the photo is tried again next sync. Others' photos (S8) go to the cache lazily, not here.
+ * Returns how many files were written.
+ */
+export async function downloadMissingPhotos(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  io: PhotoIO = defaultPhotoIO,
+  limit = 20,
+): Promise<number> {
+  const rows = await db.getAllAsync<Pick<Media, 'id' | 'spot_id' | 'file_path'>>(
+    `SELECT m.id, m.spot_id, m.file_path FROM media m JOIN spots s ON s.id = m.spot_id
+     WHERE m.owner_id = ? AND m.deleted_at IS NULL AND s.deleted_at IS NULL AND m.rev IS NOT NULL
+       AND m.file_path LIKE 'photos/%'
+     ORDER BY m.created_at DESC, m.id`,
+    uid,
+  );
+  let tried = 0;
+  let written = 0;
+  for (const media of rows) {
+    if (tried >= limit) break;
+    if (io.exists(media.file_path)) continue;
+    tried += 1;
+    try {
+      const { data, error } = await client.storage.from(PHOTOS_BUCKET).download(storagePath(uid, media));
+      if (error) throw new Error(error.message);
+      io.write(media.file_path, await blobBytes(data));
+      written += 1;
+    } catch (err) {
+      console.warn(`[sync] could not download photo ${media.id}:`, err instanceof Error ? err.message : err);
+    }
+  }
+  return written;
+}
diff --git a/src/sync/pull.ts b/src/sync/pull.ts
new file mode 100644
index 0000000..ebc2da3
--- /dev/null
+++ b/src/sync/pull.ts
@@ -0,0 +1,347 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteBindValue, SQLiteDatabase } from 'expo-sqlite';
+import { getCursor, setCursor, type SyncTable } from '@/src/db/sync';
+import { maySync, signedInAs } from './account';
+import { toIso } from './time';
+
+/**
+ * Pull (docs/plans/2026-10-22-s5-sync.md, "Pull"): brings down every row the rider can read whose server `rev` is
+ * past the table's cursor, in FK order, then reconciles what `rev` can't show (memberships the server deleted for real,
+ * others' spots the rider can no longer read).
+ *
+ * Every write here sets the server's `rev`, so the outbox triggers (which fire only when `rev` is unchanged) queue
+ * nothing: a pulled row never echoes back. A row is written only when the server's `updated_at` is at least the
+ * local one (an unpushed local edit wins; its outbox row still pushes it). Nothing here runs in a transaction.
+ */
+
+/** Rows per page; PostgREST answers at most 1000. */
+export const PULL_PAGE = 500;
+/**
+ * The server's `bump_rev` takes `nextval` inside the writer's transaction, so rev 100 can commit after rev 101 was
+ * pulled. Each pull re-reads this many revs below the cursor; a row applied twice is a no-op (`rev` guard).
+ * `sync_rev` is one sequence for every table and every rider, so this is a window of revs handed out anywhere, not
+ * of this rider's rows: a transaction that stays open while more than 200 others commit can still be missed.
+ */
+export const REV_OVERLAP = 200;
+/** Ids per `in.(…)` filter: keeps the request URL short. */
+const IDS_PER_QUERY = 100;
+const TABLES: readonly SyncTable[] = ['spots', 'media', 'hit_lists', 'hit_list_spots'];
+
+export interface PullResult {
+  /** A local row was written or removed: the stores need a reload. */
+  changed: boolean;
+  /** A table could not be read (offline, a server error): the phone is not up to date. A row that waits is not this. */
+  failed?: true;
+}
+
+type ServerRow = Record<string, unknown>;
+type Values = Record<string, SQLiteBindValue>;
+
+export async function pull(db: SQLiteDatabase, client: SupabaseClient, uid: string): Promise<PullResult> {
+  if (!(await maySync(db, client, uid))) return { changed: false };
+  let changed = false;
+  let failed = false;
+  for (const table of TABLES) {
+    const result = await pullTable(db, client, table);
+    changed = result.changed || changed;
+    failed = result.failed || failed;
+  }
+  changed = (await reconcileMemberships(db, client, uid)) || changed;
+  changed = (await reconcileReadableSpots(db, client, uid)) || changed;
+  return failed ? { changed, failed } : { changed };
+}
+
+const message = (err: unknown) => (err instanceof Error ? err.message : String(err));
+
+/**
+ * Pages `rev > cursor - REV_OVERLAP` in rev order. The table stops at the first row that can't be written (a photo
+ * whose spot isn't here yet): the cursor stays at the last row applied, so that row and the ones after it come again.
+ */
+async function pullTable(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  table: SyncTable,
+): Promise<{ changed: boolean; failed: boolean }> {
+  const cursor = await getCursor(db, table);
+  let after = Math.max(0, cursor - REV_OVERLAP);
+  let highest = cursor;
+  let changed = false;
+  let failed = false;
+  pages: for (;;) {
+    const { data, error } = await client.from(table).select('*').gt('rev', after).order('rev').limit(PULL_PAGE);
+    if (error) {
+      console.warn(`[sync] pull ${table} failed:`, error.message);
+      failed = true;
+      break;
+    }
+    const rows = (data ?? []) as ServerRow[];
+    for (const row of rows) {
+      try {
+        if (await applyRow(db, table, row)) changed = true;
+      } catch (err) {
+        console.warn(`[sync] pull ${table}: a row at rev ${String(row.rev)} waits for the next sync:`, message(err));
+        break pages;
+      }
+      highest = Math.max(highest, Number(row.rev));
+    }
+    if (rows.length < PULL_PAGE) break;
+    after = Number(rows[rows.length - 1].rev);
+  }
+  if (highest > cursor) await setCursor(db, table, highest);
+  return { changed, failed };
+}
+
+const text = (value: unknown): string | null => (value === null || value === undefined ? null : String(value));
+const num = (value: unknown): number | null => (typeof value === 'number' ? value : null);
+/** Every timestamp from the server is stored as the app writes them (`…Z`); one toIso can't read stays as sent. */
+const stamp = (value: unknown): string | null => {
+  const raw = text(value);
+  return raw === null ? null : (toIso(raw) ?? raw);
+};
+
+function applyRow(db: SQLiteDatabase, table: SyncTable, row: ServerRow): Promise<boolean> {
+  switch (table) {
+    case 'spots':
+      return applyOwned(db, table, row, spotValues(row));
+    case 'media':
+      // a pulled photo's file comes later (downloadMissingPhotos); a local row keeps its own file_path
+      return applyOwned(db, table, row, mediaValues(row), { file_path: `photos/${text(row.spot_id)}/${text(row.id)}.jpg` });
+    case 'hit_lists':
+      return applyOwned(db, table, row, listValues(row));
+    case 'hit_list_spots':
+      return applyMembership(db, row);
+  }
+}
+
+/** Server → local columns (push maps the other way). `legacy_json` never left the phone, so a pull never sets it. */
+function spotValues(row: ServerRow): Values {
+  return {
+    owner_id: text(row.owner_id),
+    name: text(row.name),
+    generated_name: text(row.generated_name),
+    latitude: Number(row.lat),
+    longitude: Number(row.lng),
+    feature_types_json: JSON.stringify(Array.isArray(row.feature_types) ? row.feature_types : []),
+    stopped: row.stopped === true ? 1 : 0,
+    // 0 (None) is a rating; only null is unset
+    natural_speed: num(row.natural_speed),
+    notes: text(row.notes),
+    primary_photo_id: text(row.primary_photo_id),
+    created_at: stamp(row.created_at),
+    updated_at: stamp(row.updated_at),
+    deleted_at: stamp(row.deleted_at),
+  };
+}
+
+function mediaValues(row: ServerRow): Values {
+  return {
+    spot_id: text(row.spot_id),
+    owner_id: text(row.owner_id),
+    captured_at: stamp(row.captured_at),
+    latitude: num(row.lat),
+    longitude: num(row.lng),
+    uploaded_by: text(row.uploaded_by),
+    created_at: stamp(row.created_at),
+    updated_at: stamp(row.updated_at),
+    deleted_at: stamp(row.deleted_at),
+  };
+}
+
+function listValues(row: ServerRow): Values {
+  return {
+    owner_id: text(row.owner_id),
+    name: text(row.name),
+    kind: text(row.kind),
+    area_center_lat: num(row.area_center_lat),
+    area_center_lng: num(row.area_center_lng),
+    area_radius_m: num(row.area_radius_m),
+    area_filters_json: row.area_filters === null || row.area_filters === undefined ? null : JSON.stringify(row.area_filters),
+    area_place: text(row.area_place),
+    shared: row.shared === true ? 1 : 0,
+    created_at: stamp(row.created_at),
+    updated_at: stamp(row.updated_at),
+    deleted_at: stamp(row.deleted_at),
+  };
+}
+
+/** The incoming row is older than the local one. An unreadable incoming time never overwrites; an unreadable local one does. */
+function isOlder(incoming: SQLiteBindValue, local: SQLiteBindValue): boolean {
+  const at = (value: SQLiteBindValue) => Date.parse(toIso(typeof value === 'string' ? value : null) ?? '');
+  const theirs = at(incoming);
+  const mine = at(local);
+  if (Number.isNaN(theirs)) return true;
+  return !Number.isNaN(mine) && theirs < mine;
+}
+
+/**
+ * Inserts a row this phone doesn't have, or updates one when the server's rev is newer than the stored one and its
+ * updated_at is not older (equal applies: the echo of this phone's own push only stores the rev). Both guards sit in
+ * the UPDATE itself, so an edit the rider saves while the pull awaits is never overwritten (julianday reads `…Z` and
+ * SQLite's `YYYY-MM-DD HH:MM:SS`). Never `INSERT OR REPLACE`: replacing a spot would cascade-delete its photos and
+ * memberships.
+ */
+async function applyOwned(
+  db: SQLiteDatabase,
+  table: 'spots' | 'media' | 'hit_lists',
+  row: ServerRow,
+  values: Values,
+  insertOnly: Values = {},
+): Promise<boolean> {
+  const id = text(row.id);
+  const rev = Number(row.rev);
+  const columns = Object.keys(values);
+  const local = await db.getFirstAsync<Values>(`SELECT ${columns.join(', ')}, rev FROM ${table} WHERE id = ?`, id);
+  if (!local) {
+    const insert: Values = { id, ...values, ...insertOnly, rev };
+    const names = Object.keys(insert);
+    await db.runAsync(
+      `INSERT INTO ${table} (${names.join(', ')}) VALUES (${names.map(() => '?').join(', ')})`,
+      ...Object.values(insert),
+    );
+    return true;
+  }
+  if (typeof local.rev === 'number' && local.rev >= rev) return false;
+  if (isOlder(values.updated_at, local.updated_at)) return false;
+  const { changes } = await db.runAsync(
+    `UPDATE ${table} SET ${columns.map((c) => `${c} = ?`).join(', ')}, rev = ?
+     WHERE id = ? AND (rev IS NULL OR rev < ?)
+       AND (julianday(updated_at) IS NULL OR julianday(updated_at) <= julianday(?))`,
+    ...Object.values(values),
+    rev,
+    id,
+    rev,
+    values.updated_at,
+  );
+  return changes > 0 && columns.some((c) => local[c] !== values[c]);
+}
+
+/**
+ * A membership is insert-only (the server has no update). One the rider removed and hasn't pushed yet stays removed.
+ * A list or spot that isn't here fails the foreign key and stops the table.
+ */
+async function applyMembership(db: SQLiteDatabase, row: ServerRow): Promise<boolean> {
+  const listId = text(row.list_id);
+  const spotId = text(row.spot_id);
+  const { changes } = await db.runAsync(
+    `INSERT OR IGNORE INTO hit_list_spots (list_id, spot_id, added_by, added_at, rev)
+     SELECT ?, ?, ?, ?, ? WHERE NOT EXISTS (
+       SELECT 1 FROM sync_outbox
+       WHERE entity = 'hit_list_spot' AND entity_id = ? AND op = 'delete' AND parked = 0
+     )`,
+    listId,
+    spotId,
+    text(row.added_by),
+    stamp(row.added_at),
+    Number(row.rev),
+    `${listId}/${spotId}`,
+  );
+  return changes > 0;
+}
+
+function chunks<T>(items: T[], size: number): T[][] {
+  const out: T[][] = [];
+  for (let i = 0; i < items.length; i += size) out.push(items.slice(i, i + size));
+  return out;
+}
+
+/** Which of `ids` the server lets the rider read, or null when any request failed (then nothing is removed). */
+async function readable(
+  ask: (chunk: string[]) => PromiseLike<{ data: ServerRow[] | null; error: { message: string } | null }>,
+  column: string,
+  ids: string[],
+  what: string,
+): Promise<Set<string> | null> {
+  const found = new Set<string>();
+  for (const chunk of chunks(ids, IDS_PER_QUERY)) {
+    const { data, error } = await ask(chunk);
+    if (error) {
+      console.warn(`[sync] pull: could not check ${what}, nothing removed:`, error.message);
+      return null;
+    }
+    for (const row of data ?? []) found.add(String(row[column]));
+  }
+  return found;
+}
+
+/** No outbox row of any kind (waiting or parked) for the membership: the phone has nothing left to tell the server. */
+const NO_OUTBOX_ROW = `NOT EXISTS (
+  SELECT 1 FROM sync_outbox o WHERE o.entity = 'hit_list_spot' AND o.entity_id = m.list_id || '/' || m.spot_id
+)`;
+
+/**
+ * The server deletes memberships for real, so `rev` can't show it. A membership of the rider's live list whose spot is
+ * synced, with no outbox row, that the server no longer has is removed here. It is marked `rev = -1` first so the
+ * delete trigger queues nothing (a queued delete would go to the server). A phone-only list or spot is never asked
+ * about; any failed request, or the session ending (an anonymous read sees no memberships), removes nothing.
+ */
+async function reconcileMemberships(db: SQLiteDatabase, client: SupabaseClient, uid: string): Promise<boolean> {
+  const local = await db.getAllAsync<{ list_id: string; spot_id: string }>(
+    `SELECT m.list_id, m.spot_id FROM hit_list_spots m
+     JOIN hit_lists l ON l.id = m.list_id
+     JOIN spots s ON s.id = m.spot_id
+     WHERE l.owner_id = ? AND l.deleted_at IS NULL AND s.owner_id IS NOT NULL AND ${NO_OUTBOX_ROW}
+     ORDER BY m.list_id, m.spot_id`,
+    uid,
+  );
+  const byList = new Map<string, string[]>();
+  for (const { list_id, spot_id } of local) byList.set(list_id, [...(byList.get(list_id) ?? []), spot_id]);
+
+  const gone: string[] = [];
+  for (const [listId, spotIds] of byList) {
+    const found = await readable(
+      (chunk) => client.from('hit_list_spots').select('spot_id').eq('list_id', listId).in('spot_id', chunk),
+      'spot_id',
+      spotIds,
+      'list memberships',
+    );
+    if (found === null) return false;
+    for (const spotId of spotIds) if (!found.has(spotId)) gone.push(`${listId}/${spotId}`);
+  }
+  if (gone.length === 0 || !(await signedInAs(client, uid))) return false;
+
+  const ids = JSON.stringify(gone);
+  await db.runAsync(
+    `UPDATE hit_list_spots AS m SET rev = -1
+     WHERE m.list_id || '/' || m.spot_id IN (SELECT value FROM json_each(?)) AND ${NO_OUTBOX_ROW}`,
+    ids,
+  );
+  const { changes } = await db.runAsync(
+    `DELETE FROM hit_list_spots WHERE rev = -1 AND list_id || '/' || spot_id IN (SELECT value FROM json_each(?))`,
+    ids,
+  );
+  return changes > 0;
+}
+
+/**
+ * Others' spots (S8) the rider can no longer read (left the list, unfriended, unshared) are removed from the phone
+ * with their photos' rows and memberships (spec §3.4 "removes local copies"). Only rows owned by someone else: never
+ * the rider's own, never a phone-only (NULL) row. Removing them queues nothing: spots and media have no delete
+ * trigger, and a membership queues only when its spot is the rider's. Any failed request, or the session ending,
+ * removes nothing.
+ */
+async function reconcileReadableSpots(db: SQLiteDatabase, client: SupabaseClient, uid: string): Promise<boolean> {
+  const foreign = (
+    await db.getAllAsync<{ id: string }>(
+      'SELECT id FROM spots WHERE owner_id IS NOT NULL AND owner_id <> ? ORDER BY id',
+      uid,
+    )
+  ).map((r) => r.id);
+  if (foreign.length === 0) return false;
+
+  const found = await readable(
+    (chunk) => client.from('spots').select('id').in('id', chunk),
+    'id',
+    foreign,
+    'readable spots',
+  );
+  if (found === null) return false;
+  const gone = foreign.filter((id) => !found.has(id));
+  if (gone.length === 0 || !(await signedInAs(client, uid))) return false;
+
+  const ids = JSON.stringify(gone);
+  const theirs = `SELECT id FROM spots WHERE id IN (SELECT value FROM json_each(?)) AND owner_id IS NOT NULL AND owner_id <> ?`;
+  await db.runAsync(`DELETE FROM hit_list_spots WHERE spot_id IN (${theirs})`, ids, uid);
+  await db.runAsync(`DELETE FROM media WHERE spot_id IN (${theirs})`, ids, uid);
+  const { changes } = await db.runAsync(`DELETE FROM spots WHERE id IN (${theirs})`, ids, uid);
+  return changes > 0;
+}
diff --git a/src/sync/push.ts b/src/sync/push.ts
new file mode 100644
index 0000000..7bacb75
--- /dev/null
+++ b/src/sync/push.ts
@@ -0,0 +1,364 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteDatabase } from 'expo-sqlite';
+import {
+  BACKOFF_AFTER_ATTEMPTS,
+  FAILED_AFTER_ATTEMPTS,
+  markDone,
+  markFailed,
+  parkRow,
+  peekOutbox,
+  type OutboxRow,
+} from '@/src/db/sync';
+import { maySync, signedInAs } from './account';
+import { defaultPhotoIO, storagePath, uploadPhoto, type PhotoIO } from './photos';
+import { toIso } from './time';
+
+/**
+ * Push (docs/plans/2026-10-22-s5-sync.md, "Push"): drains the outbox into Supabase in id order. Each row sends the
+ * entity's **current** local state; the outbox row is deleted only after the server confirmed the write.
+ *
+ * 1. Fresh pass: rows with fewer than BACKOFF_AFTER_ATTEMPTS failures; the first failure stops the push (an
+ *    unreachable server fails everything anyway).
+ * 2. Backoff pass: each row with BACKOFF_AFTER_ATTEMPTS ≤ attempts < FAILED_AFTER_ATTEMPTS once; a failure goes on.
+ * 3. FAILED_AFTER_ATTEMPTS or more waits for Profile's Retry.
+ * A photo or membership whose spot (or list) still has an earlier row waiting is left untouched until that row is
+ * done: the server would refuse it with 42501 (RLS runs before the FK check), which reads like a real refusal.
+ * A refusal no retry can fix (RLS, a check, a photo file that is gone, a row of another account) is parked, unless the
+ * session ended mid-push (the anon key gets 42501 for everything): then the push stops and leaves the rows alone.
+ */
+
+const PAGE = 50;
+/** PostgREST codes that mean "never": RLS refused (42501), a check failed (23514). 23503 (FK) is a normal retry. */
+const PERMANENT_CODES = new Set(['42501', '23514']);
+export const PHOTO_MISSING = 'photo missing';
+const NOT_THIS_ACCOUNT = 'not this account';
+
+export interface PushResult {
+  /** Rows the server confirmed (or that no longer exist on the phone, so there was nothing to send). */
+  pushed: number;
+  /** Rows that failed or were parked in this push. */
+  failed: number;
+}
+
+/** Sent (or gone locally: nothing to send), held back behind its parent, or a reason to park it. */
+type Sent = 'sent' | 'waiting' | { park: string };
+
+class ServerError extends Error {
+  constructor(
+    message: string,
+    readonly code?: string,
+  ) {
+    super(message);
+  }
+}
+
+/** A `{ data, error }` answer: an error throws, so every server call fails the same way. */
+function check({ error }: { error: { message: string; code?: string } | null }): void {
+  if (error) throw new ServerError(error.message, error.code);
+}
+
+/** Required timestamps: ISO when readable, else as stored (the server parses more than toIso; never invent one). */
+const stamp = (value: string) => toIso(value) ?? value;
+const optionalStamp = (value: string | null) => (value === null ? null : stamp(value));
+
+export async function push(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  io: PhotoIO = defaultPhotoIO,
+): Promise<PushResult> {
+  const result: PushResult = { pushed: 0, failed: 0 };
+  if (!(await maySync(db, client, uid))) return result;
+
+  const tally = (outcome: Outcome) => {
+    if (outcome === 'done') result.pushed += 1;
+    else if (outcome === 'failed' || outcome === 'parked') result.failed += 1;
+  };
+
+  // both passes page by id: a waiting row stays in the outbox, so peeking from the start would find it again
+  let afterId = 0;
+  for (;;) {
+    const rows = await peekOutbox(db, PAGE, { skipFailed: true, afterId });
+    if (rows.length === 0) break;
+    for (const row of rows) {
+      const outcome = await pushRow(db, client, uid, io, row);
+      tally(outcome);
+      if (outcome === 'failed' || outcome === 'stop') return result;
+      afterId = row.id;
+    }
+  }
+
+  afterId = 0;
+  for (;;) {
+    const rows = await peekOutbox(db, PAGE, {
+      minAttempts: BACKOFF_AFTER_ATTEMPTS,
+      maxAttempts: FAILED_AFTER_ATTEMPTS,
+      afterId,
+    });
+    if (rows.length === 0) break;
+    for (const row of rows) {
+      const outcome = await pushRow(db, client, uid, io, row);
+      if (outcome === 'stop') return result;
+      tally(outcome);
+      afterId = row.id;
+    }
+  }
+  return result;
+}
+
+/** An earlier row for this spot or list still waits (not parked): it must reach the server first. */
+async function parentWaiting(db: SQLiteDatabase, row: OutboxRow, spotId: string, listId?: string): Promise<boolean> {
+  const found = await db.getFirstAsync<{ id: number }>(
+    `SELECT id FROM sync_outbox WHERE parked = 0 AND id < ?
+       AND ((entity = 'spot' AND entity_id = ?) OR (entity = 'hit_list' AND entity_id = ?)) LIMIT 1`,
+    row.id,
+    spotId,
+    listId ?? null,
+  );
+  return found !== null;
+}
+
+/** `stop`: the session is gone, so nothing this push could say about the row is true; it is left as it was. */
+type Outcome = 'done' | 'failed' | 'parked' | 'waiting' | 'stop';
+
+async function pushRow(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  io: PhotoIO,
+  row: OutboxRow,
+): Promise<Outcome> {
+  let sent: Sent;
+  try {
+    sent = await send(db, client, uid, io, row);
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    if (err instanceof ServerError && err.code && PERMANENT_CODES.has(err.code)) {
+      if (!(await signedInAs(client, uid))) return 'stop';
+      sent = { park: message };
+    } else {
+      console.warn(`[sync] push ${row.entity} ${row.entity_id} failed:`, message);
+      await markFailed(db, row.id, message);
+      return 'failed';
+    }
+  }
+  if (sent === 'sent') {
+    await markDone(db, row.id);
+    return 'done';
+  }
+  if (sent === 'waiting') return 'waiting';
+  console.warn(`[sync] push ${row.entity} ${row.entity_id} set aside:`, sent.park);
+  await parkRow(db, row.id, sent.park);
+  return 'parked';
+}
+
+function send(db: SQLiteDatabase, client: SupabaseClient, uid: string, io: PhotoIO, row: OutboxRow): Promise<Sent> {
+  switch (row.entity) {
+    case 'spot':
+      return sendSpot(db, client, uid, row.entity_id);
+    case 'media':
+      return sendMedia(db, client, uid, io, row);
+    case 'hit_list':
+      return sendHitList(db, client, uid, row.entity_id);
+    case 'hit_list_spot':
+      return sendMembership(db, client, uid, row);
+  }
+}
+
+interface SpotRow {
+  id: string;
+  owner_id: string | null;
+  name: string | null;
+  generated_name: string | null;
+  latitude: number;
+  longitude: number;
+  feature_types_json: string;
+  stopped: number;
+  natural_speed: number | null;
+  notes: string | null;
+  primary_photo_id: string | null;
+  created_at: string;
+  updated_at: string;
+  deleted_at: string | null;
+}
+
+function featureTypes(json: string): string[] {
+  try {
+    const parsed: unknown = JSON.parse(json);
+    if (Array.isArray(parsed)) return parsed.filter((t): t is string => typeof t === 'string');
+  } catch {
+    // an unreadable column reads as untagged, as getSpots does
+  }
+  return [];
+}
+
+/** A spot's upsert; its 'delete' is the same upsert (the row carries deleted_at; spots have no delete policy). */
+async function sendSpot(db: SQLiteDatabase, client: SupabaseClient, uid: string, id: string): Promise<Sent> {
+  const row = await db.getFirstAsync<SpotRow>(
+    `SELECT id, owner_id, name, generated_name, latitude, longitude, feature_types_json, stopped, natural_speed, notes,
+            primary_photo_id, created_at, updated_at, deleted_at FROM spots WHERE id = ?`,
+    id,
+  );
+  if (!row) return 'sent';
+  if (row.owner_id !== uid) return { park: NOT_THIS_ACCOUNT };
+  check(
+    await client.from('spots').upsert({
+      id: row.id,
+      owner_id: row.owner_id,
+      name: row.name,
+      generated_name: row.generated_name,
+      lat: row.latitude,
+      lng: row.longitude,
+      feature_types: featureTypes(row.feature_types_json),
+      stopped: row.stopped === 1,
+      // 0 (None) is a rating; only NULL is unset
+      natural_speed: row.natural_speed,
+      notes: row.notes,
+      primary_photo_id: row.primary_photo_id,
+      created_at: stamp(row.created_at),
+      updated_at: stamp(row.updated_at),
+      deleted_at: optionalStamp(row.deleted_at),
+    }),
+  );
+  return 'sent';
+}
+
+interface MediaRow {
+  id: string;
+  spot_id: string;
+  owner_id: string | null;
+  file_path: string;
+  captured_at: string | null;
+  latitude: number | null;
+  longitude: number | null;
+  created_at: string;
+  updated_at: string | null;
+  deleted_at: string | null;
+}
+
+/** The photo goes up first, then the row; a removed photo sends only its deleted_at (D3: its file may be gone). */
+async function sendMedia(
+  db: SQLiteDatabase,
+  client: SupabaseClient,
+  uid: string,
+  io: PhotoIO,
+  outboxRow: OutboxRow,
+): Promise<Sent> {
+  const row = await db.getFirstAsync<MediaRow>(
+    `SELECT id, spot_id, owner_id, file_path, captured_at, latitude, longitude, created_at, updated_at, deleted_at
+     FROM media WHERE id = ?`,
+    outboxRow.entity_id,
+  );
+  if (!row) return 'sent';
+  if (row.owner_id !== uid) return { park: NOT_THIS_ACCOUNT };
+  if (await parentWaiting(db, outboxRow, row.spot_id)) return 'waiting';
+  if (row.deleted_at === null) {
+    if (!io.exists(row.file_path)) return { park: PHOTO_MISSING };
+    const prepared = await io.prepare(row.file_path);
+    try {
+      await uploadPhoto(client, uid, row, prepared.bytes);
+    } finally {
+      prepared.cleanup();
+    }
+  }
+  check(
+    await client.from('media').upsert({
+      id: row.id,
+      spot_id: row.spot_id,
+      owner_id: row.owner_id,
+      storage_path: storagePath(uid, row),
+      // EXIF wall-clock time without a zone (src/utils/exif.ts); unreadable → null
+      captured_at: toIso(row.captured_at, 'local'),
+      lat: row.latitude,
+      lng: row.longitude,
+      uploaded_by: row.owner_id,
+      created_at: stamp(row.created_at),
+      updated_at: stamp(row.updated_at ?? row.created_at),
+      deleted_at: optionalStamp(row.deleted_at),
+    }),
+  );
+  return 'sent';
+}
+
+interface HitListRow {
+  id: string;
+  owner_id: string | null;
+  name: string;
+  kind: string;
+  area_center_lat: number | null;
+  area_center_lng: number | null;
+  area_radius_m: number | null;
+  area_filters_json: string | null;
+  area_place: string | null;
+  created_at: string;
+  updated_at: string;
+  deleted_at: string | null;
+}
+
+function areaFilters(json: string | null): unknown {
+  if (json === null) return null;
+  try {
+    return JSON.parse(json);
+  } catch {
+    return null;
+  }
+}
+
+async function sendHitList(db: SQLiteDatabase, client: SupabaseClient, uid: string, id: string): Promise<Sent> {
+  const row = await db.getFirstAsync<HitListRow>(
+    `SELECT id, owner_id, name, kind, area_center_lat, area_center_lng, area_radius_m, area_filters_json, area_place,
+            created_at, updated_at, deleted_at FROM hit_lists WHERE id = ?`,
+    id,
+  );
+  if (!row) return 'sent';
+  if (row.owner_id !== uid) return { park: NOT_THIS_ACCOUNT };
+  check(
+    await client.from('hit_lists').upsert({
+      id: row.id,
+      owner_id: row.owner_id,
+      name: row.name,
+      kind: row.kind,
+      area_center_lat: row.area_center_lat,
+      area_center_lng: row.area_center_lng,
+      area_radius_m: row.area_radius_m,
+      area_filters: areaFilters(row.area_filters_json),
+      area_place: row.area_place,
+      // never `shared`: a stale false would fire the server's t30_unshare (drops every member); only the sharing
+      // functions change it
+      created_at: stamp(row.created_at),
+      updated_at: stamp(row.updated_at),
+      deleted_at: optionalStamp(row.deleted_at),
+    }),
+  );
+  return 'sent';
+}
+
+/**
+ * A membership has no update policy: an upsert is "insert unless it is there" (ON CONFLICT DO NOTHING); a delete
+ * that matches no row is done too.
+ */
+async function sendMembership(db: SQLiteDatabase, client: SupabaseClient, uid: string, row: OutboxRow): Promise<Sent> {
+  const slash = row.entity_id.indexOf('/');
+  const listId = row.entity_id.slice(0, slash);
+  const spotId = row.entity_id.slice(slash + 1);
+  if (row.op === 'delete') {
+    check(await client.from('hit_list_spots').delete().eq('list_id', listId).eq('spot_id', spotId));
+    return 'sent';
+  }
+  const member = await db.getFirstAsync<{ added_at: string }>(
+    'SELECT added_at FROM hit_list_spots WHERE list_id = ? AND spot_id = ?',
+    listId,
+    spotId,
+  );
+  if (!member) return 'sent';
+  if (await parentWaiting(db, row, spotId, listId)) return 'waiting';
+  check(
+    await client
+      .from('hit_list_spots')
+      .upsert(
+        { list_id: listId, spot_id: spotId, added_by: uid, added_at: stamp(member.added_at) },
+        { onConflict: 'list_id,spot_id', ignoreDuplicates: true },
+      ),
+  );
+  return 'sent';
+}
