--- /dev/null
+++ b/src/sync/account.ts
@@ -0,0 +1,17 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { SQLiteDatabase } from 'expo-sqlite';
+import { getSyncState } from '@/src/db/sync';
+
+/** The client holds a session for `uid` right now. */
+export async function signedInAs(client: SupabaseClient, uid: string): Promise<boolean> {
+  const { data, error } = await client.auth.getSession();
+  return !error && data.session?.user.id === uid;
+}
+
+/**
+ * Push and pull run only with a session for `uid`, on a phone whose rows are `uid`'s (sync_state.user_id): anything
+ * else would send one account's rows under another, or pull and reconcile one account's data into another's.
+ */
+export async function maySync(db: SQLiteDatabase, client: SupabaseClient, uid: string): Promise<boolean> {
+  return (await signedInAs(client, uid)) && (await getSyncState(db, 'user_id')) === uid;
+}
diff --git a/src/sync/adopt.ts b/src/sync/adopt.ts
new file mode 100644
index 0000000..8dd6543
--- /dev/null
+++ b/src/sync/adopt.ts
@@ -0,0 +1,228 @@
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import {
+  adoptableMemberships,
+  clearOutbox,
+  countPending,
+  enqueueMemberships,
+  getSyncState,
+  resetCursors,
+  setSyncState,
+} from '@/src/db/sync';
+import { useSyncStore } from '@/src/stores/sync-store';
+import { deleteSpotPhotos } from '@/src/utils/photo-storage';
+import { reloadStores, runExclusive } from './engine';
+import { defaultPhotoIO, type PhotoIO } from './photos';
+
+/*
+ * Whose rows are on the phone (S5-06, D38, D66, D67; docs/plans/2026-10-22-s5-sync.md "Adoption", "Sign out").
+ * Each runs on the sync queue (runExclusive), so no push or pull sees it half done, and each writes in one
+ * transaction: the exception to "no withTransactionAsync for app writes", accepted because they run at sign-in,
+ * sign-out or account deletion, when no screen is writing (only a town backfill could, and it is redone next launch).
+ * After the commit the photo folders of the removed spots go and the stores reload.
+ */
+
+export type AdoptResult = 'done' | 'needs_confirm';
+
+/** The spots and lists Keep after Delete account made phone-only (what its Remove then takes away). */
+export interface ReleasedRows {
+  spotIds: string[];
+  listIds: string[];
+}
+
+/** Rows adoption takes: live phone-only spots, live photos of live spots, live lists (a deleted one never uploads). */
+const ADOPTABLE_SPOTS = 'owner_id IS NULL AND deleted_at IS NULL';
+const ADOPTABLE_MEDIA =
+  'owner_id IS NULL AND deleted_at IS NULL AND spot_id IN (SELECT id FROM spots WHERE deleted_at IS NULL)';
+const ADOPTABLE_LISTS = 'owner_id IS NULL AND deleted_at IS NULL';
+
+/** The commit already happened: a reload that fails only warns (the next pull that changes rows reloads again). */
+async function reloadAfterCommit(db: SQLiteDatabase): Promise<void> {
+  try {
+    await reloadStores(db);
+  } catch (err) {
+    console.warn('[sync] reloading the stores failed:', err instanceof Error ? err.message : err);
+  }
+}
+
+/**
+ * Deletes every row that came with an account (owner_id set) except `keep`'s, memberships first, and returns the
+ * removed spots' ids (for their photo folders). `sync_state.user_id` must already be cleared, so no delete trigger
+ * queues a server DELETE.
+ */
+async function deleteAccountRows(db: SQLiteDatabase, keep: string | null): Promise<string[]> {
+  const owned = 'owner_id IS NOT NULL AND owner_id IS NOT ?';
+  const spots = await db.getAllAsync<{ id: string }>(`SELECT id FROM spots WHERE ${owned}`, keep);
+  await db.runAsync(
+    `DELETE FROM hit_list_spots
+     WHERE list_id IN (SELECT id FROM hit_lists WHERE ${owned}) OR spot_id IN (SELECT id FROM spots WHERE ${owned})`,
+    keep,
+    keep,
+  );
+  await db.runAsync(
+    `DELETE FROM media WHERE ${owned} OR spot_id IN (SELECT id FROM spots WHERE ${owned})`,
+    keep,
+    keep,
+  );
+  await db.runAsync(`DELETE FROM spots WHERE ${owned}`, keep);
+  await db.runAsync(`DELETE FROM hit_lists WHERE ${owned}`, keep);
+  return spots.map((s) => s.id);
+}
+
+/** A row adoption would take. */
+async function hasPhoneOnlyRows(db: SQLiteDatabase): Promise<boolean> {
+  const row = await db.getFirstAsync<{ any: number }>(
+    `SELECT EXISTS (SELECT 1 FROM spots WHERE ${ADOPTABLE_SPOTS})
+         OR EXISTS (SELECT 1 FROM media WHERE ${ADOPTABLE_MEDIA})
+         OR EXISTS (SELECT 1 FROM hit_lists WHERE ${ADOPTABLE_LISTS}) AS any`,
+  );
+  return row?.any === 1;
+}
+
+/**
+ * Makes the phone `uid`'s (sign-in, and launch when already signed in). When another account's rows are here, they
+ * leave first with their photo files, outbox and cursors (D66); if any of their changes never reached the server it
+ * returns 'needs_confirm' and changes nothing, unless `confirmSwitch` (the rider chose Remove and continue). Then every
+ * live phone-only spot, photo and list gets `uid` as owner (one deleted before sign-in stays on the phone only, so its
+ * photos never upload), the triggers queue their upserts (user_id is set first),
+ * and the memberships that just became fully owned are queued after them. Idempotent: with nothing phone-only and the
+ * phone already `uid`'s it writes nothing. The caller syncs afterwards (never from inside: see runExclusive).
+ */
+export function adopt(
+  db: SQLiteDatabase,
+  uid: string,
+  opts: { confirmSwitch?: boolean } = {},
+): Promise<AdoptResult> {
+  return runExclusive(async (): Promise<AdoptResult> => {
+    const prev = await getSyncState(db, 'user_id');
+    const switching = prev !== uid;
+    if (prev !== undefined && switching && !opts.confirmSwitch && (await countPending(db)) > 0) return 'needs_confirm';
+    if (!switching && !(await hasPhoneOnlyRows(db))) return 'done';
+
+    let removed: string[] = [];
+    await db.withTransactionAsync(async () => {
+      if (switching) {
+        await setSyncState(db, 'user_id', null);
+        if (prev !== undefined) await setSyncState(db, `last_sync_at:${prev}`, null);
+        removed = await deleteAccountRows(db, uid);
+        await clearOutbox(db);
+        await resetCursors(db);
+      }
+      const memberships = await adoptableMemberships(db);
+      await setSyncState(db, 'user_id', uid);
+      await db.runAsync(`UPDATE spots SET owner_id = ? WHERE ${ADOPTABLE_SPOTS}`, uid);
+      await db.runAsync(`UPDATE media SET owner_id = ? WHERE ${ADOPTABLE_MEDIA}`, uid);
+      await db.runAsync(`UPDATE hit_lists SET owner_id = ? WHERE ${ADOPTABLE_LISTS}`, uid);
+      await enqueueMemberships(db, memberships);
+    });
+    deleteSpotPhotos(removed);
+    await reloadAfterCommit(db);
+    return 'done';
+  });
+}
+
+/**
+ * Remove from this phone (D38): the account's rows (and whatever else came with it) and their photo files leave, the
+ * outbox and `uid`'s sync state are cleared; phone-only spots stay. Resolves false and removes nothing while a change
+ * still waits to be backed up (D69), unless `discardPending` (after Delete account: there is no account to reach).
+ */
+export function removeLocalAccountData(
+  db: SQLiteDatabase,
+  uid: string,
+  opts: { discardPending?: boolean } = {},
+): Promise<boolean> {
+  return runExclusive(async () => {
+    if (!opts.discardPending && (await countPending(db)) > 0) return false;
+    // from now on a new spot is phone-only, also while the sign-out itself still runs
+    useSyncStore.setState({ adoptedUserId: null });
+    let removed: string[] = [];
+    await db.withTransactionAsync(async () => {
+      await setSyncState(db, 'user_id', null);
+      await setSyncState(db, `last_sync_at:${uid}`, null);
+      removed = await deleteAccountRows(db, null);
+      await clearOutbox(db);
+      await resetCursors(db);
+    });
+    deleteSpotPhotos(removed);
+    await reloadAfterCommit(db);
+    return true;
+  });
+}
+
+/**
+ * Keep after Delete account (D67), run as soon as the account is gone, before the rider answers Keep / Remove (an
+ * unanswered alert must not leave rows a later sign-in would remove as another account's): `uid`'s spots, photos,
+ * lists and memberships become phone-only again (owner and rev cleared), so a later sign-in adopts them like any
+ * other; photo rows whose file never reached this phone go (there is nowhere left to download them from), rows of
+ * other accounts go, and the outbox, cursors and user_id are cleared. Photo files on the phone stay. Resolves the
+ * spots and lists it released, for removeReleasedRows.
+ */
+export function releaseAccountData(
+  db: SQLiteDatabase,
+  uid: string,
+  io: Pick<PhotoIO, 'exists'> = defaultPhotoIO,
+): Promise<ReleasedRows> {
+  return runExclusive(async () => {
+    useSyncStore.setState({ adoptedUserId: null });
+    let removed: string[] = [];
+    const released: ReleasedRows = { spotIds: [], listIds: [] };
+    await db.withTransactionAsync(async () => {
+      await setSyncState(db, 'user_id', null);
+      await setSyncState(db, `last_sync_at:${uid}`, null);
+      removed = await deleteAccountRows(db, uid);
+      const media = await db.getAllAsync<{ id: string; file_path: string }>(
+        'SELECT id, file_path FROM media WHERE owner_id = ?',
+        uid,
+      );
+      const missing = JSON.stringify(media.filter((m) => !io.exists(m.file_path)).map((m) => m.id));
+      await db.runAsync(
+        'UPDATE spots SET primary_photo_id = NULL WHERE primary_photo_id IN (SELECT value FROM json_each(?))',
+        missing,
+      );
+      await db.runAsync('DELETE FROM media WHERE id IN (SELECT value FROM json_each(?))', missing);
+      const ids = async (table: 'spots' | 'hit_lists') =>
+        (await db.getAllAsync<{ id: string }>(`SELECT id FROM ${table} WHERE owner_id = ? ORDER BY id`, uid)).map(
+          (r) => r.id,
+        );
+      released.spotIds = await ids('spots');
+      released.listIds = await ids('hit_lists');
+      await db.runAsync('UPDATE spots SET owner_id = NULL, rev = NULL WHERE owner_id = ?', uid);
+      await db.runAsync('UPDATE media SET owner_id = NULL, rev = NULL WHERE owner_id = ?', uid);
+      await db.runAsync('UPDATE hit_lists SET owner_id = NULL, rev = NULL WHERE owner_id = ?', uid);
+      await db.runAsync('UPDATE hit_list_spots SET rev = NULL WHERE rev IS NOT NULL');
+      await clearOutbox(db);
+      await resetCursors(db);
+    });
+    deleteSpotPhotos(removed);
+    await reloadAfterCommit(db);
+    return released;
+  });
+}
+
+/**
+ * Remove after Delete account: the spots and lists releaseAccountData released, with their photos, memberships and
+ * photo files. Rows a sign-in adopted since are no longer phone-only and stay.
+ */
+export function removeReleasedRows(db: SQLiteDatabase, released: ReleasedRows): Promise<void> {
+  return runExclusive(async () => {
+    const spots = JSON.stringify(released.spotIds);
+    const lists = JSON.stringify(released.listIds);
+    const phoneOnlyIn = 'owner_id IS NULL AND id IN (SELECT value FROM json_each(?))';
+    let removed: string[] = [];
+    await db.withTransactionAsync(async () => {
+      removed = (await db.getAllAsync<{ id: string }>(`SELECT id FROM spots WHERE ${phoneOnlyIn}`, spots)).map((r) => r.id);
+      const gone = JSON.stringify(removed);
+      await db.runAsync(
+        `DELETE FROM hit_list_spots WHERE spot_id IN (SELECT value FROM json_each(?))
+           OR list_id IN (SELECT id FROM hit_lists WHERE ${phoneOnlyIn})`,
+        gone,
+        lists,
+      );
+      await db.runAsync('DELETE FROM media WHERE spot_id IN (SELECT value FROM json_each(?))', gone);
+      await db.runAsync('DELETE FROM spots WHERE id IN (SELECT value FROM json_each(?))', gone);
+      await db.runAsync(`DELETE FROM hit_lists WHERE ${phoneOnlyIn}`, lists);
+    });
+    deleteSpotPhotos(removed);
+    await reloadAfterCommit(db);
+  });
+}
diff --git a/src/sync/engine.ts b/src/sync/engine.ts
new file mode 100644
index 0000000..c60041e
--- /dev/null
+++ b/src/sync/engine.ts
@@ -0,0 +1,185 @@
+import type { SQLiteDatabase } from 'expo-sqlite';
+
+import { getAllMedia, getHitLists, getListMemberships, getSpots } from '@/src/db';
+import { countFailed, countPending, getSyncState, lastOutboxId, setSyncState } from '@/src/db/sync';
+import { useHitListsStore, useMediaStore, useSpotsStore } from '@/src/stores';
+import { useSyncStore } from '@/src/stores/sync-store';
+import { getSupabase } from './client';
+import { downloadMissingPhotos } from './photos';
+import { pull } from './pull';
+import { push } from './push';
+
+/** useSync's timer: a sync every 5 minutes while the app is open (D48). */
+export const SYNC_INTERVAL_MS = 300_000;
+
+/** The tail of the queue every sync and every exclusive task (adopt, Remove from this phone) runs on, one at a time. */
+let queue: Promise<unknown> = Promise.resolve();
+/** The sync queued or running now (`started` once it runs); a call before it starts joins it. */
+let current: { promise: Promise<void>; started: boolean } | null = null;
+/** The one sync asked for while `current` runs: it starts after `current`, so a change saved meanwhile goes too. */
+let followUp: Promise<void> | null = null;
+
+/**
+ * Runs `task` once nothing else on the queue runs: never during a sync's push or pull, and a sync asked for meanwhile
+ * waits for it. Adoption and Remove (S5-06) go through here, so no push or pull sees their transaction half done.
+ * A task must not await syncNow (that sync queues behind the task: a deadlock); `void syncNow(db)` inside it, or
+ * awaiting it after runExclusive resolves, is fine.
+ */
+export function runExclusive<T>(task: () => Promise<T>): Promise<T> {
+  const run = queue.then(task, task);
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+/**
+ * Push, then pull, then the missing photo files, as the signed-in rider; single-flight: a call while a sync waits to
+ * start joins it, a call while one runs gets exactly one more sync after it (Retry or pull-to-refresh right after an
+ * edit must not join a sync already past its push). Nothing happens without a client, without a session, or while
+ * the phone's rows are not the session's rider's (sync_state.user_id: not adopted yet, or another account's). Never
+ * rejects: errors are `console.warn` and land in the sync store.
+ */
+export function syncNow(db: SQLiteDatabase): Promise<void> {
+  if (current && !current.started) return current.promise;
+  if (current) {
+    followUp ??= current.promise.then(() => {
+      followUp = null;
+      return syncNow(db);
+    });
+    return followUp;
+  }
+  const entry = {
+    started: false,
+    promise: runExclusive(() => {
+      entry.started = true;
+      return syncOnce(db);
+    }).finally(() => {
+      if (current === entry) current = null;
+    }),
+  };
+  current = entry;
+  return entry.promise;
+}
+
+const message = (err: unknown) => (err instanceof Error ? err.message : String(err));
+const lastSyncKey = (uid: string) => `last_sync_at:${uid}`;
+
+async function sessionRider(db: SQLiteDatabase): Promise<string | null> {
+  const client = getSupabase();
+  if (!client) return null;
+  const { data } = await client.auth.getSession();
+  const uid = data.session?.user.id;
+  return uid && (await getSyncState(db, 'user_id')) === uid ? uid : null;
+}
+
+async function syncOnce(db: SQLiteDatabase): Promise<void> {
+  const client = getSupabase();
+  let uid: string | null;
+  try {
+    uid = await sessionRider(db);
+  } catch (err) {
+    console.warn('[sync] could not read the session:', message(err));
+    return;
+  }
+  if (!client || !uid) return;
+
+  const shown = useSyncStore.getState();
+  const sameRider = shown.userId === uid;
+  useSyncStore.setState({
+    userId: uid,
+    syncing: true,
+    failedCount: sameRider ? shown.failedCount : 0,
+    lastError: sameRider ? shown.lastError : null,
+    lastSyncAt: sameRider ? shown.lastSyncAt : null,
+  });
+
+  let error: string | null = null;
+  const fail = (what: string, err: unknown) => {
+    console.warn(`[sync] ${what} failed:`, message(err));
+    error ??= message(err);
+  };
+  try {
+    useSyncStore.setState({ lastSyncAt: (await getSyncState(db, lastSyncKey(uid))) ?? null });
+    // Backed up = every change queued before this sync reached the server (one saved meanwhile goes next time).
+    const queuedBefore = await lastOutboxId(db);
+
+    try {
+      const { failed } = await push(db, client, uid);
+      if (failed > 0) error ??= `push: ${failed} ${failed === 1 ? 'change' : 'changes'} failed`;
+    } catch (err) {
+      fail('push', err);
+    }
+    let changed = false;
+    try {
+      const result = await pull(db, client, uid);
+      changed = result.changed;
+      if (result.failed) error ??= 'pull: the server could not be read';
+    } catch (err) {
+      fail('pull', err);
+    }
+    try {
+      await downloadMissingPhotos(db, client, uid);
+    } catch (err) {
+      // the photos are already backed up; their files come next sync
+      console.warn('[sync] photo download failed:', message(err));
+    }
+    if (changed) {
+      try {
+        await reloadStores(db);
+      } catch (err) {
+        console.warn('[sync] reloading the stores failed:', message(err));
+      }
+    }
+
+    const failedCount = await countFailed(db);
+    const waiting = await countPending(db, queuedBefore);
+    if (waiting > 0) error ??= `${waiting} ${waiting === 1 ? 'change' : 'changes'} still waiting`;
+    // push and pull quietly do nothing once the session is gone: that is not a backup either
+    if (error === null && (await sessionRider(db)) !== uid) error = 'signed out during the sync';
+    if (error === null) {
+      const lastSyncAt = new Date().toISOString();
+      await setSyncState(db, lastSyncKey(uid), lastSyncAt);
+      useSyncStore.setState({ lastSyncAt });
+    }
+    useSyncStore.setState({ failedCount, lastError: error });
+  } catch (err) {
+    fail('sync', err);
+    useSyncStore.setState({ lastError: error });
+  } finally {
+    useSyncStore.setState({ syncing: false });
+  }
+}
+
+/** Reads before giving up on a reload the rider keeps changing (the next pull that changes rows reloads again). */
+const RELOAD_TRIES = 3;
+
+/** The store values a reload replaces; the action hooks replace them (store first, then the DB) on every change. */
+const storeValues = () => [
+  useSpotsStore.getState().spots,
+  useMediaStore.getState().mediaBySpot,
+  useHitListsStore.getState().lists,
+  useHitListsStore.getState().membershipBySpot,
+];
+
+/**
+ * What a pull (or adoption, src/sync/adopt.ts) changed reaches the screens: the same loads as useDbInit's. A change the rider made while the loads ran
+ * is in the store but maybe not in what was read, so then it reads again rather than put an older state back (the
+ * action hooks issue their DB write right after the store update, so the next read sees it).
+ */
+export async function reloadStores(db: SQLiteDatabase): Promise<void> {
+  for (let attempt = 0; attempt < RELOAD_TRIES; attempt += 1) {
+    const before = storeValues();
+    const [spots, media, lists, memberships] = await Promise.all([
+      getSpots(db),
+      getAllMedia(db),
+      getHitLists(db),
+      getListMemberships(db),
+    ]);
+    if (storeValues().some((value, i) => value !== before[i])) continue;
+    useSpotsStore.getState().setSpots(spots);
+    useMediaStore.getState().setAll(media);
+    useHitListsStore.getState().setLists(lists);
+    useHitListsStore.getState().setMemberships(memberships);
+    return;
+  }
+  console.warn('[sync] the stores kept changing; they reload after the next pull that changes rows');
+}
