--- /dev/null
+++ b/src/hooks/use-sync.ts
@@ -0,0 +1,43 @@
+import { useEffect } from 'react';
+import { AppState } from 'react-native';
+import { useSQLiteContext } from 'expo-sqlite';
+
+import { useAuthStore } from '@/src/stores/auth-store';
+import { SYNC_INTERVAL_MS, syncNow } from '@/src/sync/engine';
+
+/**
+ * The sync triggers (D48), mounted once inside DBInitializer (so the DB is ready): while a rider is signed in, a sync
+ * now, on every return to the foreground, and every 5 minutes while the app is in the foreground. The timer stops in
+ * the background, on sign-out and on unmount. The engine itself decides whether this phone may sync for the session.
+ */
+export function useSync(): void {
+  const db = useSQLiteContext();
+  const userId = useAuthStore((s) => (s.status === 'signed_in' ? s.userId : null));
+
+  useEffect(() => {
+    if (!userId) return;
+    let timer: ReturnType<typeof setInterval> | null = null;
+    const startTimer = () => {
+      timer ??= setInterval(() => void syncNow(db), SYNC_INTERVAL_MS);
+    };
+    const stopTimer = () => {
+      if (timer !== null) clearInterval(timer);
+      timer = null;
+    };
+
+    void syncNow(db);
+    startTimer();
+    const appState = AppState.addEventListener('change', (state) => {
+      if (state === 'active') {
+        void syncNow(db);
+        startTimer();
+      } else if (state === 'background') {
+        stopTimer();
+      }
+    });
+    return () => {
+      stopTimer();
+      appState.remove();
+    };
+  }, [db, userId]);
+}
diff --git a/src/stores/sync-store.ts b/src/stores/sync-store.ts
new file mode 100644
index 0000000..132aa3e
--- /dev/null
+++ b/src/stores/sync-store.ts
@@ -0,0 +1,30 @@
+import { create } from 'zustand';
+
+// What the last sync left (src/sync/engine.ts writes it; Profile and the Spots tab's pull-to-refresh read it).
+// `userId` is the rider those values belong to: a screen shows them only for the account signed in now.
+export interface SyncSnapshot {
+  userId: string | null;
+  /** When a sync last finished with no error (ISO), kept per rider in sync_state so a relaunch knows it. */
+  lastSyncAt: string | null;
+  syncing: boolean;
+  /** Outbox rows waiting for Retry (countFailed). */
+  failedCount: number;
+  /** The last sync's first error message, `null` after one that went through. */
+  lastError: string | null;
+  /**
+   * The signed-in rider once adoption made the phone's rows theirs (useAdoption), `null` signed out: new spots and
+   * lists get it as owner (src/sync/owner.ts).
+   */
+  adoptedUserId: string | null;
+}
+
+export const INITIAL_SYNC: SyncSnapshot = {
+  userId: null,
+  lastSyncAt: null,
+  syncing: false,
+  failedCount: 0,
+  lastError: null,
+  adoptedUserId: null,
+};
+
+export const useSyncStore = create<SyncSnapshot>(() => ({ ...INITIAL_SYNC }));
