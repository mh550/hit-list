+
+  it('a later sign-in adopts the released rows like any phone-only spot', async () => {
+    await setSyncState(db, 'user_id', A);
+    await seedOwnedBy(A, 'a');
+    await releaseAccountData(db, A);
+
+    await adopt(db, B);
