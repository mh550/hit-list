+      } else {
+        console.warn('[share sheet] sharing failed:', errorMessage(err));
+        setLine(FAILED);
+      }
+    } finally {
+      busy.current = false;
+      setPhase(null);
+    }
+  };
+
+  let rows: ReactNode;
+  if (!loaded) {
