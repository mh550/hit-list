+    <meta name="hitlist-functions-url" content="http://127.0.0.1:54321/functions/v1" />
+    <!-- The token is in the fragment, which no request carries; never send this URL as a referrer either. -->
+    <meta name="referrer" content="no-referrer" />
+    <meta
+      http-equiv="Content-Security-Policy"
+      content="default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src https: http:; connect-src https: http:; base-uri 'none'; form-action 'none'"
+    />
+    <meta name="robots" content="noindex" />
+    <title>HitList</title>
+    <style>
+      :root {
+        color-scheme: light dark;
+        --fg: #111;
+        --muted: #666;
+        --card: #fff;
+        --bg: #f2f2f7;
+        --line: #d1d1d6;
