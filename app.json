{
  "expo": {
    "name": "HitList",
    "slug": "hit-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hitlist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hitlist.app",
      "infoPlist": {
        "NSCameraUsageDescription": "HitList needs camera access to take photos of spots.",
        "NSPhotoLibraryUsageDescription": "HitList needs photo library access to import spot photos.",
        "NSLocationWhenInUseUsageDescription": "HitList needs your location to show nearby spots and tag spot locations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HitList needs your location to show nearby spots and tag spot locations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.hitlist.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HitList needs camera access to take photos of spots."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HitList needs your location to show nearby spots and tag spot locations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HitList needs photo library access to import spot photos."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
